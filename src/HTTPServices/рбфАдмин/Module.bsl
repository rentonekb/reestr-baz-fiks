// Админ-API реестра баз вместо COM-соединения (с 14.10.2026).
// POST /hs/rbf-admin/{method}, тело - JSON; GET /hs/rbf-admin/{method}?параметры - только чтение.
// Доступ: роль ПолныеПрава или рбфАдминAPI. Каждый вызов на запись пишется в журнал «рбфАдминAPI».
//
// Методы:
//  POST grant-access     {"login"}                         - добавить пользователя в группу «Пользователи реестра баз»
//  POST profile-role     {"profile", "role"}               - добавить роль ("Роль.Имя") в профиль групп доступа
//  POST set-archive-type {"server", "base", "type"}        - записать тип базы до архивации (рбфТипДоАрхива)
//  POST enqueue          {"command", "param"}              - поставить команду в ОчередьКоманд
//  POST archive          {"rule", "bases":[...], "server"} - поставить базы в архивный цикл (КонтрольБаз)
//  POST set-owner        {"server", "base", "owner"}       - назначить владельца базы (перенос записи измерения)
//  POST set-server       {"base", "server"}                - перенести базу на другой сервер 1С
//  POST service-user     {"login"}                         - создать/привязать элемент справочника для учётки РЗ_*
//  POST run-job          {"job"}                           - запустить регламентное задание сразу фоновым заданием
//  POST agent-user       {"login", "password"}             - учётка агента мониторинга РЗ_*: пользователь ИБ,
//                                                            профиль «Агент мониторинга», группа «Агенты мониторинга»
//  POST metrics          {"server", "time", "values":{}}    - замер агента (рбфСчетчики); роль рбфАгентМониторинга
//  POST techlog          {"server", "hour", "events":[]}    - агрегаты ТЖ за час (рбфСобытияТЖ); роль рбфАгентМониторинга
//  POST tj-result        {"id", "status", "summary", "diagnosis", "error"} - результат анализа ТЖ (status done/error);
//                                                            роль рбфАгентМониторинга
//  POST tj-analyze       {"dir", "from", "to", "dry_run"}  - поставить анализ ТЖ в очередь рбфЗаданияАнализаТЖ
//  GET  tj-job                                             - взять задание анализа ТЖ (статус running):
//                                                            {"id","dir","from","to","dry_run"} или {"job":null};
//                                                            роль рбфАгентМониторинга
//  GET  logcfg           ?server=                          - текст logcfg.xml сервера (без порта) для агента:
//                                                            {"server","applied","changed","logcfg"}, applied - текст
//                                                            сохранён кнопкой «Применить на сервере»; роль рбфАгентМониторинга
//  GET  user-roles       ?login=                           - роли пользователя ИБ
//  GET  ping                                               - проверка доступности

#Область ОбработчикиСобытий

Функция КомандаВыполнить(Запрос)

	Возврат Обработать(Запрос, Истина);

КонецФункции

Функция КомандаПрочитать(Запрос)

	Возврат Обработать(Запрос, Ложь);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Обработать(Запрос, ЭтоЗапись)

	Метод = НРег(Запрос.ПараметрыURL.Получить("method"));
	// агентам мониторинга (роль рбфАгентМониторинга) доступны только методы приёма замеров и заданий анализа ТЖ
	ЭтоМетодАгента = ЭтоЗапись И (Метод = "metrics" ИЛИ Метод = "techlog" ИЛИ Метод = "tj-result")
		ИЛИ НЕ ЭтоЗапись И (Метод = "tj-job" ИЛИ Метод = "logcfg");
	Если НЕ (РольДоступна("ПолныеПрава") ИЛИ РольДоступна("рбфАдминAPI")
		ИЛИ ЭтоМетодАгента И РольДоступна("рбфАгентМониторинга")) Тогда
		Журнал(Метод, "отказ: нет прав", УровеньЖурналаРегистрации.Предупреждение);
		Возврат Ответ(403, Новый Структура("error", "нет прав"));
	КонецЕсли;
	// права проверены выше; служебной учётке с одной ролью рбфАдминAPI нужен доступ к данным
	УстановитьПривилегированныйРежим(Истина);

	Попытка
		Если ЭтоЗапись Тогда
			Параметры = ПрочитатьТело(Запрос);
		Иначе
			Параметры = Новый Соответствие;
			Для Каждого КлючЗначение Из Запрос.ПараметрыЗапроса Цикл
				Параметры.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЦикла;
		КонецЕсли;

		Если ЭтоЗапись И Метод = "grant-access" Тогда
			Результат = ВыдатьДоступ(Обязательный(Параметры, "login"));
		ИначеЕсли ЭтоЗапись И Метод = "profile-role" Тогда
			Результат = ДобавитьРольВПрофиль(Обязательный(Параметры, "profile"), Обязательный(Параметры, "role"));
		ИначеЕсли ЭтоЗапись И Метод = "set-archive-type" Тогда
			Результат = ЗаписатьТипДоАрхива(Обязательный(Параметры, "server"), Обязательный(Параметры, "base"),
				Обязательный(Параметры, "type"));
		ИначеЕсли ЭтоЗапись И Метод = "enqueue" Тогда
			Результат = ПоставитьВОчередь(Обязательный(Параметры, "command"), Параметры.Получить("param"));
		ИначеЕсли ЭтоЗапись И Метод = "archive" Тогда
			Результат = ПоставитьВАрхив(Обязательный(Параметры, "rule"), Обязательный(Параметры, "bases"),
				Параметры.Получить("server"));
		ИначеЕсли ЭтоЗапись И Метод = "set-owner" Тогда
			Результат = НазначитьВладельцаAPI(Обязательный(Параметры, "server"), Обязательный(Параметры, "base"),
				Обязательный(Параметры, "owner"));
		ИначеЕсли ЭтоЗапись И Метод = "set-server" Тогда
			Результат = ПеренестиНаСервер(Обязательный(Параметры, "base"), Обязательный(Параметры, "server"));
		ИначеЕсли ЭтоЗапись И Метод = "service-user" Тогда
			Результат = ПривязатьСлужебногоПользователя(Обязательный(Параметры, "login"));
		ИначеЕсли ЭтоЗапись И Метод = "run-job" Тогда
			Результат = ЗапуститьЗадание(Обязательный(Параметры, "job"));
		ИначеЕсли ЭтоЗапись И Метод = "metrics" Тогда
			Результат = Новый Структура("written", ПравилаРеестраБаз.ПринятьСчетчики(Обязательный(Параметры, "server"),
				ДатаИзСтроки(Обязательный(Параметры, "time")), Обязательный(Параметры, "values")));
		ИначеЕсли ЭтоЗапись И Метод = "techlog" Тогда
			События = Параметры.Получить("events");
			Результат = Новый Структура("written", ПравилаРеестраБаз.ПринятьСобытияТЖ(Обязательный(Параметры, "server"),
				ДатаИзСтроки(Обязательный(Параметры, "hour")), ?(События = Неопределено, Новый Массив, События)));
		ИначеЕсли ЭтоЗапись И Метод = "tj-result" Тогда
			Результат = Новый Структура("updated", ПравилаРеестраБаз.ПринятьРезультатАнализаТЖ(
				Обязательный(Параметры, "id"), Обязательный(Параметры, "status"), СтрокаПараметра(Параметры, "summary"),
				СтрокаПараметра(Параметры, "diagnosis"), СтрокаПараметра(Параметры, "error")));
		ИначеЕсли ЭтоЗапись И Метод = "tj-analyze" Тогда
			Результат = Новый Структура("id", ПравилаРеестраБаз.ПоставитьАнализТЖ(Обязательный(Параметры, "dir"),
				ДатаИзСтроки(Обязательный(Параметры, "from")), ДатаИзСтроки(Обязательный(Параметры, "to")),
				Параметры.Получить("dry_run") = Истина, ИмяПользователя()));
		ИначеЕсли НЕ ЭтоЗапись И Метод = "tj-job" Тогда
			Результат = ЗаданиеАнализаТЖ();
		ИначеЕсли НЕ ЭтоЗапись И Метод = "logcfg" Тогда
			Результат = ТекстLogcfg(Обязательный(Параметры, "server"));
		ИначеЕсли ЭтоЗапись И Метод = "agent-user" Тогда
			Результат = СоздатьАгента(Обязательный(Параметры, "login"), Обязательный(Параметры, "password"));
		ИначеЕсли НЕ ЭтоЗапись И Метод = "user-roles" Тогда
			Результат = РолиПользователя(Обязательный(Параметры, "login"));
		ИначеЕсли НЕ ЭтоЗапись И Метод = "ping" Тогда
			Результат = Новый Структура("ok,user", Истина, ИмяПользователя());
		Иначе
			Возврат Ответ(404, Новый Структура("error", "неизвестный метод " + Метод));
		КонецЕсли;
	Исключение
		Текст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Журнал(Метод, "ошибка: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), УровеньЖурналаРегистрации.Ошибка);
		Возврат Ответ(400, Новый Структура("error", Текст));
	КонецПопытки;

	// замеры агентов (каждые 5 минут) и опрос заданий ТЖ (раз в минуту) в журнал не пишем; пароль в журнал не попадает
	Если ЭтоЗапись И НЕ ЭтоМетодАгента Тогда
		Если Параметры.Получить("password") <> Неопределено Тогда
			Параметры.Вставить("password", "***");
		КонецЕсли;
		Журнал(Метод, ЗаписатьJSONВСтроку(Параметры) + " -> " + ЗаписатьJSONВСтроку(Результат),
			УровеньЖурналаРегистрации.Информация);
	КонецЕсли;
	Возврат Ответ(200, Результат);

КонецФункции

Функция ВыдатьДоступ(Логин)

	Пользователь = ПользовательПоЛогину(Логин);
	Группа = Справочники.ГруппыДоступа.НайтиПоНаименованию("Пользователи реестра баз", Истина);
	Если Группа.Пустая() Тогда
		ВызватьИсключение "нет группы доступа «Пользователи реестра баз»";
	КонецЕсли;
	Объект = Группа.ПолучитьОбъект();
	Добавлен = Объект.Пользователи.Найти(Пользователь, "Пользователь") = Неопределено;
	Если Добавлен Тогда
		Объект.Пользователи.Добавить().Пользователь = Пользователь;
		Объект.Записать();
	КонецЕсли;
	Возврат Новый Структура("login,added,roles", Логин, Добавлен, РолиПользователя(Логин).roles);

КонецФункции

Функция ДобавитьРольВПрофиль(ИмяПрофиля, ПолноеИмяРоли)

	Профиль = Справочники.ПрофилиГруппДоступа.НайтиПоНаименованию(ИмяПрофиля, Истина);
	Если Профиль.Пустая() Тогда
		ВызватьИсключение "нет профиля «" + ИмяПрофиля + "»";
	КонецЕсли;
	Роль = ИдентификаторРоли(ПолноеИмяРоли);
	Объект = Профиль.ПолучитьОбъект();
	Добавлена = Объект.Роли.Найти(Роль, "Роль") = Неопределено;
	Если Добавлена Тогда
		Объект.Роли.Добавить().Роль = Роль;
		Объект.Записать();
	КонецЕсли;
	Возврат Новый Структура("profile,role,added", ИмяПрофиля, ПолноеИмяРоли, Добавлена);

КонецФункции

Функция ЗаписатьТипДоАрхива(Сервер, ИмяБазы, Тип)

	Если Метаданные.Перечисления.ТипБазы.ЗначенияПеречисления.Найти(Тип) = Неопределено Тогда
		ВызватьИсключение "нет значения ТипБазы «" + Тип + "»";
	КонецЕсли;
	МенеджерЗаписи = РегистрыСведений.рбфТипДоАрхива.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Сервер1С = Сервер;
	МенеджерЗаписи.ИмяБазы1С = ИмяБазы;
	МенеджерЗаписи.Тип = Тип;
	МенеджерЗаписи.ДатаАрхивации = ТекущаяДатаСеанса();
	МенеджерЗаписи.Записать();
	Возврат Новый Структура("server,base,type", Сервер, ИмяБазы, Тип);

КонецФункции

Функция ПоставитьВОчередь(Команда, Параметр)

	МенеджерЗаписи = РегистрыСведений.ОчередьКоманд.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Идентификатор = "api-" + Строка(Новый УникальныйИдентификатор);
	МенеджерЗаписи.Команда = Команда;
	МенеджерЗаписи.Параметр = ?(Параметр = Неопределено, "", Строка(Параметр));
	МенеджерЗаписи.Состояние = "новая";
	МенеджерЗаписи.Записать();
	Возврат Новый Структура("id", МенеджерЗаписи.Идентификатор);

КонецФункции

// Ставит базы в архивный цикл: пишет учёт правила КонтрольБаз с датой отключения 31 день назад
// (поведение archive_list.os). Немедленного DROP здесь нет: базу заберёт ближайший прогон
// правила КонтрольВладельцев (АрхивироватьОтключённыеБазы) - бэкап с проверкой, DROP, удаление
// ИБ из кластера, тип «Архивная». База должна быть в OFFLINE: ONLINE цикл считает включённой
// вручную и пропускает.
//
// Параметры:
//  Правило - Строка - имя правила КонтрольБаз ("Владелец", "Актуальность", "Простой", ...).
//  Базы - Массив, Строка - имена ИБ; строку разбираем по запятой.
//  Сервер - Строка, Неопределено - представление сервера 1С; Неопределено - все серверы.
//
// Возвращаемое значение:
//  Структура - rule, count, bases (массив структур base, server, action).
Функция ПоставитьВАрхив(Правило, Базы, Сервер)

	Список = ?(ТипЗнч(Базы) = Тип("Массив"), Базы, СтрРазделить(Строка(Базы), ",", Ложь));
	СерверТекст = ?(Сервер = Неопределено, "", СокрЛП(Строка(Сервер)));
	Дата = ТекущаяДатаСеанса() - 31 * 86400;
	Результаты = Новый Массив;

	Для Каждого Значение Из Список Цикл

		ИмяБазы = СокрЛП(Строка(Значение));
		Если НЕ ЗначениеЗаполнено(ИмяБазы) Тогда
			Продолжить;
		КонецЕсли;

		// @skip-check query-in-loop - список баз задаёт вызывающий, на каждой итерации свой набор
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ПРЕДСТАВЛЕНИЕ(С.Сервер1С) КАК Сервер,
		|	С.ИмяБазы1С КАК ИмяБазы1С,
		|	ПРЕДСТАВЛЕНИЕ(С.Тип) КАК Тип
		|ИЗ
		|	РегистрСведений.СерверыИБазы КАК С
		|ГДЕ
		|	С.ИмяБазы1С = &ИмяБазы1С");
		Запрос.УстановитьПараметр("ИмяБазы1С", ИмяБазы);
		Выборка = Запрос.Выполнить().Выбрать();

		Найдено = Ложь;
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(СерверТекст) И СокрЛП(Выборка.Сервер) <> СерверТекст Тогда
				Продолжить;
			КонецЕсли;
			Найдено = Истина;
			Если Выборка.Тип = "Архивная" Тогда
				Результаты.Добавить(Новый Структура("base,server,action", ИмяБазы, СокрЛП(Выборка.Сервер), "пропуск: уже архивная"));
				Продолжить;
			КонецЕсли;

			МенеджерЗаписи = РегистрыСведений.КонтрольБаз.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Правило = Правило;
			МенеджерЗаписи.Сервер1С = СокрЛП(Выборка.Сервер);
			МенеджерЗаписи.ИмяБазы1С = ИмяБазы;
			МенеджерЗаписи.Прочитать();
			МенеджерЗаписи.Правило = Правило;
			МенеджерЗаписи.Сервер1С = СокрЛП(Выборка.Сервер);
			МенеджерЗаписи.ИмяБазы1С = ИмяБазы;
			Если НЕ ЗначениеЗаполнено(МенеджерЗаписи.ДатаПервогоУведомления) Тогда
				МенеджерЗаписи.ДатаПервогоУведомления = Дата;
				МенеджерЗаписи.СрокДней = 30;
			КонецЕсли;
			МенеджерЗаписи.ДатаПоследнегоУведомления = ТекущаяДатаСеанса();
			МенеджерЗаписи.ДатаОтключения = Дата;
			МенеджерЗаписи.Статус = "в архив по решению администратора " + Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy")
				+ " (" + Правило + ")";
			МенеджерЗаписи.Записать(Истина);

			Результаты.Добавить(Новый Структура("base,server,action", ИмяБазы, СокрЛП(Выборка.Сервер), "поставлена в архивный цикл"));
		КонецЦикла;

		Если НЕ Найдено Тогда
			Результаты.Добавить(Новый Структура("base,server,action", ИмяБазы, СерверТекст, "не найдена в реестре"));
		КонецЕсли;

	КонецЦикла;

	Возврат Новый Структура("rule,count,bases", Правило, Результаты.Количество(), Результаты);

КонецФункции

// Назначает владельца базе: владелец - измерение регистра, поэтому запись переносится
// (новую пишем, старую удаляем) - это делает ПравилаРеестраБаз.НазначитьВладельца,
// та же процедура, что и при возврате базы из архива. Повторный вызов с тем же владельцем
// ничего не меняет.
//
// Параметры:
//  Сервер - Строка - представление сервера 1С ("S2019:1541").
//  ИмяБазы - Строка - имя информационной базы.
//  ИмяВладельца - Строка - наименование элемента справочника Владелец (ФИО).
//
// Возвращаемое значение:
//  Структура - server, base, owner, before, after, changed.
Функция НазначитьВладельцаAPI(Сервер, ИмяБазы, ИмяВладельца)

	Владелец = Справочники.Владелец.НайтиПоНаименованию(СокрЛП(Строка(ИмяВладельца)), Истина);
	Если Владелец.Пустая() Тогда
		ВызватьИсключение "нет владельца «" + ИмяВладельца + "» в справочнике Владелец";
	КонецЕсли;
	СерверСсылка = СсылкаНаСервер1С(Сервер);

	Было = ТекущийВладелецБазы(СерверСсылка, ИмяБазы);
	Если Было = Неопределено Тогда
		ВызватьИсключение "база «" + ИмяБазы + "» не найдена на сервере " + Строка(СерверСсылка);
	КонецЕсли;

	ПравилаРеестраБаз.НазначитьВладельца(СерверСсылка, ИмяБазы, Владелец);
	Стало = ТекущийВладелецБазы(СерверСсылка, ИмяБазы);

	Возврат Новый Структура("server,base,owner,before,after,changed", Строка(СерверСсылка), ИмяБазы,
		Строка(Владелец), Строка(Было), Строка(Стало), Было <> Владелец);

КонецФункции

// Переносит базу на другой сервер 1С: измерение Сервер1С у записей СерверыИБазы (запись переносится)
// и строковое измерение Сервер1С у учёта правил КонтрольБаз - как set_server1c.os.
//
// Параметры:
//  ИмяБазы - Строка - имя информационной базы.
//  Сервер - Строка - представление нового сервера 1С.
//
// Возвращаемое значение:
//  Структура - base, server, moved, skipped, ruleRecords.
Функция ПеренестиНаСервер(ИмяБазы, Сервер)

	СерверСсылка = СсылкаНаСервер1С(Сервер);
	Измерения = Метаданные.РегистрыСведений.СерверыИБазы.Измерения;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	РегистрСведений.СерверыИБазы КАК С
	|ГДЕ
	|	С.ИмяБазы1С = &ИмяБазы1С");
	Запрос.УстановитьПараметр("ИмяБазы1С", ИмяБазы);
	Выборка = Запрос.Выполнить().Выбрать();

	Перенесено = 0;
	Пропущено = 0;
	Пока Выборка.Следующий() Цикл

		ЗаписьПеренесена = Ложь;
		Если Выборка.Сервер1С <> СерверСсылка Тогда
			НачатьТранзакцию();
			Попытка
				СтарыйНабор = РегистрыСведений.СерверыИБазы.СоздатьНаборЗаписей();
				Для Каждого Измерение Из Измерения Цикл
					СтарыйНабор.Отбор[Измерение.Имя].Установить(Выборка[Измерение.Имя]);
				КонецЦикла;
				СтарыйНабор.Прочитать();
				ЗаписьПеренесена = СтарыйНабор.Количество() > 0;
				Если ЗаписьПеренесена Тогда
					НовыйНабор = РегистрыСведений.СерверыИБазы.СоздатьНаборЗаписей();
					Для Каждого Измерение Из Измерения Цикл
						НовыйНабор.Отбор[Измерение.Имя].Установить(?(Измерение.Имя = "Сервер1С", СерверСсылка,
							Выборка[Измерение.Имя]));
					КонецЦикла;
					НовыйНабор.Прочитать();
					НоваяЗапись = ?(НовыйНабор.Количество() > 0, НовыйНабор[0], НовыйНабор.Добавить());
					ЗаполнитьЗначенияСвойств(НоваяЗапись, СтарыйНабор[0]);
					НоваяЗапись.Сервер1С = СерверСсылка;

					СтарыйНабор.Очистить();
					СтарыйНабор.Записать();
					НовыйНабор.Записать();
				КонецЕсли;
				ЗафиксироватьТранзакцию();
			Исключение
				ОтменитьТранзакцию();
				ВызватьИсключение;
			КонецПопытки;
		КонецЕсли;

		Если ЗаписьПеренесена Тогда
			Перенесено = Перенесено + 1;
		Иначе
			Пропущено = Пропущено + 1;
		КонецЕсли;

	КонецЦикла;

	ПеренесеноУчёта = ПеренестиУчётПравил(ИмяБазы, Строка(СерверСсылка));

	Возврат Новый Структура("base,server,moved,skipped,ruleRecords", ИмяБазы, Строка(СерверСсылка),
		Перенесено, Пропущено, ПеренесеноУчёта);

КонецФункции

// Учёт правил хранит сервер строкой: записи КонтрольБаз с другим сервером переносятся на новый.
//
// Параметры:
//  ИмяБазы - Строка - имя информационной базы.
//  Сервер - Строка - представление нового сервера 1С.
//
// Возвращаемое значение:
//  Число - сколько записей учёта перенесено.
Функция ПеренестиУчётПравил(ИмяБазы, Сервер)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	К.Правило КАК Правило,
	|	К.Сервер1С КАК Сервер1С,
	|	К.ДатаПервогоУведомления КАК ДатаПервогоУведомления,
	|	К.ДатаПоследнегоУведомления КАК ДатаПоследнегоУведомления,
	|	К.СрокДней КАК СрокДней,
	|	К.ДатаОтключения КАК ДатаОтключения,
	|	К.Статус КАК Статус
	|ИЗ
	|	РегистрСведений.КонтрольБаз КАК К
	|ГДЕ
	|	К.ИмяБазы1С = &ИмяБазы1С
	|	И К.Сервер1С <> &Сервер");
	Запрос.УстановитьПараметр("ИмяБазы1С", ИмяБазы);
	Запрос.УстановитьПараметр("Сервер", Сервер);
	Выборка = Запрос.Выполнить().Выбрать();

	Перенесено = 0;
	Пока Выборка.Следующий() Цикл
		// @skip-check query-in-loop - записей учёта у базы единицы (по правилам)
		Новая = РегистрыСведений.КонтрольБаз.СоздатьМенеджерЗаписи();
		Новая.Правило = Выборка.Правило;
		Новая.Сервер1С = Сервер;
		Новая.ИмяБазы1С = ИмяБазы;
		Новая.ДатаПервогоУведомления = Выборка.ДатаПервогоУведомления;
		Новая.ДатаПоследнегоУведомления = Выборка.ДатаПоследнегоУведомления;
		Новая.СрокДней = Выборка.СрокДней;
		Новая.ДатаОтключения = Выборка.ДатаОтключения;
		Новая.Статус = Выборка.Статус;
		Новая.Записать(Истина);

		Старая = РегистрыСведений.КонтрольБаз.СоздатьМенеджерЗаписи();
		Старая.Правило = Выборка.Правило;
		Старая.Сервер1С = Выборка.Сервер1С;
		Старая.ИмяБазы1С = ИмяБазы;
		Старая.Удалить();

		Перенесено = Перенесено + 1;
	КонецЦикла;

	Возврат Перенесено;

КонецФункции

// Элемент справочника Пользователи для служебной учётки регламентных заданий РЗ_*: привязывает
// существующий (по наименованию) или создаёт новый, лишние дубли помечает на удаление.
// БСП сбрасывает ИдентификаторПользователяИБ, заданный напрямую, поэтому привязка идёт через
// ДополнительныеСвойства.ОписаниеПользователяИБ (Действие = "Записать") - как link_service_users.os.
//
// Параметры:
//  Логин - Строка - имя пользователя ИБ, начинается с "РЗ_".
//
// Возвращаемое значение:
//  Структура - login, user, created, duplicates.
Функция ПривязатьСлужебногоПользователя(Логин)

	Логин = СокрЛП(Строка(Логин));
	Если НЕ СтрНачинаетсяС(Логин, "РЗ_") Тогда
		ВызватьИсключение "метод только для служебных учёток РЗ_*, получено «" + Логин + "»";
	КонецЕсли;
	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Логин);
	Если ПользовательИБ = Неопределено Тогда
		ВызватьИсключение "нет пользователя ИБ «" + Логин + "»";
	КонецЕсли;
	Ид = ПользовательИБ.УникальныйИдентификатор;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	П.Ссылка КАК Ссылка,
	|	П.ИдентификаторПользователяИБ КАК Ид
	|ИЗ
	|	Справочник.Пользователи КАК П
	|ГДЕ
	|	П.Наименование = &Логин
	|	И НЕ П.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	П.Ссылка");
	Запрос.УстановитьПараметр("Логин", Логин);
	Выборка = Запрос.Выполнить().Выбрать();

	Привязан = Неопределено;
	Дублей = 0;
	Пока Выборка.Следующий() Цикл
		// @skip-check query-in-loop - записей по логину единицы
		Если Привязан = Неопределено И Выборка.Ид <> Ид Тогда
			ПривязатьПользователяИБ(Выборка.Ссылка.ПолучитьОбъект(), Ид);
			Привязан = Выборка.Ссылка;
		ИначеЕсли Привязан = Неопределено Тогда
			// элемент уже указывает на нужного пользователя ИБ
			Привязан = Выборка.Ссылка;
		Иначе
			Дубль = Выборка.Ссылка.ПолучитьОбъект();
			Дубль.УстановитьПометкуУдаления(Истина);
			Дублей = Дублей + 1;
		КонецЕсли;
	КонецЦикла;

	Создан = Ложь;
	Если Привязан = Неопределено Тогда
		Элемент = Справочники.Пользователи.СоздатьЭлемент();
		Элемент.Наименование = Логин;
		ПривязатьПользователяИБ(Элемент, Ид);
		Привязан = Элемент.Ссылка;
		Создан = Истина;
	КонецЕсли;

	Возврат Новый Структура("login,user,created,duplicates", Логин, Строка(Привязан), Создан, Дублей);

КонецФункции

// Привязка элемента справочника Пользователи к пользователю ИБ: БСП читает описание из
// ДополнительныеСвойства и само проставляет ИдентификаторПользователяИБ при записи.
//
// Параметры:
//  Элемент - СправочникОбъект.Пользователи - элемент (существующий или новый).
//  Ид - УникальныйИдентификатор - уникальный идентификатор пользователя ИБ.
Процедура ПривязатьПользователяИБ(Элемент, Ид)

	Описание = Новый Структура;
	Описание.Вставить("Действие", "Записать");
	Описание.Вставить("УникальныйИдентификатор", Ид);
	Элемент.ДополнительныеСвойства.Вставить("ОписаниеПользователяИБ", Описание);
	Элемент.Служебный = Истина;
	Элемент.Записать();

КонецПроцедуры

// Запускает регламентное задание сразу фоновым заданием от имени текущего пользователя,
// расписание не трогает. У РегламентноеЗадание нет метода «Выполнить», поэтому берём имя
// метода из метаданных задания и запускаем через ФоновыеЗадания.Выполнить.
//
// Параметры:
//  ИмяЗадания - Строка - имя метаданных регламентного задания (например, КонтрольВладельцевБаз).
//
// Возвращаемое значение:
//  Структура - job, method, id, state.
Функция ЗапуститьЗадание(ИмяЗадания)

	ИмяЗадания = СокрЛП(Строка(ИмяЗадания));
	МетаданныеЗадания = Метаданные.РегламентныеЗадания.Найти(ИмяЗадания);
	Если МетаданныеЗадания = Неопределено Тогда
		ВызватьИсключение "нет регламентного задания «" + ИмяЗадания + "»";
	КонецЕсли;

	ИмяМетода = СтрЗаменить(СтрЗаменить(МетаданныеЗадания.ИмяМетода, "CommonModule.", ""), "ОбщийМодуль.", "");
	Части = СтрРазделить(ИмяМетода, ".", Ложь);
	Если Части.Количество() <> 2 Тогда
		ВызватьИсключение "не разобрано имя метода задания: " + МетаданныеЗадания.ИмяМетода;
	КонецЕсли;
	Если Метаданные.ОбщиеМодули.Найти(Части[0]) = Неопределено Тогда
		ВызватьИсключение "нет общего модуля «" + Части[0] + "»";
	КонецЕсли;

	Задание = ФоновыеЗадания.Выполнить(ИмяМетода, Новый Массив, "api-" + Строка(Новый УникальныйИдентификатор),
		"API: " + ИмяЗадания);

	Возврат Новый Структура("job,method,id,state", ИмяЗадания, ИмяМетода,
		Строка(Задание.УникальныйИдентификатор), Строка(Задание.Состояние));

КонецФункции

// Ссылка справочника Сервер1С по представлению ("S2019:1541").
//
// Параметры:
//  Сервер - Строка - представление сервера 1С.
//
// Возвращаемое значение:
//  СправочникСсылка.Сервер1С
Функция СсылкаНаСервер1С(Сервер)

	Сервер = СокрЛП(Строка(Сервер));
	Ссылка = Справочники.Сервер1С.НайтиПоНаименованию(Сервер, Истина);
	Если Ссылка.Пустая() Тогда
		ВызватьИсключение "нет сервера 1С «" + Сервер + "» в справочнике Сервер1С";
	КонецЕсли;
	Возврат Ссылка;

КонецФункции

// Текущий владелец базы из реестра.
//
// Параметры:
//  Сервер1С - СправочникСсылка.Сервер1С - сервер кластера.
//  ИмяБазы1С - Строка - имя информационной базы.
//
// Возвращаемое значение:
//  СправочникСсылка.Владелец, Неопределено - Неопределено, если записи в реестре нет.
Функция ТекущийВладелецБазы(Сервер1С, ИмяБазы1С)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	С.Владелец КАК Владелец
	|ИЗ
	|	РегистрСведений.СерверыИБазы КАК С
	|ГДЕ
	|	С.Сервер1С = &Сервер
	|	И С.ИмяБазы1С = &ИмяБазы1С");
	Запрос.УстановитьПараметр("Сервер", Сервер1С);
	Запрос.УстановитьПараметр("ИмяБазы1С", ИмяБазы1С);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Выборка.Владелец;

КонецФункции

Функция РолиПользователя(Логин)

	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Логин);
	Если ПользовательИБ = Неопределено Тогда
		ВызватьИсключение "нет пользователя ИБ «" + Логин + "»";
	КонецЕсли;
	Роли = Новый Массив;
	Для Каждого Роль Из ПользовательИБ.Роли Цикл
		Роли.Добавить(Роль.Имя);
	КонецЦикла;
	Возврат Новый Структура("login,fullName,roles", Логин, ПользовательИБ.ПолноеИмя, Роли);

КонецФункции

Функция ПользовательПоЛогину(Логин)

	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Логин);
	Если ПользовательИБ = Неопределено Тогда
		ВызватьИсключение "нет пользователя ИБ «" + Логин + "»";
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1 П.Ссылка КАК Ссылка ИЗ Справочник.Пользователи КАК П
	|ГДЕ П.ИдентификаторПользователяИБ = &Ид");
	Запрос.УстановитьПараметр("Ид", ПользовательИБ.УникальныйИдентификатор);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		ВызватьИсключение "пользователя ИБ «" + Логин + "» нет в справочнике Пользователи";
	КонецЕсли;
	Возврат Выборка.Ссылка;

КонецФункции

Функция ИдентификаторРоли(ПолноеИмяРоли)

	Для Каждого Таблица Из СтрРазделить("ИдентификаторыОбъектовМетаданных,ИдентификаторыОбъектовРасширений", ",") Цикл
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Ид.Ссылка КАК Ссылка ИЗ Справочник." + Таблица + " КАК Ид
		|ГДЕ Ид.ПолноеИмя = &Имя И НЕ Ид.ПометкаУдаления");
		Запрос.УстановитьПараметр("Имя", ПолноеИмяРоли);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "нет идентификатора роли «" + ПолноеИмяРоли + "»";

КонецФункции

// Учётка агента мониторинга: пользователь ИБ со стандартной аутентификацией, элемент справочника
// Пользователи, профиль «Агент мониторинга» (роль рбфАгентМониторинга) и группа доступа
// «Агенты мониторинга». Роли пользователю назначает БСП по группе доступа. Повторный вызов
// меняет пароль и ничего не дублирует.
//
// Параметры:
//  Логин - Строка - имя служебной учётки, только РЗ_*.
//  Пароль - Строка - пароль.
//
// Возвращаемое значение:
//  Структура - login, created, roles.
Функция СоздатьАгента(Логин, Пароль)

	Логин = СокрЛП(Строка(Логин));
	Если НЕ СтрНачинаетсяС(Логин, "РЗ_") Тогда
		ВызватьИсключение "учётка агента должна начинаться с РЗ_, получено «" + Логин + "»";
	КонецЕсли;

	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Логин);
	Создан = ПользовательИБ = Неопределено;
	Если Создан Тогда
		ПользовательИБ = ПользователиИнформационнойБазы.СоздатьПользователя();
		ПользовательИБ.Имя = Логин;
		ПользовательИБ.ПолноеИмя = Логин;
		ПользовательИБ.ПоказыватьВСпискеВыбора = Ложь;
		ПользовательИБ.АутентификацияОС = Ложь;
	КонецЕсли;
	ПользовательИБ.АутентификацияСтандартная = Истина;
	ПользовательИБ.Пароль = Пароль;
	ПользовательИБ.ЗапрещеноИзменятьПароль = Истина;
	ПользовательИБ.Записать();
	ПривязатьСлужебногоПользователя(Логин);

	Профиль = Справочники.ПрофилиГруппДоступа.НайтиПоНаименованию("Агент мониторинга", Истина);
	Если Профиль.Пустая() Тогда
		ОбъектПрофиля = Справочники.ПрофилиГруппДоступа.СоздатьЭлемент();
		ОбъектПрофиля.Наименование = "Агент мониторинга";
		ОбъектПрофиля.Роли.Добавить().Роль = ИдентификаторРоли("Роль.рбфАгентМониторинга");
		ОбъектПрофиля.Записать();
		Профиль = ОбъектПрофиля.Ссылка;
	КонецЕсли;

	Группа = Справочники.ГруппыДоступа.НайтиПоНаименованию("Агенты мониторинга", Истина);
	ОбъектГруппы = ?(Группа.Пустая(), Справочники.ГруппыДоступа.СоздатьЭлемент(), Группа.ПолучитьОбъект());
	ОбъектГруппы.Наименование = "Агенты мониторинга";
	ОбъектГруппы.Профиль = Профиль;
	Пользователь = ПользовательПоЛогину(Логин);
	Если ОбъектГруппы.Пользователи.Найти(Пользователь, "Пользователь") = Неопределено Тогда
		ОбъектГруппы.Пользователи.Добавить().Пользователь = Пользователь;
	КонецЕсли;
	ОбъектГруппы.Записать();

	// БСП назначает роли по группам доступа, но для служебной учётки, созданной в обход формы
	// пользователя, этого не произошло (проверено 15.10.2026): пересчитываем явно, иначе ставим роль сами
	Попытка
		УправлениеДоступомСлужебный.ОбновитьРолиПользователей(Пользователь);
	Исключение
		Журнал("agent-user", "ОбновитьРолиПользователей: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
			УровеньЖурналаРегистрации.Предупреждение);
	КонецПопытки;
	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Логин);
	Если НЕ ПользовательИБ.Роли.Содержит(Метаданные.Роли.рбфАгентМониторинга) Тогда
		ПользовательИБ.Роли.Добавить(Метаданные.Роли.рбфАгентМониторинга);
		ПользовательИБ.Записать();
	КонецЕсли;

	Возврат Новый Структура("login,created,roles", Логин, Создан, РолиПользователя(Логин).roles);

КонецФункции

// Дата из строки JSON вида 2026-10-15T21:05:00 (местное время агента).
//
// Параметры:
//  Значение - Строка - дата и время в формате ISO 8601 без часового пояса.
//
// Возвращаемое значение:
//  Дата - разобранная дата.
Функция ДатаИзСтроки(Значение)

	Возврат XMLЗначение(Тип("Дата"), Лев(СокрЛП(Строка(Значение)), 19));

КонецФункции

// Задание анализа ТЖ для исполнителя в виде JSON-структуры; даты - ISO 8601 без часового пояса.
//
// Возвращаемое значение:
//  Структура - id, dir, from, to, dry_run или job = Null, если очередь пуста.
Функция ЗаданиеАнализаТЖ()

	Задание = ПравилаРеестраБаз.ВзятьЗаданиеАнализаТЖ();
	Если Задание = Неопределено Тогда
		Возврат Новый Структура("job", Null);
	КонецЕсли;
	Возврат Новый Структура("id,dir,from,to,dry_run", Задание.Ид, Задание.Каталог,
		XMLСтрока(Задание.ПериодС), XMLСтрока(Задание.ПериодПо), Задание.ПробныйПрогон);

КонецФункции

// Текст logcfg.xml сервера для агента; дата изменения - ISO 8601 без часового пояса.
//
// Параметры:
//  Сервер - Строка - имя компьютера сервера 1С без порта.
//
// Возвращаемое значение:
//  Структура - server, applied, changed, logcfg.
Функция ТекстLogcfg(Сервер)

	Данные = ПравилаРеестраБаз.ТекстLogcfgДляАгента(Сервер);
	Возврат Новый Структура("server,applied,changed,logcfg", СокрЛП(Сервер), Данные.Применён,
		?(ЗначениеЗаполнено(Данные.Изменено), XMLСтрока(Данные.Изменено), Null), Данные.Текст);

КонецФункции

// Строковое значение необязательного параметра; отсутствующий или Null - пустая строка.
//
// Параметры:
//  Параметры - Соответствие - параметры запроса.
//  Имя - Строка - имя параметра.
//
// Возвращаемое значение:
//  Строка - значение параметра.
Функция СтрокаПараметра(Параметры, Имя)

	Значение = Параметры.Получить(Имя);
	Возврат ?(Значение = Неопределено ИЛИ Значение = Null, "", Строка(Значение));

КонецФункции

Функция ПрочитатьТело(Запрос)

	Текст = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

Функция Обязательный(Параметры, Имя)

	Значение = Параметры.Получить(Имя);
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		ВызватьИсключение "не задан параметр " + Имя;
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция Ответ(Код, Данные)

	HTTPОтвет = Новый HTTPСервисОтвет(Код);
	HTTPОтвет.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	HTTPОтвет.УстановитьТелоИзСтроки(ЗаписатьJSONВСтроку(Данные), КодировкаТекста.UTF8,
		ИспользованиеByteOrderMark.НеИспользовать);
	Возврат HTTPОтвет;

КонецФункции

Функция ЗаписатьJSONВСтроку(Данные)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();

КонецФункции

Процедура Журнал(Метод, Текст, Уровень)

	ЗаписьЖурналаРегистрации("рбфАдминAPI", Уровень, , , Метод + ": " + Текст);

КонецПроцедуры

