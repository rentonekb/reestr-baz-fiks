// Снимает с контроля базы, которых больше нет в выборке правила
// (владельца проставили или дату отключения продлили).
//
// Параметры:
//  Правило - Строка - имя правила: "Владелец" или "Актуальность".
//  Ключи - Массив из Строка - ключи баз текущей выборки правила, см. КлючБазы.
Процедура СнятьЛишние(Правило, Ключи)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ т.Сервер1С КАК Сервер1С, т.ИмяБазы1С КАК ИмяБазы1С
	|ИЗ РегистрСведений.КонтрольБаз КАК т
	|ГДЕ т.Правило = &Правило И т.ДатаОтключения = ДАТАВРЕМЯ(1,1,1)";
	Запрос.УстановитьПараметр("Правило", Правило);
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Если Ключи.Найти(Выборка.Сервер1С + "|" + Выборка.ИмяБазы1С) = Неопределено Тогда
			МенеджерЗаписи = РегистрыСведений.КонтрольБаз.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Правило   = Правило;
			МенеджерЗаписи.Сервер1С  = Выборка.Сервер1С;
			МенеджерЗаписи.ИмяБазы1С = Выборка.ИмяБазы1С;
			МенеджерЗаписи.Удалить();
			ЗаписьЖурналаРегистрации("ПравилаРеестра." + Правило, УровеньЖурналаРегистрации.Информация, , ,
				"Снята с контроля: " + Выборка.ИмяБазы1С);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Письмо владельцу базы (если у него заполнена почта и он работает в компании) с копией администраторам.
// Уволенным (учётка в AD отключена или удалена) письмо не отправляется: оно уходит только
// администраторам с пометкой, что базе нужен новый владелец.
//
// Параметры:
//  Владелец - СправочникСсылка.Владелец, Неопределено - владелец базы; Неопределено - письмо только администраторам.
//  Тема - Строка - тема письма.
//  ТекстHTML - Строка - текст письма в формате HTML.
Процедура ОтправитьПисьмо(Владелец, Тема, ТекстHTML)

	Адреса = Новый Массив;
	ТемаПисьма = Тема;
	ТекстПисьма = ТекстHTML;
	Если Владелец <> Неопределено И ЗначениеЗаполнено(Владелец) Тогда
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Владелец, "Наименование, Почта, WinЛогин");
		Состояние = СостояниеУчёткиВAD(Реквизиты.WinЛогин, Реквизиты.Почта);
		Если Состояние = "отключена" Или Состояние = "не найдена" Тогда
			ТемаПисьма = "[владелец уволен] " + Тема;
			ТекстПисьма = "<p><b>Владелец " + Реквизиты.Наименование + " не работает в компании (учётная запись в AD "
				+ Состояние + "). Письмо ему не отправлено, базе нужно назначить нового владельца.</b></p>" + ТекстHTML;
			ЗаписьЖурналаРегистрации("ПравилаРеестра.Письмо", УровеньЖурналаРегистрации.Предупреждение, , ,
				"Владелец " + Реквизиты.Наименование + ": учётка в AD " + Состояние + ", письмо только администраторам");
		ИначеЕсли ЗначениеЗаполнено(Реквизиты.Почта) Тогда
			Адреса.Добавить(Реквизиты.Почта);
		КонецЕсли;
	КонецЕсли;

	СтрокаКопий = Настройка("АдресаАдминистраторов", "rentonekb@gmail.com,i.pohozhaev@activelogic.ru");
	Для Каждого Адрес Из СтрРазделить(СтрокаКопий, ",", Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Адрес)) Тогда
			Адреса.Добавить(СокрЛП(Адрес));
		КонецЕсли;
	КонецЦикла;

	ОтправитьПисьмоНаАдреса(Адреса, ТемаПисьма, ТекстПисьма);

КонецПроцедуры

// Состояние учётной записи сотрудника в Active Directory: ищется по логину Windows,
// если по логину не нашлась - по почте (mail или userPrincipalName).
// При любой ошибке обращения к AD возвращается "неизвестно": письмо тогда уходит как раньше,
// чтобы сбой AD не глушил уведомления.
//
// Параметры:
//  WinЛогин - Строка - логин вида \\al\i.ivanov, al\i.ivanov или i.ivanov.
//  Почта - Строка - адрес почты сотрудника.
//
// Возвращаемое значение:
//  Строка - "активна", "отключена", "не найдена" или "неизвестно".
Функция СостояниеУчёткиВAD(WinЛогин, Почта)

	Логин = СокрЛП(WinЛогин);
	Позиция = СтрНайти(Логин, "\", НаправлениеПоиска.СКонца);
	Если Позиция > 0 Тогда
		Логин = Сред(Логин, Позиция + 1);
	КонецЕсли;
	Адрес = СокрЛП(Почта);

	Фильтры = Новый Массив;
	Если ЗначениеЗаполнено(Логин) Тогда
		Фильтры.Добавить("(sAMAccountName=" + Логин + ")");
	КонецЕсли;
	Если ЗначениеЗаполнено(Адрес) Тогда
		Фильтры.Добавить("(|(mail=" + Адрес + ")(userPrincipalName=" + Адрес + "))");
	КонецЕсли;
	Если Фильтры.Количество() = 0 Тогда
		Возврат "неизвестно";
	КонецЕсли;

	Попытка
		Соединение = Новый COMОбъект("ADODB.Connection");
		Соединение.Provider = "ADsDSOObject";
		Соединение.Open("Active Directory Provider");
		Команда = Новый COMОбъект("ADODB.Command");
		Команда.ActiveConnection = Соединение;
		Для Каждого Фильтр Из Фильтры Цикл
			Команда.CommandText = "<LDAP://DC=al,DC=local>;(&(objectCategory=person)(objectClass=user)" + Фильтр
				+ ");userAccountControl;subtree";
			Результат = Команда.Execute();
			Если НЕ Результат.EOF Тогда
				ФлагиУчётки = Результат.Fields("userAccountControl").Value;
				Соединение.Close();
				// Бит 2 (ACCOUNTDISABLE) - учётная запись отключена
				Возврат ?(Цел(ФлагиУчётки / 2) % 2 = 1, "отключена", "активна");
			КонецЕсли;
		КонецЦикла;
		Соединение.Close();
		Возврат "не найдена";
	Исключение
		ЗаписьЖурналаРегистрации("ПравилаРеестра.Письмо", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Проверка учётки в AD не выполнена: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат "неизвестно";
	КонецПопытки;

КонецФункции

// Новая сводка суточного цикла правил.
//
// Возвращаемое значение:
//  Структура:
//   * Разделы - Соответствие из КлючИЗначение - ключ: имя раздела, значение: Массив из Строка (HTML).
//   * Владельцам - Соответствие из КлючИЗначение - ключ: СправочникСсылка.Владелец,
//      значение: Массив из Строка (HTML) - абзацы письма владельцу.
Функция НоваяСводка()
	Возврат Новый Структура("Разделы,Владельцам", Новый Соответствие, Новый Соответствие);
КонецФункции

// Событие правила в сводку администраторам и, если указан владелец, в его письмо.
//
// Параметры:
//  Сводка - см. НоваяСводка.
//  Раздел - Строка - имя раздела, см. ОтправитьСводку.
//  СтрокаHTML - Строка - строка раздела для администраторов.
//  Владелец - СправочникСсылка.Владелец, Неопределено - кому ещё сообщить.
//  ТекстВладельцу - Строка - абзац письма владельцу (HTML).
Процедура ДобавитьВСводку(Сводка, Раздел, СтрокаHTML, Владелец = Неопределено, ТекстВладельцу = "")

	Строки = Сводка.Разделы.Получить(Раздел);
	Если Строки = Неопределено Тогда
		Строки = Новый Массив;
		Сводка.Разделы.Вставить(Раздел, Строки);
	КонецЕсли;
	Строки.Добавить(СтрокаHTML);

	Если Владелец <> Неопределено И ЗначениеЗаполнено(Владелец) И ЗначениеЗаполнено(ТекстВладельцу) Тогда
		Абзацы = Сводка.Владельцам.Получить(Владелец);
		Если Абзацы = Неопределено Тогда
			Абзацы = Новый Массив;
			Сводка.Владельцам.Вставить(Владелец, Абзацы);
		КонецЕсли;
		Абзацы.Добавить(ТекстВладельцу);
	КонецЕсли;

КонецПроцедуры

// Ошибка шага суточного цикла: в журнал и в раздел «Сбои» сводки. Остальные шаги
// выполняются - отказ сверки с SQL не должен оставлять без контроля владельцев и сроки.
//
// Параметры:
//  Сводка - см. НоваяСводка.
//  Событие - Строка - событие журнала регистрации.
//  Шаг - Строка - название шага для сводки.
Процедура ДобавитьОшибкуВСводку(Сводка, Событие, Шаг)

	Информация = ИнформацияОбОшибке();
	ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , ,
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));
	ДобавитьВСводку(Сводка, "Сбои", Шаг + ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(Информация));

КонецПроцедуры

