// Описание базы для отключения правилом.
//
// Параметры:
//  Выборка - ВыборкаИзРезультатаЗапроса - строка с полями Сервер1С, ИмяБазы1С, СерверБД,
//   ИмяБазыБД, Тип, Владелец.
//
// Возвращаемое значение:
//  Структура - те же поля.
Функция ОписаниеБазы(Выборка)

	Описание = Новый Структура;
	Описание.Вставить("Сервер1С", Выборка.Сервер1С);
	Описание.Вставить("ИмяБазы1С", Выборка.ИмяБазы1С);
	Описание.Вставить("СерверБД", Выборка.СерверБД);
	Описание.Вставить("ИмяБазыБД", Выборка.ИмяБазыБД);
	Описание.Вставить("Тип", Выборка.Тип);
	Описание.Вставить("Владелец", Выборка.Владелец);
	Возврат Описание;

КонецФункции

Функция ПрочитатьСостояние(Правило, Сервер1С, ИмяБазы1С)

	МенеджерЗаписи = РегистрыСведений.КонтрольБаз.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Правило   = Правило;
	МенеджерЗаписи.Сервер1С  = Строка(Сервер1С);
	МенеджерЗаписи.ИмяБазы1С = ИмяБазы1С;
	МенеджерЗаписи.Прочитать();

	Если НЕ МенеджерЗаписи.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Состояние = Новый Структура;
	Состояние.Вставить("ДатаПервогоУведомления", МенеджерЗаписи.ДатаПервогоУведомления);
	Состояние.Вставить("ДатаПоследнегоУведомления", МенеджерЗаписи.ДатаПоследнегоУведомления);
	Состояние.Вставить("СрокДней", МенеджерЗаписи.СрокДней);
	Состояние.Вставить("ДатаОтключения", МенеджерЗаписи.ДатаОтключения);
	Состояние.Вставить("Статус", МенеджерЗаписи.Статус);
	Возврат Состояние;

КонецФункции

Процедура ЗаписатьСостояние(Правило, Сервер1С, ИмяБазы1С, СрокДней, Статус)

