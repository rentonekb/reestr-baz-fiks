////////////////////////////////////////////////////////////////////////////////
// Правила контроля реестра баз. Выполняются регламентными заданиями:
//   КонтрольВладельцевБаз        - база без владельца дольше срока;
//   КонтрольСрокаАктуальности - истёк срок актуальности (только тестовые базы).
//
// Внешние действия (SQL и кластер 1С) выполняются вызовом консольных утилит
// через ЗапуститьПриложение: COM-соединение не подходит, потому что кластеры
// работают на разных версиях платформы (1541 - 8.3.27.2214, 4541 - 8.3.27.2130,
// 7541 - 8.3.21.1624, 8541 - 8.3.27.2074), а COMConnector жёстко привязан к версии.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Регламентное задание КонтрольВладельцевБаз - суточный цикл правил реестра.
// Все суточные правила выполняются одним проходом и пишут события в общую сводку:
//   сверка с SQL (даты, бэкапы, неучтённые базы) -> размеры таблиц -> архивирование отключённых ->
//   владельцы -> срок актуальности -> одно письмо администраторам и по одному письму
//   каждому владельцу со всеми его базами.
// Раньше каждое событие уходило отдельным письмом, и администраторы получали копию
// каждого письма владельцу.
Процедура КонтрольВладельцев() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Сводка = НоваяСводка();

	Попытка
		ЗаполнитьДатыБаз(Ложь, Сводка);
	Исключение
		ДобавитьОшибкуВСводку(Сводка, "ПравилаРеестра.Даты", "Сверка с SQL");
	КонецПопытки;

	Попытка
		СобратьРазмерыТаблиц(Сводка);
	Исключение
		ДобавитьОшибкуВСводку(Сводка, "ПравилаРеестра.Размеры", "Сбор размеров таблиц");
	КонецПопытки;

	Попытка
		ИтогиМониторинга(Сводка);
	Исключение
		ДобавитьОшибкуВСводку(Сводка, "ПравилаРеестра.Мониторинг", "Итоги мониторинга серверов");
	КонецПопытки;

	Попытка
		АрхивироватьОтключённыеБазы(Сводка);
	Исключение
		ДобавитьОшибкуВСводку(Сводка, "ПравилаРеестра.Архив", "Архивирование отключённых баз");
	КонецПопытки;

	Попытка
		ПроверитьВладельцев(Сводка);
	Исключение
		ДобавитьОшибкуВСводку(Сводка, "ПравилаРеестра.Владельцы", "Контроль владельцев");
	КонецПопытки;

	Попытка
		ПроверитьСрокАктуальности(Сводка);
	Исключение
		ДобавитьОшибкуВСводку(Сводка, "ПравилаРеестра.Актуальность", "Контроль срока актуальности");
	КонецПопытки;

	ОтправитьСводку(Сводка);

КонецПроцедуры

// Регламентное задание КонтрольСрокаАктуальности. С 13.10.2026 правило выполняется
// в суточном цикле КонтрольВладельцев, чтобы все события попали в одну сводку;
// расписание этого задания выключает НастроитьРасписания.
Процедура КонтрольСрокаАктуальности() Экспорт

	ЗаписьЖурналаРегистрации("ПравилаРеестра.Актуальность", УровеньЖурналаРегистрации.Информация, , ,
		"Пропуск: правило выполняется в суточном цикле КонтрольВладельцев");

КонецПроцедуры

// База без владельца дольше СрокаДней переводится в OFFLINE.
// Рабочие базы не отключаются никогда - они только перечисляются в сводке.
//
// Параметры:
//  Сводка - см. НоваяСводка.
Процедура ПроверитьВладельцев(Сводка)

	ЗаписьЖурналаРегистрации("ПравилаРеестра.Владельцы", УровеньЖурналаРегистрации.Информация, , , "Старт");

	СрокДней          = Настройка("СрокБезВладельцаДней", 30);
	СрокПервойВолны   = Настройка("СрокПервойВолныДней", 30);
	ЛимитЗаПрогон     = Настройка("ЛимитОтключенийЗаПрогон", 5);
	ПредупреждатьДней = Настройка("ПредупреждатьЗаДней", 7);
	// Рабочие базы без владельца: в сводке при постановке на контроль и раз в неделю, иначе
	// одна и та же строка делает сводку ежедневной.
	ДеньНапоминания = Настройка("ДеньНапоминанияРабочих", 1);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СерверыИБазы.Сервер1С       КАК Сервер1С,
	|	СерверыИБазы.ИмяБазы1С      КАК ИмяБазы1С,
	|	СерверыИБазы.СерверБД       КАК СерверБД,
	|	СерверыИБазы.ИмяБазыБД      КАК ИмяБазыБД,
	|	СерверыИБазы.Тип            КАК Тип,
	|	СерверыИБазы.Владелец       КАК Владелец
	|ИЗ
	|	РегистрСведений.СерверыИБазы КАК СерверыИБазы
	|ГДЕ
	|	СерверыИБазы.Владелец = ЗНАЧЕНИЕ(Справочник.Владелец.ПустаяСсылка)
	|	И СерверыИБазы.Тип <> ЗНАЧЕНИЕ(Перечисление.ТипБазы.Архивная)";

	Выборка = Запрос.Выполнить().Выбрать();

	Ключи = Новый Массив;
	Кандидаты = Новый Массив;
	ЕстьУчёт = ЕстьЗаписиКонтроля("Владелец");
	НапомнитьОРабочих = (ДеньНедели(ТекущаяДатаСеанса()) = ДеньНапоминания);

	Пока Выборка.Следующий() Цикл

		Ключи.Добавить(КлючБазы(Выборка.Сервер1С, Выборка.ИмяБазы1С));
		// @skip-check query-in-loop - правило обходит десятки баз и по каждой выполняет отдельное действие
		Состояние = ПрочитатьСостояние("Владелец", Выборка.Сервер1С, Выборка.ИмяБазы1С);
		ЭтоРабочая = (Выборка.Тип = Перечисления.ТипБазы.Рабочая);

		Если Состояние = Неопределено Тогда
			Срок = ?(ЕстьУчёт, СрокДней, СрокПервойВолны);
			ЗаписатьСостояние("Владелец", Выборка.Сервер1С, Выборка.ИмяБазы1С, Срок, "взята под контроль");
			Если ЭтоРабочая Тогда
				ДобавитьВСводку(Сводка, "РабочиеБезВладельца", СтрокаБазы(Выборка) + " <i>новая</i>");
			Иначе
				ДобавитьВСводку(Сводка, "НовыеБезВладельца", СтрокаБазы(Выборка) + ", отключение через " + Срок + " дн.");
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(Состояние.ДатаОтключения) Тогда
			Продолжить;
		КонецЕсли;

		ПрошлоДней = Цел((ТекущаяДатаСеанса() - Состояние.ДатаПервогоУведомления) / 86400);
		Осталось = Состояние.СрокДней - ПрошлоДней;

		Если ЭтоРабочая Тогда
			Если НапомнитьОРабочих Тогда
				ДобавитьВСводку(Сводка, "РабочиеБезВладельца", СтрокаБазы(Выборка) + ", без владельца " + ПрошлоДней + " дн.");
			КонецЕсли;
			Если Осталось <= 0 И Состояние.Статус <> "рабочая: отключение не применяется" Тогда
				ОбновитьСтатус("Владелец", Выборка.Сервер1С, Выборка.ИмяБазы1С, "рабочая: отключение не применяется");
			КонецЕсли;
		ИначеЕсли Осталось <= 0 Тогда
			Кандидаты.Добавить(ОписаниеБазы(Выборка));
		ИначеЕсли Осталось <= ПредупреждатьДней Тогда
			ДобавитьВСводку(Сводка, "СкороОтключение", СтрокаБазы(Выборка) + ": нет владельца, отключение через " + Осталось + " дн.");
		КонецЕсли;

	КонецЦикла;

	СнятьЛишние("Владелец", Ключи);

	ЗаписьЖурналаРегистрации("ПравилаРеестра.Владельцы", УровеньЖурналаРегистрации.Информация, , ,
		"Итог: без владельца " + Ключи.Количество() + ", созрело для отключения " + Кандидаты.Количество());

	Если Кандидаты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если Кандидаты.Количество() > ЛимитЗаПрогон Тогда
		ДобавитьВСводку(Сводка, "СверхЛимита", "Баз без владельца сверх срока: " + Кандидаты.Количество()
			+ ", лимит за прогон: " + ЛимитЗаПрогон + ". Ничего не отключено, нужна ручная проверка.");
		ЗаписьЖурналаРегистрации("ПравилаРеестра.Владельцы", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Кандидатов " + Кандидаты.Количество() + " больше лимита " + ЛимитЗаПрогон + ", отключение не выполнялось");
		Возврат;
	КонецЕсли;

	Для Каждого База Из Кандидаты Цикл
		// @skip-check query-in-loop - правило обходит десятки баз и по каждой выполняет отдельное действие
		ОтключитьБазу(База, "в реестре не указан владелец более " + СрокДней + " дн.", "Владелец", Сводка);
	КонецЦикла;

КонецПроцедуры

// Наступила дата отключения тестовой базы - сообщение владельцу, а если он за отведённый
// срок дату не продлил, база переводится в OFFLINE и удаляется из кластера.
// С 28.09.2026 крайний срок - ДатаОтключения (= дата создания базы в SQL + 2 месяца, владелец
// может продлить); ДатаАктуальности - дата создания базы, её заполняет ЗаполнитьДатыБаз.
// Правило касается только тестовых баз: даты теперь есть у всех, а бессрочные, служебные
// и прочие базы отключать по сроку нельзя.
//
// Параметры:
//  Сводка - см. НоваяСводка.
Процедура ПроверитьСрокАктуальности(Сводка)

	ЗаписьЖурналаРегистрации("ПравилаРеестра.Актуальность", УровеньЖурналаРегистрации.Информация, , , "Старт");

	СрокДней        = Настройка("СрокПослеАктуальностиДней", 10);
	СрокПервойВолны = Настройка("СрокПервойВолныДней", 30);
	ЛимитЗаПрогон   = Настройка("ЛимитОтключенийЗаПрогон", 3);
	ПовторДней      = Настройка("ПовторНапоминанияДней", 7);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СерверыИБазы.Сервер1С          КАК Сервер1С,
	|	СерверыИБазы.ИмяБазы1С         КАК ИмяБазы1С,
	|	СерверыИБазы.СерверБД          КАК СерверБД,
	|	СерверыИБазы.ИмяБазыБД         КАК ИмяБазыБД,
	|	СерверыИБазы.Тип               КАК Тип,
	|	СерверыИБазы.Владелец          КАК Владелец,
	|	СерверыИБазы.ДатаОтключения    КАК ДатаОтключения
	|ИЗ
	|	РегистрСведений.СерверыИБазы КАК СерверыИБазы
	|ГДЕ
	|	СерверыИБазы.ДатаОтключения <> ДАТАВРЕМЯ(1,1,1)
	|	И СерверыИБазы.ДатаОтключения <= &Сейчас
	|	И СерверыИБазы.Тип = ЗНАЧЕНИЕ(Перечисление.ТипБазы.Тестовая)";
	Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());

	Выборка = Запрос.Выполнить().Выбрать();

	Ключи = Новый Массив;
	Просроченные = Новый Массив;
	ЕстьУчёт = ЕстьЗаписиКонтроля("Актуальность");

	Пока Выборка.Следующий() Цикл

		Ключи.Добавить(КлючБазы(Выборка.Сервер1С, Выборка.ИмяБазы1С));
		// @skip-check query-in-loop - правило обходит десятки баз и по каждой выполняет отдельное действие
		Состояние = ПрочитатьСостояние("Актуальность", Выборка.Сервер1С, Выборка.ИмяБазы1С);

		Если Состояние = Неопределено Тогда
			Срок = ?(ЕстьУчёт, СрокДней, СрокПервойВолны);
			ЗаписатьСостояние("Актуальность", Выборка.Сервер1С, Выборка.ИмяБазы1С, Срок, "наступила дата отключения");
			ДобавитьВСводку(Сводка, "ИстёкСрок", СтрокаБазы(Выборка) + ": дата отключения "
				+ Формат(Выборка.ДатаОтключения, "ДФ=dd.MM.yyyy") + ", отключение через " + Срок + " дн.",
				Выборка.Владелец,
				"<b>" + Выборка.ИмяБазы1С + "</b> (" + Строка(Выборка.Сервер1С) + "): наступила дата отключения "
				+ Формат(Выборка.ДатаОтключения, "ДФ=dd.MM.yyyy") + ". Если база нужна, продлите дату отключения в реестре "
				+ "«Серверы и базы» в течение " + Срок + " дн., иначе база будет переведена в OFFLINE и удалена из кластера 1С. "
				+ "Файлы базы сохранятся." + ПутьКБазеHTML(Выборка));
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(Состояние.ДатаОтключения) Тогда
			Продолжить;
		КонецЕсли;

		ПрошлоДней = (ТекущаяДатаСеанса() - Состояние.ДатаПервогоУведомления) / 86400;
		Если ПрошлоДней >= Состояние.СрокДней Тогда
			ОписаниеПросроченной = ОписаниеБазы(Выборка);
			ОписаниеПросроченной.Вставить("ПрошлоДней", Цел(ПрошлоДней));
			Просроченные.Добавить(ОписаниеПросроченной);
		ИначеЕсли (ТекущаяДатаСеанса() - Состояние.ДатаПоследнегоУведомления) / 86400 >= ПовторДней Тогда
			Осталось = Состояние.СрокДней - Цел(ПрошлоДней);
			ДобавитьВСводку(Сводка, "СкороОтключение", СтрокаБазы(Выборка) + ": срок не продлён, отключение через " + Осталось + " дн.",
				Выборка.Владелец,
				"<b>" + Выборка.ИмяБазы1С + "</b> (" + Строка(Выборка.Сервер1С) + "): напоминание - дата отключения наступила "
				+ Цел(ПрошлоДней) + " дн. назад, до отключения осталось " + Осталось + " дн. "
				+ "Если база нужна, продлите дату отключения в реестре «Серверы и базы»." + ПутьКБазеHTML(Выборка));
			ОбновитьСтатус("Актуальность", Выборка.Сервер1С, Выборка.ИмяБазы1С, "напоминание, " + Цел(ПрошлоДней) + " дн.");
		КонецЕсли;

	КонецЦикла;

	// Дату продлили - снимаем с контроля
	СнятьЛишние("Актуальность", Ключи);

	ЗаписьЖурналаРегистрации("ПравилаРеестра.Актуальность", УровеньЖурналаРегистрации.Информация, , ,
		"Итог: просрочено " + Ключи.Количество() + ", созрело для отключения " + Просроченные.Количество());

	Если Просроченные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если Просроченные.Количество() > ЛимитЗаПрогон Тогда
		ДобавитьВСводку(Сводка, "СверхЛимита", "Тестовых баз, у которых дата отключения не продлена за отведённое время: "
			+ Просроченные.Количество() + ", лимит за прогон: " + ЛимитЗаПрогон + ". Ничего не отключено, нужна ручная проверка.");
		ЗаписьЖурналаРегистрации("ПравилаРеестра.Актуальность", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Кандидатов " + Просроченные.Количество() + " больше лимита " + ЛимитЗаПрогон);
		Возврат;
	КонецЕсли;

	Для Каждого База Из Просроченные Цикл
		// @skip-check query-in-loop - правило обходит десятки баз и по каждой выполняет отдельное действие
		ОтключитьБазу(База, "дата отключения не продлена в течение " + База.ПрошлоДней + " дн.", "Актуальность", Сводка);
	КонецЦикла;

КонецПроцедуры

// Значение настройки правила. Настройки хранятся в регистре НастройкиПравилРеестра,
// при отсутствии значения возвращается значение по умолчанию.
//
// Параметры:
//  Имя - Строка - имя параметра в регистре НастройкиПравилРеестра.
//  ПоУмолчанию - Произвольный - значение, если настройка не задана или пуста.
//
// Возвращаемое значение:
//  Произвольный - значение настройки или ПоУмолчанию.
Функция Настройка(Имя, ПоУмолчанию) Экспорт

	// форма списка читает пороги в сеансе пользователя, прав на регистр настроек у него нет
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 НастройкиПравилРеестра.Значение КАК Значение
	|ИЗ РегистрСведений.НастройкиПравилРеестра КАК НастройкиПравилРеестра
	|ГДЕ НастройкиПравилРеестра.Параметр = &Параметр";
	Запрос.УстановитьПараметр("Параметр", Имя);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	Возврат ?(ЗначениеЗаполнено(Выборка.Значение), Выборка.Значение, ПоУмолчанию);

КонецФункции

// Автоопределение кластеров 1С: порт, версия платформы, порт RAS, путь к rac.
// Раньше это соответствие было зашито в код константами - при установке нового
// кластера или обновлении платформы правила молча ломались на выборе утилиты.
Процедура ОбновитьКластеры() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	ЗаписьЖурналаРегистрации("Мониторинг.Кластеры", УровеньЖурналаРегистрации.Информация, , , "Старт");

	// Какие процессы менеджеров кластера сейчас запущены и из какого каталога платформы
	// Порт кластера берём из слушающих TCP-портов процесса rmngr, а версию платформы -
	// из пути к исполняемому файлу этого процесса.
	Команда = "powershell -NoProfile -Command ""$r=@{}; Get-CimInstance Win32_Process -Filter \"" Name='rmngr.exe' \"" | ForEach-Object { $r[[int]$_.ProcessId]=$_.ExecutablePath }; "
		+ "Get-NetTCPConnection -State Listen | Where-Object { $r.ContainsKey([int]$_.OwningProcess) } | "
		+ "ForEach-Object { \""$($_.LocalPort);$($r[[int]$_.OwningProcess])\"" } | Sort-Object -Unique""";

	Ответ = ВыполнитьКоманду(Команда);
	Найдено = 0;

	Для Каждого Строка Из СтрРазделить(Ответ.Вывод, Символы.ПС, Ложь) Цикл

		Части = СтрРазделить(СокрЛП(Строка), ";", Истина);
		Если Части.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;

		// Процесс rmngr слушает несколько портов; порт кластера оканчивается на 41 (1541, 4541, 7541, 8541)
		ПортСтрокой = СокрЛП(Части[0]);
		Если СтрДлина(ПортСтрокой) <> 4 ИЛИ Прав(ПортСтрокой, 2) <> "41" Тогда
			Продолжить;
		КонецЕсли;

		ПутьПроцесса = СокрЛП(Части[1]);
		Если НЕ ЗначениеЗаполнено(ПутьПроцесса) Тогда
			Продолжить;
		КонецЕсли;

		// C:\Program Files\1cv8\8.3.27.2214\bin\rmngr.exe -> версия и каталог bin
		Версия = "";
		Сегменты = СтрРазделить(ПутьПроцесса, "\", Ложь);
		Для Индекс = 0 По Сегменты.Количество() - 1 Цикл
			Если СтрНачинаетсяС(Сегменты[Индекс], "8.3.") Тогда
				Версия = Сегменты[Индекс];
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ЗначениеЗаполнено(Версия) Тогда
			Продолжить;
		КонецЕсли;

		ПортКластера = ПортСтрокой;

		МенеджерЗаписи = РегистрыСведений.КластерыПлатформы.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ПортКластера = ПортКластера;
		МенеджерЗаписи.Прочитать();
		МенеджерЗаписи.ПортКластера   = ПортКластера;
		МенеджерЗаписи.ВерсияПлатформы = Версия;
		МенеджерЗаписи.ПортRAS        = Формат(Число(ПортКластера) + 4, "ЧГ=0");
		МенеджерЗаписи.ПутьКRac       = "C:\Program Files\1cv8\" + Версия + "\bin\rac.exe";
		МенеджерЗаписи.ДатаОбновления = ТекущаяДатаСеанса();
		МенеджерЗаписи.Записать(Истина);
		Найдено = Найдено + 1;

	КонецЦикла;

	ЗаписьЖурналаРегистрации("Мониторинг.Кластеры", УровеньЖурналаРегистрации.Информация, , ,
		"Итог: определено кластеров " + Найдено);

	// раз в сутки: сведения о программных лицензиях 1С на сервере
	Попытка
		ОбновитьЛицензии();
	Исключение
		ЗаписьЖурналаРегистрации("Мониторинг.Лицензии", УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// Сверка дат с SQL и архивирование отключённых баз с 13.10.2026 выполняются в суточном
	// цикле КонтрольВладельцев, чтобы их события попали в общую сводку.

КонецПроцедуры

// Контроль доступности: заблокированы ли регламентные задания и сеансы в базах,
// в каком состоянии база в СУБД. Идея взята из 1sMonitor - именно на скрытой
// блокировке регламентных заданий мы потеряли много времени вслепую.
Процедура КонтрольДоступности() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	ЗаписьЖурналаРегистрации("Мониторинг.Доступность", УровеньЖурналаРегистрации.Информация, , , "Старт");

	Запреты = ЗапретыИзРеестровКластеров();

	Проблемы = Новый Массив;
	Проверено = 0;
	НеНайдено = 0;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СерверыИБазы.Сервер1С  КАК Сервер1С,
	|	СерверыИБазы.ИмяБазы1С КАК ИмяБазы1С,
	|	СерверыИБазы.СерверБД  КАК СерверБД,
	|	СерверыИБазы.ИмяБазыБД КАК ИмяБазыБД,
	|	СерверыИБазы.Тип       КАК Тип,
	|	СерверыИБазы.Владелец  КАК Владелец
	|ИЗ
	|	РегистрСведений.СерверыИБазы КАК СерверыИБазы
	|ГДЕ
	|	СерверыИБазы.Сервер1С <> ЗНАЧЕНИЕ(Справочник.Сервер1С.ПустаяСсылка)";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Проверено = Проверено + 1;

		// --- запреты в кластере: из файла реестра кластера, пароли баз не нужны ---
		Порт = "1541";
		Части = СтрРазделить(Строка(Выборка.Сервер1С), ":", Ложь);
		Если Части.Количество() > 1 Тогда
			Порт = СокрЛП(Части[1]);
		КонецЕсли;
		Запрет = Запреты.Получить(Порт + "|" + ВРег(СокрЛП(Выборка.ИмяБазы1С)));
		Если Запрет = Неопределено Тогда
			НеНайдено = НеНайдено + 1;
			ЗаданияЗапрещены = Ложь;
			СеансыЗапрещены  = Ложь;
		Иначе
			ЗаданияЗапрещены = Запрет.ЗаданияЗапрещены;
			СеансыЗапрещены  = Запрет.СеансыЗапрещены;
		КонецЕсли;

		// --- состояние базы в СУБД ---
		СостояниеСУБД = "";
		Если ЗначениеЗаполнено(Выборка.ИмяБазыБД) Тогда
			Сервер = ?(ЗначениеЗаполнено(Выборка.СерверБД), Строка(Выборка.СерверБД), "localhost");
			// @skip-check query-in-loop - правило обходит десятки баз и по каждой выполняет отдельное действие
			Ответ = ВыполнитьКоманду(КомандаSQL(Сервер) + " -h -1 -W -Q ""SET NOCOUNT ON; SELECT state_desc FROM sys.databases WHERE name = '"
				+ Выборка.ИмяБазыБД + "'""");
			Для Каждого Строка Из СтрРазделить(Ответ.Вывод, Символы.ПС, Ложь) Цикл
				Стр = СокрЛП(Строка);
				Если Стр = "ONLINE" ИЛИ Стр = "OFFLINE" ИЛИ Стр = "RESTORING" ИЛИ Стр = "SUSPECT" ИЛИ Стр = "RECOVERY_PENDING" ИЛИ Стр = "EMERGENCY" Тогда
					СостояниеСУБД = Стр;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		// --- фиксация состояния ---
		МенеджерЗаписи = РегистрыСведений.СостояниеБаз.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Сервер1С  = Строка(Выборка.Сервер1С);
		МенеджерЗаписи.ИмяБазы1С = Выборка.ИмяБазы1С;
		МенеджерЗаписи.Прочитать();
		БылиЗаданияЗапрещены = МенеджерЗаписи.ЗаданияЗапрещены;
		БылоСостояние        = МенеджерЗаписи.СостояниеСУБД;

		МенеджерЗаписи.Сервер1С         = Строка(Выборка.Сервер1С);
		МенеджерЗаписи.ИмяБазы1С        = Выборка.ИмяБазы1С;
		МенеджерЗаписи.ЗаданияЗапрещены = ЗаданияЗапрещены;
		МенеджерЗаписи.СеансыЗапрещены  = СеансыЗапрещены;
		МенеджерЗаписи.СостояниеСУБД    = СостояниеСУБД;
		МенеджерЗаписи.ДатаПроверки     = ТекущаяДатаСеанса();
		МенеджерЗаписи.Записать(Истина);

		// Сообщаем только об изменениях, чтобы не слать одно и то же каждые 15 минут
		Если ЗаданияЗапрещены И НЕ БылиЗаданияЗапрещены Тогда
			Проблемы.Добавить("<b>" + Выборка.ИмяБазы1С + "</b> (" + Строка(Выборка.Сервер1С) + "): заблокированы регламентные задания");
		КонецЕсли;
		Если ЗначениеЗаполнено(СостояниеСУБД) И СостояниеСУБД <> "ONLINE" И СостояниеСУБД <> БылоСостояние Тогда
			Проблемы.Добавить("<b>" + Выборка.ИмяБазы1С + "</b>: база в СУБД в состоянии " + СостояниеСУБД);
		КонецЕсли;

	КонецЦикла;

	Если Проблемы.Количество() > 0 Тогда
		ОтправитьПисьмо(Неопределено, "Реестр баз: изменения в доступности баз",
			"<p>Обнаружены отклонения:</p><p>" + СтрСоединить(Проблемы, "<br>") + "</p>");
	КонецЕсли;

	ЗаписьЖурналаРегистрации("Мониторинг.Доступность", УровеньЖурналаРегистрации.Информация, , ,
		"Итог: проверено " + Проверено + ", отклонений " + Проблемы.Количество()
		+ ", не найдено в реестрах кластеров " + НеНайдено);

	// лицензии и ключи HASP других серверов из файлов их сборщиков
	Попытка
		ОбновитьЛицензииИзФайлов();
	Исключение
		ЗаписьЖурналаРегистрации("Мониторинг.Лицензии", УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Резкое падение числа сеансов - признак сбоя (идея из 1sMonitor).
// Сравниваем текущее число сеансов базы с её обычным значением за последние сутки.
Процедура КонтрольСеансов() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	ЗаписьЖурналаРегистрации("Мониторинг.Сеансы", УровеньЖурналаРегистрации.Информация, , , "Старт");

	ПорогПадения = Настройка("ПорогПаденияСеансовПроцент", 50);
	Учётка = УчётнаяЗаписьКластера();
	Если Учётка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПеренестиИсториюАктивности();

	Проблемы = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ СерверыИБазы.Сервер1С КАК Сервер1С
	|ИЗ РегистрСведений.СерверыИБазы КАК СерверыИБазы
	|ГДЕ СерверыИБазы.Сервер1С <> ЗНАЧЕНИЕ(Справочник.Сервер1С.ПустаяСсылка)";
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		// @skip-check query-in-loop - правило обходит десятки баз и по каждой выполняет отдельное действие
		Rac = ПутьКRac(Выборка.Сервер1С);
		Если Rac = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Адрес = "localhost:" + Rac.ПортRAS;
		Кластер = ИдентификаторКластера(Rac, Адрес);
		Если НЕ ЗначениеЗаполнено(Кластер) Тогда
			Продолжить;
		КонецЕсли;

		Ответ = ВыполнитьКоманду("""" + Rac.Путь + """ " + Адрес + " session list --cluster=" + Кластер
			+ " --cluster-user=" + Учётка.Пользователь + " --cluster-pwd=" + Учётка.Пароль);
		Сеансы = ЗаписиВыводаRac(Ответ.Вывод);
		ИменаИБ = ИменаИБКластера(Rac, Адрес, Кластер, Учётка);
		Если Ответ.КодВозврата = 0 И ИменаИБ.Количество() > 0 Тогда
			// @skip-check query-in-loop - цикл по серверам 1С (единицы), чтение одной настройки
			ОтметитьНачалоНаблюдения(Строка(Выборка.Сервер1С), ТекущаяДатаСеанса());
		КонецЕсли;

		// Считаем сеансы по каждой информационной базе
		ПоБазам = Новый Соответствие;
		Для Каждого Сеанс Из Сеансы Цикл
			ТекущаяИБ = Сеанс.Получить("infobase");
			Если ЗначениеЗаполнено(ТекущаяИБ) Тогда
				ПоБазам.Вставить(ТекущаяИБ, ?(ПоБазам.Получить(ТекущаяИБ) = Неопределено, 1, ПоБазам.Получить(ТекущаяИБ) + 1));
			КонецЕсли;
		КонецЦикла;

		ЗаписатьАктивностьБаз(Строка(Выборка.Сервер1С), Сеансы, ИменаИБ);

		Для Каждого КЗ Из ПоБазам Цикл

			ИмяБазы = ИменаИБ.Получить(КЗ.Ключ);
			Если НЕ ЗначениеЗаполнено(ИмяБазы) Тогда
				Продолжить;
			КонецЕсли;

			МенеджерЗаписи = РегистрыСведений.СостояниеБаз.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Сервер1С  = Строка(Выборка.Сервер1С);
			МенеджерЗаписи.ИмяБазы1С = ИмяБазы;
			МенеджерЗаписи.Прочитать();

			Текущее = КЗ.Значение;
			Обычное = МенеджерЗаписи.ОбычноеЧислоСеансов;
			Предыдущее = МенеджерЗаписи.ЧислоСеансов;

			ПадениеСейчас = Обычное > 4 И Текущее * 100 / Обычное <= (100 - ПорогПадения);
			ПадениеРанее = Предыдущее > 0 И Обычное > 4
				И Предыдущее * 100 / Обычное <= (100 - ПорогПадения);

			// Уведомляем только при переходе в аварийное состояние, а не при каждом запуске задания.
			Если ПадениеСейчас И НЕ ПадениеРанее Тогда
				Проблемы.Добавить("<b>" + ИмяБазы + "</b>: сеансов " + Текущее + " против обычных " + Обычное);
			КонецЕсли;

			// Скользящее среднее, чтобы норма подстраивалась под жизнь базы
			МенеджерЗаписи.Сервер1С  = Строка(Выборка.Сервер1С);
			МенеджерЗаписи.ИмяБазы1С = ИмяБазы;
			МенеджерЗаписи.ЧислоСеансов = Текущее;
			МенеджерЗаписи.ОбычноеЧислоСеансов = ?(Обычное = 0, Текущее, Цел((Обычное * 5 + Текущее) / 6));
			МенеджерЗаписи.ДатаПроверки = ТекущаяДатаСеанса();
			МенеджерЗаписи.Записать(Истина);

		КонецЦикла;

	КонецЦикла;

	ПересчитатьДниПростоя();

	Если Проблемы.Количество() > 0 Тогда
		Текст = "<p>Резкое падение числа сеансов (порог " + ПорогПадения + "%):</p><p>" + СтрСоединить(Проблемы, "<br>") + "</p>";
		ОтправитьПисьмо(Неопределено, "Реестр баз: резкое падение числа сеансов", Текст);
		ОтправитьТелеграм(СтрЗаменить(СтрЗаменить(Текст, "<br>", Символы.ПС), "</p><p>", Символы.ПС));
	КонецЕсли;

	ЗаписьЖурналаРегистрации("Мониторинг.Сеансы", УровеньЖурналаРегистрации.Информация, , ,
		"Итог: отклонений " + Проблемы.Количество());

КонецПроцедуры

// Регламентное задание: обработчик очереди команд.
// Позволяет выполнять обслуживание базы без интерактивного входа: команда кладётся
// в регистр ОчередьКоманд (в том числе внешним скриптом), задание её выполняет и
// записывает результат. Нужно потому, что запуск внешних обработок и заданий вручную
// требует подтверждения человеком, а обслуживание должно идти автономно.
Процедура ОбработчикКоманд() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОчередьКоманд.Идентификатор КАК Идентификатор,
	|	ОчередьКоманд.Команда       КАК Команда,
	|	ОчередьКоманд.Параметр      КАК Параметр
	|ИЗ
	|	РегистрСведений.ОчередьКоманд КАК ОчередьКоманд
	|ГДЕ
	|	ОчередьКоманд.Состояние = ""новая""";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Результат = "";
		Попытка

			Если Выборка.Команда = "СнятьЗащиту" Тогда
				Результат = СнятьЗащитуОтОпасныхДействий(Выборка.Параметр);

			ИначеЕсли Выборка.Команда = "КонтрольВладельцев" Тогда
				// @skip-check query-in-loop - правило обходит десятки баз и по каждой выполняет отдельное действие
				КонтрольВладельцев();
				Результат = "выполнено";

			ИначеЕсли Выборка.Команда = "КонтрольАктуальности" Тогда
				// правило срока выполняется в общем суточном цикле
				// @skip-check query-in-loop - правило обходит десятки баз и по каждой выполняет отдельное действие
				КонтрольВладельцев();
				Результат = "выполнено";

			ИначеЕсли Выборка.Команда = "ОбновитьКластеры" Тогда
				// @skip-check query-in-loop - правило обходит десятки баз и по каждой выполняет отдельное действие
				ОбновитьКластеры();
				Результат = "выполнено";

			ИначеЕсли Выборка.Команда = "КонтрольДоступности" Тогда
				// @skip-check query-in-loop - правило обходит десятки баз и по каждой выполняет отдельное действие
				КонтрольДоступности();
				Результат = "выполнено";

			ИначеЕсли Выборка.Команда = "КонтрольСеансов" Тогда
				// @skip-check query-in-loop - правило обходит десятки баз и по каждой выполняет отдельное действие
				КонтрольСеансов();
				Результат = "выполнено";

			ИначеЕсли Выборка.Команда = "НастроитьРасписания" Тогда
				Результат = НастроитьРасписания();

			ИначеЕсли Выборка.Команда = "ВернутьБазу" Тогда
				// @skip-check query-in-loop - правило обходит десятки баз и по каждой выполняет отдельное действие
				Результат = ВернутьБазу(Выборка.Параметр);

			ИначеЕсли Выборка.Команда = "ЗаполнитьДатыБаз" Тогда
				// параметр "все" - пересчитать и дату отключения у всех баз, иначе только пустые
				// @skip-check query-in-loop - команды очереди выполняются по одной
				Результат = ЗаполнитьДатыБаз(НРег(СокрЛП(Выборка.Параметр)) = "все");

			ИначеЕсли Выборка.Команда = "СобратьРазмерыТаблиц" Тогда
				// внеплановый снимок размеров; события сводки не рассылаются, итог - в журнале
				// @skip-check query-in-loop - команды очереди выполняются по одной
				СобратьРазмерыТаблиц(НоваяСводка());
				Результат = "выполнено";

			ИначеЕсли Выборка.Команда = "ЗаписатьLogcfg" Тогда
				// параметр - имя сервера; текст - в строке сервера рбфНастройкиТЖ (ПрименитьLogcfg)
				// @skip-check query-in-loop - команды очереди выполняются по одной
				Результат = ЗаписатьLogcfgНаСервер(Выборка.Параметр);

			Иначе
				Результат = "неизвестная команда";
			КонецЕсли;

		Исключение
			Результат = "ОШИБКА: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;

		МенеджерЗаписи = РегистрыСведений.ОчередьКоманд.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Идентификатор = Выборка.Идентификатор;
		МенеджерЗаписи.Прочитать();
		МенеджерЗаписи.Идентификатор = Выборка.Идентификатор;
		МенеджерЗаписи.Команда   = Выборка.Команда;
		МенеджерЗаписи.Параметр  = Выборка.Параметр;
		МенеджерЗаписи.Состояние = "выполнена";
		МенеджерЗаписи.Результат = Лев(Результат, 500);
		МенеджерЗаписи.ДатаВыполнения = ТекущаяДатаСеанса();
		МенеджерЗаписи.Записать(Истина);

		ЗаписьЖурналаРегистрации("ПравилаРеестра.Команды", УровеньЖурналаРегистрации.Информация, , ,
			Выборка.Команда + " -> " + Результат);

	КонецЦикла;

КонецПроцедуры

// Запрос на возврат базы, отключённой правилом: проверяет, что причина устранена,
// и ставит команду ВернутьБазу в очередь. Сеанс пользователя сам запускать rac и sqlcmd
// не может (защита от опасных действий), поэтому возврат выполняет фоновое задание.
//
// Параметры:
//  Сервер1С - СправочникСсылка.Сервер1С - сервер кластера базы.
//  ИмяБазы1С - Строка - имя информационной базы.
//
// Возвращаемое значение:
//  Строка - сообщение для пользователя.
Функция ЗапроситьВозвратБазы(Сервер1С, ИмяБазы1С) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	К.Правило КАК Правило,
	|	К.Статус КАК Статус
	|ИЗ
	|	РегистрСведений.КонтрольБаз КАК К
	|ГДЕ
	|	К.Сервер1С = &Сервер1С
	|	И К.ИмяБазы1С = &ИмяБазы1С
	|	И К.ДатаОтключения <> ДАТАВРЕМЯ(1, 1, 1)";
	Запрос.УстановитьПараметр("Сервер1С", Строка(Сервер1С));
	Запрос.УстановитьПараметр("ИмяБазы1С", ИмяБазы1С);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат "База «" + ИмяБазы1С + "» не отключалась правилами реестра, возвращать нечего.";
	КонецЕсли;
	// удалённую базу ВернутьБазу восстанавливает из бэкапа (ПутьБэкап в реестре); нет пути - нечего восстанавливать
	Удалена = СтрНачинаетсяС(Выборка.Статус, "удалена");

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	С.ДатаОтключения КАК ДатаОтключения,
	|	С.ПутьБэкап КАК ПутьБэкап
	|ИЗ
	|	РегистрСведений.СерверыИБазы КАК С
	|ГДЕ
	|	С.Сервер1С = &Сервер
	|	И С.ИмяБазы1С = &ИмяБазы1С";
	Запрос.УстановитьПараметр("Сервер", Сервер1С);
	Запись = Запрос.Выполнить().Выбрать();
	Если НЕ Запись.Следующий() Тогда
		Возврат "База «" + ИмяБазы1С + "» не найдена в реестре.";
	КонецЕсли;

	Если Удалена И НЕ ЗначениеЗаполнено(Запись.ПутьБэкап) Тогда
		Возврат "База «" + ИмяБазы1С + "» удалена, а путь к её бэкапу в реестре не указан. Обратитесь к администратору.";
	КонецЕсли;

	// Прошедшую дату отключения продлевать не нужно: ВернутьБазу сама сдвигает даты (с 14.10.2026).

	// Кто вернул базу, тот и становится её владельцем.
	Владелец = ВладелецТекущегоПользователя();
	Если Владелец = Неопределено Тогда
		Возврат "Не удалось определить владельца по текущему пользователю: у пользователя не заполнено полное имя.";
	КонецЕсли;
	НазначитьВладельца(Сервер1С, ИмяБазы1С, Владелец);

	Параметр = Строка(Сервер1С) + "|" + ИмяБазы1С;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 1 КАК Поле
	|ИЗ РегистрСведений.ОчередьКоманд КАК О
	|ГДЕ О.Команда = ""ВернутьБазу"" И ПОДСТРОКА(О.Параметр, 1, &Длина) = &Параметр И О.Состояние = ""новая""";
	Запрос.УстановитьПараметр("Параметр", Параметр + "|");
	Запрос.УстановитьПараметр("Длина", СтрДлина(Параметр) + 1);
	Если НЕ Запрос.Выполнить().Пустой() Тогда
		Возврат "Возврат базы «" + ИмяБазы1С + "» уже запрошен. Когда база будет готова, придёт письмо.";
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.ОчередьКоманд.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Идентификатор = "ret-" + Строка(Новый УникальныйИдентификатор);
	МенеджерЗаписи.Команда = "ВернутьБазу";
	// третья часть - кто запросил возврат, для отметки в комментарии реестра
	МенеджерЗаписи.Параметр = Параметр + "|" + СтрЗаменить(ПользователиИнформационнойБазы.ТекущийПользователь().ПолноеИмя, "|", " ");
	МенеджерЗаписи.Состояние = "новая";
	МенеджерЗаписи.Записать();

	ЗаписьЖурналаРегистрации("ПравилаРеестра.Возврат", УровеньЖурналаРегистрации.Информация, , ,
		"Запрошен возврат " + Параметр + " пользователем " + ИмяПользователя());

	Возврат "Возврат базы «" + ИмяБазы1С + "» запрошен. Когда база будет готова, придёт письмо.";

КонецФункции

// Обработчик регламентного задания рбфОчисткаВыполненийТЖ: удаляет из рбфВыполненияТЖ события
// старше глубины хранения. Глубина, дн - ГлубинаВыполненийДней в общей строке рбфНастройкиТЖ
// (пустые Сервер1С и ИмяБазы1С), по умолчанию 14. Удаляем порциями, чтобы не держать
// длинную транзакцию и блокировку на весь регистр.
Процедура ОчисткаВыполненийТЖ() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	РазмерПорции = 10000;

	ГлубинаДней = рбфАнализСервер.НастройкиВыполненийТЖ().ГлубинаДней;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 10000
	|	Выполнения.Ид КАК Ид
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Выполнения
	|ГДЕ
	|	Выполнения.Время < &Граница
	|
	|УПОРЯДОЧИТЬ ПО
	|	Выполнения.Время";
	Запрос.УстановитьПараметр("Граница", ТекущаяДатаСеанса() - ГлубинаДней * 86400);

	Удалено = 0;
	Пока Истина Цикл
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		НачатьТранзакцию();
		Попытка
			Пока Выборка.Следующий() Цикл
				Набор = РегистрыСведений.рбфВыполненияТЖ.СоздатьНаборЗаписей();
				Набор.Отбор.Ид.Установить(Выборка.Ид);
				Набор.Записать(Истина);
			КонецЦикла;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации("Мониторинг.ОчисткаВыполненийТЖ", УровеньЖурналаРегистрации.Ошибка, , ,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ВызватьИсключение;
		КонецПопытки;
		Удалено = Удалено + Выборка.Количество();
		Если Выборка.Количество() < РазмерПорции Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	ЗаписьЖурналаРегистрации("Мониторинг.ОчисткаВыполненийТЖ", УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон("Удалено событий: %1, глубина %2 дн", Удалено, ГлубинаДней));

	Для Каждого НастройкиСервера Из СерверыСбораТЖ() Цикл
		Попытка
			Итог = ОчиститьКаталогТЖ(НастройкиСервера.Каталог);
			ЗаписьЖурналаРегистрации("Мониторинг.ОчисткаВыполненийТЖ", УровеньЖурналаРегистрации.Информация, , ,
				СтрШаблон("%1: удалено пустых файлов ТЖ %2, каталогов %3", НастройкиСервера.Сервер, Итог.Файлов, Итог.Каталогов));
		Исключение
			ЗаписьЖурналаРегистрации("Мониторинг.ОчисткаВыполненийТЖ", УровеньЖурналаРегистрации.Предупреждение, , ,
				НастройкиСервера.Сервер + ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Убирает мусор каталога ТЖ: платформа заводит каталог <процесс>_<pid> в каждом логе logcfg для любого
// процесса, даже если событий по отбору нет (23.10.2026: rac из Zabbix rac_monitor.ps1 - до 7 тыс. каталогов
// в час на 37 логов), и каждый час создаёт файл только с BOM; history подчищает это не полностью.
// Удаляются файлы не больше 3 байт и пустые каталоги, не менявшиеся 2 часа: файлы текущего часа и
// каталоги работающих процессов (rphost пишет файл каждый час) не трогаются.
//
// Параметры:
//  Каталог - Строка - каталог ТЖ, доступный этому процессу (локальный или UNC).
//
// Возвращаемое значение:
//  Структура - Файлов, Каталогов (Число) - сколько удалено.
Функция ОчиститьКаталогТЖ(Каталог)

	Итог = Новый Структура("Файлов,Каталогов", 0, 0);
	Корень = Новый Файл(Каталог);
	Если НЕ ЗначениеЗаполнено(Каталог) ИЛИ НЕ Корень.Существует() ИЛИ НЕ Корень.ЭтоКаталог() Тогда
		Возврат Итог;
	КонецЕсли;
	Граница = ТекущаяУниверсальнаяДата() - 7200;

	// время каталогов - до удаления файлов: удаление файла обновляет время изменения его каталога
	Каталоги = Новый ТаблицаЗначений;
	Каталоги.Колонки.Добавить("Путь", Новый ОписаниеТипов("Строка"));
	Каталоги.Колонки.Добавить("Длина", Новый ОписаниеТипов("Число"));
	Каталоги.Колонки.Добавить("Изменён", Новый ОписаниеТипов("Дата"));
	Найденные = НайтиФайлы(Каталог, ПолучитьМаскуВсеФайлы(), Истина);
	Файлы = Новый Массив;
	Для Каждого Элемент Из Найденные Цикл
		Попытка
			Если Элемент.ЭтоКаталог() Тогда
				СтрокаКаталога = Каталоги.Добавить();
				СтрокаКаталога.Путь = Элемент.ПолноеИмя;
				СтрокаКаталога.Длина = СтрДлина(Элемент.ПолноеИмя);
				СтрокаКаталога.Изменён = Элемент.ПолучитьУниверсальноеВремяИзменения();
			ИначеЕсли ВРег(Элемент.Расширение) = ".LOG" Тогда
				Файлы.Добавить(Элемент);
			КонецЕсли;
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;

	Для Каждого Элемент Из Файлы Цикл
		Попытка
			Если Элемент.Размер() <= 3 И Элемент.ПолучитьУниверсальноеВремяИзменения() < Граница Тогда
				УдалитьФайлы(Элемент.ПолноеИмя);
				Итог.Файлов = Итог.Файлов + 1;
			КонецЕсли;
		Исключение
			// файл занят процессом или нет прав - останется до следующего запуска
			Продолжить;
		КонецПопытки;
	КонецЦикла;

	// сначала самые глубокие: каталог процесса, затем, если опустел, каталог лога
	Каталоги.Сортировать("Длина Убыв");
	Для Каждого СтрокаКаталога Из Каталоги Цикл
		Попытка
			Если СтрокаКаталога.Изменён < Граница
				И НайтиФайлы(СтрокаКаталога.Путь, ПолучитьМаскуВсеФайлы(), Ложь).Количество() = 0 Тогда
				УдалитьФайлы(СтрокаКаталога.Путь);
				Итог.Каталогов = Итог.Каталогов + 1;
			КонецЕсли;
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Обработчик регламентного задания рбфСборТЖ (раз в минуту): дочитывает файлы ТЖ серверов с позиций
// рбфПозицииФайловТЖ и пишет события в рбфВыполненияТЖ через рбфАнализСервер.ПринятьВыполненияТЖ.
// Серверы - строки «Агент.<Сервер>» в НастройкиПравилРеестра и серверы рбфНастройкиТЖ с включёнными базами;
// каталог - из настроек сервера (как в КонфигурацияАгента), локальный путь чужого сервера читается
// через административную шару \\<сервер>\<диск>$. Первый запуск по серверу встаёт в конец файлов.
// За запуск - не больше 20000 событий и около 45 с, остальное дочитывает следующий запуск.
Процедура СборТЖ() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Лимиты = Новый Структура("Событий,ДоМс,Записано",
		20000, ТекущаяУниверсальнаяДатаВМиллисекундах() + 45000, 0);
	Позиции = ПозицииФайловТЖ();
	Итоги = Новый Массив;
	Ошибка = Ложь;
	Для Каждого НастройкиСервера Из СерверыСбораТЖ() Цикл
		Если Лимиты.Событий <= 0 ИЛИ ТекущаяУниверсальнаяДатаВМиллисекундах() >= Лимиты.ДоМс Тогда
			Итоги.Добавить(НастройкиСервера.Сервер + ": отложен до следующего запуска");
			Продолжить;
		КонецЕсли;
		Попытка
			Итоги.Добавить(НастройкиСервера.Сервер + ": "
				+ СобратьТЖСервера(НастройкиСервера, Позиции.Получить(ВРег(НастройкиСервера.Сервер)), Лимиты));
		Исключение
			Ошибка = Истина;
			Итоги.Добавить(НастройкиСервера.Сервер + ": ОШИБКА");
			ЗаписьЖурналаРегистрации("Мониторинг.СборТЖ", УровеньЖурналаРегистрации.Ошибка, , ,
				НастройкиСервера.Сервер + ": " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		Попытка
			КонтрольТЖ(НастройкиСервера);
		Исключение
			ЗаписьЖурналаРегистрации("Мониторинг.КонтрольТЖ", УровеньЖурналаРегистрации.Предупреждение, , ,
				НастройкиСервера.Сервер + ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	// блокировки и взаимоблокировки СУБД - из XE-сессии rbf_blocking SQL Server, после файлов ТЖ:
	// DBMSSQL виновников к этому моменту уже записаны. Свой лимит: отчётов XE мало, а хвост большого
	// файла ТЖ съедает общий лимит, и блокировки СУБД откладывались бы до его разбора
	ЛимитыСУБД = Новый Структура("Событий,ДоМс,Записано", 5000, ТекущаяУниверсальнаяДатаВМиллисекундах() + 15000, 0);
	Попытка
		Итоги.Добавить(СобратьБлокировкиСУБД(ЛимитыСУБД));
		Лимиты.Записано = Лимиты.Записано + ЛимитыСУБД.Записано;
	Исключение
		Ошибка = Истина;
		Итоги.Добавить("Блокировки СУБД: ОШИБКА");
		ЗаписьЖурналаРегистрации("Мониторинг.СборТЖ", УровеньЖурналаРегистрации.Ошибка, , ,
			"Блокировки СУБД: " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка
		Удалено = ОчиститьНесвязанныеСобытияБлокировок(ТекущаяУниверсальнаяДатаВМиллисекундах() + 15000);
		Если Удалено > 0 Тогда
			Итоги.Добавить("удалено TLOCK/Commit без ожидания: " + Формат(Удалено, "ЧГ=0"));
		КонецЕсли;
	Исключение
		Ошибка = Истина;
		Итоги.Добавить("Очистка TLOCK: ОШИБКА");
		ЗаписьЖурналаРегистрации("Мониторинг.СборТЖ", УровеньЖурналаРегистрации.Ошибка, , ,
			"Очистка TLOCK: " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// раз в минуту: в журнал - только запуски, которые что-то записали или упали
	Если Лимиты.Записано > 0 ИЛИ Ошибка Тогда
		ЗаписьЖурналаРегистрации("Мониторинг.СборТЖ", УровеньЖурналаРегистрации.Информация, , ,
			СтрСоединить(Итоги, "; "));
	КонецЕсли;

КонецПроцедуры

// Методика ИТС (metod8dev i8105809): TLOCK пишутся все, но нужны только как виновники ожиданий.
// Удаляет из рбфВыполненияТЖ старше 15 минут TLOCK без ожидания и SDBL CommitTransaction/RollbackTransaction
// (границы транзакций для поиска виновника), кроме событий соединений-виновников ожиданий TLOCK/TTIMEOUT
// в пределах 10 минут от события-виновника: по ним карточка формы «Блокировки» показывает транзакцию виновника.
// За вызов - до 10000 записей, по одной без общей транзакции, пока не истечёт ДоМс.
//
// Параметры:
//  ДоМс - Число - момент ТекущаяУниверсальнаяДатаВМиллисекундах, после которого новые порции не берутся.
//
// Возвращаемое значение:
//  Число - удалено записей.
Функция ОчиститьНесвязанныеСобытияБлокировок(ДоМс)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Вин.Сервер КАК Сервер,
	|	Вин.База КАК База,
	|	Вин.СоединениеИд КАК СоединениеИд,
	|	ДОБАВИТЬКДАТЕ(Вин.Время, СЕКУНДА, -600) КАК ВремяС,
	|	ДОБАВИТЬКДАТЕ(Вин.Время, СЕКУНДА, 600) КАК ВремяПо
	|ПОМЕСТИТЬ Виновники
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Ж
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.рбфВыполненияТЖ КАК Вин
	|		ПО (Вин.Ид = Ж.ВиновникИд)
	|ГДЕ
	|	Ж.Событие В (""TLOCK"", ""TTIMEOUT"")
	|	И Ж.ВиновникИд <> """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 10000
	|	Т.Ид КАК Ид
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|		ЛЕВОЕ СОЕДИНЕНИЕ Виновники КАК Вн
	|		ПО (Вн.Сервер = Т.Сервер)
	|			И (Вн.База = Т.База)
	|			И (Вн.СоединениеИд = Т.СоединениеИд)
	|			И (Т.Время МЕЖДУ Вн.ВремяС И Вн.ВремяПо)
	|ГДЕ
	|	Т.Время < &Граница
	|	И (Т.Событие = ""TLOCK""
	|				И Т.ЖдалСоединения = """"
	|			ИЛИ Т.Событие = ""SDBL""
	|				И Т.Функция В (""CommitTransaction"", ""RollbackTransaction"", ""Transaction""))
	|	И Вн.СоединениеИд ЕСТЬ NULL";
	// Transaction - фиксации, записанные до исправления разбора двух Func (22.10.2026)
	Запрос.УстановитьПараметр("Граница", ТекущаяДатаСеанса() - 900);
	// отбор по регистру в миллионы строк идёт секунды - один отбор на запуск. Удаление - по записи без
	// общей транзакции: пачка в одной транзакции эскалирует блокировку SQL на таблицу и останавливает
	// запись сбора ТЖ (22.10.2026, ошибка 1222)
	Идентификаторы = Запрос.ВыполнитьПакет()[1].Выгрузить().ВыгрузитьКолонку("Ид");

	Удалено = 0;
	Для Каждого Ид Из Идентификаторы Цикл
		Если Удалено % 100 = 0 И ТекущаяУниверсальнаяДатаВМиллисекундах() >= ДоМс Тогда
			Прервать;
		КонецЕсли;
		Набор = РегистрыСведений.рбфВыполненияТЖ.СоздатьНаборЗаписей();
		Набор.Отбор.Ид.Установить(Ид);
		Набор.Записать(Истина);
		Удалено = Удалено + 1;
	КонецЦикла;
	Возврат Удалено;

КонецФункции

// Контроль ТЖ сервера, вызывается из СборТЖ (раз в минуту):
// - через 1-2 мин после выполнения команды ЗаписатьLogcfg - есть ли файлы *.log, изменённые после записи logcfg;
//   нет - тревога в Telegram (журнал не пишется: ошибка в logcfg, нет прав на каталог);
// - раз в час (в :02) - объём каталога ТЖ и прирост за прошлый час (файлы yyMMddHH.log прошлого часа);
//   выше порогов ТЖТревогаЧасМб (по умолчанию 2048) или ТЖТревогаКаталогГб (100) - тревога в Telegram.
//
// Параметры:
//  НастройкиСервера - Структура - см. СерверыСбораТЖ.
Процедура КонтрольТЖ(НастройкиСервера)

	Каталог = НастройкиСервера.Каталог;
	Если НЕ ЗначениеЗаполнено(Каталог) Тогда
		Возврат;
	КонецЕсли;
	КаталогФайл = Новый Файл(Каталог);
	Если НЕ КаталогФайл.Существует() Тогда
		Возврат;
	КонецЕсли;
	Сейчас = ТекущаяДатаСеанса();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	О.ДатаВыполнения КАК ДатаВыполнения
	|ИЗ
	|	РегистрСведений.ОчередьКоманд КАК О
	|ГДЕ
	|	О.Команда = ""ЗаписатьLogcfg""
	|	И О.Параметр = &Сервер
	|	И О.Состояние = ""выполнена""
	|	И О.ДатаВыполнения > &ВыполненаС
	|	И О.ДатаВыполнения <= &ВыполненаПо
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаВыполнения УБЫВ";
	Запрос.УстановитьПараметр("Сервер", НастройкиСервера.Сервер);
	Запрос.УстановитьПараметр("ВыполненаС", Сейчас - 120);
	Запрос.УстановитьПараметр("ВыполненаПо", Сейчас - 60);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Пишется = Ложь;
		Для Каждого Файл Из НайтиФайлы(Каталог, "*.log", Истина) Цикл
			Если Файл.ПолучитьВремяИзменения() >= Выборка.ДатаВыполнения Тогда
				Пишется = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Пишется Тогда
			ОтправитьТелеграм(СтрШаблон("ТЖ %1: после записи logcfg в %2 нет свежих файлов в %3 - журнал не пишется?",
				НастройкиСервера.Сервер, Формат(Выборка.ДатаВыполнения, "ДФ=HH:mm"), Каталог));
		КонецЕсли;
	КонецЕсли;

	Если Минута(Сейчас) <> 2 Тогда
		Возврат;
	КонецЕсли;
	ПрошлыйЧас = Формат(Сейчас - 3600, "ДФ=yyMMddHH");
	Всего = 0;
	ЗаЧас = 0;
	Для Каждого Файл Из НайтиФайлы(Каталог, "*.log", Истина) Цикл
		Размер = Файл.Размер();
		Всего = Всего + Размер;
		Если Файл.ИмяБезРасширения = ПрошлыйЧас Тогда
			ЗаЧас = ЗаЧас + Размер;
		КонецЕсли;
	КонецЦикла;
	ЗаЧасМб = Окр(ЗаЧас / 1048576);
	ВсегоГб = Окр(Всего / 1073741824, 1);
	ЗаписьЖурналаРегистрации("Мониторинг.КонтрольТЖ", УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон("%1: каталог ТЖ %2 ГБ, за час %3 МБ", НастройкиСервера.Сервер, ВсегоГб, ЗаЧасМб));
	ПорогЧасМб = Число(Строка(Настройка("ТЖТревогаЧасМб", 2048)));
	ПорогКаталогГб = Число(Строка(Настройка("ТЖТревогаКаталогГб", 100)));
	Если ЗаЧасМб > ПорогЧасМб ИЛИ ВсегоГб > ПорогКаталогГб Тогда
		ОтправитьТелеграм(СтрШаблон("ТЖ %1: каталог %2 - %3 ГБ (порог %4), за прошлый час +%5 МБ (порог %6)",
			НастройкиСервера.Сервер, Каталог, ВсегоГб, ПорогКаталогГб, ЗаЧасМб, ПорогЧасМб));
	КонецЕсли;

КонецПроцедуры

// Обработчик регламентного задания рбфАгрегатыТЖ (раз в час, в :05): почасовые агрегаты рбфСобытияТЖ
// закрытого часа из рбфВыполненияТЖ по серверам сбора (СерверыСбораТЖ). Ключи группировки - как Event-Key
// агента rbf_agent, не больше ТопНаСобытие строк на вид события; запись и тревоги - ПринятьСобытияТЖ.
Процедура АгрегатыТЖ() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Час = НачалоЧаса(ТекущаяДатаСеанса()) - 3600;

	Серверы = Новый Соответствие;
	Для Каждого НастройкиСервера Из СерверыСбораТЖ() Цикл
		Серверы.Вставить(ВРег(НастройкиСервера.Сервер), НастройкиСервера);
	КонецЦикла;
	Если Серверы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Выполнения.Сервер КАК Сервер,
	|	Выполнения.База КАК База,
	|	Выполнения.Событие КАК Событие,
	|	Выполнения.ДлительностьМс КАК ДлительностьМс,
	|	Выполнения.Пользователь КАК Пользователь,
	|	Выполнения.Функция КАК Функция,
	|	Выполнения.КонтекстСтрока КАК КонтекстСтрока,
	|	ПОДСТРОКА(Выполнения.КонтекстПолный, 1, 2000) КАК КонтекстПолный,
	|	ПОДСТРОКА(Выполнения.ТекстSQL, 1, 2000) КАК ТекстSQL,
	|	ПОДСТРОКА(Выполнения.Блокировки, 1, 2000) КАК Блокировки,
	|	Выполнения.ЖдалСоединения КАК ЖдалСоединения,
	|	ПОДСТРОКА(Выполнения.Взаимоблокировка, 1, 2000) КАК Взаимоблокировка,
	|	ПОДСТРОКА(Выполнения.Описание, 1, 2000) КАК Описание
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Выполнения
	|ГДЕ
	|	Выполнения.Время >= &Начало
	|	И Выполнения.Время < &Конец";
	Запрос.УстановитьПараметр("Начало", Час);
	Запрос.УстановитьПараметр("Конец", Час + 3600);
	Выборка = Запрос.Выполнить().Выбрать();

	Группы = Новый Соответствие; // ВРег(сервер) -> Соответствие: ид группы -> Соответствие агрегата
	Пока Выборка.Следующий() Цикл
		КлючСервера = ВРег(СокрЛП(Выборка.Сервер));
		Если Серверы.Получить(КлючСервера) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ГруппыСервера = Группы.Получить(КлючСервера);
		Если ГруппыСервера = Неопределено Тогда
			ГруппыСервера = Новый Соответствие;
			Группы.Вставить(КлючСервера, ГруппыСервера);
		КонецЕсли;
		ДобавитьВАгрегатТЖ(ГруппыСервера, Выборка);
	КонецЦикла;

	Для Каждого КЗ Из Группы Цикл
		НастройкиСервера = Серверы.Получить(КЗ.Ключ);
		Попытка
			ПринятьСобытияТЖ(НастройкиСервера.Сервер, Час, ТопАгрегатовТЖ(КЗ.Значение, НастройкиСервера.ТопНаСобытие));
		Исключение
			ЗаписьЖурналаРегистрации("Мониторинг.АгрегатыТЖ", УровеньЖурналаРегистрации.Ошибка, , ,
				НастройкиСервера.Сервер + ": " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает базу, отключённую правилом: ONLINE в СУБД, повторная регистрация в кластере
// (без создания БД), снятие с учёта правила, письмо владельцу.
//
// Параметры:
//  Параметр - Строка - "Сервер1С|ИмяБазы1С".
//
// Возвращаемое значение:
//  Строка - итог выполнения.
Функция ВернутьБазу(Параметр)

	Части = СтрРазделить(Параметр, "|", Истина);
	Если Части.Количество() < 2 Тогда
		Возврат "неверный параметр";
	КонецЕсли;
	СерверСтрокой = Части[0];
	ИмяБазы1С = Части[1];
	КтоВернул = ?(Части.Количество() > 2 И ЗначениеЗаполнено(Части[2]), Части[2], "не указан");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	С.Сервер1С КАК Сервер1С,
	|	С.СерверБД КАК СерверБД,
	|	С.ИмяБазыБД КАК ИмяБазыБД,
	|	С.Владелец КАК Владелец,
	|	С.ПутьБэкап КАК ПутьБэкап
	|ИЗ
	|	РегистрСведений.СерверыИБазы КАК С
	|ГДЕ
	|	С.ИмяБазы1С = &ИмяБазы1С";
	Запрос.УстановитьПараметр("ИмяБазы1С", ИмяБазы1С);
	База = Запрос.Выполнить().Выбрать();
	Найдена = Ложь;
	Пока База.Следующий() Цикл
		// представление ссылки в условии запроса сравнивать нельзя - сверяем здесь
		Если Строка(База.Сервер1С) = СерверСтрокой Тогда
			Найдена = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НЕ Найдена Тогда
		Возврат "база не найдена в реестре";
	КонецЕсли;

	Статус = Новый Массив;

	// 1. база СУБД: удалённую архивацией восстанавливаем из бэкапа, отключённую переводим в ONLINE
	СерверSQL = ?(ЗначениеЗаполнено(База.СерверБД), Строка(База.СерверБД), "localhost");
	Ответ = ВыполнитьКоманду(КомандаSQL(СерверSQL) + " -h -1 -W -Q ""SET NOCOUNT ON; SELECT COUNT(*) FROM sys.databases WHERE name = '"
		+ База.ИмяБазыБД + "'""");
	Если Ответ.КодВозврата <> 0 ИЛИ СтрНайти(Ответ.Вывод, "Msg ") > 0 Тогда
		Возврат ОшибкаВозврата(База.Владелец, ИмяБазы1С, "СУБД: состояние не прочитано " + Лев(Ответ.Вывод, 300));
	КонецЕсли;
	ЕстьВСУБД = СокрЛП(Ответ.Вывод) <> "0";
	Если НЕ ЕстьВСУБД Тогда
		Если НЕ ЗначениеЗаполнено(База.ПутьБэкап) Тогда
			Возврат ОшибкаВозврата(База.Владелец, ИмяБазы1С, "базы нет в СУБД, путь к бэкапу в реестре не указан");
		КонецЕсли;
		Ответ = ВыполнитьКоманду(КомандаSQL(СерверSQL) + " -b -Q ""RESTORE DATABASE [" + База.ИмяБазыБД
			+ "] FROM DISK = N'" + База.ПутьБэкап + "' WITH RECOVERY, CHECKSUM""");
		Если Ответ.КодВозврата <> 0 Тогда
			Возврат ОшибкаВозврата(База.Владелец, ИмяБазы1С, "восстановление из бэкапа " + База.ПутьБэкап
				+ " не удалось: " + Лев(Ответ.Вывод, 500));
		КонецЕсли;
		Статус.Добавить("СУБД: восстановлена из бэкапа " + База.ПутьБэкап);
	Иначе
		Ответ = ВыполнитьКоманду(КомандаSQL(СерверSQL) + " -b -Q ""ALTER DATABASE [" + База.ИмяБазыБД + "] SET ONLINE""");
		Если Ответ.КодВозврата <> 0 Тогда
			Возврат ОшибкаВозврата(База.Владелец, ИмяБазы1С, "СУБД: ошибка (" + Ответ.КодВозврата + ") " + Лев(Ответ.Вывод, 300));
		КонецЕсли;
		Статус.Добавить("СУБД: ONLINE");
	КонецЕсли;

	// 2. регистрация информационной базы в кластере, БД не создаётся
	Rac = ПутьКRac(База.Сервер1С);
	Учётка = УчётнаяЗаписьКластера();
	УчёткаСУБД = УчётнаяЗаписьСУБД();
	Если Rac = Неопределено ИЛИ Учётка = Неопределено ИЛИ УчёткаСУБД = Неопределено Тогда
		Статус.Добавить("кластер: нет данных для подключения (rac, учётка кластера или учётка СУБД)");
	Иначе
		Адрес = "localhost:" + Rac.ПортRAS;
		Кластер = ИдентификаторКластера(Rac, Адрес);
		Если ЗначениеЗаполнено(ИдентификаторИБ(Rac, Адрес, Кластер, Учётка, ИмяБазы1С)) Тогда
			Статус.Добавить("кластер: ИБ уже зарегистрирована");
		Иначе
			Ответ = ВыполнитьКоманду("""" + Rac.Путь + """ " + Адрес + " infobase create --cluster=" + Кластер
				+ " --cluster-user=" + Учётка.Пользователь + " --cluster-pwd=" + Учётка.Пароль
				+ " --name=""" + ИмяБазы1С + """ --dbms=MSSQLServer --db-server=""" + СерверSQL + """"
				+ " --db-name=""" + База.ИмяБазыБД + """ --locale=ru_RU --date-offset=2000"
				+ " --db-user=" + УчёткаСУБД.Пользователь + " --db-pwd=" + УчёткаСУБД.Пароль
				+ " --license-distribution=allow");
			Статус.Добавить(?(Ответ.КодВозврата = 0, "кластер: ИБ зарегистрирована",
				"кластер: ошибка регистрации (" + Ответ.КодВозврата + ") " + Лев(Ответ.Вывод, 200)));
		КонецЕсли;
	КонецЕсли;

	// 3. снимаем с учёта правил: отсчёт начнётся заново, если причина вернётся
	Запрос.Текст =
	"ВЫБРАТЬ К.Правило КАК Правило ИЗ РегистрСведений.КонтрольБаз КАК К
	|ГДЕ К.Сервер1С = &Сервер И К.ИмяБазы1С = &ИмяБазы1С";
	Запрос.УстановитьПараметр("Сервер", СерверСтрокой);
	Правила = Запрос.Выполнить().Выбрать();
	Пока Правила.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.КонтрольБаз.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Правило = Правила.Правило;
		МенеджерЗаписи.Сервер1С = СерверСтрокой;
		МенеджерЗаписи.ИмяБазы1С = ИмяБазы1С;
		МенеджерЗаписи.Удалить();
	КонецЦикла;

	// 4. даты: актуальность - день возврата, отключение - через 2 месяца (позднюю дату не сокращаем)
	Статус.Добавить(ОбновитьДатыПослеВозврата(База.Сервер1С, ИмяБазы1С));
	Статус.Добавить(ЗаписатьИсториюВозврата(СерверСтрокой, ИмяБазы1С, КтоВернул));

	Итог = СтрСоединить(Статус, "; ");
	// В Bitrix сообщаем только после восстановления БД из бэкапа и подтверждённой регистрации ИБ в кластере.
	Если СтрНайти(Итог, "СУБД: восстановлена из бэкапа") > 0
		И (СтрНайти(Итог, "кластер: ИБ зарегистрирована") > 0
			ИЛИ СтрНайти(Итог, "кластер: ИБ уже зарегистрирована") > 0) Тогда
		ОтправитьТелеграм("БАЗА ВОССТАНОВЛЕНА: «" + ИмяБазы1С + "» на сервере " + СерверСтрокой);
	КонецЕсли;

	ОтправитьПисьмо(База.Владелец, "Реестр баз: база «" + ИмяБазы1С + "» снова включена",
		"<p>База <b>" + ИмяБазы1С + "</b> (" + СерверСтрокой + ") снова включена.</p><p>" + Итог + "</p>");
	ЗаписьЖурналаРегистрации("ПравилаРеестра.Возврат", УровеньЖурналаРегистрации.Информация, , ,
		ИмяБазы1С + ": " + Итог);

	Возврат Итог;

КонецФункции

// Сбой возврата: письмо владельцу (копия администраторам) и запись в журнал.
//
// Параметры:
//  Владелец - СправочникСсылка.Владелец - владелец базы.
//  ИмяБазы1С - Строка - имя информационной базы.
//  Текст - Строка - описание сбоя.
//
// Возвращаемое значение:
//  Строка - итог для очереди команд.
Функция ОшибкаВозврата(Владелец, ИмяБазы1С, Текст)

	ОтправитьПисьмо(Владелец, "Реестр баз: базу «" + ИмяБазы1С + "» вернуть не удалось",
		"<p>Базу <b>" + ИмяБазы1С + "</b> вернуть не удалось, администраторы получили копию этого письма.</p><p>"
		+ Текст + "</p>");
	ЗаписьЖурналаРегистрации("ПравилаРеестра.Возврат", УровеньЖурналаРегистрации.Ошибка, , ,
		ИмяБазы1С + ": " + Текст);
	Возврат Текст;

КонецФункции

// Запоминает тип базы перед архивацией в регистре рбфТипДоАрхива (имя значения перечисления ТипБазы).
//
// Параметры:
//  Сервер1С - Строка - представление сервера кластера.
//  ИмяБазы1С - Строка - имя информационной базы.
//  Тип - ПеречислениеСсылка.ТипБазы - тип до архивации.
Процедура ЗапомнитьТипДоАрхива(Сервер1С, ИмяБазы1С, Тип)

	МенеджерЗаписи = РегистрыСведений.рбфТипДоАрхива.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Сервер1С = Сервер1С;
	МенеджерЗаписи.ИмяБазы1С = ИмяБазы1С;
	МенеджерЗаписи.Тип = ?(ЗначениеЗаполнено(Тип), XMLСтрока(Тип), "");
	МенеджерЗаписи.ДатаАрхивации = ТекущаяДатаСеанса();
	МенеджерЗаписи.Записать();

КонецПроцедуры

// Тип базы до архивации из рбфТипДоАрхива; если не запомнен - Тестовая.
//
// Параметры:
//  Сервер1С - Строка - представление сервера кластера.
//  ИмяБазы1С - Строка - имя информационной базы.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.ТипБазы
Функция ТипДоАрхива(Сервер1С, ИмяБазы1С)

	МенеджерЗаписи = РегистрыСведений.рбфТипДоАрхива.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Сервер1С = Сервер1С;
	МенеджерЗаписи.ИмяБазы1С = ИмяБазы1С;
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() И ЗначениеЗаполнено(МенеджерЗаписи.Тип) Тогда
		Значения = Метаданные.Перечисления.ТипБазы.ЗначенияПеречисления;
		Значение = Значения.Найти(МенеджерЗаписи.Тип);
		Если Значение <> Неопределено Тогда
			Возврат Перечисления.ТипБазы.Получить(Значения.Индекс(Значение));
		КонецЕсли;
		ЗаписьЖурналаРегистрации("ПравилаРеестра.Возврат", УровеньЖурналаРегистрации.Предупреждение, , ,
			ИмяБазы1С + ": неизвестный тип до архивации «" + МенеджерЗаписи.Тип + "», ставлю Тестовая");
	КонецЕсли;
	Возврат Перечисления.ТипБазы.Тестовая;

КонецФункции

// Отметка в регистре рбфВозвратыБаз:кто и когда вернул базу. Пользователи регистр только читают.
//
// Параметры:
//  Сервер1С - Строка - представление сервера кластера.
//  ИмяБазы1С - Строка - имя информационной базы.
//  КтоВернул - Строка - полное имя пользователя, запросившего возврат.
//
// Возвращаемое значение:
//  Строка - итог для письма.
Функция ЗаписатьИсториюВозврата(Сервер1С, ИмяБазы1С, КтоВернул)

	МенеджерЗаписи = РегистрыСведений.рбфВозвратыБаз.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Сервер1С = Сервер1С;
	МенеджерЗаписи.ИмяБазы1С = ИмяБазы1С;
	МенеджерЗаписи.ДатаВозврата = ТекущаяДатаСеанса();
	МенеджерЗаписи.КтоВернул = КтоВернул;
	Попытка
		МенеджерЗаписи.Записать();
	Исключение
		ЗаписьЖурналаРегистрации("ПравилаРеестра.Возврат", УровеньЖурналаРегистрации.Ошибка, , ,
			ИмяБазы1С + ": история возврата не записана: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат "история: ошибка записи";
	КонецПопытки;
	Возврат "вернул " + КтоВернул + " " + Формат(МенеджерЗаписи.ДатаВозврата, "ДФ='dd.MM.yyyy HH:mm'");

КонецФункции

// Даты базы после возврата:ДатаАктуальности - день возврата, ДатаОтключения - через 2 месяца,
// если в реестре не стоит более поздняя. Архивная база становится тестовой, отметка архива снимается.
//
// Параметры:
//  Сервер1С - СправочникСсылка.Сервер1С - сервер кластера базы.
//  ИмяБазы1С - Строка - имя информационной базы.
//
// Возвращаемое значение:
//  Строка - итог для письма.
Функция ОбновитьДатыПослеВозврата(Сервер1С, ИмяБазы1С)

	ДатаВозврата = НачалоДня(ТекущаяДатаСеанса());
	НоваяДатаОтключения = ДобавитьМесяц(ДатаВозврата, 2);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	РегистрСведений.СерверыИБазы КАК С
	|ГДЕ
	|	С.Сервер1С = &Сервер
	|	И С.ИмяБазы1С = &ИмяБазы1С";
	Запрос.УстановитьПараметр("Сервер", Сервер1С);
	Запрос.УстановитьПараметр("ИмяБазы1С", ИмяБазы1С);
	Выборка = Запрос.Выполнить().Выбрать();
	Измерения = Метаданные.РегистрыСведений.СерверыИБазы.Измерения;

	Итог = "даты: запись в реестре не найдена";
	Пока Выборка.Следующий() Цикл
		Набор = РегистрыСведений.СерверыИБазы.СоздатьНаборЗаписей();
		Для Каждого Измерение Из Измерения Цикл
			Набор.Отбор[Измерение.Имя].Установить(Выборка[Измерение.Имя]);
		КонецЦикла;
		Попытка
			Набор.Прочитать();
			Для Каждого Запись Из Набор Цикл
				Запись.ДатаАктуальности = ДатаВозврата;
				Если Запись.ДатаОтключения < НоваяДатаОтключения Тогда
					Запись.ДатаОтключения = НоваяДатаОтключения;
				КонецЕсли;
				Итог = "даты: актуальность " + Формат(Запись.ДатаАктуальности, "ДФ=dd.MM.yyyy")
					+ ", отключение " + Формат(Запись.ДатаОтключения, "ДФ=dd.MM.yyyy");
				// тип до архивации берём из рбфТипДоАрхива; если его не запомнили (архив до 14.10.2026) - Тестовая
				Если Запись.Тип = Перечисления.ТипБазы.Архивная ИЛИ Запись.ВАрхиве Тогда
					Если Запись.Тип = Перечисления.ТипБазы.Архивная Тогда
						Запись.Тип = ТипДоАрхива(Строка(Сервер1С), ИмяБазы1С);
					КонецЕсли;
					Запись.ВАрхиве = Ложь;
					Запись.ДатаАрхива = Дата(1, 1, 1);
					Итог = Итог + "; тип: " + Строка(Запись.Тип) + " (была в архиве)";
				КонецЕсли;
			КонецЦикла;
			Набор.Записать();
		Исключение
			Итог = "даты: ошибка записи " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации("ПравилаРеестра.Возврат", УровеньЖурналаРегистрации.Ошибка, , ,
				ИмяБазы1С + ": " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Элемент справочника Владелец для текущего пользователя: поиск по ФИО (полному имени
// пользователя ИБ), при отсутствии - создаётся, как это делает автосинхронизация реестра.
//
// Возвращаемое значение:
//  СправочникСсылка.Владелец, Неопределено - Неопределено, если у пользователя нет полного имени.
Функция ВладелецТекущегоПользователя()

	ФИО = СокрЛП(ПользователиИнформационнойБазы.ТекущийПользователь().ПолноеИмя);
	Если НЕ ЗначениеЗаполнено(ФИО) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Владелец = Справочники.Владелец.НайтиПоНаименованию(ФИО, Истина);
	Если НЕ Владелец.Пустая() Тогда
		Возврат Владелец;
	КонецЕсли;
	НовыйВладелец = Справочники.Владелец.СоздатьЭлемент();
	НовыйВладелец.Наименование = ФИО;
	НовыйВладелец.Записать();
	Возврат НовыйВладелец.Ссылка;

КонецФункции

// Записывает владельца базы в реестр СерверыИБазы. Владелец - ИЗМЕРЕНИЕ регистра, поэтому
// запись со старым владельцем удаляется и пишется новая, остальные поля копируются.
//
// Параметры:
//  Сервер1С - СправочникСсылка.Сервер1С - сервер кластера.
//  ИмяБазы1С - Строка - имя информационной базы.
//  Владелец - СправочникСсылка.Владелец - новый владелец.
Процедура НазначитьВладельца(Сервер1С, ИмяБазы1С, Владелец) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	РегистрСведений.СерверыИБазы КАК С
	|ГДЕ
	|	С.Сервер1С = &Сервер
	|	И С.ИмяБазы1С = &ИмяБазы1С";
	Запрос.УстановитьПараметр("Сервер", Сервер1С);
	Запрос.УстановитьПараметр("ИмяБазы1С", ИмяБазы1С);
	Выборка = Запрос.Выполнить().Выбрать();
	Измерения = Метаданные.РегистрыСведений.СерверыИБазы.Измерения;

	Пока Выборка.Следующий() Цикл
		Если Выборка.Владелец = Владелец Тогда
			Продолжить;
		КонецЕсли;
		СтарыйВладелец = Выборка.Владелец;

		НачатьТранзакцию();
		Попытка
			СтарыйНабор = РегистрыСведений.СерверыИБазы.СоздатьНаборЗаписей();
			Для Каждого Измерение Из Измерения Цикл
				СтарыйНабор.Отбор[Измерение.Имя].Установить(Выборка[Измерение.Имя]);
			КонецЦикла;
			СтарыйНабор.Прочитать();
			ЗаписьНайдена = СтарыйНабор.Количество() > 0;
			Если ЗаписьНайдена Тогда
				НовыйНабор = РегистрыСведений.СерверыИБазы.СоздатьНаборЗаписей();
				Для Каждого Измерение Из Измерения Цикл
					НовыйНабор.Отбор[Измерение.Имя].Установить(?(Измерение.Имя = "Владелец", Владелец, Выборка[Измерение.Имя]));
				КонецЦикла;
				НовыйНабор.Прочитать();
				НоваяЗапись = ?(НовыйНабор.Количество() > 0, НовыйНабор[0], НовыйНабор.Добавить());
				ЗаполнитьЗначенияСвойств(НоваяЗапись, СтарыйНабор[0]);
				НоваяЗапись.Владелец = Владелец;

				СтарыйНабор.Очистить();
				СтарыйНабор.Записать();
				НовыйНабор.Записать();
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;

		Если НЕ ЗаписьНайдена Тогда
			Продолжить;
		КонецЕсли;

		ЗаписьЖурналаРегистрации("ПравилаРеестра.Возврат", УровеньЖурналаРегистрации.Информация, , ,
			ИмяБазы1С + ": владелец " + Строка(СтарыйВладелец) + " -> " + Строка(Владелец)
			+ " (вернул базу " + ИмяПользователя() + ")");
	КонецЦикла;

КонецПроцедуры

// Базы, отключённые правилами и не возвращённые за СрокДоУдаленияОтключённойДней: полный бэкап
// на SHARE с проверкой, затем DROP DATABASE, в реестре - тип «Архивная» и путь к бэкапу.
// Бэкапы старше СрокХраненияАрхиваДней удаляются. Вызывается суточным заданием ОбновлениеКластеров.
//
// Параметры:
//  Сводка - см. НоваяСводка.
Процедура АрхивироватьОтключённыеБазы(Сводка)

	СрокДней   = Настройка("СрокДоУдаленияОтключённойДней", 30);
	ХранитьДней = Настройка("СрокХраненияАрхиваДней", 60);
	Лимит      = Настройка("ЛимитУдаленийЗаПрогон", 3);
	Каталог    = Настройка("КаталогАрхиваОтключённыхБаз", "\\SHARE\Backup_SQL\S2019\arch_rule\");
	Если Прав(Каталог, 1) <> "\" Тогда
		Каталог = Каталог + "\";
	КонецЕсли;
	Сейчас = ТекущаяДатаСеанса();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	К.Правило КАК Правило,
	|	К.Сервер1С КАК Сервер1С,
	|	К.ИмяБазы1С КАК ИмяБазы1С,
	|	К.ДатаОтключения КАК ДатаОтключения
	|ИЗ
	|	РегистрСведений.КонтрольБаз КАК К
	|ГДЕ
	|	К.ДатаОтключения <> ДАТАВРЕМЯ(1, 1, 1)
	|	И К.ДатаОтключения <= &Граница
	|	И НЕ К.Статус ПОДОБНО ""удалена%""
	|	И НЕ К.Статус ПОДОБНО ""пропущено%""
	|УПОРЯДОЧИТЬ ПО
	|	К.ДатаОтключения";
	Запрос.УстановитьПараметр("Граница", Сейчас - СрокДней * 86400);
	Выборка = Запрос.Выполнить().Выбрать();

	Сделано = 0;
	Пока Выборка.Следующий() И Сделано < Лимит Цикл

		ЗапросБазы = Новый Запрос;
		ЗапросБазы.Текст =
		"ВЫБРАТЬ
		|	С.Сервер1С КАК Сервер1С,
		|	С.ИмяБазыБД КАК ИмяБазыБД,
		|	С.СерверБД КАК СерверБД,
		|	С.Владелец КАК Владелец
		|ИЗ
		|	РегистрСведений.СерверыИБазы КАК С
		|ГДЕ
		|	С.ИмяБазы1С = &ИмяБазы1С";
		ЗапросБазы.УстановитьПараметр("ИмяБазы1С", Выборка.ИмяБазы1С);
		// @skip-check query-in-loop - правило обходит десятки баз и по каждой выполняет отдельное действие
		База = ЗапросБазы.Выполнить().Выбрать();
		Найдена = Ложь;
		Пока База.Следующий() Цикл
			// представление ссылки в условии запроса сравнивать нельзя - сверяем здесь
			Если Строка(База.Сервер1С) = Выборка.Сервер1С Тогда
				Найдена = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Найдена ИЛИ НЕ ЗначениеЗаполнено(База.ИмяБазыБД) Тогда
			ОбновитьСтатус(Выборка.Правило, Выборка.Сервер1С, Выборка.ИмяБазы1С, "пропущено: нет записи в реестре");
			Продолжить;
		КонецЕсли;

		ИмяБД = База.ИмяБазыБД;
		СерверSQL = ?(ЗначениеЗаполнено(База.СерверБД), Строка(База.СерверБД), "localhost");

		// состояние в СУБД: вернули вручную - не трогаем; базы уже нет - только отмечаем
		// @skip-check query-in-loop - правило обходит десятки баз и по каждой выполняет отдельное действие
		Ответ = ВыполнитьКоманду(КомандаSQL(СерверSQL) + " -h -1 -W -Q ""SET NOCOUNT ON; SELECT state_desc FROM sys.databases WHERE name = '"
			+ ИмяБД + "'""");
		// запрос не выполнился - состояние неизвестно; «базы нет» только при успешном пустом ответе
		Если Ответ.КодВозврата <> 0 ИЛИ СтрНайти(Ответ.Вывод, "Msg ") > 0 ИЛИ СтрНайти(Ответ.Вывод, "Sqlcmd:") > 0 Тогда
			ОбновитьСтатус(Выборка.Правило, Выборка.Сервер1С, Выборка.ИмяБазы1С,
				"отключена, состояние в СУБД не прочитано: " + Лев(Ответ.Вывод, 300));
			Продолжить;
		КонецЕсли;
		Состояние = "";
		Для Каждого СтрокаОтвета Из СтрРазделить(Ответ.Вывод, Символы.ПС, Ложь) Цикл
			Если СокрЛП(СтрокаОтвета) = "ONLINE" ИЛИ СокрЛП(СтрокаОтвета) = "OFFLINE" Тогда
				Состояние = СокрЛП(СтрокаОтвета);
			КонецЕсли;
		КонецЦикла;
		Если Состояние = "ONLINE" Тогда
			ОбновитьСтатус(Выборка.Правило, Выборка.Сервер1С, Выборка.ИмяБазы1С, "пропущено: база в СУБД включена вручную");
			Продолжить;
		ИначеЕсли Состояние = "" Тогда
			ОбновитьСтатус(Выборка.Правило, Выборка.Сервер1С, Выборка.ИмяБазы1С, "удалена ранее: базы нет в СУБД");
			Продолжить;
		КонецЕсли;

		// @skip-check query-in-loop - правило обходит десятки баз и по каждой выполняет отдельное действие
		Связи = СвязиБазы(Выборка.ИмяБазы1С);
		Если ЗначениеЗаполнено(Связи) Тогда
			ДобавитьВСводку(Сводка, "Связи", "<b>" + Выборка.ИмяБазы1С + "</b> удаляется, а в реестре связей у неё: " + Связи);
		КонецЕсли;

		// бэкап с проверкой; при сбое база возвращается в OFFLINE и не удаляется
		ФайлБэкапа = Каталог + ИмяБД + "_" + Формат(Сейчас, "ДФ=yyyyMMdd_HHmm") + ".bak";
		// @skip-check query-in-loop - правило обходит десятки баз и по каждой выполняет отдельное действие
		Ответ = ВыполнитьКоманду(КомандаSQL(СерверSQL) + " -b -Q ""ALTER DATABASE [" + ИмяБД + "] SET ONLINE; "
			+ "BACKUP DATABASE [" + ИмяБД + "] TO DISK = N'" + ФайлБэкапа + "' WITH COPY_ONLY, COMPRESSION, CHECKSUM, INIT; "
			+ "RESTORE VERIFYONLY FROM DISK = N'" + ФайлБэкапа + "' WITH CHECKSUM""");
		Если Ответ.КодВозврата <> 0 Тогда
			// @skip-check query-in-loop - правило обходит десятки баз и по каждой выполняет отдельное действие
			ВыполнитьКоманду(КомандаSQL(СерверSQL) + " -b -Q ""ALTER DATABASE [" + ИмяБД + "] SET OFFLINE WITH ROLLBACK IMMEDIATE""");
			ОбновитьСтатус(Выборка.Правило, Выборка.Сервер1С, Выборка.ИмяБазы1С,
				"отключена, бэкап перед удалением НЕ удался: " + Лев(Ответ.Вывод, 300));
			ДобавитьВСводку(Сводка, "Сбои", "<b>" + Выборка.ИмяБазы1С + "</b>: бэкап перед удалением не удался, база не удалена");
			ЗаписьЖурналаРегистрации("ПравилаРеестра.Архив", УровеньЖурналаРегистрации.Ошибка, , ,
				Выборка.ИмяБазы1С + ": бэкап не удался, база не удалена. " + Ответ.Вывод);
			Продолжить;
		КонецЕсли;

		// @skip-check query-in-loop - правило обходит десятки баз и по каждой выполняет отдельное действие
		Ответ = ВыполнитьКоманду(КомандаSQL(СерверSQL) + " -b -Q ""ALTER DATABASE [" + ИмяБД
			+ "] SET SINGLE_USER WITH ROLLBACK IMMEDIATE; DROP DATABASE [" + ИмяБД + "]""");
		Если Ответ.КодВозврата <> 0 Тогда
			ОбновитьСтатус(Выборка.Правило, Выборка.Сервер1С, Выборка.ИмяБазы1С,
				"бэкап " + ФайлБэкапа + ", но DROP не удался: " + Лев(Ответ.Вывод, 300));
			ДобавитьВСводку(Сводка, "Сбои", "<b>" + Выборка.ИмяБазы1С + "</b>: бэкап сделан, но DROP не удался");
			Продолжить;
		КонецЕсли;

		// ИБ без базы данных в кластере не нужна; обычно её уже удалило отключение
		ИтогКластера = "";
		Если ЗначениеЗаполнено(Выборка.Сервер1С) Тогда
			// @skip-check query-in-loop - правило обходит десятки баз и по каждой выполняет отдельное действие
			ИтогКластера = "; " + УдалитьИБИзКластера(Выборка.Сервер1С, Выборка.ИмяБазы1С);
		КонецЕсли;

		// @skip-check query-in-loop - правило обходит десятки баз и по каждой выполняет отдельное действие
		ОтметитьАрхивВРеестре(Выборка.Сервер1С, Выборка.ИмяБазы1С, ФайлБэкапа, Сейчас);
		ОбновитьСтатус(Выборка.Правило, Выборка.Сервер1С, Выборка.ИмяБазы1С, "удалена " + Формат(Сейчас, "ДФ=dd.MM.yyyy")
			+ ", бэкап " + ФайлБэкапа + ИтогКластера);
		ХранитсяДо = Формат(Сейчас + ХранитьДней * 86400, "ДФ=dd.MM.yyyy");
		ДобавитьВСводку(Сводка, "Удалены", "<b>" + Выборка.ИмяБазы1С + "</b> (" + Выборка.Сервер1С + "), бэкап "
			+ ФайлБэкапа + " до " + ХранитсяДо, База.Владелец,
			"<b>" + Выборка.ИмяБазы1С + "</b> (" + Выборка.Сервер1С + ") удалена: после отключения её не вернули. "
			+ "Служебная копия: " + ФайлБэкапа + " (хранится до " + ХранитсяДо + ").");
		ЗаписьЖурналаРегистрации("ПравилаРеестра.Архив", УровеньЖурналаРегистрации.Информация, , ,
			Выборка.ИмяБазы1С + " удалена, бэкап " + ФайлБэкапа);
		Сделано = Сделано + 1;

	КонецЦикла;

	// бэкапы старше срока хранения удаляет сам SQL Server (у его службы есть права на SHARE)
	Граница = Формат(Сейчас - ХранитьДней * 86400, "ДФ=yyyy-MM-ddTHH:mm:ss");
	Ответ = ВыполнитьКоманду(КомандаSQL("localhost") + " -b -Q ""EXEC master.dbo.xp_delete_file 0, N'" + Каталог
		+ "', N'bak', N'" + Граница + "', 0""");
	Если Ответ.КодВозврата <> 0 Тогда
		ЗаписьЖурналаРегистрации("ПравилаРеестра.Архив", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Очистка старых бэкапов не удалась: " + Ответ.Вывод);
	КонецЕсли;

КонецПроцедуры

// Ежедневная сверка реестра с SQL Server и кластерами 1С (вызывается из ОбновитьКластеры и
// командой очереди ЗаполнитьДатыБаз). Одним запросом на каждый сервер СУБД берутся дата
// создания, размер и дата последнего полного бэкапа всех баз, затем:
//  - ДатаАктуальности = дата создания, ДатаОтключения = она же + 2 месяца (без ПересчитатьВсе -
//    только если пустая: владелец мог продлить);
//  - РазмерБазы (Гб) и ДатаФактБэкап (последний полный бэкап);
//  - база, в имени которой есть "test", переводится в тип Тестовая;
//  - одно письмо администраторам, если есть рабочие базы без свежего бэкапа, базы SQL или
//    ИБ кластеров без записи в реестре.
// Архивные записи и базы, которых нет в SQL, не трогаются.
//
// Параметры:
//  ПересчитатьВсе - Булево - перезаписать дату отключения у всех баз.
//  Сводка - см. НоваяСводка, Неопределено - замечания в сводку суточного цикла;
//   Неопределено (команда очереди) - отдельным письмом администраторам.
//
// Возвращаемое значение:
//  Строка - итог для очереди команд и журнала.
Функция ЗаполнитьДатыБаз(ПересчитатьВсе, Сводка = Неопределено)

	УстановитьПривилегированныйРежим(Истина);

	ДнейБезБэкапа = Настройка("ДнейБезБэкапаРабочей", 8); // полный бэкап у нас раз в неделю (сб), в будни - разностный
	СлужебныеБазы = СтрРазделить(НРег(Настройка("СлужебныеБазыSQL",
		"master,model,msdb,tempdb,distribution,dba,veeambackup,reportserver,reportservertempdb,ssisdb")), ",", Ложь);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	РегистрСведений.СерверыИБазы КАК С";
	ВсеЗаписи = Запрос.Выполнить().Выгрузить();

	// сведения о базах - одним запросом на каждый сервер СУБД
	СведенияSQL = Новый Соответствие;
	Серверы = Новый Соответствие;
	Для Каждого ЗаписьРеестра Из ВсеЗаписи Цикл
		Если ЗначениеЗаполнено(ЗаписьРеестра.ИмяБазыБД) Тогда
			Серверы.Вставить(?(ЗначениеЗаполнено(ЗаписьРеестра.СерверБД), Строка(ЗаписьРеестра.СерверБД), "localhost"), Истина);
		КонецЕсли;
	КонецЦикла;
	НеПрочитаны = Новый Массив;
	Для Каждого Сервер Из Серверы Цикл
		// @skip-check query-in-loop - один запрос на сервер СУБД, их единицы
		Ответ = ВыполнитьКоманду(КомандаSQL(Сервер.Ключ) + " -h -1 -W -Q ""SET NOCOUNT ON; "
			+ "SELECT d.name + '|' + CONVERT(varchar(19), d.create_date, 120) + '|' "
			+ "+ ISNULL(CONVERT(varchar(20), CAST((SELECT SUM(CAST(f.size AS bigint)) FROM sys.master_files f WHERE f.database_id = d.database_id) * 8 / 1024 AS bigint)), '') + '|' "
			+ "+ ISNULL(CONVERT(varchar(19), (SELECT MAX(b.backup_finish_date) FROM msdb.dbo.backupset b WHERE b.database_name = d.name AND b.type = 'D'), 120), '') "
			+ "FROM sys.databases d""");
		Если Ответ.КодВозврата <> 0 Тогда
			НеПрочитаны.Добавить(Сервер.Ключ);
			ЗаписьЖурналаРегистрации("ПравилаРеестра.Даты", УровеньЖурналаРегистрации.Предупреждение, , ,
				Сервер.Ключ + ": не удалось прочитать сведения о базах: " + Лев(Ответ.Вывод, 300));
			Продолжить;
		КонецЕсли;
		Для Каждого СтрокаОтвета Из СтрРазделить(Ответ.Вывод, Символы.ПС, Ложь) Цикл
			Части = СтрРазделить(СокрЛП(СтрокаОтвета), "|", Истина);
			Если Части.Количество() <> 4 Тогда
				Продолжить;
			КонецЕсли;
			Сведения = Новый Структура("Сервер,Имя,Создана,РазмерГб,ПоследнийБэкап",
				Сервер.Ключ, Части[0], ДатаИзSQL(Части[1]),
				?(ПустаяСтрока(Части[2]), Неопределено, Окр(Число(Части[2]) / 1024, 3)), НачалоДня(ДатаИзSQL(Части[3])));
			// точность как у полей реестра: РазмерБазы - 3 знака, ДатаФактБэкап - только дата; иначе запись "меняется" каждый день
			// размер Неопределено: учётке СУБД не видны файлы чужих баз (не sysadmin на этом экземпляре)
			СведенияSQL.Вставить(НРег(Сервер.Ключ) + "|" + НРег(Части[0]), Сведения);
		КонецЦикла;
	КонецЦикла;

	// версия SQL Server каждого экземпляра: "MS SQL 2019 CU32 (15.0.4490.9)"
	ВерсииСерверов = Новый Соответствие;
	СледующиеБэкапы = Новый Соответствие;
	Площадка = Справочники.Площадка.НайтиПоНаименованию(Настройка("ПлощадкаПоУмолчанию", "S2019"), Истина);
	Для Каждого Сервер Из Серверы Цикл
		Если НеПрочитаны.Найти(Сервер.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// @skip-check query-in-loop - один запрос на сервер СУБД, их единицы
		ВерсияСервера = ВерсияSQLServer(Сервер.Ключ);
		// @skip-check query-in-loop - один запрос на сервер СУБД, их единицы
		СледующиеБэкапы.Вставить(НРег(Сервер.Ключ), СледующийПолныйБэкап(Сервер.Ключ));
		Если ЗначениеЗаполнено(ВерсияСервера) Тогда
			ВерсииСерверов.Вставить(НРег(Сервер.Ключ), ВерсияСервера);
		КонецЕсли;
	КонецЦикла;
	Измерения = Метаданные.РегистрыСведений.СерверыИБазы.Измерения;
	ВРеестре = Новый Соответствие;
	Изменено = 0;
	НетВSQL = 0;
	ВТестовые = Новый Массив;
	БезБэкапа = Новый Массив;
	Граница = ТекущаяДатаСеанса() - ДнейБезБэкапа * 86400;

	Для Каждого ЗаписьРеестра Из ВсеЗаписи Цикл

		СерверSQL = ?(ЗначениеЗаполнено(ЗаписьРеестра.СерверБД), Строка(ЗаписьРеестра.СерверБД), "localhost");
		Ключ = НРег(СерверSQL) + "|" + НРег(ЗаписьРеестра.ИмяБазыБД);
		ВРеестре.Вставить(Ключ, Истина);

		Если ЗаписьРеестра.Тип = Перечисления.ТипБазы.Архивная ИЛИ НЕ ЗначениеЗаполнено(ЗаписьРеестра.ИмяБазыБД) Тогда
			Продолжить;
		КонецЕсли;
		Сведения = СведенияSQL.Получить(Ключ);
		Если Сведения = Неопределено Тогда
			НетВSQL = НетВSQL + 1;
			Продолжить;
		КонецЕсли;

		// более поздняя дата актуальности - день возврата базы (ОбновитьДатыПослеВозврата), её не затираем
		НоваяАктуальность = Макс(НачалоДня(Сведения.Создана), ЗаписьРеестра.ДатаАктуальности);
		НовоеОтключение = ЗаписьРеестра.ДатаОтключения;
		Если ПересчитатьВсе ИЛИ НЕ ЗначениеЗаполнено(НовоеОтключение) Тогда
			НовоеОтключение = ДобавитьМесяц(НоваяАктуальность, 2);
		КонецЕсли;
		НовыйРазмер = ?(Сведения.РазмерГб = Неопределено, ЗаписьРеестра.РазмерБазы, Сведения.РазмерГб);
		НоваяВерсия = ВерсииСерверов.Получить(НРег(СерверSQL));
		НоваяВерсия = ?(НоваяВерсия = Неопределено, ЗаписьРеестра.ВерсияСУБД, НоваяВерсия);
		// плановый полный бэкап - только у баз, которые задание BackUP_FULL реально бэкапит (свежий бэкап есть)
		НовыйПлан = Дата(1, 1, 1);
		Если ЗначениеЗаполнено(Сведения.ПоследнийБэкап) И Сведения.ПоследнийБэкап >= Граница Тогда
			НовыйПлан = СледующиеБэкапы.Получить(НРег(СерверSQL));
			НовыйПлан = ?(НовыйПлан = Неопределено, Дата(1, 1, 1), НовыйПлан);
		КонецЕсли;
		НоваяПлощадка = ?(ЗначениеЗаполнено(ЗаписьРеестра.Площадка) ИЛИ Площадка.Пустая(), ЗаписьРеестра.Площадка, Площадка);
		НовыйТип = ЗаписьРеестра.Тип;
		Если НовыйТип <> Перечисления.ТипБазы.Тестовая
			И (СтрНайти(НРег(ЗаписьРеестра.ИмяБазы1С), "test") > 0 ИЛИ СтрНайти(НРег(ЗаписьРеестра.ИмяБазыБД), "test") > 0) Тогда
			НовыйТип = Перечисления.ТипБазы.Тестовая;
			ВТестовые.Добавить(ЗаписьРеестра.ИмяБазы1С + " (было: " + Строка(ЗаписьРеестра.Тип) + ")");
		КонецЕсли;

		Если НовыйТип = Перечисления.ТипБазы.Рабочая
			И (НЕ ЗначениеЗаполнено(Сведения.ПоследнийБэкап) ИЛИ Сведения.ПоследнийБэкап < Граница) Тогда
			БезБэкапа.Добавить(ЗаписьРеестра.ИмяБазыБД + " (" + СерверSQL + ", "
				+ ?(ЗначениеЗаполнено(Сведения.ПоследнийБэкап), "последний полный бэкап " + Формат(Сведения.ПоследнийБэкап, "ДФ=dd.MM.yyyy"), "полного бэкапа нет")
				+ ", " + НовыйРазмер + " Гб)");
		КонецЕсли;

		Если ЗаписьРеестра.ДатаАктуальности = НоваяАктуальность И ЗаписьРеестра.ДатаОтключения = НовоеОтключение
			И ЗаписьРеестра.Тип = НовыйТип И ЗаписьРеестра.РазмерБазы = НовыйРазмер
			И ЗаписьРеестра.ДатаФактБэкап = Сведения.ПоследнийБэкап И ЗаписьРеестра.ВерсияСУБД = НоваяВерсия
			И ЗаписьРеестра.ДатаПланБэкап = НовыйПлан И ЗаписьРеестра.Площадка = НоваяПлощадка Тогда
			Продолжить;
		КонецЕсли;

		Набор = РегистрыСведений.СерверыИБазы.СоздатьНаборЗаписей();
		Для Каждого Измерение Из Измерения Цикл
			Набор.Отбор[Измерение.Имя].Установить(ЗаписьРеестра[Измерение.Имя]);
		КонецЦикла;
		// @skip-check query-in-loop - запись по одной базе, десятки записей
		Набор.Прочитать();
		Для Каждого ЗаписьНабора Из Набор Цикл
			ЗаписьНабора.ДатаАктуальности = НоваяАктуальность;
			ЗаписьНабора.ДатаОтключения = НовоеОтключение;
			ЗаписьНабора.Тип = НовыйТип;
			ЗаписьНабора.РазмерБазы = НовыйРазмер;
			ЗаписьНабора.ДатаФактБэкап = Сведения.ПоследнийБэкап;
			ЗаписьНабора.ВерсияСУБД = НоваяВерсия;
			ЗаписьНабора.ДатаПланБэкап = НовыйПлан;
			ЗаписьНабора.Площадка = НоваяПлощадка;
		КонецЦикла;
		Набор.Записать();
		Изменено = Изменено + 1;

	КонецЦикла;

	// базы SQL без записи в реестре (служебные не в счёт)
	НеучтённыеSQL = Новый Массив;
	Для Каждого Элемент Из СведенияSQL Цикл
		Если ВРеестре.Получить(Элемент.Ключ) = Неопределено
			И СлужебныеБазы.Найти(НРег(Элемент.Значение.Имя)) = Неопределено Тогда
			НеучтённыеSQL.Добавить(Элемент.Значение.Имя + " (" + Элемент.Значение.Сервер + ?(Элемент.Значение.РазмерГб = Неопределено, "", ", " + Элемент.Значение.РазмерГб + " Гб") + ")");
		КонецЕсли;
	КонецЦикла;

	// ИБ кластеров без записи в реестре
	ИБВРеестре = Новый Соответствие;
	Для Каждого ЗаписьРеестра Из ВсеЗаписи Цикл
		Части = СтрРазделить(Строка(ЗаписьРеестра.Сервер1С), ":", Ложь);
		Если Части.Количество() > 1 Тогда
			ИБВРеестре.Вставить(СокрЛП(Части[1]) + "|" + ВРег(ЗаписьРеестра.ИмяБазы1С), Истина);
		КонецЕсли;
	КонецЦикла;
	НеучтённыеИБ = Новый Массив;
	Для Каждого Элемент Из ЗапретыИзРеестровКластеров() Цикл
		Если ИБВРеестре.Получить(Элемент.Ключ) = Неопределено Тогда
			НеучтённыеИБ.Добавить(СтрЗаменить(Элемент.Ключ, "|", " / "));
		КонецЕсли;
	КонецЦикла;

	Если Сводка <> Неопределено Тогда
		Для Каждого Элемент Из БезБэкапа Цикл
			ДобавитьВСводку(Сводка, "БезБэкапа", Элемент);
		КонецЦикла;
		Для Каждого Элемент Из НеучтённыеSQL Цикл
			ДобавитьВСводку(Сводка, "НеучтённыеSQL", Элемент);
		КонецЦикла;
		Для Каждого Элемент Из НеучтённыеИБ Цикл
			ДобавитьВСводку(Сводка, "НеучтённыеИБ", Элемент);
		КонецЦикла;
		Для Каждого Элемент Из НеПрочитаны Цикл
			ДобавитьВСводку(Сводка, "Сбои", "не удалось прочитать сведения с сервера СУБД " + Элемент);
		КонецЦикла;
		Для Каждого Элемент Из ВТестовые Цикл
			ДобавитьВСводку(Сводка, "ВТестовые", Элемент);
		КонецЦикла;
	ИначеЕсли БезБэкапа.Количество() + НеучтённыеSQL.Количество() + НеучтённыеИБ.Количество() + НеПрочитаны.Количество() > 0 Тогда
		Текст = "";
		Если БезБэкапа.Количество() > 0 Тогда
			Текст = Текст + "<p><b>Рабочие базы без полного бэкапа дольше " + ДнейБезБэкапа + " дн.:</b><br>"
				+ СтрСоединить(БезБэкапа, "<br>") + "</p>";
		КонецЕсли;
		Если НеучтённыеSQL.Количество() > 0 Тогда
			Текст = Текст + "<p><b>Базы в SQL без записи в реестре:</b><br>" + СтрСоединить(НеучтённыеSQL, "<br>") + "</p>";
		КонецЕсли;
		Если НеучтённыеИБ.Количество() > 0 Тогда
			Текст = Текст + "<p><b>Информационные базы в кластерах без записи в реестре (порт / имя):</b><br>"
				+ СтрСоединить(НеучтённыеИБ, "<br>") + "</p>";
		КонецЕсли;
		Если НеПрочитаны.Количество() > 0 Тогда
			Текст = Текст + "<p><b>Не удалось прочитать сведения с серверов СУБД:</b> " + СтрСоединить(НеПрочитаны, ", ") + "</p>";
		КонецЕсли;
		ОтправитьПисьмо(Неопределено, "Реестр баз: требуют внимания администратора", Текст);
	КонецЕсли;

	Итог = "сверка с SQL: изменено " + Изменено + ", нет в SQL " + НетВSQL
		+ ", в тестовые " + ВТестовые.Количество() + ", рабочих без бэкапа " + БезБэкапа.Количество()
		+ ", неучтённых в SQL " + НеучтённыеSQL.Количество() + ", неучтённых ИБ " + НеучтённыеИБ.Количество()
		+ ?(ПересчитатьВсе, " (пересчёт всех дат)", "");
	Если ВТестовые.Количество() > 0 Тогда
		Итог = Итог + ". Переведены в тестовые: " + СтрСоединить(ВТестовые, ", ");
	КонецЕсли;
	ЗаписьЖурналаРегистрации("ПравилаРеестра.Даты", УровеньЖурналаРегистрации.Информация, , , Итог);
	Возврат Итог;

КонецФункции

// Дата следующего запуска задания SQL Agent BackUP_FULL (полный бэкап) на экземпляре.
//
// Параметры:
//  СерверSQL - Строка - имя экземпляра SQL Server.
//
// Возвращаемое значение:
//  Дата - начало дня следующего полного бэкапа; пустая, если задания нет или оно выключено.
// Ежедневный снимок размеров рабочих и тестовых баз в регистр рбфРазмерыТаблиц:
// 10 крупнейших таблиц каждой базы (место с индексами и число строк) и три итога -
// «(файлы данных)» и «(журнал)» по размеру файлов, «(занято в данных)» по всем таблицам.
// Повторный запуск в тот же день перезаписывает снимок. Базы, которые растут за неделю
// больше порогов, попадают в сводку.
//
// Параметры:
//  Сводка - см. НоваяСводка.
Процедура СобратьРазмерыТаблиц(Сводка)

	УстановитьПривилегированныйРежим(Истина);
	ТаблицВБазе = Настройка("РазмерыТаблицТопN", 10);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	С.Сервер1С КАК Сервер1С,
	|	С.ИмяБазы1С КАК ИмяБазы1С,
	|	С.СерверБД КАК СерверБД,
	|	С.ИмяБазыБД КАК ИмяБазыБД
	|ИЗ
	|	РегистрСведений.СерверыИБазы КАК С
	|ГДЕ
	|	С.Тип В (ЗНАЧЕНИЕ(Перечисление.ТипБазы.Рабочая), ЗНАЧЕНИЕ(Перечисление.ТипБазы.Тестовая))
	|	И С.ИмяБазыБД <> """"";
	Выборка = Запрос.Выполнить().Выбрать();

	// базы по серверам СУБД: имя БД в нижнем регистре -> база реестра
	Серверы = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		СерверSQL = ?(ЗначениеЗаполнено(Выборка.СерверБД), Строка(Выборка.СерверБД), "localhost");
		Базы = Серверы.Получить(СерверSQL);
		Если Базы = Неопределено Тогда
			Базы = Новый Соответствие;
			Серверы.Вставить(СерверSQL, Базы);
		КонецЕсли;
		Базы.Вставить(НРег(Выборка.ИмяБазыБД), Новый Структура("Сервер1С,ИмяБазы1С,ИмяБазыБД",
			Строка(Выборка.Сервер1С), Выборка.ИмяБазы1С, Выборка.ИмяБазыБД));
	КонецЦикла;

	Итоги = Новый Соответствие;
	Итоги.Вставить("*DATA*", "(файлы данных)");
	Итоги.Вставить("*LOG*", "(журнал)");
	Итоги.Вставить("*USED*", "(занято в данных)");

	ДатаСнимка = НачалоДня(ТекущаяДатаСеанса());
	Записано = 0;
	Для Каждого Сервер Из Серверы Цикл

		Имена = Новый Массив;
		Для Каждого База Из Сервер.Значение Цикл
			Имена.Добавить("N'" + СтрЗаменить(База.Значение.ИмяБазыБД, "'", "''") + "'");
		КонецЦикла;

		ФайлЗапроса = ПолучитьИмяВременногоФайла("sql");
		ЗаписьФайла = Новый ЗаписьТекста(ФайлЗапроса, КодировкаТекста.ANSI);
		ЗаписьФайла.Записать(ТекстЗапросаРазмеров(СтрСоединить(Имена, ","), ТаблицВБазе));
		ЗаписьФайла.Закрыть();
		// @skip-check query-in-loop - один запрос на сервер СУБД, их единицы
		Ответ = ВыполнитьКоманду(КомандаSQL(Сервер.Ключ) + " -h -1 -W -i """ + ФайлЗапроса + """");
		УдалитьФайлы(ФайлЗапроса);
		Если Ответ.КодВозврата <> 0 ИЛИ СтрНайти(Ответ.Вывод, "Sqlcmd:") > 0 Тогда
			ДобавитьВСводку(Сводка, "Сбои", "Размеры таблиц: не прочитан сервер " + Сервер.Ключ + " - " + Лев(Ответ.Вывод, 200));
			Продолжить;
		КонецЕсли;

		Строки = Новый Соответствие; // имя БД -> массив структур Таблица, РазмерМБ, Строк
		Для Каждого СтрокаОтвета Из СтрРазделить(Ответ.Вывод, Символы.ПС, Ложь) Цикл
			Части = СтрРазделить(СокрЛП(СтрокаОтвета), "|", Истина);
			Если Части.Количество() = 3 И Части[0] = "ERR" Тогда
				ЗаписьЖурналаРегистрации("ПравилаРеестра.Размеры", УровеньЖурналаРегистрации.Предупреждение, , ,
					Сервер.Ключ + "/" + Части[1] + ": " + Части[2]);
				Продолжить;
			ИначеЕсли Части.Количество() <> 4 Тогда
				Продолжить;
			КонецЕсли;
			Таблица = Итоги.Получить(Части[1]);
			Попытка
				Элемент = Новый Структура("Таблица,РазмерМБ,Строк", ?(Таблица = Неопределено, Части[1], Таблица),
					Число(Части[2]), Число(Части[3]));
			Исключение
				Продолжить;
			КонецПопытки;
			Ключ = НРег(Части[0]);
			Массив = Строки.Получить(Ключ);
			Если Массив = Неопределено Тогда
				Массив = Новый Массив;
				Строки.Вставить(Ключ, Массив);
			КонецЕсли;
			Массив.Добавить(Элемент);
		КонецЦикла;

		Для Каждого КЗ Из Строки Цикл
			База = Сервер.Значение.Получить(КЗ.Ключ);
			Если База = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Набор = РегистрыСведений.рбфРазмерыТаблиц.СоздатьНаборЗаписей();
			Набор.Отбор.ДатаСнимка.Установить(ДатаСнимка);
			Набор.Отбор.Сервер1С.Установить(База.Сервер1С);
			Набор.Отбор.ИмяБазы1С.Установить(База.ИмяБазы1С);
			Для Каждого Элемент Из КЗ.Значение Цикл
				Запись = Набор.Добавить();
				Запись.ДатаСнимка = ДатаСнимка;
				Запись.Сервер1С = База.Сервер1С;
				Запись.ИмяБазы1С = База.ИмяБазы1С;
				ЗаполнитьЗначенияСвойств(Запись, Элемент);
			КонецЦикла;
			// @skip-check query-in-loop - запись снимка одной базы
			Набор.Записать(Истина);
			Записано = Записано + 1;
		КонецЦикла;

	КонецЦикла;

	ЗаписьЖурналаРегистрации("ПравилаРеестра.Размеры", УровеньЖурналаРегистрации.Информация, , ,
		"Снимок размеров за " + Формат(ДатаСнимка, "ДФ=dd.MM.yyyy") + ": баз " + Записано);

	ПроверитьБыстрыйРост(ДатаСнимка, Сводка);

КонецПроцедуры

// Текст T-SQL для снимка размеров: по каждой из перечисленных баз - N крупнейших таблиц
// и место, занятое всеми таблицами; по файлам - размер данных и журнала.
// Строки ответа: "база|таблица|МБ|строк"; ошибка чтения базы - "ERR|база|текст".
//
// Параметры:
//  СписокИмён - Строка - имена баз в виде N'имя',N'имя'.
//  ТаблицВБазе - Число - сколько крупнейших таблиц брать.
//
// Возвращаемое значение:
//  Строка - текст пакета для sqlcmd.
Функция ТекстЗапросаРазмеров(СписокИмён, ТаблицВБазе)

	Текст =
	"SET NOCOUNT ON;
	|DECLARE @r TABLE (db sysname, t nvarchar(300), mb decimal(18,2), rws bigint);
	|DECLARE @db sysname, @s nvarchar(max);
	|DECLARE c CURSOR LOCAL FAST_FORWARD FOR
	|	SELECT name FROM sys.databases WHERE state = 0 AND name IN (%1);
	|OPEN c;
	|FETCH NEXT FROM c INTO @db;
	|WHILE @@FETCH_STATUS = 0
	|BEGIN
	|	SET @s = N'USE ' + QUOTENAME(@db) + N';
	|SELECT TOP (%2) DB_NAME(), t.name, CAST(SUM(p.reserved_page_count) * 8 / 1024.0 AS decimal(18,2)),
	|	SUM(CASE WHEN p.index_id < 2 THEN p.row_count ELSE 0 END)
	|FROM sys.dm_db_partition_stats p JOIN sys.tables t ON t.object_id = p.object_id
	|GROUP BY t.name ORDER BY 3 DESC;
	|SELECT DB_NAME(), N''*USED*'', CAST(SUM(reserved_page_count) * 8 / 1024.0 AS decimal(18,2)), 0
	|FROM sys.dm_db_partition_stats;';
	|	BEGIN TRY
	|		INSERT @r EXEC (@s);
	|	END TRY
	|	BEGIN CATCH
	|		PRINT 'ERR|' + @db + '|' + REPLACE(ERROR_MESSAGE(), '|', '/');
	|	END CATCH
	|	FETCH NEXT FROM c INTO @db;
	|END
	|CLOSE c;
	|DEALLOCATE c;
	|INSERT @r
	|SELECT d.name, CASE f.type WHEN 1 THEN N'*LOG*' ELSE N'*DATA*' END,
	|	CAST(SUM(CAST(f.size AS bigint)) * 8 / 1024.0 AS decimal(18,2)), 0
	|FROM sys.master_files f JOIN sys.databases d ON d.database_id = f.database_id
	|WHERE d.name IN (%1)
	|GROUP BY d.name, CASE f.type WHEN 1 THEN N'*LOG*' ELSE N'*DATA*' END;
	|SELECT db + '|' + t + '|' + CONVERT(varchar(30), mb) + '|' + CONVERT(varchar(30), rws) FROM @r;";

	Возврат СтрШаблон(Текст, СписокИмён, Формат(ТаблицВБазе, "ЧГ=0"));

КонецФункции

// Базы, у которых файлы данных за неделю выросли больше порогов (и в мегабайтах, и в процентах),
// попадают в сводку. Сравнение со снимком ровно недельной давности; если его нет - база пропускается.
//
// Параметры:
//  ДатаСнимка - Дата - день текущего снимка.
//  Сводка - см. НоваяСводка.
Процедура ПроверитьБыстрыйРост(ДатаСнимка, Сводка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Сервер1С КАК Сервер1С,
	|	Т.ИмяБазы1С КАК ИмяБазы1С,
	|	Н.РазмерМБ КАК Было,
	|	Т.РазмерМБ КАК Стало
	|ИЗ
	|	РегистрСведений.рбфРазмерыТаблиц КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.рбфРазмерыТаблиц КАК Н
	|		ПО Т.Сервер1С = Н.Сервер1С
	|			И Т.ИмяБазы1С = Н.ИмяБазы1С
	|			И Т.Таблица = Н.Таблица
	|			И (Н.ДатаСнимка = &НеделюНазад)
	|ГДЕ
	|	Т.ДатаСнимка = &ДатаСнимка
	|	И Т.Таблица = ""(файлы данных)""
	|	И Н.РазмерМБ > 0
	|	И Т.РазмерМБ - Н.РазмерМБ >= &ПорогМБ
	|	И (Т.РазмерМБ - Н.РазмерМБ) * 100 / Н.РазмерМБ >= &ПорогПроцентов
	|УПОРЯДОЧИТЬ ПО
	|	Т.РазмерМБ - Н.РазмерМБ УБЫВ";
	Запрос.УстановитьПараметр("ДатаСнимка", ДатаСнимка);
	Запрос.УстановитьПараметр("НеделюНазад", ДатаСнимка - 7 * 86400);
	Запрос.УстановитьПараметр("ПорогМБ", Настройка("ПорогРостаБазыЗаНеделюМБ", 1024));
	Запрос.УстановитьПараметр("ПорогПроцентов", Настройка("ПорогРостаБазыЗаНеделюПроцентов", 10));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьВСводку(Сводка, "БыстрыйРост", СтрокаБазы(Выборка) + ": "
			+ Формат(Выборка.Было / 1024, "ЧДЦ=1; ЧН=0") + " -> " + Формат(Выборка.Стало / 1024, "ЧДЦ=1; ЧН=0")
			+ " Гб за неделю (+" + Формат((Выборка.Стало - Выборка.Было) * 100 / Выборка.Было, "ЧДЦ=0") + "%)");
	КонецЦикла;

КонецПроцедуры

// Связи базы из регистра рбфСвязиБаз, где она источник или приёмник.
//
// Параметры:
//  ИмяБазы1С - Строка - имя информационной базы.
//
// Возвращаемое значение:
//  Строка - связи через "; " вида "источник -> приёмник (вид)"; пусто, если связей нет.
Функция СвязиБазы(ИмяБазы1С)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	С.БазаИсточник КАК БазаИсточник,
	|	С.БазаПриемник КАК БазаПриемник,
	|	С.ВидСвязи КАК ВидСвязи
	|ИЗ
	|	РегистрСведений.рбфСвязиБаз КАК С
	|ГДЕ
	|	(С.БазаИсточник = &ИмяБазы1С
	|			ИЛИ С.БазаПриемник = &ИмяБазы1С)";
	Запрос.УстановитьПараметр("ИмяБазы1С", ИмяБазы1С);
	Выборка = Запрос.Выполнить().Выбрать();
	Связи = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Связи.Добавить(Выборка.БазаИсточник + " -> " + Выборка.БазаПриемник
			+ ?(ЗначениеЗаполнено(Выборка.ВидСвязи), " (" + Выборка.ВидСвязи + ")", ""));
	КонецЦикла;
	Возврат СтрСоединить(Связи, "; ");

КонецФункции

// Замер агента мониторинга (метод rbf-admin/metrics): значения счётчиков одного сервера
// на один момент времени. Повторная отправка того же момента перезаписывает замер.
// После записи проверяются пороги тревог.
//
// Параметры:
//  Сервер - Строка - имя сервера из конфигурации агента.
//  Время - Дата - момент замера (местное время сервера).
//  Значения - Соответствие из КлючИЗначение - имя счётчика -> Число.
//
// Возвращаемое значение:
//  Число - сколько значений записано.
Функция ПринятьСчетчики(Сервер, Время, Значения) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Набор = РегистрыСведений.рбфСчетчики.СоздатьНаборЗаписей();
	Набор.Отбор.Время.Установить(Время);
	Набор.Отбор.Сервер.Установить(Сервер);
	Для Каждого КЗ Из Значения Цикл
		Если ТипЗнч(КЗ.Значение) <> Тип("Число") Тогда
			Продолжить;
		КонецЕсли;
		Запись = Набор.Добавить();
		Запись.Время = Время;
		Запись.Сервер = Сервер;
		Запись.Счетчик = Лев(КЗ.Ключ, 150);
		Запись.Значение = КЗ.Значение;
	КонецЦикла;
	Набор.Записать(Истина);

	Попытка
		ПроверитьТревогиСчетчиков(Сервер, Время);
	Исключение
		ЗаписьЖурналаРегистрации("ПравилаРеестра.Мониторинг", УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Набор.Количество();

КонецФункции

// Почасовые агрегаты технологического журнала от агента (метод rbf-admin/techlog).
// Повторная отправка того же часа перезаписывает его. Взаимоблокировки и таймауты
// управляемых блокировок сразу уходят в Telegram.
//
// Параметры:
//  Сервер - Строка - имя сервера из конфигурации агента.
//  Час - Дата - начало часа.
//  События - Массив из Соответствие - ключи base, event, key, count, dur_sum_ms, dur_max_ms, example.
//
// Возвращаемое значение:
//  Число - сколько строк записано.
Функция ПринятьСобытияТЖ(Сервер, Час, События) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Набор = РегистрыСведений.рбфСобытияТЖ.СоздатьНаборЗаписей();
	Набор.Отбор.Час.Установить(Час);
	Набор.Отбор.Сервер.Установить(Лев(Сервер, 50));
	Тревоги = Новый Соответствие; // событие -> Структура Количество, Базы
	БазыСТЖ = рбфАнализСервер.КартаБазСНастройкойТЖ();
	Для Каждого Событие Из События Цикл
		// базы без настройки ТЖ не анализируем, кроме ошибок (по ним видно проблемные базы);
		// строки без базы (процессы, кластер) остаются
		ИмяБазыСобытия = ВРег(СокрЛП(Строка(Событие.Получить("base"))));
		Если ЗначениеЗаполнено(ИмяБазыСобытия) И БазыСТЖ.Получить(ИмяБазыСобытия) = Неопределено
			И НЕ рбфАнализСервер.ЭтоСобытиеОшибкиТЖ(Строка(Событие.Получить("event"))) Тогда
			Продолжить;
		КонецЕсли;
		Запись = Набор.Добавить();
		Запись.Час = Час;
		Запись.Сервер = Лев(Сервер, 50);
		Запись.База = Лев(Строка(Событие.Получить("base")), 100);
		Запись.Событие = Лев(Строка(Событие.Получить("event")), 20);
		Запись.Ключ = Лев(Строка(Событие.Получить("key")), 300);
		// в измерении - хеш ключа: полный текст в индексе не помещается в лимит ключа SQL Server
		Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
		Хеш.Добавить(Запись.Ключ);
		Запись.КлючХеш = ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма);
		Запись.Количество = ЧислоИзОтвета(Событие.Получить("count"));
		Запись.ДлительностьСуммаМс = ЧислоИзОтвета(Событие.Получить("dur_sum_ms"));
		Запись.ДлительностьМаксМс = ЧислоИзОтвета(Событие.Получить("dur_max_ms"));
		Запись.Пример = Лев(Строка(Событие.Получить("example")), 2000);
		Если Запись.Событие = "TDEADLOCK" ИЛИ Запись.Событие = "TTIMEOUT" Тогда
			Итог = Тревоги.Получить(Запись.Событие);
			Если Итог = Неопределено Тогда
				Итог = Новый Структура("Количество,Базы", 0, Новый Соответствие);
				Тревоги.Вставить(Запись.Событие, Итог);
			КонецЕсли;
			Итог.Количество = Итог.Количество + Запись.Количество;
			Итог.Базы.Вставить(Запись.База, Истина);
		КонецЕсли;
	КонецЦикла;
	// агент сам усекает ключ до 300 символов до группировки, поэтому хеши ключей в наборе уникальны
	Набор.Записать(Истина);

	Если Тревоги.Количество() > 0 Тогда
		Названия = Новый Соответствие;
		Названия.Вставить("TDEADLOCK", "взаимоблокировок");
		Названия.Вставить("TTIMEOUT", "таймаутов ожидания блокировки");
		Строки = Новый Массив;
		Для Каждого КЗ Из Тревоги Цикл
			Базы = Новый Массив;
			Для Каждого Б Из КЗ.Значение.Базы Цикл
				Базы.Добавить(Б.Ключ);
			КонецЦикла;
			Строки.Добавить(Названия.Получить(КЗ.Ключ) + ": " + КЗ.Значение.Количество + " (" + СтрСоединить(Базы, ", ") + ")");
		КонецЦикла;
		ОтправитьТелеграм("ТЖ " + Сервер + " за " + Формат(Час, "ДФ='dd.MM HH:mm'") + Символы.ПС + СтрСоединить(Строки, Символы.ПС)
			+ Символы.ПС + "Подробно: base_list, отчёт «Проблемы производительности (ТЖ)»");
	КонецЕсли;

	Возврат Набор.Количество();

КонецФункции

// Число из значения JSON; нечисловое - 0.
//
// Параметры:
//  Значение - Произвольный - значение поля JSON.
//
// Возвращаемое значение:
//  Число - значение или 0.
Функция ЧислоИзОтвета(Значение)
	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, 0);
КонецФункции

// Ставит задание анализа ТЖ в очередь рбфЗаданияАнализаТЖ (статус "queued").
// Задание забирает исполнитель на 88.44 через rbf-admin/tj-job.
//
// Параметры:
//  Каталог - Строка - каталог логов ТЖ (UNC).
//  ПериодС - Дата - начало периода анализа.
//  ПериодПо - Дата - конец периода анализа.
//  ПробныйПрогон - Булево - только сводка, без диагноза ИИ.
//  Автор - Строка - кто поставил задание.
//
// Возвращаемое значение:
//  Строка - идентификатор задания.
Функция ПоставитьАнализТЖ(Каталог, ПериодС, ПериодПо, ПробныйПрогон, Автор) Экспорт

	Если НЕ ЗначениеЗаполнено(Каталог) Тогда
		ВызватьИсключение "не задан каталог логов ТЖ";
	КонецЕсли;
	Если ЗначениеЗаполнено(ПериодС) И ЗначениеЗаполнено(ПериодПо) И ПериодС > ПериодПо Тогда
		ВызватьИсключение "начало периода позже конца";
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Ид = Строка(Новый УникальныйИдентификатор);
	Запись = РегистрыСведений.рбфЗаданияАнализаТЖ.СоздатьМенеджерЗаписи();
	Запись.Ид = Ид;
	Запись.Создано = ТекущаяДатаСеанса();
	Запись.Автор = Лев(Автор, 100);
	Запись.Каталог = Лев(Каталог, 500);
	Запись.ПериодС = ПериодС;
	Запись.ПериодПо = ПериодПо;
	Запись.ПробныйПрогон = (ПробныйПрогон = Истина);
	Запись.Статус = "queued";
	Запись.Записать();
	Возврат Ид;

КонецФункции

// Выдаёт исполнителю самое старое задание из очереди и переводит его в "running".
// Задания в "running" дольше 2 часов считаются зависшими и возвращаются в очередь.
//
// Возвращаемое значение:
//  Структура, Неопределено - Ид, Каталог, ПериодС, ПериодПо, ПробныйПрогон; Неопределено - очередь пуста.
Функция ВзятьЗаданиеАнализаТЖ() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	ГраницаЗависших = ТекущаяДатаСеанса() - 2 * 3600;
	Результат = Неопределено;

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Блокировка.Добавить("РегистрСведений.рбфЗаданияАнализаТЖ").Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Задания.Ид КАК Ид,
		|	Задания.Создано КАК Создано
		|ИЗ
		|	РегистрСведений.рбфЗаданияАнализаТЖ КАК Задания
		|ГДЕ
		|	(Задания.Статус = ""queued""
		|			ИЛИ Задания.Статус = ""running""
		|				И Задания.Взято < &ГраницаЗависших)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Создано";
		Запрос.УстановитьПараметр("ГраницаЗависших", ГраницаЗависших);
		Выборка = Запрос.Выполнить().Выбрать();

		// зависшее задание снова выдаётся как ожидающее, порядок - по времени постановки
		Если Выборка.Следующий() Тогда
			Запись = РегистрыСведений.рбфЗаданияАнализаТЖ.СоздатьМенеджерЗаписи();
			Запись.Ид = Выборка.Ид;
			Запись.Прочитать();
			Если Запись.Выбран() Тогда
				Запись.Статус = "running";
				Запись.Взято = ТекущаяДатаСеанса();
				Запись.Завершено = Дата(1, 1, 1);
				Запись.Ошибка = "";
				Запись.Записать();
				Результат = Новый Структура("Ид,Каталог,ПериодС,ПериодПо,ПробныйПрогон",
					Запись.Ид, Запись.Каталог, Запись.ПериодС, Запись.ПериодПо, Запись.ПробныйПрогон);
			КонецЕсли;
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Принимает результат анализа ТЖ от исполнителя.
//
// Параметры:
//  Ид - Строка - идентификатор задания.
//  Статус - Строка - "done" или "error".
//  Сводка - Строка - сводка tj-analyzer.
//  Диагноз - Строка - диагноз ИИ.
//  Ошибка - Строка - текст ошибки исполнителя.
//
// Возвращаемое значение:
//  Булево - Истина, если задание найдено и обновлено.
Функция ПринятьРезультатАнализаТЖ(Ид, Статус, Сводка, Диагноз, Ошибка) Экспорт

	Если Статус <> "done" И Статус <> "error" Тогда
		ВызватьИсключение "недопустимый статус " + Статус + ": ожидается done или error";
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	КлючЗадания = Лев(Ид, 36);
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.рбфЗаданияАнализаТЖ");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Ид", КлючЗадания);
		Блокировка.Заблокировать();

		Запись = РегистрыСведений.рбфЗаданияАнализаТЖ.СоздатьМенеджерЗаписи();
		Запись.Ид = КлючЗадания;
		Запись.Прочитать();
		Найдено = Запись.Выбран();
		Если Найдено Тогда
			Запись.Статус = Статус;
			Запись.Завершено = ТекущаяДатаСеанса();
			Запись.Сводка = Строка(Сводка);
			Запись.Диагноз = Строка(Диагноз);
			Запись.Ошибка = Строка(Ошибка);
			Запись.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Найдено;

КонецФункции

// Текст logcfg.xml сервера по показателям ТЖ баз (рбфНастройкиТЖ), как у 1С-Монитора
// (docs/tasks/monitor-logcfg-ref.md): на каждую базу и вид показателя отдельный <log>
// в каталоге <Каталог>\<база>_<порт>\<Вид>, фильтр p:processName = имя базы и только
// нужные свойства. logcfg.xml один на компьютер, поэтому в файл входят базы всех
// кластеров сервера. Пороги длительности в фильтре - в десятитысячных секунды, как у Монитора.
//
// Параметры:
//  Сервер - Строка - имя компьютера сервера 1С без порта.
//
// Возвращаемое значение:
//  Строка - текст XML.
Функция СформироватьLogcfg(Сервер) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	ИмяСервера = СокрЛП(Сервер);
	Если НЕ ЗначениеЗаполнено(ИмяСервера) Тогда
		ВызватьИсключение "не задан сервер";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Н.Сервер1С КАК Сервер1С,
	|	Н.ИмяБазы1С КАК ИмяБазы1С,
	|	Н.ДолгийЗапрос КАК ДолгийЗапрос,
	|	Н.ДолгийЗапросПорог КАК ДолгийЗапросПорог,
	|	Н.ОжиданиеНаБлокировке1С КАК ОжиданиеНаБлокировке1С,
	|	Н.ОжиданиеНаБлокировкеСУБД КАК ОжиданиеНаБлокировкеСУБД,
	|	Н.Взаимоблокировка1С КАК Взаимоблокировка1С,
	|	Н.ВзаимоблокировкаСУБД КАК ВзаимоблокировкаСУБД,
	|	Н.ОшибкаТЖ КАК ОшибкаТЖ,
	|	Н.Транзакции КАК Транзакции,
	|	Н.СерверныйВызов КАК СерверныйВызов,
	|	Н.СерверныйВызовПорог КАК СерверныйВызовПорог,
	|	Н.КаталогЛогов КАК КаталогЛогов,
	|	Н.Глубина КАК Глубина
	|ИЗ
	|	РегистрСведений.рбфНастройкиТЖ КАК Н
	|ГДЕ
	|	НЕ (Н.Сервер1С = """" И Н.ИмяБазы1С = """")
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сервер1С,
	|	ИмяБазы1С";
	Выборка = Запрос.Выполнить().Выбрать();

	КаталогПоУмолчанию = Настройка("КаталогЛоговТЖ", "D:\logs_1c\rbf");
	МусорноеИсключение = Настройка("ТЖМусорноеИсключение", "");

	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиXML("UTF-8", , Истина));
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьНачалоЭлемента("config");
	Запись.ЗаписатьСоответствиеПространстваИмен("", "http://v8.1c.ru/v8/tech-log");
	Запись.ЗаписатьКомментарий(" Сформировано base_list (РеестрБазФикс) " + Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm'")
		+ " для " + ИмяСервера + ". Вручную не править: файл перезаписывается кнопкой «Применить на сервере» формы «Настройка ТЖ». ");

	// пороги - по свойству durationus (микросекунды): duration в сотнях мкс зависит от настройки
	// точности времени и с 8.3.x считается устаревшим; настройки порогов хранятся в секундах
	МксВСекунде = 1000000;
	// свойства ожиданий на блокировках СУБД (<dbmslocks/>): жертва lkp/lkpid/lkpto, виновник lka/lkaid/lkato,
	// lksrc - номер соединения 1С виновника
	СвойстваБлокировокСУБД = "lka,lkp,lkpid,lkaid,lksrc,lkpto,lkato";
	ГлубинаПрод = "28"; // часы: прод-журнал и длинные события по ИТС (i8105809) - больше суток
	КаталогПрод = "";

	БлокировкиСУБД = Ложь;
	БазыСТЖ = Новый Массив; // базы сервера с включённым ТЖ - для отбора прод-журнала
	Пока Выборка.Следующий() Цикл

		Части = СтрРазделить(Выборка.Сервер1С, ":", Ложь);
		Если Части.Количество() = 0 ИЛИ ВРег(СокрЛП(Части[0])) <> ВРег(ИмяСервера) Тогда
			Продолжить;
		КонецЕсли;
		Каталог = СокрЛП(Выборка.КаталогЛогов);
		Если НЕ ЗначениеЗаполнено(Каталог) Тогда
			Каталог = КаталогПоУмолчанию;
		КонецЕсли;
		Если СтрЗаканчиваетсяНа(Каталог, "\") Тогда
			Каталог = Лев(Каталог, СтрДлина(Каталог) - 1);
		КонецЕсли;

		// строка сервера: каталог прод-журнала. <dump> не пишется (решение 22.10.2026), флаг ДампПроцесса не используется
		Если НЕ ЗначениеЗаполнено(Выборка.ИмяБазы1С) Тогда
			КаталогПрод = Каталог;
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(КаталогПрод) Тогда
			КаталогПрод = Каталог;
		КонецЕсли;

		База = СокрЛП(Выборка.ИмяБазы1С);
		Порт = ?(Части.Количество() > 1, СокрЛП(Части[1]), "1541");
		Папка = Каталог + "\" + База + "_" + Порт + "\";
		Глубина = Формат(?(Выборка.Глубина > 0, Выборка.Глубина, 2), "ЧГ=");

		// длинные события любого вида (CALL/SCALL/SDBL/EXCP, Commit) - по каждой базе с включённым ТЖ
		Если Выборка.ДолгийЗапрос ИЛИ Выборка.ОжиданиеНаБлокировке1С ИЛИ Выборка.ОжиданиеНаБлокировкеСУБД
			ИЛИ Выборка.Взаимоблокировка1С ИЛИ Выборка.ВзаимоблокировкаСУБД ИЛИ Выборка.ОшибкаТЖ
			ИЛИ Выборка.Транзакции ИЛИ Выборка.СерверныйВызов Тогда
			БазыСТЖ.Добавить(База);
			События = Новый Массив;
			События.Добавить(УсловияСобытияТЖ("ge", "durationus", Формат(20 * МксВСекунде, "ЧГ=")));
			ЗаписатьЛогТЖ(Запись, Папка + "LongEvents", ГлубинаПрод, База, События,
				"p:processName,SessionID,t:clientID,t:applicationName,t:computerName,t:connectID,Context,Usr,dbpid,Sql,Sdbl,trans,Rows,Func,Exception,Descr,IName,MName,Txt");
		КонецЕсли;

		Если Выборка.ДолгийЗапрос Тогда
			Порог = Формат(Окр(Выборка.ДолгийЗапросПорог * МксВСекунде), "ЧГ=");
			События = Новый Массив;
			События.Добавить(УсловияСобытияТЖ("eq", "name", "DBMSSQL", "ge", "durationus", Порог));
			ЗаписатьЛогТЖ(Запись, Папка + "Queries", Глубина, База, События,
				"p:processName,SessionID,t:clientID,t:applicationName,t:computerName,t:connectID,Context,Usr,dbpid,Sql,trans,Rows,RowsAffected,DataBase,DBCopy,"
				+ СвойстваБлокировокСУБД);
			// текст запроса на языке 1С (свойство Sdbl); отдельного порога в настройках нет - тот же, что у DBMSSQL
			События = Новый Массив;
			События.Добавить(УсловияСобытияТЖ("eq", "name", "SDBL", "ge", "durationus", Порог));
			ЗаписатьЛогТЖ(Запись, Папка + "Queries1C", Глубина, База, События,
				"p:processName,SessionID,t:clientID,t:applicationName,t:computerName,t:connectID,Context,Usr,trans,Rows,Func,Sdbl");
		КонецЕсли;

		Если Выборка.Транзакции Тогда
			События = Новый Массив;
			События.Добавить(УсловияСобытияТЖ("eq", "name", "SDBL", "eq", "Func", "CommitTransaction"));
			События.Добавить(УсловияСобытияТЖ("eq", "name", "SDBL", "eq", "Func", "RollbackTransaction"));
			ЗаписатьЛогТЖ(Запись, Папка + "Transactions", Глубина, База, События,
				"p:processName,SessionID,t:clientID,t:connectID,Usr,lka,Func");
		КонецЕсли;

		// TLOCK - все, без порога и без отбора по WaitConnections (методика ИТС metod8dev i8105809, i8106006):
		// виновник ожидания ставит блокировку сразу, его TLOCK с пустым WaitConnections - единственное место,
		// где видны пространство, значения полей и точка кода виновника. Объём ограничивает отдельный лог
		// с коротким history; в регистре TLOCK без ожидания, не ставшие виновниками, подчищаются.
		Если Выборка.ОжиданиеНаБлокировке1С Тогда
			События = Новый Массив;
			События.Добавить(УсловияСобытияТЖ("eq", "name", "TLOCK"));
			События.Добавить(УсловияСобытияТЖ("eq", "name", "TTIMEOUT"));
			ЗаписатьЛогТЖ(Запись, Папка + "1C_Locks", Глубина, База, События,
				"p:processName,SessionID,t:clientID,t:applicationName,t:computerName,t:connectID,Context,Usr,Locks,escalating,WaitConnections");
		КонецЕсли;

		Если Выборка.ОжиданиеНаБлокировкеСУБД Тогда
			БлокировкиСУБД = Истина;
			События = Новый Массив;
			События.Добавить(УсловияСобытияТЖ("eq", "name", "DBMSSQL", "like", "Sql", "UPDATE% dbo._%"));
			События.Добавить(УсловияСобытияТЖ("eq", "name", "DBMSSQL", "like", "Sql", "DELETE% dbo._%"));
			События.Добавить(УсловияСобытияТЖ("eq", "name", "DBMSSQL", "like", "Sql", "INSERT INTO dbo._%"));
			ЗаписатьЛогТЖ(Запись, Папка + "SQL_Locks", Глубина, База, События,
				"p:processName,SessionID,t:computerName,t:connectID,t:applicationName,Context,Usr,dbpid,Sql,t:clientID,"
				+ СвойстваБлокировокСУБД);
		КонецЕсли;

		Если Выборка.Взаимоблокировка1С Тогда
			События = Новый Массив;
			События.Добавить(УсловияСобытияТЖ("eq", "name", "TDEADLOCK"));
			ЗаписатьЛогТЖ(Запись, Папка + "1C_Deadlocks", Глубина, База, События,
				"p:processName,SessionID,t:computerName,t:connectID,Context,Usr,DeadlockConnectionIntersections");
		КонецЕсли;
		// взаимоблокировки СУБД разбираются по SQL_Locks и <dbmslocks/>, отдельного лога у Монитора нет
		Если Выборка.ВзаимоблокировкаСУБД Тогда
			БлокировкиСУБД = Истина;
		КонецЕсли;

		Если Выборка.ОшибкаТЖ Тогда
			События = Новый Массив;
			Если ЗначениеЗаполнено(МусорноеИсключение) Тогда
				События.Добавить(УсловияСобытияТЖ("eq", "name", "EXCP", "ne", "exception", МусорноеИсключение));
			Иначе
				События.Добавить(УсловияСобытияТЖ("eq", "name", "EXCP"));
			КонецЕсли;
			События.Добавить(УсловияСобытияТЖ("eq", "name", "SDBL", "eq", "Func", "setRollbackOnly"));
			События.Добавить(УсловияСобытияТЖ("eq", "name", "QERR"));
			ЗаписатьЛогТЖ(Запись, Папка + "Exceptions", Глубина, База, События, "all");
		КонецЕсли;

		Если Выборка.СерверныйВызов Тогда
			Порог = Формат(Окр(Выборка.СерверныйВызовПорог * МксВСекунде), "ЧГ=");
			События = Новый Массив;
			События.Добавить(УсловияСобытияТЖ("eq", "name", "CALL", "ge", "durationus", Порог));
			События.Добавить(УсловияСобытияТЖ("eq", "name", "SCALL", "ge", "durationus", Порог));
			ЗаписатьЛогТЖ(Запись, Папка + "Calls", Глубина, База, События,
				"p:processName,SessionID,t:clientID,t:applicationName,t:computerName,t:connectID,Context,Usr,Memory,MemoryPeak,InBytes,OutBytes,CpuTime");
		КонецЕсли;

	КонецЦикла;

	// минимальный прод-журнал сервера (ИТС i8105809), решение 23.10.2026: исключения - по всем базам (видно
	// проблемные базы), соединения и сеансы - только баз с включённым ТЖ, процессы, администрирование и
	// кластер - без отбора по базе: это события ragent/rmngr/rphost, у них нет p:processName, пишутся всегда
	Если НЕ ЗначениеЗаполнено(КаталогПрод) Тогда
		КаталогПрод = КаталогПоУмолчанию;
	КонецЕсли;
	Если ЗначениеЗаполнено(КаталогПрод) Тогда
		События = Новый Массив;
		Если ЗначениеЗаполнено(МусорноеИсключение) Тогда
			События.Добавить(УсловияСобытияТЖ("eq", "name", "EXCP", "ne", "exception", МусорноеИсключение));
		Иначе
			События.Добавить(УсловияСобытияТЖ("eq", "name", "EXCP"));
		КонецЕсли;
		Для Каждого БазаПрод Из БазыСТЖ Цикл
			Для Каждого ИмяСобытия Из СтрРазделить("CONN,SESN", ",") Цикл
				Условия = УсловияСобытияТЖ("eq", "name", ИмяСобытия);
				Условия.Добавить(Новый Структура("Вид,Свойство,Значение", "eq", "p:processName", БазаПрод));
				События.Добавить(Условия);
			КонецЦикла;
		КонецЦикла;
		Для Каждого ИмяСобытия Из СтрРазделить("PROC,ADMIN,CLSTR", ",") Цикл
			События.Добавить(УсловияСобытияТЖ("eq", "name", ИмяСобытия));
		КонецЦикла;
		ЗаписатьЛогТЖ(Запись, КаталогПрод + "\Prod", ГлубинаПрод, "", События, "all");
	КонецЕсли;

	Если БлокировкиСУБД Тогда
		Запись.ЗаписатьНачалоЭлемента("dbmslocks");
		Запись.ЗаписатьКонецЭлемента();
	КонецЕсли;

	Запись.ЗаписатьКонецЭлемента();
	Возврат Запись.Закрыть();

КонецФункции

// Применение настроек ТЖ на сервере: текст logcfg сохраняется в строке сервера
// рбфНастройкиТЖ (на случай, если настройки поменяют до выполнения команды), а в
// ОчередьКоманд ставится команда ЗаписатьLogcfg. Её выполняет ОбработчикКоманд:
// бэкап текущего logcfg.xml и запись нового.
//
// Параметры:
//  Сервер - Строка - имя компьютера сервера 1С без порта.
//
// Возвращаемое значение:
//  Строка - сообщение для пользователя.
Функция ПрименитьLogcfg(Сервер) Экспорт

	ИмяСервера = СокрЛП(Сервер);
	Текст = СформироватьLogcfg(ИмяСервера);

	УстановитьПривилегированныйРежим(Истина);
	Запись = РегистрыСведений.рбфНастройкиТЖ.СоздатьМенеджерЗаписи();
	Запись.Сервер1С = ИмяСервера;
	Запись.ИмяБазы1С = "";
	Запись.Прочитать();
	Запись.Сервер1С = ИмяСервера;
	Запись.ИмяБазы1С = "";
	Запись.ТекстLogcfg = Текст;
	Запись.Изменено = ТекущаяДатаСеанса();
	Запись.Автор = Лев(ИмяПользователя(), 100);
	Запись.Записать();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 1 КАК Поле
	|ИЗ РегистрСведений.ОчередьКоманд КАК О
	|ГДЕ О.Команда = ""ЗаписатьLogcfg"" И О.Параметр = &Сервер И О.Состояние = ""новая""";
	Запрос.УстановитьПараметр("Сервер", ИмяСервера);
	Если Запрос.Выполнить().Пустой() Тогда
		МенеджерЗаписи = РегистрыСведений.ОчередьКоманд.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Идентификатор = "tj-" + Строка(Новый УникальныйИдентификатор);
		МенеджерЗаписи.Команда = "ЗаписатьLogcfg";
		МенеджерЗаписи.Параметр = ИмяСервера;
		МенеджерЗаписи.Состояние = "новая";
		МенеджерЗаписи.Записать();
	КонецЕсли;

	ЗаписьЖурналаРегистрации("ПравилаРеестра.НастройкиТЖ", УровеньЖурналаРегистрации.Информация, , ,
		"Запрошена запись logcfg на " + ИмяСервера + " пользователем " + ИмяПользователя());

	Возврат "Команда записи logcfg.xml на " + ИмяСервера + " поставлена в очередь. Текущий файл будет сохранён
		|рядом как logcfg.xml.bak_<дата>. Результат - в регистре «Очередь команд обслуживания».";

КонецФункции

// Текст logcfg для агента rbf (метод rbf-admin/logcfg): текст, сохранённый кнопкой
// «Применить на сервере», а если применения ещё не было - сформированный по настройкам.
//
// Параметры:
//  Сервер - Строка - имя компьютера сервера 1С без порта.
//
// Возвращаемое значение:
//  Структура - Текст, Применён (Булево - текст сохранён кнопкой «Применить на сервере»), Изменено.
Функция ТекстLogcfgДляАгента(Сервер) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	ИмяСервера = СокрЛП(Сервер);
	Запись = РегистрыСведений.рбфНастройкиТЖ.СоздатьМенеджерЗаписи();
	Запись.Сервер1С = ИмяСервера;
	Запись.ИмяБазы1С = "";
	Запись.Прочитать();
	Если Запись.Выбран() И ЗначениеЗаполнено(Запись.ТекстLogcfg) Тогда
		Возврат Новый Структура("Текст,Применён,Изменено", Запись.ТекстLogcfg, Истина, Запись.Изменено);
	КонецЕсли;
	Возврат Новый Структура("Текст,Применён,Изменено", СформироватьLogcfg(ИмяСервера), Ложь, Дата(1, 1, 1));

КонецФункции

// Ключ записи НастройкиПравилРеестра с настройками агента мониторинга сервера.
//
// Параметры:
//  Сервер - Строка - имя сервера из agent.json агента (например, S2019).
//
// Возвращаемое значение:
//  Строка - "Агент." + имя сервера.
Функция КлючНастроекАгента(Сервер) Экспорт

	Возврат "Агент." + СокрЛП(Сервер);

КонецФункции

// Настройки агента мониторинга по умолчанию (форма «Настройки мониторинга», метод agent-config).
//
// Возвращаемое значение:
//  Структура:
//   * КаталогТЖ - Строка - каталог ТЖ; пусто - КаталогТЖАгентаПоУмолчанию.
//   * Диски - Массив из Строка - диски для замеров.
//   * Процессы - Массив из Строка - процессы для замеров.
//   * SQL - Массив из Структура - экземпляры SQL: name, instance.
//   * ПропускатьСобытия - Массив из Строка - события ТЖ, которые агент не отправляет.
//   * ТопНаСобытие - Число - сколько самых долгих событий каждого вида отправлять.
//   * ОтправлятьСобытия - Булево - отправлять отдельные события ТЖ (tj-events).
//   * ПакетСобытий - Число - событий в одном вызове tj-events.
//   * МаксДлинаТекста - Число - предельная длина текста события.
Функция НастройкиАгентаПоУмолчанию() Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("КаталогТЖ", "");
	Настройки.Вставить("Диски", Новый Массив);
	Настройки.Вставить("Процессы", Новый Массив);
	Настройки.Вставить("SQL", Новый Массив);
	Настройки.Вставить("ПропускатьСобытия", СтрРазделить("EXCPCNTX", ","));
	Настройки.Вставить("ТопНаСобытие", 100);
	Настройки.Вставить("ОтправлятьСобытия", Истина);
	Настройки.Вставить("ПакетСобытий", 2000);
	Настройки.Вставить("МаксДлинаТекста", 20000);
	Возврат Настройки;

КонецФункции

// Разбирает JSON настроек агента из НастройкиПравилРеестра; отсутствующие ключи - по умолчанию.
//
// Параметры:
//  Текст - Строка - JSON, записанный СтрокаНастроекАгента.
//
// Возвращаемое значение:
//  Структура - см. НастройкиАгентаПоУмолчанию.
Функция РазобратьНастройкиАгента(Текст) Экспорт

	Настройки = НастройкиАгентаПоУмолчанию();
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Настройки;
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		ЗаписьЖурналаРегистрации("Мониторинг.НастройкиАгента", УровеньЖурналаРегистрации.Ошибка, , ,
			"Не разобраны настройки агента: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Настройки;
	КонецПопытки;
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Настройки;
	КонецЕсли;

	Соответствие = СоответствиеКлючейАгента();
	Для Каждого КЗ Из Соответствие Цикл
		Значение = Данные.Получить(КЗ.Значение);
		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если КЗ.Ключ = "SQL" Тогда
			Экземпляры = Новый Массив;
			Если ТипЗнч(Значение) = Тип("Массив") Тогда
				Для Каждого Элемент Из Значение Цикл
					Если ТипЗнч(Элемент) = Тип("Соответствие") Тогда
						Экземпляры.Добавить(Новый Структура("name,instance",
							Строка(Элемент.Получить("name")), Строка(Элемент.Получить("instance"))));
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			Настройки.SQL = Экземпляры;
		ИначеЕсли ТипЗнч(Настройки[КЗ.Ключ]) = Тип("Массив") Тогда
			Настройки[КЗ.Ключ] = ?(ТипЗнч(Значение) = Тип("Массив"), Значение, Новый Массив);
		ИначеЕсли ТипЗнч(Настройки[КЗ.Ключ]) = ТипЗнч(Значение) Тогда
			Настройки[КЗ.Ключ] = Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Настройки;

КонецФункции

// Компактный JSON настроек агента для НастройкиПравилРеестра (Значение - строка до 500 символов):
// значения, совпадающие с умолчаниями, не пишутся.
//
// Параметры:
//  Настройки - Структура - см. НастройкиАгентаПоУмолчанию.
//
// Возвращаемое значение:
//  Строка - JSON без форматирования.
Функция СтрокаНастроекАгента(Настройки) Экспорт

	ПоУмолчанию = НастройкиАгентаПоУмолчанию();
	Данные = Новый Структура;
	Для Каждого КЗ Из СоответствиеКлючейАгента() Цикл
		Значение = Настройки[КЗ.Ключ];
		Если ТипЗнч(Значение) = Тип("Массив") Тогда
			Если КЗ.Ключ <> "SQL" И СтрСоединить(Значение, ",") = СтрСоединить(ПоУмолчанию[КЗ.Ключ], ",")
				ИЛИ Значение.Количество() = 0 И ПоУмолчанию[КЗ.Ключ].Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
		ИначеЕсли Значение = ПоУмолчанию[КЗ.Ключ] Тогда
			Продолжить;
		КонецЕсли;
		Данные.Вставить(КЗ.Значение, Значение);
	КонецЦикла;

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();

КонецФункции

// Каталог ТЖ агента по умолчанию: КаталогЛогов строки сервера рбфНастройкиТЖ,
// иначе настройка КаталогЛоговТЖ (как в СформироватьLogcfg).
//
// Параметры:
//  Сервер - Строка - имя сервера без порта.
//
// Возвращаемое значение:
//  Строка - каталог.
Функция КаталогТЖАгентаПоУмолчанию(Сервер) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Запись = РегистрыСведений.рбфНастройкиТЖ.СоздатьМенеджерЗаписи();
	Запись.Сервер1С = СокрЛП(Сервер);
	Запись.ИмяБазы1С = "";
	Запись.Прочитать();
	Если Запись.Выбран() И ЗначениеЗаполнено(Запись.КаталогЛогов) Тогда
		Возврат СокрЛП(Запись.КаталогЛогов);
	КонецЕсли;
	Возврат Настройка("КаталогЛоговТЖ", "D:\logs_1c\rbf");

КонецФункции

// Конфигурация агента мониторинга для метода rbf-admin/agent-config (docs/tj-events-schema.md).
//
// Параметры:
//  Сервер - Строка - имя сервера из agent.json.
//
// Возвращаемое значение:
//  Структура - server, techlogDir и, если настройки сервера записаны, disks, processes, sql,
//              skipEvents, topPerEvent, sendEvents, eventsBatch, maxText.
Функция КонфигурацияАгента(Сервер) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	ИмяСервера = СокрЛП(Сервер);
	Текст = Настройка(КлючНастроекАгента(ИмяСервера), "");
	Настройки = РазобратьНастройкиАгента(Строка(Текст));
	КаталогТЖ = ?(ЗначениеЗаполнено(Настройки.КаталогТЖ), Настройки.КаталогТЖ, КаталогТЖАгентаПоУмолчанию(ИмяСервера));

	Результат = Новый Структура("server,techlogDir", ИмяСервера, КаталогТЖ);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.Вставить("disks", Настройки.Диски);
	Результат.Вставить("processes", Настройки.Процессы);
	Результат.Вставить("sql", Настройки.SQL);
	Результат.Вставить("skipEvents", Настройки.ПропускатьСобытия);
	Результат.Вставить("topPerEvent", Настройки.ТопНаСобытие);
	Результат.Вставить("sendEvents", Настройки.ОтправлятьСобытия);
	Результат.Вставить("eventsBatch", Настройки.ПакетСобытий);
	Результат.Вставить("maxText", Настройки.МаксДлинаТекста);
	Возврат Результат;

КонецФункции

// Запускает регламентное задание расширения сразу фоновым заданием (кнопка формы, метод run-job).
//
// Параметры:
//  ИмяЗадания - Строка - имя метаданных регламентного задания.
//
// Возвращаемое значение:
//  ФоновоеЗадание - запущенное задание.
Функция ЗапуститьРегламентноеЗаданиеСейчас(ИмяЗадания) Экспорт

	МетаданныеЗадания = Метаданные.РегламентныеЗадания.Найти(СокрЛП(Строка(ИмяЗадания)));
	Если МетаданныеЗадания = Неопределено Тогда
		ВызватьИсключение "нет регламентного задания «" + ИмяЗадания + "»";
	КонецЕсли;

	ИмяМетода = СтрЗаменить(СтрЗаменить(МетаданныеЗадания.ИмяМетода, "CommonModule.", ""), "ОбщийМодуль.", "");
	Части = СтрРазделить(ИмяМетода, ".", Ложь);
	Если Части.Количество() <> 2 Тогда
		ВызватьИсключение "не разобрано имя метода задания: " + МетаданныеЗадания.ИмяМетода;
	КонецЕсли;
	Если Метаданные.ОбщиеМодули.Найти(Части[0]) = Неопределено Тогда
		ВызватьИсключение "нет общего модуля «" + Части[0] + "»";
	КонецЕсли;

	Возврат ФоновыеЗадания.Выполнить(ИмяМетода, Новый Массив, "api-" + Строка(Новый УникальныйИдентификатор),
		"Вручную: " + МетаданныеЗадания.Имя);

КонецФункции

// Исполнитель команды ЗаписатьLogcfg: бэкап текущего logcfg.xml (logcfg.xml.bak_<дата>)
// и запись текста из строки сервера рбфНастройкиТЖ. Путь - шаблон из настройки ПутьLogcfg,
// %1 - имя сервера; по умолчанию администраторская шара \\<сервер>\c$.
//
// Параметры:
//  Сервер - Строка - имя компьютера сервера 1С без порта.
//
// Возвращаемое значение:
//  Строка - итог выполнения.
Функция ЗаписатьLogcfgНаСервер(Сервер)

	ИмяСервера = СокрЛП(Сервер);
	Запись = РегистрыСведений.рбфНастройкиТЖ.СоздатьМенеджерЗаписи();
	Запись.Сервер1С = ИмяСервера;
	Запись.ИмяБазы1С = "";
	Запись.Прочитать();
	Если НЕ Запись.Выбран() ИЛИ НЕ ЗначениеЗаполнено(Запись.ТекстLogcfg) Тогда
		Возврат "ОШИБКА: нет текста logcfg для " + ИмяСервера + ", нажмите «Применить на сервере» в форме «Настройка ТЖ»";
	КонецЕсли;

	Путь = СтрШаблон(Настройка("ПутьLogcfg", "\\%1\c$\Program Files\1cv8\conf\logcfg.xml"), ИмяСервера);
	Бэкап = "";
	ФайлНастроек = Новый Файл(Путь);
	Если ФайлНастроек.Существует() Тогда
		Бэкап = Путь + ".bak_" + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd_HHmmss");
		КопироватьФайл(Путь, Бэкап);
	КонецЕсли;
	// logcfg перечитывает каждый запускаемый процесс платформы (rac мониторинга - несколько раз в минуту):
	// запись, совпавшая с чтением, падает с «Ошибка совместного доступа» (23.10.2026) - до 10 попыток
	Попыток = 0;
	Пока Истина Цикл
		Попытка
			ЗаписьФайла = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
			ЗаписьФайла.Записать(Запись.ТекстLogcfg);
			ЗаписьФайла.Закрыть();
			Прервать;
		Исключение
			Попыток = Попыток + 1;
			Если Попыток >= 10 Тогда
				ВызватьИсключение;
			КонецЕсли;
			// пауза 300 мс: в серверном коде нет штатного ожидания
			Граница = ТекущаяУниверсальнаяДатаВМиллисекундах() + 300;
			Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Граница Цикл
			КонецЦикла;
		КонецПопытки;
	КонецЦикла;

	Возврат "записан " + Путь + ?(ЗначениеЗаполнено(Бэкап), ", бэкап " + Бэкап, ", прежнего файла не было");

КонецФункции

// Условия одного события для <log> logcfg: пары (вид, свойство, значение) подряд.
//
// Параметры:
//  Вид1, Свойство1, Значение1 - Строка - первое условие (eq, ne, like, ge ...).
//  Вид2, Свойство2, Значение2 - Строка - второе условие, необязательное.
//
// Возвращаемое значение:
//  Массив из Структура - Вид, Свойство, Значение.
Функция УсловияСобытияТЖ(Вид1, Свойство1, Значение1, Вид2 = "", Свойство2 = "", Значение2 = "")

	Условия = Новый Массив;
	Условия.Добавить(Новый Структура("Вид,Свойство,Значение", Вид1, Свойство1, Значение1));
	Если ЗначениеЗаполнено(Вид2) Тогда
		Условия.Добавить(Новый Структура("Вид,Свойство,Значение", Вид2, Свойство2, Значение2));
	КонецЕсли;
	Возврат Условия;

КонецФункции

// Пишет элемент <log> logcfg: события с фильтром по базе (p:processName) и перечень свойств.
//
// Параметры:
//  Запись - ЗаписьXML - запись logcfg.
//  Каталог - Строка - каталог лога.
//  Глубина - Строка - history, часы.
//  База - Строка - имя информационной базы в кластере; пустая - без фильтра по базе.
//  События - Массив из Массив - условия каждого события, см. УсловияСобытияТЖ.
//  Свойства - Строка - имена свойств через запятую.
Процедура ЗаписатьЛогТЖ(Запись, Каталог, Глубина, База, События, Свойства)

	Запись.ЗаписатьНачалоЭлемента("log");
	Запись.ЗаписатьАтрибут("location", Каталог);
	Запись.ЗаписатьАтрибут("history", Глубина);
	// служебные пользователи, чья работа не нужна в ТЖ: агент мониторинга пишет события ТЖ в base_list,
	// и каждая его запись давала TLOCK и транзакцию - петля (21.10.2026: 31 тыс. TLOCK за 5 минут)
	Исключить = СтрРазделить(Настройка("ТЖИсключитьПользователей", "РЗ_АгентМониторинга"), ",", Ложь);
	Для Индекс = 0 По Исключить.ВГраница() Цикл
		Исключить[Индекс] = СокрЛП(Исключить[Индекс]);
	КонецЦикла;
	// регламентные задания сбора ТЖ пишут в base_list и дают ту же петлю (21.10.2026: 69 тыс. TLOCK
	// за 25 минут от РЗ_СборТЖ), поэтому их TLOCK исключаются всегда, независимо от настройки.
	// Остальные их события (TTIMEOUT, TDEADLOCK, запросы) остаются: без них не найти виновника,
	// если ждут именно их.
	ИсключитьTLOCK = Новый Массив;
	Для Каждого Имя Из Исключить Цикл
		ИсключитьTLOCK.Добавить(Имя);
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("РЗ_СборТЖ,РЗ_АгрегатыТЖ,РЗ_ОчисткаВыполненийТЖ", ",") Цикл
		Если ИсключитьTLOCK.Найти(Имя) = Неопределено Тогда
			ИсключитьTLOCK.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Условия Из События Цикл
		Запись.ЗаписатьНачалоЭлемента("event");
		// петлю дают и TLOCK, и DML без порога из SQL_Locks (21.10.2026: 25 тыс. INSERT/UPDATE РЗ_СборТЖ
		// за 20 минут) - для них сборщик исключается; долгие запросы и ожидания остаются
		ЭтоTLOCK = Ложь;
		ЭтоDBMSSQL = Ложь;
		ЕстьОтборSql = Ложь;
		Для Каждого Условие Из Условия Цикл
			ЗаписатьУсловиеТЖ(Запись, Условие.Вид, Условие.Свойство, Условие.Значение);
			Если Условие.Вид = "eq" И Условие.Свойство = "name" И ВРег(Условие.Значение) = "TLOCK" Тогда
				ЭтоTLOCK = Истина;
			ИначеЕсли Условие.Вид = "eq" И Условие.Свойство = "name" И ВРег(Условие.Значение) = "DBMSSQL" Тогда
				ЭтоDBMSSQL = Истина;
			ИначеЕсли Условие.Вид = "like" И Условие.Свойство = "Sql" Тогда
				ЕстьОтборSql = Истина;
			КонецЕсли;
		КонецЦикла;
		Если ЗначениеЗаполнено(База) Тогда
			ЗаписатьУсловиеТЖ(Запись, "eq", "p:processName", База);
		КонецЕсли;
		Для Каждого Имя Из ?(ЭтоTLOCK ИЛИ ЭтоDBMSSQL И ЕстьОтборSql, ИсключитьTLOCK, Исключить) Цикл
			ЗаписатьУсловиеТЖ(Запись, "ne", "Usr", Имя);
		КонецЦикла;
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить(Свойства, ",", Ложь) Цикл
		Запись.ЗаписатьНачалоЭлемента("property");
		Запись.ЗаписатьАтрибут("name", Имя);
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента();

КонецПроцедуры

Процедура ЗаписатьУсловиеТЖ(Запись, Вид, Свойство, Значение)

	Запись.ЗаписатьНачалоЭлемента(Вид);
	Запись.ЗаписатьАтрибут("property", Свойство);
	Запись.ЗаписатьАтрибут("value", Значение);
	Запись.ЗаписатьКонецЭлемента();

КонецПроцедуры

// Пороговые тревоги по последним замерам сервера: значение за порогом во всех
// последних N замерах подряд. Одна и та же тревога повторяется не чаще раза в час.
// Пороги - в НастройкиПравилРеестра. Счётчик правила, начинающийся с "*", сравнивается
// по окончанию имени (SQL-счётчики называются по экземпляру).
//
// Параметры:
//  Сервер - Строка - имя сервера.
//  Время - Дата - момент последнего замера.
Процедура ПроверитьТревогиСчетчиков(Сервер, Время)

	Правила = Новый Массив;
	Правила.Добавить(Новый Структура("Счетчик,Больше,Порог,Название", "CPU, %", Истина,
		Настройка("ПорогCPUПроцентов", 90), "загрузка CPU"));
	Правила.Добавить(Новый Структура("Счетчик,Больше,Порог,Название", "Память свободно, МБ", Ложь,
		Настройка("ПорогСвободнойПамятиМБ", 2048), "мало свободной памяти"));
	Правила.Добавить(Новый Структура("Счетчик,Больше,Порог,Название", "*: Page life expectancy, с", Ложь,
		Настройка("ПорогPLEСекунд", 300), "SQL вытесняет кэш (PLE)"));
	Правила.Добавить(Новый Структура("Счетчик,Больше,Порог,Название", "*: Заблокированных процессов", Истина,
		Настройка("ПорогЗаблокированныхПроцессов", 5), "блокировки в SQL"));
	Подряд = Настройка("ЗамеровДляТревогиПодряд", 3);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1000
	|	С.Время КАК Время,
	|	С.Счетчик КАК Счетчик,
	|	С.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.рбфСчетчики КАК С
	|ГДЕ
	|	С.Сервер = &Сервер
	|	И С.Время > &С
	|	И С.Время <= &По
	|УПОРЯДОЧИТЬ ПО
	|	Время УБЫВ";
	Запрос.УстановитьПараметр("Сервер", Сервер);
	Запрос.УстановитьПараметр("С", Время - Подряд * 360);
	Запрос.УстановитьПараметр("По", Время);
	Замеры = Запрос.Выполнить().Выгрузить();

	Для Каждого Правило Из Правила Цикл
		ПоСчетчикам = Новый Соответствие; // счётчик -> Массив значений, от новых к старым
		Для Каждого Замер Из Замеры Цикл
			Подходит = ?(СтрНачинаетсяС(Правило.Счетчик, "*"),
				СтрЗаканчиваетсяНа(Замер.Счетчик, Сред(Правило.Счетчик, 2)), Замер.Счетчик = Правило.Счетчик);
			Если НЕ Подходит Тогда
				Продолжить;
			КонецЕсли;
			Значения = ПоСчетчикам.Получить(Замер.Счетчик);
			Если Значения = Неопределено Тогда
				Значения = Новый Массив;
				ПоСчетчикам.Вставить(Замер.Счетчик, Значения);
			КонецЕсли;
			Значения.Добавить(Замер.Значение);
		КонецЦикла;

		Для Каждого КЗ Из ПоСчетчикам Цикл
			Если КЗ.Значение.Количество() < Подряд Тогда
				Продолжить;
			КонецЕсли;
			ВсеЗаПорогом = Истина;
			Для Индекс = 0 По Подряд - 1 Цикл
				Значение = КЗ.Значение[Индекс];
				Если (Правило.Больше И Значение <= Правило.Порог) ИЛИ (НЕ Правило.Больше И Значение >= Правило.Порог) Тогда
					ВсеЗаПорогом = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ ВсеЗаПорогом Тогда
				Продолжить;
			КонецЕсли;

			КлючТревоги = Лев("Тревога " + Сервер + " " + КЗ.Ключ, 100);
			// @skip-check query-in-loop - тревоги срабатывают редко, по одной на счётчик
			Прошлая = ДатаИзISO(Строка(Настройка(КлючТревоги, "")));
			Если ЗначениеЗаполнено(Прошлая) И ТекущаяДатаСеанса() - Прошлая < 3600 Тогда
				Продолжить;
			КонецЕсли;
			ЗаписатьНастройку(КлючТревоги, Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
			ОтправитьТелеграм("Сервер " + Сервер + ": " + Правило.Название + Символы.ПС + КЗ.Ключ + " = "
				+ Формат(КЗ.Значение[0], "ЧДЦ=1; ЧН=0; ЧГ=0") + " (порог " + Правило.Порог + ", " + Подряд + " замера подряд)");
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Суточный шаг мониторинга: очистка старых замеров и событий ТЖ, в сводку - только
// заметное за сутки: пики CPU и PLE за порогом, взаимоблокировки и таймауты, самые
// долгие серверные вызовы, серверы, от которых больше часа нет замеров.
//
// Параметры:
//  Сводка - см. НоваяСводка.
Процедура ИтогиМониторинга(Сводка)

	УстановитьПривилегированныйРежим(Истина);
	Сейчас = ТекущаяДатаСеанса();
	ОчиститьСтарыеЗамеры("рбфСчетчики", "Время", "Сервер", Сейчас - Настройка("ХранитьСчетчикиДней", 90) * 86400);
	ОчиститьСтарыеЗамеры("рбфСобытияТЖ", "Час", "Сервер", Сейчас - Настройка("ХранитьСобытияТЖДней", 60) * 86400);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	С.Сервер КАК Сервер,
	|	МАКСИМУМ(С.Время) КАК Последний,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА С.Счетчик = ""CPU, %""
	|				ТОГДА С.Значение
	|		КОНЕЦ) КАК CPUМакс,
	|	СРЕДНЕЕ(ВЫБОР
	|			КОГДА С.Счетчик = ""CPU, %""
	|				ТОГДА С.Значение
	|		КОНЕЦ) КАК CPUСреднее,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА С.Счетчик = ""Память свободно, МБ""
	|				ТОГДА С.Значение
	|		КОНЕЦ) КАК ПамятьМин,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА С.Счетчик ПОДОБНО ""%: Page life expectancy, с""
	|				ТОГДА С.Значение
	|		КОНЕЦ) КАК PLEМин
	|ИЗ
	|	РегистрСведений.рбфСчетчики КАК С
	|ГДЕ
	|	С.Время > &Сутки
	|
	|СГРУППИРОВАТЬ ПО
	|	С.Сервер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Сервер КАК Сервер,
	|	Т.Событие КАК Событие,
	|	СУММА(Т.Количество) КАК Количество
	|ИЗ
	|	РегистрСведений.рбфСобытияТЖ КАК Т
	|ГДЕ
	|	Т.Час > &Сутки
	|	И Т.Событие В (""TDEADLOCK"", ""TTIMEOUT"")
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.Сервер,
	|	Т.Событие
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 3
	|	Т.Сервер КАК Сервер,
	|	Т.База КАК База,
	|	Т.Ключ КАК Ключ,
	|	СУММА(Т.Количество) КАК Количество,
	|	МАКСИМУМ(Т.ДлительностьМаксМс) КАК МаксМс
	|ИЗ
	|	РегистрСведений.рбфСобытияТЖ КАК Т
	|ГДЕ
	|	Т.Час > &Сутки
	|	И Т.Событие = ""CALL""
	|	И Т.ДлительностьМаксМс >= &ДолгийВызовМс
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.Сервер,
	|	Т.База,
	|	Т.Ключ
	|
	|УПОРЯДОЧИТЬ ПО
	|	МаксМс УБЫВ";
	Запрос.УстановитьПараметр("Сутки", Сейчас - 86400);
	Запрос.УстановитьПараметр("ДолгийВызовМс", Настройка("ДолгийВызовДляСводкиСекунд", 60) * 1000);
	Результаты = Запрос.ВыполнитьПакет();

	ПорогCPU = Настройка("ПорогCPUПроцентов", 90);
	ПорогPLE = Настройка("ПорогPLEСекунд", 300);
	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Сейчас - Выборка.Последний > 3600 Тогда
			ДобавитьВСводку(Сводка, "Нагрузка", "<b>" + Выборка.Сервер + "</b>: агент не присылает замеры с "
				+ Формат(Выборка.Последний, "ДФ='dd.MM HH:mm'"));
		КонецЕсли;
		Если Выборка.CPUМакс <> NULL И Выборка.CPUМакс >= ПорогCPU Тогда
			ДобавитьВСводку(Сводка, "Нагрузка", "<b>" + Выборка.Сервер + "</b>: CPU до " + Формат(Выборка.CPUМакс, "ЧДЦ=0")
				+ "% (в среднем " + Формат(Выборка.CPUСреднее, "ЧДЦ=0; ЧН=0") + "%), свободной памяти минимум "
				+ Формат(Выборка.ПамятьМин, "ЧДЦ=0; ЧГ=0") + " МБ");
		КонецЕсли;
		Если Выборка.PLEМин <> NULL И Выборка.PLEМин < ПорогPLE Тогда
			ДобавитьВСводку(Сводка, "Нагрузка", "<b>" + Выборка.Сервер + "</b>: SQL Page life expectancy падала до "
				+ Формат(Выборка.PLEМин, "ЧДЦ=0; ЧН=0; ЧГ=0") + " с");
		КонецЕсли;
	КонецЦикла;

	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьВСводку(Сводка, "Нагрузка", "<b>" + Выборка.Сервер + "</b>: "
			+ ?(Выборка.Событие = "TDEADLOCK", "взаимоблокировок", "таймаутов блокировок") + " " + Выборка.Количество);
	КонецЦикла;

	Выборка = Результаты[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьВСводку(Сводка, "Нагрузка", "<b>" + Выборка.База + "</b> (" + Выборка.Сервер + "): серверный вызов до "
			+ Формат(Выборка.МаксМс / 1000, "ЧДЦ=0; ЧГ=0") + " с, раз " + Выборка.Количество + ": " + Лев(Выборка.Ключ, 150));
	КонецЦикла;

КонецПроцедуры

// Удаляет записи регистра мониторинга старше границы - наборами по измерениям времени и сервера.
//
// Параметры:
//  ИмяРегистра - Строка - рбфСчетчики или рбфСобытияТЖ.
//  ПолеВремени - Строка - измерение с датой.
//  ПолеСервера - Строка - измерение с сервером.
//  Граница - Дата - удаляется всё раньше неё.
Процедура ОчиститьСтарыеЗамеры(ИмяРегистра, ПолеВремени, ПолеСервера, Граница)

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 5000
	|	Р.%2 КАК Время,
	|	Р.%3 КАК Сервер
	|ИЗ
	|	РегистрСведений.%1 КАК Р
	|ГДЕ
	|	Р.%2 < &Граница", ИмяРегистра, ПолеВремени, ПолеСервера);
	Запрос.УстановитьПараметр("Граница", Граница);
	Выборка = Запрос.Выполнить().Выбрать();
	Менеджер = РегистрыСведений[ИмяРегистра];
	Пока Выборка.Следующий() Цикл
		Набор = Менеджер.СоздатьНаборЗаписей();
		Набор.Отбор[ПолеВремени].Установить(Выборка.Время);
		Набор.Отбор[ПолеСервера].Установить(Выборка.Сервер);
		// @skip-check query-in-loop - удаление набора за один момент и сервер
		Набор.Записать(Истина);
	КонецЦикла;

КонецПроцедуры

Функция СледующийПолныйБэкап(СерверSQL)

	Ответ = ВыполнитьКоманду(КомандаSQL(СерверSQL) + " -h -1 -W -Q ""SET NOCOUNT ON; "
		+ "SELECT TOP 1 CAST(s.next_run_date AS varchar(8)) FROM msdb.dbo.sysjobs j "
		+ "JOIN msdb.dbo.sysjobschedules s ON s.job_id = j.job_id "
		+ "WHERE j.name = 'BackUP_FULL' AND j.enabled = 1 AND s.next_run_date > 0 "
		+ "ORDER BY s.next_run_date, s.next_run_time""");
	Если Ответ.КодВозврата <> 0 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Для Каждого СтрокаОтвета Из СтрРазделить(Ответ.Вывод, Символы.ПС, Ложь) Цикл
		Цифры = СокрЛП(СтрокаОтвета);
		Если СтрДлина(Цифры) = 8 Тогда
			Возврат ДатаИзSQL(Лев(Цифры, 4) + "-" + Сред(Цифры, 5, 2) + "-" + Прав(Цифры, 2) + " 00:00:00");
		КонецЕсли;
	КонецЦикла;
	Возврат Дата(1, 1, 1);

КонецФункции
// Версия SQL Server экземпляра для реестра.
//
// Параметры:
//  СерверSQL - Строка - имя экземпляра SQL Server.
//
// Возвращаемое значение:
//  Строка - например "MS SQL 2019 CU32 (15.0.4490.9)"; пустая, если не прочитана.
Функция ВерсияSQLServer(СерверSQL)

	Ответ = ВыполнитьКоманду(КомандаSQL(СерверSQL) + " -h -1 -W -Q ""SET NOCOUNT ON; SELECT "
		+ "CAST(SERVERPROPERTY('ProductVersion') AS varchar(30)) + '|' "
		+ "+ ISNULL(CAST(SERVERPROPERTY('ProductUpdateLevel') AS varchar(30)), '') + '|' "
		+ "+ CAST(SERVERPROPERTY('ProductLevel') AS varchar(30))""");
	Если Ответ.КодВозврата <> 0 Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого СтрокаОтвета Из СтрРазделить(Ответ.Вывод, Символы.ПС, Ложь) Цикл
		Части = СтрРазделить(СокрЛП(СтрокаОтвета), "|", Истина);
		Если Части.Количество() <> 3 Тогда
			Продолжить;
		КонецЕсли;
		Годы = Новый Соответствие;
		Годы.Вставить("11", "2012");
		Годы.Вставить("12", "2014");
		Годы.Вставить("13", "2016");
		Годы.Вставить("14", "2017");
		Годы.Вставить("15", "2019");
		Годы.Вставить("16", "2022");
		Годы.Вставить("17", "2025");
		Мажорная = СтрРазделить(Части[0], ".")[0];
		Год = Годы.Получить(Мажорная);
		Уровень = ?(ЗначениеЗаполнено(Части[1]), Части[1], Части[2]);
		Возврат "MS SQL " + ?(Год = Неопределено, Мажорная, Год) + " " + Уровень + " (" + Части[0] + ")";
	КонецЦикла;
	Возврат "";

КонецФункции
// Дата из строки sqlcmd вида "2026-08-26 14:45:35".
//
// Параметры:
//  ДатаСтрокой - Строка - дата в формате ODBC (CONVERT 120).
//
// Возвращаемое значение:
//  Дата - дата или пустая дата, если строка пустая или не разобрана.
Функция ДатаИзSQL(ДатаСтрокой)

	Цифры = СтрЗаменить(СтрЗаменить(СтрЗаменить(СокрЛП(ДатаСтрокой), "-", ""), " ", ""), ":", "");
	Если СтрДлина(Цифры) <> 14 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Попытка
		Возврат Дата(Цифры);
	Исключение
		// строка из цифр, но не дата - считаем, что даты нет
		Возврат Дата(1, 1, 1);
	КонецПопытки;

КонецФункции

// Продление срока тестовой базы на 2 месяца от сегодняшнего дня (кнопка в списке реестра).
//
// Параметры:
//  Сервер1С - СправочникСсылка.Сервер1С - сервер кластера базы.
//  ИмяБазы1С - Строка - имя информационной базы.
//
// Возвращаемое значение:
//  Строка - сообщение для пользователя.
Функция ПродлитьСрокБазы(Сервер1С, ИмяБазы1С) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Набор = НаборЗаписиРеестра(Сервер1С, ИмяБазы1С);
	Если Набор = Неопределено Тогда
		Возврат "База «" + ИмяБазы1С + "» не найдена в реестре.";
	КонецЕсли;
	Запись = Набор[0];
	Если Запись.Тип = Перечисления.ТипБазы.Архивная Тогда
		Возврат "База «" + ИмяБазы1С + "» уже в архиве, продлевать нечего.";
	КонецЕсли;

	НовыйСрок = ДобавитьМесяц(НачалоДня(ТекущаяДатаСеанса()), 2);
	Если Запись.ДатаОтключения >= НовыйСрок Тогда
		Возврат "Срок базы «" + ИмяБазы1С + "» и так до " + Формат(Запись.ДатаОтключения, "ДФ=dd.MM.yyyy") + ".";
	КонецЕсли;
	Было = Запись.ДатаОтключения;
	Запись.ДатаОтключения = НовыйСрок;
	Набор.Записать();

	ЗаписьЖурналаРегистрации("ПравилаРеестра.Продление", УровеньЖурналаРегистрации.Информация, , ,
		ИмяБазы1С + ": дата отключения " + Формат(Было, "ДФ=dd.MM.yyyy; ДП=-") + " -> "
		+ Формат(НовыйСрок, "ДФ=dd.MM.yyyy") + " (продлил " + ИмяПользователя() + ")");

	Возврат "Срок базы «" + ИмяБазы1С + "» продлён до " + Формат(НовыйСрок, "ДФ=dd.MM.yyyy") + ".";

КонецФункции

// Назначение текущего пользователя владельцем базы без владельца (кнопка в списке реестра).
//
// Параметры:
//  Сервер1С - СправочникСсылка.Сервер1С - сервер кластера базы.
//  ИмяБазы1С - Строка - имя информационной базы.
//
// Возвращаемое значение:
//  Строка - сообщение для пользователя.
Функция СтатьВладельцемБазы(Сервер1С, ИмяБазы1С) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Набор = НаборЗаписиРеестра(Сервер1С, ИмяБазы1С);
	Если Набор = Неопределено Тогда
		Возврат "База «" + ИмяБазы1С + "» не найдена в реестре.";
	КонецЕсли;
	Если ЗначениеЗаполнено(Набор[0].Владелец) Тогда
		Возврат "У базы «" + ИмяБазы1С + "» уже есть владелец: " + Строка(Набор[0].Владелец)
			+ ". Передать базу может он сам или администратор.";
	КонецЕсли;

	Владелец = ВладелецТекущегоПользователя();
	Если Владелец = Неопределено Тогда
		Возврат "Не удалось определить владельца по текущему пользователю: у пользователя не заполнено полное имя.";
	КонецЕсли;
	НазначитьВладельца(Сервер1С, ИмяБазы1С, Владелец);

	ЗаписьЖурналаРегистрации("ПравилаРеестра.Владелец", УровеньЖурналаРегистрации.Информация, , ,
		ИмяБазы1С + ": владельцем стал " + Строка(Владелец) + " (кнопка «Стать владельцем», " + ИмяПользователя() + ")");

	Возврат "Теперь вы владелец базы «" + ИмяБазы1С + "».";

КонецФункции

// Набор из одной записи реестра по серверу 1С и имени ИБ.
//
// Параметры:
//  Сервер1С - СправочникСсылка.Сервер1С - сервер кластера базы.
//  ИмяБазы1С - Строка - имя информационной базы.
//
// Возвращаемое значение:
//  РегистрСведенийНаборЗаписей.СерверыИБазы, Неопределено - прочитанный набор; Неопределено,
//   если записи нет или их несколько.
Функция НаборЗаписиРеестра(Сервер1С, ИмяБазы1С)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	РегистрСведений.СерверыИБазы КАК С
	|ГДЕ
	|	С.Сервер1С = &Сервер
	|	И С.ИмяБазы1С = &ИмяБазы1С";
	Запрос.УстановитьПараметр("Сервер", Сервер1С);
	Запрос.УстановитьПараметр("ИмяБазы1С", ИмяБазы1С);
	Таблица = Запрос.Выполнить().Выгрузить();
	Если Таблица.Количество() <> 1 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Набор = РегистрыСведений.СерверыИБазы.СоздатьНаборЗаписей();
	Для Каждого Измерение Из Метаданные.РегистрыСведений.СерверыИБазы.Измерения Цикл
		Набор.Отбор[Измерение.Имя].Установить(Таблица[0][Измерение.Имя]);
	КонецЦикла;
	Набор.Прочитать();
	Возврат ?(Набор.Количество() = 1, Набор, Неопределено);

КонецФункции

// Отмечает базу в реестре как архивную (без смены измерений записи).
//
// Параметры:
//  Сервер1С - Строка - представление сервера кластера.
//  ИмяБазы1С - Строка - имя информационной базы.
//  ФайлБэкапа - Строка - путь к бэкапу.
//  Дата - Дата - дата архивации.
Процедура ОтметитьАрхивВРеестре(Сервер1С, ИмяБазы1С, ФайлБэкапа, Дата)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	РегистрСведений.СерверыИБазы КАК С
	|ГДЕ
	|	С.ИмяБазы1С = &ИмяБазы1С";
	Запрос.УстановитьПараметр("ИмяБазы1С", ИмяБазы1С);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// представление ссылки в условии запроса сравнивать нельзя - сверяем здесь
		Если Строка(Выборка.Сервер1С) <> Строка(Сервер1С) Тогда
			Продолжить;
		КонецЕсли;
		Набор = РегистрыСведений.СерверыИБазы.СоздатьНаборЗаписей();
		Для Каждого Измерение Из Метаданные.РегистрыСведений.СерверыИБазы.Измерения Цикл
			Набор.Отбор[Измерение.Имя].Установить(Выборка[Измерение.Имя]);
		КонецЦикла;
		Набор.Прочитать();
		Для Каждого ЗаписьНабора Из Набор Цикл
			// прежний тип - для возврата базы в том же статусе (ВернутьБазу)
			Если ЗаписьНабора.Тип <> Перечисления.ТипБазы.Архивная Тогда
				ЗапомнитьТипДоАрхива(Строка(Сервер1С), ИмяБазы1С, ЗаписьНабора.Тип);
			КонецЕсли;
			ЗаписьНабора.Тип = Перечисления.ТипБазы.Архивная;
			ЗаписьНабора.ВАрхиве = Истина;
			ЗаписьНабора.ДатаАрхива = Дата;
			ЗаписьНабора.ДатаФактБэкап = Дата;
			ЗаписьНабора.ПутьБэкап = ФайлБэкапа;
			Если НЕ ЗначениеЗаполнено(ЗаписьНабора.ДатаОтключения) Тогда
				ЗаписьНабора.ДатаОтключения = Дата;
			КонецЕсли;
		КонецЦикла;
		Набор.Записать();
	КонецЦикла;

КонецПроцедуры

// Сведения о программных лицензиях 1С сервера (утилита ring license) в регистр рбфЛицензии1С.
// ПИН-код в регистр не пишется: имя лицензии «ПИН-регномер» не сохраняется.
Процедура ОбновитьЛицензии()

	Ring = Настройка("ПутьКRing", "D:\EDT\components\1c-enterprise-ring-0.20.0+4-x86_64\ring.cmd");
	JavaHome = Настройка("JavaHomeДляRing", "D:\EDT\components\axiom-jdk-full-17.0.16+12-x86_64");
	Префикс = "set JAVA_HOME=" + JavaHome + "& set JAVA_TOOL_OPTIONS=-Dstdout.encoding=UTF-8 -Dfile.encoding=UTF-8& """ + Ring + """ license ";
	Сервер = ИмяКомпьютера();
	Сейчас = ТекущаяДатаСеанса();

	Ответ = ВыполнитьКоманду(Префикс + "list --send-statistics false", "UTF-8");
	Если Ответ.КодВозврата <> 0 Тогда
		ЗаписьЖурналаРегистрации("Мониторинг.Лицензии", УровеньЖурналаРегистрации.Ошибка, , ,
			"ring license list: " + Ответ.Вывод);
		Возврат;
	КонецЕсли;

	// строки вида: 052888788348491-8101766632 (имя файла: "20230126202031.lic")
	Имена = Новый Массив;
	Для Каждого СтрокаВывода Из СтрРазделить(Ответ.Вывод, Символы.ПС, Ложь) Цикл
		Стр = СокрЛП(СтрокаВывода);
		Позиция = СтрНайти(Стр, " (");
		Если Позиция > 0 И СтрНайти(Стр, ".lic") > 0 И НЕ СтрНачинаетсяС(Стр, "Picked up") Тогда
			Имена.Добавить(Лев(Стр, Позиция - 1));
		КонецЕсли;
	КонецЦикла;

	Набор = РегистрыСведений.рбфЛицензии1С.СоздатьНаборЗаписей();
	Набор.Отбор.Сервер.Установить(Сервер);

	// прежнее состояние проверки оборудования: письмо только при смене «совпадает» -> «не совпадает»
	Прежние = Новый Соответствие;
	Набор.Прочитать();
	Для Каждого Прежняя Из Набор Цикл
		Прежние.Вставить(Прежняя.ФайлЛицензии, Прежняя.ОборудованиеСовпадает);
	КонецЦикла;
	Набор.Очистить();
	Расхождения = Новый Массив;

	Для Каждого Имя Из Имена Цикл
		Ответ = ВыполнитьКоманду(Префикс + "info --name " + Имя + " --send-statistics false", "UTF-8");
		Если Ответ.КодВозврата <> 0 Тогда
			ЗаписьЖурналаРегистрации("Мониторинг.Лицензии", УровеньЖурналаРегистрации.Предупреждение, , ,
				"ring license info: " + Ответ.Вывод);
			Продолжить;
		КонецЕсли;
		Поля = Новый Соответствие;
		Для Каждого СтрокаВывода Из СтрРазделить(Ответ.Вывод, Символы.ПС, Ложь) Цикл
			Позиция = СтрНайти(СтрокаВывода, ":");
			Если Позиция > 0 Тогда
				Поля.Вставить(СокрЛП(Лев(СтрокаВывода, Позиция - 1)), СокрЛП(Сред(СтрокаВывода, Позиция + 1)));
			КонецЕсли;
		КонецЦикла;

		Запись = Набор.Добавить();
		Запись.Сервер = Сервер;
		Запись.ФайлЛицензии = СтрЗаменить(ЗначениеПоля(Поля, "Имя файла лицензии"), """", "");
		Запись.Продукт = ЗначениеПоля(Поля, "Описание");
		Запись.ТипЛицензии = ЗначениеПоля(Поля, "Тип лицензии");
		Запись.Привязка = ЗначениеПоля(Поля, "Тип привязки лицензии");
		Запись.РегистрационныйНомер = ЗначениеПоля(Поля, "Регистрационный номер");
		Запись.КодПродукта = ЗначениеПоля(Поля, "Код продукта");
		Запись.ВладелецЛицензии = СокрЛП(ЗначениеПоля(Поля, "Фамилия") + " " + ЗначениеПоля(Поля, "Имя") + " "
			+ ЗначениеПоля(Поля, "Отчество"));
		Запись.Почта = ЗначениеПоля(Поля, "e-mail");
		Запись.Компания = ЗначениеПоля(Поля, "Компания");
		Запись.ДатаПроверки = Сейчас;
		// LicenseGenerationDate: 2022-11-16T13:28:30
		ДатаСтрокой = СтрЗаменить(СтрЗаменить(СтрЗаменить(ЗначениеПоля(Поля, "LicenseGenerationDate"), "-", ""), "T", ""), ":", "");
		Если СтрДлина(ДатаСтрокой) = 14 Тогда
			Попытка
				Запись.ДатаКомплектации = Дата(ДатаСтрокой);
			Исключение
				Запись.ДатаКомплектации = '00010101';
			КонецПопытки;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Запись.ФайлЛицензии) Тогда
			Запись.ФайлЛицензии = Прав(Имя, 10);
		КонецЕсли;

		// соответствие оборудования: код 0 - совпадает, 1 - изменены параметры компьютера, 2 - ошибка подписи
		Проверка = ВыполнитьКоманду(Префикс + "validate --name " + Имя + " --send-statistics false", "UTF-8");
		Запись.ОборудованиеСовпадает = (Проверка.КодВозврата = 0);
		Запись.РезультатПроверки = Лев(СокрЛП(СтрЗаменить(Проверка.Вывод,
			"Picked up JAVA_TOOL_OPTIONS: -Dstdout.encoding=UTF-8 -Dfile.encoding=UTF-8", "")), 1000);
		Если НЕ Запись.ОборудованиеСовпадает И Прежние.Получить(Запись.ФайлЛицензии) <> Ложь Тогда
			Расхождения.Добавить("<b>" + Запись.Продукт + "</b> (" + Запись.РегистрационныйНомер + ", файл "
				+ Запись.ФайлЛицензии + "):<br>" + СтрЗаменить(Запись.РезультатПроверки, Символы.ПС, "<br>"));
		КонецЕсли;
	КонецЦикла;

	Набор.Записать();

	Если Расхождения.Количество() > 0 Тогда
		ОтправитьПисьмо(Неопределено, "Реестр баз: оборудование сервера " + Сервер + " не совпадает с лицензией 1С",
			"<p>Проверка ring license validate показала, что оборудование сервера " + Сервер
			+ " отличается от зафиксированного при активации лицензии. Лицензия может перестать работать.</p><p>"
			+ СтрСоединить(Расхождения, "</p><p>") + "</p>");
		ЗаписьЖурналаРегистрации("Мониторинг.Лицензии", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Оборудование не совпадает: " + СтрСоединить(Расхождения, "; "));
	КонецЕсли;
	ЗаписьЖурналаРегистрации("Мониторинг.Лицензии", УровеньЖурналаРегистрации.Информация, , ,
		"Сервер " + Сервер + ": лицензий " + Набор.Количество());

КонецПроцедуры

// Лицензии и ключи HASP других серверов: их сборщики (задачи Windows от SYSTEM) пишут файлы
// <ИМЯ КОМПЬЮТЕРА>.tsv в КаталогФайловЛицензий. Первая строка: #generated, время, компьютер, срок годности в часах.
// Данные старше срока считаются сбоем сборщика. Письмо - при переходе строки в «не в порядке».
Процедура ОбновитьЛицензииИзФайлов()

	Каталог = Настройка("КаталогФайловЛицензий", "D:\1cv8\lic_drop");
	Сейчас = ТекущаяДатаСеанса();

	Для Каждого Файл Из НайтиФайлы(Каталог, "*.tsv", Ложь) Цикл

		Попытка
			Чтение = Новый ЧтениеТекста(Файл.ПолноеИмя, КодировкаТекста.UTF8);
			Текст = Чтение.Прочитать();
			Чтение.Закрыть();
		Исключение
			ЗаписьЖурналаРегистрации("Мониторинг.Лицензии", УровеньЖурналаРегистрации.Ошибка, , ,
				"Не прочитан " + Файл.ПолноеИмя + ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Продолжить;
		КонецПопытки;

		Строки = СтрРазделить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, Ложь);
		Если Строки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Заголовок = СтрРазделить(Строки[0], Символы.Таб, Истина);
		Если Заголовок.Количество() < 3 ИЛИ Заголовок[0] <> "#generated" Тогда
			Продолжить;
		КонецЕсли;
		Сервер = СокрЛП(Заголовок[2]);
		Сформирован = ДатаИзISO(Заголовок[1]);
		СрокЧасов = 26;
		Если Заголовок.Количество() > 3 И ЗначениеЗаполнено(Заголовок[3]) Тогда
			СрокЧасов = Число(Заголовок[3]);
		КонецЕсли;
		Устарел = (Сейчас - Сформирован) > СрокЧасов * 3600;

		Набор = РегистрыСведений.рбфЛицензии1С.СоздатьНаборЗаписей();
		Набор.Отбор.Сервер.Установить(Сервер);
		Набор.Прочитать();
		Прежние = Новый Соответствие;
		Для Каждого Прежняя Из Набор Цикл
			Прежние.Вставить(Прежняя.ФайлЛицензии, Прежняя.ОборудованиеСовпадает);
		КонецЦикла;
		Набор.Очистить();
		Расхождения = Новый Массив;

		Для Индекс = 1 По Строки.Количество() - 1 Цикл
			Поля = СтрРазделить(Строки[Индекс], Символы.Таб, Истина);
			Если Поля.Количество() < 13 Тогда
				Продолжить;
			КонецЕсли;
			Запись = Набор.Добавить();
			Запись.Сервер = Сервер;
			Запись.ФайлЛицензии = Поля[1];
			Запись.Продукт = Поля[2];
			Запись.ТипЛицензии = Поля[3];
			Запись.Привязка = Поля[4];
			Запись.РегистрационныйНомер = Поля[5];
			Запись.КодПродукта = Поля[6];
			Запись.ДатаКомплектации = ДатаИзISO(Поля[7]);
			Запись.ВладелецЛицензии = Поля[8];
			Запись.Почта = Поля[9];
			Запись.Компания = Поля[10];
			Запись.ДатаПроверки = Сформирован;
			Запись.ОборудованиеСовпадает = (СокрЛП(Поля[11]) = "0") И НЕ Устарел;
			Запись.РезультатПроверки = Лев(?(Устарел, "Данные не обновлялись с " + Формат(Сформирован, "ДФ='dd.MM.yyyy HH:mm'")
				+ " (срок " + СрокЧасов + " ч): сборщик на сервере не работает. ", "") + Поля[12], 1000);
			Если НЕ Запись.ОборудованиеСовпадает И Прежние.Получить(Запись.ФайлЛицензии) <> Ложь Тогда
				Расхождения.Добавить("<b>" + Запись.ФайлЛицензии + "</b> " + Запись.Продукт + ": " + Запись.РезультатПроверки);
			КонецЕсли;
		КонецЦикла;

		Набор.Записать();

		Если Расхождения.Количество() > 0 Тогда
			// @skip-check query-in-loop - правило обходит десятки баз и по каждой выполняет отдельное действие
			ОтправитьПисьмо(Неопределено, "Реестр баз: лицензии/ключи 1С на сервере " + Сервер + " требуют внимания",
				"<p>Проверка лицензий и ключей HASP на сервере " + Сервер + ":</p><p>"
				+ СтрСоединить(Расхождения, "</p><p>") + "</p>");
			ЗаписьЖурналаРегистрации("Мониторинг.Лицензии", УровеньЖурналаРегистрации.Предупреждение, , ,
				Сервер + ": " + СтрСоединить(Расхождения, "; "));
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Дата из строки ISO 8601 вида 2026-09-24T14:50:19.
//
// Параметры:
//  ДатаСтрокой - Строка - дата в формате ISO.
//
// Возвращаемое значение:
//  Дата - дата или пустая дата, если строка не разобрана.
Функция ДатаИзISO(ДатаСтрокой)

	Цифры = СтрЗаменить(СтрЗаменить(СтрЗаменить(Лев(СокрЛП(ДатаСтрокой), 19), "-", ""), "T", ""), ":", "");
	Если СтрДлина(Цифры) <> 14 Тогда
		Возврат '00010101';
	КонецЕсли;
	Попытка
		Возврат Дата(Цифры);
	Исключение
		Возврат '00010101';
	КонецПопытки;

КонецФункции

// Значение поля из разобранного вывода ring или пустая строка.
//
// Параметры:
//  Поля - Соответствие из КлючИЗначение - ключ: имя поля, значение: значение поля.
//  Имя - Строка - имя поля.
//
// Возвращаемое значение:
//  Строка - значение поля.
Функция ЗначениеПоля(Поля, Имя)
	Значение = Поля.Получить(Имя);
	Возврат ?(Значение = Неопределено, "", Значение);
КонецФункции

// Логин и пароль пользователя СУБД для регистрации баз в кластере хранятся вне конфигурации.
//
// Возвращаемое значение:
//  Структура, Неопределено - поля Пользователь и Пароль (Строка).
Функция УчётнаяЗаписьСУБД()

	Путь = Настройка("ФайлУчётнойЗаписиСУБД", "C:\Kirill\OwnerGuard\db.cred");
	Попытка
		Чтение = Новый ЧтениеТекста(Путь, "UTF-8");
		Строка = СокрЛП(Чтение.Прочитать());
		Чтение.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Части = СтрРазделить(Строка, Символы.Таб, Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Пользователь,Пароль", СокрЛП(Части[0]), СокрЛП(Части[1]));

КонецФункции

// Начало командной строки sqlcmd с сервером и учётной записью СУБД.
// Служба сервера 1С работает под доменной учётной записью без логина в SQL Server,
// поэтому доверенное подключение из фоновых заданий не проходит.
//
// Параметры:
//  СерверSQL - Строка - имя экземпляра SQL Server.
//
// Возвращаемое значение:
//  Строка - "sqlcmd -S ... -U ... -P ..." или "sqlcmd -S ... -E", если учётка не прочитана.
Функция КомандаSQL(СерверSQL)

	Учётка = УчётнаяЗаписьСУБД();
	Если Учётка = Неопределено Тогда
		Возврат "sqlcmd -S """ + СерверSQL + """ -E";
	КонецЕсли;
	Возврат "sqlcmd -S """ + СерверSQL + """ -U """ + Учётка.Пользователь + """ -P """ + Учётка.Пароль + """";

КонецФункции

// Снимает у служебных учётных записей предупреждение об опасных действиях:
// иначе запуск rac и sqlcmd из фонового задания молча блокируется.
//
// Параметры:
//  СписокИмён - Строка - имена пользователей через запятую; пусто - все пользователи с префиксом "РЗ_".
//
// Возвращаемое значение:
//  Строка - результат по каждому пользователю через "; ".
Функция СнятьЗащитуОтОпасныхДействий(СписокИмён)

	Имена = Новый Массив;
	Если ЗначениеЗаполнено(СписокИмён) Тогда
		Для Каждого Имя Из СтрРазделить(СписокИмён, ",", Ложь) Цикл
			Имена.Добавить(СокрЛП(Имя));
		КонецЦикла;
	Иначе
		Для Каждого Пользователь Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
			Если СтрНачинаетсяС(Пользователь.Имя, "РЗ_") Тогда
				Имена.Добавить(Пользователь.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Готово = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		ПользИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Имя);
		Если ПользИБ = Неопределено Тогда
			Готово.Добавить(Имя + ": не найден");
			Продолжить;
		КонецЕсли;
		Защита = ПользИБ.ЗащитаОтОпасныхДействий;
		Защита.ПредупреждатьОбОпасныхДействиях = Ложь;
		ПользИБ.ЗащитаОтОпасныхДействий = Защита;
		ПользИБ.Записать();
		Готово.Добавить(Имя + ": снята");
	КонецЦикла;

	Возврат СтрСоединить(Готово, "; ");

КонецФункции


