// Расписания задаём программно: заданное вручную в XML расширения платформа
// не приняла - задания числились включёнными, но не запускались ни разу.
// Задания, расписание или использование которых администратор задал в форме
// «Настройки мониторинга» (настройка РасписаниеЗаданийИзФормы - имена через запятую),
// пропускаются: заданное в форме не перезаписывается.
//
// Возвращаемое значение:
//  Строка - итог по каждому заданию через "; ".
Функция НастроитьРасписания()

	ИзФормы = СтрРазделить(ВРег(СтрЗаменить(Строка(Настройка("РасписаниеЗаданийИзФормы", "")), " ", "")), ",", Ложь);

	Внутридневные = Новый Соответствие;
	Внутридневные.Вставить("ОбработчикКомандОбслуживания", 300);
	Внутридневные.Вставить("КонтрольДоступностиБаз", 900);
	Внутридневные.Вставить("КонтрольСеансовБаз", 900);
	Внутридневные.Вставить("рбфСборТЖ", 60);
	Внутридневные.Вставить("рбфАгрегатыТЖ", 3600);
	Внутридневные.Вставить("рбфСнимокСУБД", 300);

	// начало внутридневного расписания, если не 00:02: агрегаты считаются в :05 каждого часа
	НачалоВнутридневных = Новый Соответствие;
	НачалоВнутридневных.Вставить("рбфАгрегатыТЖ", Дата(1, 1, 1, 0, 5, 0));

	Суточные = Новый Соответствие;
	Суточные.Вставить("КонтрольВладельцевБаз", 23400);
	Суточные.Вставить("КонтрольСрокаАктуальности", 25200);
	Суточные.Вставить("ОбновлениеКластеров", 19800);
	Суточные.Вставить("рбфОчисткаВыполненийТЖ", 12600); // 03:30

	Готово = Новый Массив;

	Для Каждого КЗ Из Внутридневные Цикл
		Если ИзФормы.Найти(ВРег(КЗ.Ключ)) <> Неопределено Тогда
			Готово.Добавить(КЗ.Ключ + ": расписание задано в форме, не меняем");
			Продолжить;
		КонецЕсли;
		Попытка
			МД = Метаданные.РегламентныеЗадания.Найти(КЗ.Ключ);
			Если МД = Неопределено Тогда
				Готово.Добавить(КЗ.Ключ + ": не найдено");
				Продолжить;
			КонецЕсли;
			Задание = РегламентныеЗадания.НайтиПредопределенное(МД);
			Расписание = Новый РасписаниеРегламентногоЗадания;
			Расписание.ПериодПовтораДней = 1;
			Начало = НачалоВнутридневных.Получить(КЗ.Ключ);
			Расписание.ВремяНачала = ?(Начало = Неопределено, Дата(1, 1, 1, 0, 2, 0), Начало);
			Расписание.ВремяКонца = Дата(1, 1, 1, 23, 59, 0);
			// В разных версиях платформы свойство пишется по-разному - пробуем оба варианта.
			ПериодУстановлен = Ложь;
			Попытка
				Расписание.ПериодПовтораВТеченииДня = КЗ.Значение;
				ПериодУстановлен = Истина;
			Исключение
				// в этой версии платформы свойство называется иначе - пробуем второй вариант ниже
				ПериодУстановлен = Ложь;
			КонецПопытки;
			Если НЕ ПериодУстановлен Тогда
				Попытка
					Расписание.ПериодПовтораВТечениеДня = КЗ.Значение;
					ПериодУстановлен = Истина;
				Исключение
					// нет и второго варианта - ниже расписание будет записано без периода повтора
					ПериодУстановлен = Ложь;
				КонецПопытки;
			КонецЕсли;
			Задание.Расписание = Расписание;
			Задание.Использование = Истина;
			Задание.Записать();
			Готово.Добавить(КЗ.Ключ + ": каждые " + КЗ.Значение / 60 + " мин, период " + ?(ПериодУстановлен, "установлен", "НЕ УСТАНОВЛЕН"));
		Исключение
			Готово.Добавить(КЗ.Ключ + ": ОШИБКА " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	Для Каждого КЗ Из Суточные Цикл
		Если ИзФормы.Найти(ВРег(КЗ.Ключ)) <> Неопределено Тогда
			Готово.Добавить(КЗ.Ключ + ": расписание задано в форме, не меняем");
			Продолжить;
		КонецЕсли;
		Попытка
			МД = Метаданные.РегламентныеЗадания.Найти(КЗ.Ключ);
			Если МД = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Задание = РегламентныеЗадания.НайтиПредопределенное(МД);
			Расписание = Новый РасписаниеРегламентногоЗадания;
			Расписание.ПериодПовтораДней = 1;
			Расписание.ВремяНачала = Дата(1, 1, 1, 0, 0, 0) + КЗ.Значение;
			Задание.Расписание = Расписание;
			Задание.Использование = Истина;
			Задание.Записать();
			Готово.Добавить(КЗ.Ключ + ": ежедневно");
		Исключение
			Готово.Добавить(КЗ.Ключ + ": ОШИБКА " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	Возврат СтрСоединить(Готово, "; ");

КонецФункции

#Область СнимокСУБД

// Обработчик регламентного задания рбфСнимокСУБД (раз в 5 минут): снимок «держит сейчас».
// Сеансы кластеров (rac session list: ожидание блокировок 1С/СУБД, текущий вызов, память),
// по SQL-серверам баз реестра - длительные транзакции и ожидания запросов, tempdb и самая длинная
// snapshot-транзакция (ИТС 5900), топ кэша запросов по CPU и частоте, дельта dm_os_wait_stats с долей
// signal wait (i8106008), раз в час - давность статистик крупных таблиц (ИТС 5837); размер сеансовых
// данных srvinfo\reg_<порт>\snccntx* и свободное место на их диске (ИТС 5860).
// Таблицы снимка - в рбфСнимокСейчас (набор Вид+Сервер перезаписывается), числа - в рбфСчетчики.
// T-SQL только читает DMV.
Процедура СнимокСУБД() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Время = ТекущаяДатаСеанса();
	Итоги = Новый Массив;
	Ошибка = Ложь;
	Счетчики = Новый Соответствие;
	СеансыПоSPID = Новый Соответствие;
	Базы = БазыСнимкаСУБД();

	Попытка
		Итоги.Добавить(СнимокСеансовКластеров(Время, Базы, СеансыПоSPID, Счетчики));
	Исключение
		Ошибка = Истина;
		Итоги.Добавить("Сеансы кластеров: ОШИБКА");
		ЗаписьЖурналаРегистрации("Мониторинг.СнимокСУБД", УровеньЖурналаРегистрации.Ошибка, , ,
			"Сеансы кластеров: " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Для Каждого КЗ Из Базы.ПоSQL Цикл
		Попытка
			Итоги.Добавить("sql:" + КЗ.Ключ + ": " + СнимокСервераSQL(КЗ.Ключ, КЗ.Значение, Время, СеансыПоSPID, Счетчики));
		Исключение
			Ошибка = Истина;
			Итоги.Добавить("sql:" + КЗ.Ключ + ": ОШИБКА");
			ЗаписьЖурналаРегистрации("Мониторинг.СнимокСУБД", УровеньЖурналаРегистрации.Ошибка, , ,
				"sql:" + КЗ.Ключ + ": " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	Попытка
		Итоги.Добавить(СнимокСеансовыхДанных(Счетчики));
	Исключение
		Ошибка = Истина;
		Итоги.Добавить("Сеансовые данные: ОШИБКА");
		ЗаписьЖурналаРегистрации("Мониторинг.СнимокСУБД", УровеньЖурналаРегистрации.Ошибка, , ,
			"Сеансовые данные: " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Для Каждого КЗ Из Счетчики Цикл
		ПринятьСчетчики(КЗ.Ключ, Время, КЗ.Значение);
	КонецЦикла;

	// раз в 5 минут: в журнал - только ошибки и запуски с тревожным снимком
	Если Ошибка Тогда
		ЗаписьЖурналаРегистрации("Мониторинг.СнимокСУБД", УровеньЖурналаРегистрации.Предупреждение, , ,
			СтрСоединить(Итоги, "; "));
	КонецЕсли;

КонецПроцедуры

// Базы реестра с базой SQL (кроме архивных) для сопоставления сеансов 1С и SQL.
// Настройка СнимокСерверыSQL (имена через запятую) ограничивает обход SQL-серверов; пусто - все.
//
// Возвращаемое значение:
//  Структура:
//   * ПоИмениИБ - Соответствие - НРег("<сервер 1С>|<имя ИБ>") -> Структура СерверSQL, ИмяБД.
//   * ПоSQL - Соответствие - имя SQL-сервера -> Соответствие: НРег(имя БД) -> имя ИБ (Строка).
Функция БазыСнимкаСУБД()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	С.Сервер1С.Наименование КАК Сервер1С,
	|	С.ИмяБазы1С КАК ИмяБазы1С,
	|	С.СерверБД.Наименование КАК СерверБД,
	|	С.ИмяБазыБД КАК ИмяБазыБД
	|ИЗ
	|	РегистрСведений.СерверыИБазы КАК С
	|ГДЕ
	|	С.ИмяБазыБД <> """"
	|	И С.Тип <> ЗНАЧЕНИЕ(Перечисление.ТипБазы.Архивная)";
	Выборка = Запрос.Выполнить().Выбрать();

	Разрешённые = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить(Строка(Настройка("СнимокСерверыSQL", "")), ",", Ложь) Цикл
		Разрешённые.Вставить(НРег(СокрЛП(Имя)), Истина);
	КонецЦикла;

	Результат = Новый Структура("ПоИмениИБ,ПоSQL", Новый Соответствие, Новый Соответствие);
	Пока Выборка.Следующий() Цикл
		СерверSQL = ?(ЗначениеЗаполнено(Выборка.СерверБД), СокрЛП(Выборка.СерверБД), "localhost");
		Если Разрешённые.Количество() > 0 И Разрешённые.Получить(НРег(СерверSQL)) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ИмяБД = СокрЛП(Выборка.ИмяБазыБД);
		ИмяИБ = СокрЛП(Выборка.ИмяБазы1С);
		Если ЗначениеЗаполнено(Выборка.Сервер1С) И ЗначениеЗаполнено(ИмяИБ) Тогда
			Результат.ПоИмениИБ.Вставить(НРег(СокрЛП(Выборка.Сервер1С) + "|" + ИмяИБ),
				Новый Структура("СерверSQL,ИмяБД", СерверSQL, ИмяБД));
		КонецЕсли;
		БазыСервера = Результат.ПоSQL.Получить(СерверSQL);
		Если БазыСервера = Неопределено Тогда
			БазыСервера = Новый Соответствие;
			Результат.ПоSQL.Вставить(СерверSQL, БазыСервера);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(БазыСервера.Получить(НРег(ИмяБД))) Тогда
			БазыСервера.Вставить(НРег(ИмяБД), ИмяИБ);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Сеансы кластеров реестра (rac session list, по кластеру на порт RAS): в снимок «Сеанс1С» попадают
// ждущие блокировку 1С или СУБД, блокирующие других, с текущим вызовом от СнимокПорогВызоваСекунд
// и с памятью текущего вызова от СнимокПорогПамятиСеансаМБ. Заполняет карту SPID (db-proc-info) -> сеанс 1С.
//
// Параметры:
//  Время - Дата - момент снимка.
//  Базы - Структура - см. БазыСнимкаСУБД.
//  СеансыПоSPID - Соответствие - заполняется: "<sql>|<бд>|<spid>" (НРег) -> Структура Сервер, База, Сеанс, Пользователь.
//  Счетчики - Соответствие - см. ДобавитьСчетчикСнимка.
//
// Возвращаемое значение:
//  Строка - итог для журнала.
Функция СнимокСеансовКластеров(Время, Базы, СеансыПоSPID, Счетчики)

	Учётка = УчётнаяЗаписьКластера();
	Если Учётка = Неопределено Тогда
		Возврат "Сеансы кластеров: нет учётной записи администратора кластера";
	КонецЕсли;
	ПорогВызоваМс = ЧислоСнимка(Настройка("СнимокПорогВызоваСекунд", 5)) * 1000;
	ПорогПамятиМБ = ЧислоСнимка(Настройка("СнимокПорогПамятиСеансаМБ", 1024));

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	С.Сервер1С КАК Сервер1С
	|ИЗ
	|	РегистрСведений.СерверыИБазы КАК С
	|ГДЕ
	|	С.Сервер1С <> ЗНАЧЕНИЕ(Справочник.Сервер1С.ПустаяСсылка)";
	Выборка = Запрос.Выполнить().Выбрать();

	Итоги = Новый Массив;
	Обойдённые = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		// @skip-check query-in-loop - цикл по серверам 1С (единицы), чтение портов кластеров
		Rac = ПутьКRac(Выборка.Сервер1С);
		Если Rac = Неопределено ИЛИ Обойдённые.Получить(Rac.ПортRAS) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Обойдённые.Вставить(Rac.ПортRAS, Истина);
		ИмяСервера = СокрЛП(Строка(Выборка.Сервер1С));
		Адрес = "localhost:" + Rac.ПортRAS;
		Кластер = ИдентификаторКластера(Rac, Адрес);
		Если НЕ ЗначениеЗаполнено(Кластер) Тогда
			Итоги.Добавить(ИмяСервера + ": кластер не найден");
			Продолжить;
		КонецЕсли;
		УчёткаКластера = Учётка;
		Ответ = ВыполнитьКоманду("""" + Rac.Путь + """ " + Адрес + " session list --cluster=" + Кластер
			+ " --cluster-user=" + Учётка.Пользователь + " --cluster-pwd=" + Учётка.Пароль);
		Если Ответ.КодВозврата <> 0 Тогда
			// у кластера нет администраторов (8541): rac отвергает чужие учётные данные, повтор без них
			УчёткаКластера = Неопределено;
			Ответ = ВыполнитьКоманду("""" + Rac.Путь + """ " + Адрес + " session list --cluster=" + Кластер);
		КонецЕсли;
		Если Ответ.КодВозврата <> 0 Тогда
			// ошибка одного кластера не прерывает остальные
			Итоги.Добавить(ИмяСервера + ": rac session list: " + Лев(Ответ.Вывод, 200));
			Продолжить;
		КонецЕсли;
		ИменаИБ = ИменаИБКластера(Rac, Адрес, Кластер, УчёткаКластера);
		Сеансы = ЗаписиВыводаRac(Ответ.Вывод);

		Блокирующие = Новый Соответствие;
		Для Каждого Сеанс Из Сеансы Цикл
			Блокирующий = ЧислоСнимка(Сеанс.Получить("blocked-by-ls"));
			Если Блокирующий > 0 Тогда
				Блокирующие.Вставить(Блокирующий, Истина);
			КонецЕсли;
		КонецЦикла;

		Строки = Новый Массив;
		ЖдутЛ = 0;
		ЖдутСУБД = 0;
		МаксВызовСек = 0;
		Для Каждого Сеанс Из Сеансы Цикл
			НомерСеанса = ЧислоСнимка(Сеанс.Получить("session-id"));
			ИмяИБ = Строка(ИменаИБ.Получить(Сеанс.Получить("infobase")));
			Пользователь = Строка(Сеанс.Получить("user-name"));
			ЖдётЛ = ЧислоСнимка(Сеанс.Получить("blocked-by-ls"));
			ЖдётСУБД = ЧислоСнимка(Сеанс.Получить("blocked-by-dbms"));
			ВызовМс = ЧислоСнимка(Сеанс.Получить("duration-current"));
			ВызовСУБДМс = ЧислоСнимка(Сеанс.Получить("duration-current-dbms"));
			ПамятьМБ = Окр(ЧислоСнимка(Сеанс.Получить("memory-current")) / 1048576, 3);
			SPID = ЧислоСнимка(Сеанс.Получить("db-proc-info"));
			ЖдутЛ = ЖдутЛ + ?(ЖдётЛ > 0, 1, 0);
			ЖдутСУБД = ЖдутСУБД + ?(ЖдётСУБД > 0, 1, 0);
			МаксВызовСек = Макс(МаксВызовСек, ВызовМс / 1000);

			Если SPID > 0 Тогда
				БазаSQL = Базы.ПоИмениИБ.Получить(НРег(ИмяСервера + "|" + ИмяИБ));
				Если БазаSQL <> Неопределено Тогда
					СеансыПоSPID.Вставить(НРег(БазаSQL.СерверSQL + "|" + БазаSQL.ИмяБД) + "|" + Формат(SPID, "ЧГ=0"),
						Новый Структура("Сервер,База,Сеанс,Пользователь", ИмяСервера, ИмяИБ, НомерСеанса, Пользователь));
				КонецЕсли;
			КонецЕсли;

			Блокирует = Блокирующие.Получить(НомерСеанса) <> Неопределено;
			Если НЕ (ЖдётЛ > 0 ИЛИ ЖдётСУБД > 0 ИЛИ Блокирует ИЛИ ВызовМс >= ПорогВызоваМс
				ИЛИ ПамятьМБ >= ПорогПамятиМБ) Тогда
				Продолжить;
			КонецЕсли;
			СтрокаСнимка = НоваяСтрокаСнимка();
			СтрокаСнимка.Ключ = ИмяИБ + " " + Формат(НомерСеанса, "ЧГ=0");
			СтрокаСнимка.База = ИмяИБ;
			СтрокаСнимка.Пользователь = Пользователь;
			СтрокаСнимка.Сеанс = НомерСеанса;
			СтрокаСнимка.SPID = SPID;
			СтрокаСнимка.БлокированЛ = ЖдётЛ;
			СтрокаСнимка.БлокированСУБД = ЖдётСУБД;
			СтрокаСнимка.ДлительностьСек = ВызовМс / 1000;
			СтрокаСнимка.Значение = ВызовСУБДМс / 1000;
			СтрокаСнимка.ПамятьМБ = ПамятьМБ;
			СтрокаСнимка.Текст = СтрШаблон("%1%2; хост %3, IP %4%5; начат %6",
				Сеанс.Получить("app-id"), ?(Блокирует, ", БЛОКИРУЕТ других", ""), Сеанс.Получить("host"),
				Сеанс.Получить("client-ip"), ?(НРег(Строка(Сеанс.Получить("hibernate"))) = "yes", ", спящий", ""),
				Сеанс.Получить("started-at"));
			Строки.Добавить(СтрокаСнимка);
		КонецЦикла;

		ЗаписатьСнимок("Сеанс1С", ИмяСервера, Строки, Время);
		ДобавитьСчетчикСнимка(Счетчики, ИмяСервера, "Сеансы: ждут блокировку 1С", ЖдутЛ);
		ДобавитьСчетчикСнимка(Счетчики, ИмяСервера, "Сеансы: ждут СУБД", ЖдутСУБД);
		ДобавитьСчетчикСнимка(Счетчики, ИмяСервера, "Сеансы: самый долгий текущий вызов, с", МаксВызовСек);
		Итоги.Добавить(СтрШаблон("%1: сеансов %2, в снимке %3", ИмяСервера, Сеансы.Количество(), Строки.Количество()));
	КонецЦикла;
	Возврат СтрСоединить(Итоги, "; ");

КонецФункции

// Снимок одного SQL-сервера одним пакетом T-SQL: tempdb, snapshot-транзакция, длительные и ждущие
// транзакции, топ кэша запросов, накопленные ожидания; раз в час (первые 5 минут часа) - статистики.
// Пороги тревог: ПорогTempdbСвободноМБ (2048), ПорогSnapshotТранзакцииСекунд (600) - не чаще раза в час.
//
// Параметры:
//  СерверSQL - Строка - имя экземпляра.
//  БазыСервера - Соответствие - НРег(имя БД) -> имя ИБ, см. БазыСнимкаСУБД.
//  Время - Дата - момент снимка.
//  СеансыПоSPID - Соответствие - см. СнимокСеансовКластеров.
//  Счетчики - Соответствие - см. ДобавитьСчетчикСнимка.
//
// Возвращаемое значение:
//  Строка - итог для журнала.
Функция СнимокСервераSQL(СерверSQL, БазыСервера, Время, СеансыПоSPID, Счетчики)

	ПорогТранзакции = ЧислоСнимка(Настройка("СнимокПорогТранзакцииSQLСекунд", 30));
	Ответ = ВыполнитьПакетSQL(СерверSQL, ТекстЗапросаСнимкаSQL(ПорогТранзакции));
	Если Ответ.КодВозврата <> 0 Тогда
		ВызватьИсключение "sqlcmd: " + Лев(Ответ.Вывод, 500);
	КонецЕсли;

	Транзакции = Новый Массив;
	Snapshot = Новый Массив;
	ПоCPU = Новый Массив;
	ПоЧастоте = Новый Массив;
	Накопленные = Новый Соответствие;
	СвободноTempdb = -1;
	ВерсииTempdb = 0;
	ДлительностьSnapshot = 0;
	ОписаниеSnapshot = "";
	МаксТранзакцияСек = 0;
	Для Каждого ТекстСтроки Из СтрРазделить(Ответ.Вывод, Символы.ПС, Ложь) Цикл
		Части = СтрРазделить(СокрЛП(ТекстСтроки), "|", Истина);
		Вид = Части[0];
		Если Вид = "T" И Части.Количество() >= 3 Тогда
			СвободноTempdb = ЧислоСнимка(Части[1]);
			ВерсииTempdb = ЧислоСнимка(Части[2]);
		ИначеЕсли Вид = "S" И Части.Количество() >= 6 Тогда
			СтрокаСнимка = СтрокаСеансаSQL(СерверSQL, БазыСервера, СеансыПоSPID, ЧислоСнимка(Части[1]),
				Части[3], Части[4], Части[5]);
			ДлительностьSnapshot = ЧислоСнимка(Части[2]);
			СтрокаСнимка.ДлительностьСек = ДлительностьSnapshot;
			ОписаниеSnapshot = СтрШаблон("spid %1, база %2, сеанс 1С %3 %4; %5", Формат(СтрокаСнимка.SPID, "ЧГ=0"),
				СтрокаСнимка.База, Формат(СтрокаСнимка.Сеанс, "ЧГ=0; ЧН=-"), СтрокаСнимка.Пользователь, СтрокаСнимка.Текст);
			Snapshot.Добавить(СтрокаСнимка);
		ИначеЕсли Вид = "X" И Части.Количество() >= 10 Тогда
			СтрокаСнимка = СтрокаСеансаSQL(СерверSQL, БазыСервера, СеансыПоSPID, ЧислоСнимка(Части[1]),
				Части[6], Части[7], Части[8]);
			СтрокаСнимка.ДлительностьСек = ЧислоСнимка(Части[2]);
			СтрокаСнимка.БлокированСУБД = ЧислоСнимка(Части[3]);
			СтрокаСнимка.Значение = ЧислоСнимка(Части[5]) / 1000;
			СтрокаСнимка.Текст = СтрШаблон("%1%2; %3", ?(ПустаяСтрока(Части[4]), "", "ждёт " + Части[4] + "; "),
				СтрокаСнимка.Текст, Лев(Части[9], 4000));
			МаксТранзакцияСек = Макс(МаксТранзакцияСек, СтрокаСнимка.ДлительностьСек);
			Транзакции.Добавить(СтрокаСнимка);
		ИначеЕсли (Вид = "C" ИЛИ Вид = "F") И Части.Количество() >= 7 Тогда
			Приёмник = ?(Вид = "C", ПоCPU, ПоЧастоте);
			ТекстЗапроса = Части[6];
			// тот же алгоритм, что у ШаблонХеш событий ТЖ: по ключу строка кэша связывается с шаблоном ТЖ
			Хеш = рбфАнализСервер.ШаблонХеш(ТекстЗапроса);
			СтрокаСнимка = НоваяСтрокаСнимка();
			СтрокаСнимка.Ключ = Формат(Приёмник.Количество() + 1, "ЧЦ=2; ЧВН=") + " " + Хеш;
			ИмяИБ = БазыСервера.Получить(НРег(Части[5]));
			СтрокаСнимка.База = ?(ЗначениеЗаполнено(ИмяИБ), ИмяИБ, Части[5]);
			СтрокаСнимка.Значение = ЧислоСнимка(Части[1]) / 1000;
			СтрокаСнимка.Значение2 = ЧислоСнимка(Части[2]);
			СтрокаСнимка.ДлительностьСек = ЧислоСнимка(Части[3]) / 1000;
			СтрокаСнимка.Текст = "чтений " + Части[4] + "; " + Лев(ТекстЗапроса, 10000);
			Приёмник.Добавить(СтрокаСнимка);
		ИначеЕсли Вид = "W" И Части.Количество() >= 4 Тогда
			Накопленные.Вставить(Части[1], Новый Структура("Ожидание,Сигнал", ЧислоСнимка(Части[2]), ЧислоСнимка(Части[3])));
		КонецЕсли;
	КонецЦикла;

	ЗаписатьСнимок("ТранзакцияSQL", СерверSQL, Транзакции, Время);
	ЗаписатьСнимок("Snapshot", СерверSQL, Snapshot, Время);
	ЗаписатьСнимок("ЗапросCPU", СерверSQL, ПоCPU, Время);
	ЗаписатьСнимок("ЗапросЧастота", СерверSQL, ПоЧастоте, Время);
	ДоляСигнала = ДельтаОжиданийSQL(СерверSQL, Накопленные, Время);

	Если СвободноTempdb >= 0 Тогда
		ДобавитьСчетчикСнимка(Счетчики, СерверSQL, "tempdb: свободно, МБ", СвободноTempdb);
		ДобавитьСчетчикСнимка(Счетчики, СерверSQL, "tempdb: хранилище версий, МБ", ВерсииTempdb);
	КонецЕсли;
	ДобавитьСчетчикСнимка(Счетчики, СерверSQL, "tempdb: самая длинная snapshot-транзакция, с", ДлительностьSnapshot);
	ДобавитьСчетчикСнимка(Счетчики, СерверSQL, "SQL: самая длинная транзакция, с", МаксТранзакцияСек);
	Если ДоляСигнала >= 0 Тогда
		ДобавитьСчетчикСнимка(Счетчики, СерверSQL, "SQL: signal wait, %", ДоляСигнала);
	КонецЕсли;

	ПорогTempdb = ЧислоСнимка(Настройка("ПорогTempdbСвободноМБ", 2048));
	Если СвободноTempdb >= 0 И СвободноTempdb < ПорогTempdb Тогда
		ТревогаСнимка("tempdb " + СерверSQL, СтрШаблон("SQL %1: в tempdb свободно %2 МБ (порог %3), хранилище версий %4 МБ.%5",
			СерверSQL, Формат(СвободноTempdb, "ЧГ=0; ЧН=0"), ПорогTempdb, Формат(ВерсииTempdb, "ЧГ=0; ЧН=0"),
			?(ПустаяСтрока(ОписаниеSnapshot), "", Символы.ПС + "Самая длинная snapshot-транзакция: " + ОписаниеSnapshot)), 3600);
	КонецЕсли;
	ПорогSnapshot = ЧислоСнимка(Настройка("ПорогSnapshotТранзакцииСекунд", 600));
	Если ДлительностьSnapshot >= ПорогSnapshot Тогда
		ТревогаСнимка("snapshot " + СерверSQL, СтрШаблон("SQL %1: snapshot-транзакция идёт %2 с (порог %3), tempdb растёт.%4%5",
			СерверSQL, Формат(ДлительностьSnapshot, "ЧГ=0; ЧН=0"), ПорогSnapshot, Символы.ПС, ОписаниеSnapshot), 3600);
	КонецЕсли;

	Итог = СтрШаблон("tempdb свободно %1 МБ, транзакций %2, snapshot %3 с", Формат(СвободноTempdb, "ЧГ=0; ЧН=0"),
		Транзакции.Количество(), Формат(ДлительностьSnapshot, "ЧГ=0; ЧН=0"));
	Если Минута(Время) < 5 Тогда
		Итог = Итог + "; " + СнимокСтатистикиSQL(СерверSQL, БазыСервера, Время, Счетчики);
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Строка снимка по сеансу SQL с сеансом 1С: по SPID и имени БД (db-proc-info из rac),
// иначе в тексте остаются host_name и program_name сеанса SQL.
//
// Параметры:
//  СерверSQL - Строка - имя экземпляра.
//  БазыСервера - Соответствие - см. БазыСнимкаСУБД.
//  СеансыПоSPID - Соответствие - см. СнимокСеансовКластеров.
//  SPID - Число - session_id.
//  ИмяБД - Строка - текущая БД сеанса.
//  Хост - Строка - host_name.
//  Программа - Строка - program_name.
//
// Возвращаемое значение:
//  Структура - см. НоваяСтрокаСнимка, Ключ "spid N".
Функция СтрокаСеансаSQL(СерверSQL, БазыСервера, СеансыПоSPID, SPID, ИмяБД, Хост, Программа)

	СтрокаСнимка = НоваяСтрокаСнимка();
	СтрокаСнимка.Ключ = "spid " + Формат(SPID, "ЧГ=0");
	СтрокаСнимка.SPID = SPID;
	ИмяИБ = БазыСервера.Получить(НРег(ИмяБД));
	СтрокаСнимка.База = ?(ЗначениеЗаполнено(ИмяИБ), ИмяИБ, ИмяБД);
	Сеанс1С = СеансыПоSPID.Получить(НРег(СерверSQL + "|" + ИмяБД) + "|" + Формат(SPID, "ЧГ=0"));
	Если Сеанс1С <> Неопределено Тогда
		СтрокаСнимка.Сеанс = Сеанс1С.Сеанс;
		СтрокаСнимка.Пользователь = Сеанс1С.Пользователь;
	КонецЕсли;
	СтрокаСнимка.Текст = СтрШаблон("%1 @ %2", Программа, Хост);
	Возврат СтрокаСнимка;

КонецФункции

// Дельта sys.dm_os_wait_stats к прошлому снимку (накопленные значения - вид «ОжиданиеНакоп»):
// топ-15 ожиданий за интервал - вид «Ожидание» (Значение - мс ожидания, Значение2 - мс signal wait).
// После перезапуска SQL (значения меньше прежних) дельта не считается.
//
// Параметры:
//  СерверSQL - Строка - имя экземпляра.
//  Накопленные - Соответствие - wait_type -> Структура Ожидание, Сигнал (мс с запуска SQL).
//  Время - Дата - момент снимка.
//
// Возвращаемое значение:
//  Число - доля signal wait за интервал, %; -1 - не посчитана.
Функция ДельтаОжиданийSQL(СерверSQL, Накопленные, Время)

	Если Накопленные.Количество() = 0 Тогда
		Возврат -1;
	КонецЕсли;
	Набор = РегистрыСведений.рбфСнимокСейчас.СоздатьНаборЗаписей();
	Набор.Отбор.Вид.Установить("ОжиданиеНакоп");
	Набор.Отбор.Сервер.Установить(Лев(СерверSQL, 100));
	Набор.Прочитать();
	Прежние = Новый Соответствие;
	ПрежнееВремя = '00010101';
	Для Каждого Запись Из Набор Цикл
		Прежние.Вставить(ВРег(Запись.Ключ), Запись);
		ПрежнееВремя = Запись.Время;
	КонецЦикла;

	Дельты = Новый ТаблицаЗначений;
	Дельты.Колонки.Добавить("Тип", Новый ОписаниеТипов("Строка"));
	Дельты.Колонки.Добавить("Ожидание", Новый ОписаниеТипов("Число"));
	Дельты.Колонки.Добавить("Сигнал", Новый ОписаниеТипов("Число"));
	СтрокиНакопленных = Новый Массив;
	Сброс = Ложь;
	Для Каждого КЗ Из Накопленные Цикл
		СтрокаСнимка = НоваяСтрокаСнимка();
		СтрокаСнимка.Ключ = КЗ.Ключ;
		СтрокаСнимка.Значение = КЗ.Значение.Ожидание;
		СтрокаСнимка.Значение2 = КЗ.Значение.Сигнал;
		СтрокиНакопленных.Добавить(СтрокаСнимка);
		Прежняя = Прежние.Получить(ВРег(КЗ.Ключ));
		Если Прежняя = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Дельта = КЗ.Значение.Ожидание - Прежняя.Значение;
		ДельтаСигнала = КЗ.Значение.Сигнал - Прежняя.Значение2;
		Если Дельта < 0 ИЛИ ДельтаСигнала < 0 Тогда
			Сброс = Истина;
		ИначеЕсли Дельта > 0 Тогда
			СтрокаДельты = Дельты.Добавить();
			СтрокаДельты.Тип = КЗ.Ключ;
			СтрокаДельты.Ожидание = Дельта;
			СтрокаДельты.Сигнал = ДельтаСигнала;
		КонецЕсли;
	КонецЦикла;
	ЗаписатьСнимок("ОжиданиеНакоп", СерверSQL, СтрокиНакопленных, Время);
	Если Сброс ИЛИ Прежние.Количество() = 0 Тогда
		Возврат -1;
	КонецЕсли;

	ВсегоОжидание = Дельты.Итог("Ожидание");
	ВсегоСигнал = Дельты.Итог("Сигнал");
	Дельты.Сортировать("Ожидание Убыв");
	Интервал = Окр((Время - ПрежнееВремя) / 60);
	Строки = Новый Массив;
	Для Каждого СтрокаДельты Из Дельты Цикл
		Если Строки.Количество() >= 15 Тогда
			Прервать;
		КонецЕсли;
		СтрокаСнимка = НоваяСтрокаСнимка();
		СтрокаСнимка.Ключ = СтрокаДельты.Тип;
		СтрокаСнимка.Значение = СтрокаДельты.Ожидание;
		СтрокаСнимка.Значение2 = СтрокаДельты.Сигнал;
		СтрокаСнимка.ДлительностьСек = СтрокаДельты.Ожидание / 1000;
		СтрокаСнимка.Текст = Формат(?(ВсегоОжидание = 0, 0, СтрокаДельты.Ожидание * 100 / ВсегоОжидание), "ЧДЦ=1; ЧН=0")
			+ "% всех ожиданий за " + Интервал + " мин; " + РасшифровкаОжиданияSQL(СтрокаДельты.Тип);
		Строки.Добавить(СтрокаСнимка);
	КонецЦикла;
	ЗаписатьСнимок("Ожидание", СерверSQL, Строки, Время);
	Возврат ?(ВсегоОжидание = 0, -1, Окр(ВсегоСигнал * 100 / ВсегоОжидание, 1));

КонецФункции

// Краткая расшифровка типа ожидания SQL Server по методике ИТС (i8106008).
//
// Параметры:
//  Тип - Строка - wait_type.
//
// Возвращаемое значение:
//  Строка - расшифровка или пустая строка.
Функция РасшифровкаОжиданияSQL(Тип)

	Расшифровки = Новый Соответствие;
	Расшифровки.Вставить("CXPACKET", "параллелизм: проверить MAXDOP (для 1С - 1)");
	Расшифровки.Вставить("CXCONSUMER", "параллелизм: проверить MAXDOP (для 1С - 1)");
	Расшифровки.Вставить("PAGEIOLATCH_", "чтение страниц с диска: медленный диск или мало памяти");
	Расшифровки.Вставить("WRITELOG", "запись журнала транзакций: диск журнала");
	Расшифровки.Вставить("LOGBUFFER", "запись журнала транзакций: диск журнала");
	Расшифровки.Вставить("IO_COMPLETION", "дисковый ввод-вывод");
	Расшифровки.Вставить("RESOURCE_SEMAPHORE", "нехватка памяти под запрос (Hash/Sort)");
	Расшифровки.Вставить("ASYNC_NETWORK_IO", "rphost медленно забирает результат (приложение или сеть)");
	Расшифровки.Вставить("LCK_M_", "блокировки СУБД");
	Расшифровки.Вставить("SOS_SCHEDULER_YIELD", "нехватка CPU");
	Расшифровки.Вставить("PAGELATCH_", "конкуренция за страницы в памяти (часто tempdb)");
	Для Каждого КЗ Из Расшифровки Цикл
		Если СтрНачинаетсяС(ВРег(Тип), КЗ.Ключ) Тогда
			Возврат КЗ.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Давность статистик крупных таблиц баз реестра на SQL-сервере (ИТС 5837: обновлять не реже раза в сутки).
// По каждой БД - до 5 самых больших таблиц от СнимокСтатистикаМинСтрок строк; давность - по самой старой
// статистике таблицы, у которой есть изменения после обновления (modification_counter > 0): статистики
// неизменных данных регламент обновлять не обязан. Тревога - от ПорогВозрастаСтатистикиЧасов (48), раз в сутки.
//
// Параметры:
//  СерверSQL - Строка - имя экземпляра.
//  БазыСервера - Соответствие - см. БазыСнимкаСУБД.
//  Время - Дата - момент снимка.
//  Счетчики - Соответствие - см. ДобавитьСчетчикСнимка.
//
// Возвращаемое значение:
//  Строка - итог для журнала.
Функция СнимокСтатистикиSQL(СерверSQL, БазыСервера, Время, Счетчики)

	Если БазыСервера.Количество() = 0 Тогда
		Возврат "статистика: нет баз";
	КонецЕсли;
	МинСтрок = ЧислоСнимка(Настройка("СнимокСтатистикаМинСтрок", 1000000));
	ПорогЧасов = ЧислоСнимка(Настройка("ПорогВозрастаСтатистикиЧасов", 48));
	Ответ = ВыполнитьПакетSQL(СерверSQL, ТекстЗапросаСтатистикиSQL(БазыСервера, МинСтрок));
	Если Ответ.КодВозврата <> 0 Тогда
		ВызватьИсключение "sqlcmd (статистика): " + Лев(Ответ.Вывод, 500);
	КонецЕсли;

	Строки = Новый Массив;
	Старые = Новый Массив;
	Ошибки = Новый Массив;
	МаксЧасов = 0;
	Для Каждого ТекстСтроки Из СтрРазделить(Ответ.Вывод, Символы.ПС, Ложь) Цикл
		Части = СтрРазделить(СокрЛП(ТекстСтроки), "|", Истина);
		Если Части[0] = "E" И Части.Количество() >= 3 Тогда
			Ошибки.Добавить(Части[1] + ": " + Лев(Части[2], 200));
			Продолжить;
		ИначеЕсли Части[0] <> "A" ИЛИ Части.Количество() < 7 Тогда
			Продолжить;
		КонецЕсли;
		ИмяИБ = БазыСервера.Получить(НРег(Части[1]));
		Часов = Окр(ЧислоСнимка(Части[4]), 1);
		МаксЧасов = Макс(МаксЧасов, Часов);
		СтрокаСнимка = НоваяСтрокаСнимка();
		СтрокаСнимка.Ключ = Части[1] + "." + Части[2];
		СтрокаСнимка.База = ?(ЗначениеЗаполнено(ИмяИБ), ИмяИБ, Части[1]);
		СтрокаСнимка.Значение = Часов;
		СтрокаСнимка.Значение2 = ЧислоСнимка(Части[3]);
		СтрокаСнимка.Текст = СтрШаблон("строк %1; самая старая изменённая статистика %2; изменений %3",
			Части[3], ?(ПустаяСтрока(Части[5]), "нет", Части[5]), Части[6]);
		Строки.Добавить(СтрокаСнимка);
		Если Часов >= ПорогЧасов Тогда
			Старые.Добавить(СтрШаблон("%1.%2 - %3 ч", СтрокаСнимка.База, Части[2], Формат(Часов, "ЧДЦ=0; ЧН=0; ЧГ=0")));
		КонецЕсли;
	КонецЦикла;
	ЗаписатьСнимок("Статистика", СерверSQL, Строки, Время);
	ДобавитьСчетчикСнимка(Счетчики, СерверSQL, "Статистика: самая старая крупных таблиц, ч", МаксЧасов);
	Если Ошибки.Количество() > 0 Тогда
		ЗаписьЖурналаРегистрации("Мониторинг.СнимокСУБД", УровеньЖурналаРегистрации.Предупреждение, , ,
			"sql:" + СерверSQL + ": статистика не прочитана: " + СтрСоединить(Ошибки, "; "));
	КонецЕсли;
	Если Старые.Количество() > 0 Тогда
		ТревогаСнимка("статистика " + СерверSQL, СтрШаблон("SQL %1: статистика крупных таблиц старше %2 ч (ИТС 5837):%3%4",
			СерверSQL, ПорогЧасов, Символы.ПС, СтрСоединить(Старые, Символы.ПС)), 86400);
	КонецЕсли;
	Возврат СтрШаблон("статистика: таблиц %1, старше порога %2", Строки.Количество(), Старые.Количество());

КонецФункции

// Пакет T-SQL снимка (только чтение DMV). Каждая строка ответа начинается с вида и "|":
//  T|свободно в tempdb МБ|хранилище версий МБ
//  S|spid|секунд|БД|host|program - самая длинная snapshot-транзакция
//  X|spid|секунд транзакции|blocking spid|wait_type|wait_time мс|БД|host|program|текст запроса
//  C|cpu мс|выполнений|длительность мс|логических чтений|БД|текст инструкции - топ-10 по CPU (F - по частоте)
//  W|wait_type|wait_time_ms|signal_wait_time_ms - накопленные ожидания без фоновых
//
// Параметры:
//  ПорогТранзакции - Число - транзакции короче (и не ждущие блокировку) не выводятся, секунд.
//
// Возвращаемое значение:
//  Строка - текст пакета.
Функция ТекстЗапросаСнимкаSQL(ПорогТранзакции)

	// фоновые ожидания, которые не означают нагрузку (список по методике разбора wait stats)
	Фоновые = "BROKER_EVENTHANDLER,BROKER_RECEIVE_WAITFOR,BROKER_TASK_STOP,BROKER_TO_FLUSH,BROKER_TRANSMITTER,"
		+ "CHECKPOINT_QUEUE,CHKPT,CLR_AUTO_EVENT,CLR_MANUAL_EVENT,CLR_SEMAPHORE,DBMIRROR_DBM_EVENT,DBMIRROR_EVENTS_QUEUE,"
		+ "DBMIRROR_WORKER_QUEUE,DBMIRRORING_CMD,DIRTY_PAGE_POLL,DISPATCHER_QUEUE_SEMAPHORE,EXECSYNC,FSAGENT,"
		+ "FT_IFTS_SCHEDULER_IDLE_WAIT,FT_IFTSHC_MUTEX,HADR_CLUSAPI_CALL,HADR_FILESTREAM_IOMGR_IOCOMPLETION,"
		+ "HADR_LOGCAPTURE_WAIT,HADR_NOTIFICATION_DEQUEUE,HADR_TIMER_TASK,HADR_WORK_QUEUE,KSOURCE_WAKEUP,LAZYWRITER_SLEEP,"
		+ "LOGMGR_QUEUE,MEMORY_ALLOCATION_EXT,ONDEMAND_TASK_QUEUE,PARALLEL_REDO_DRAIN_WORKER,PARALLEL_REDO_LOG_CACHE,"
		+ "PARALLEL_REDO_TRAN_LIST,PARALLEL_REDO_WORKER_SYNC,PARALLEL_REDO_WORKER_WAIT_WORK,PREEMPTIVE_XE_GETTARGETSTATE,"
		+ "PWAIT_ALL_COMPONENTS_INITIALIZED,PWAIT_DIRECTLOGCONSUMER_GETNEXT,QDS_PERSIST_TASK_MAIN_LOOP_SLEEP,QDS_ASYNC_QUEUE,"
		+ "QDS_CLEANUP_STALE_QUERIES_TASK_MAIN_LOOP_SLEEP,QDS_SHUTDOWN_QUEUE,REDO_THREAD_PENDING_WORK,REQUEST_FOR_DEADLOCK_SEARCH,"
		+ "RESOURCE_QUEUE,SERVER_IDLE_CHECK,SLEEP_BPOOL_FLUSH,SLEEP_DBSTARTUP,SLEEP_DCOMSTARTUP,SLEEP_MASTERDBREADY,"
		+ "SLEEP_MASTERMDREADY,SLEEP_MASTERUPGRADED,SLEEP_MSDBSTARTUP,SLEEP_SYSTEMTASK,SLEEP_TASK,SLEEP_TEMPDBSTARTUP,"
		+ "SNI_HTTP_ACCEPT,SOS_WORK_DISPATCHER,SP_SERVER_DIAGNOSTICS_SLEEP,SQLTRACE_BUFFER_FLUSH,"
		+ "SQLTRACE_INCREMENTAL_FLUSH_SLEEP,SQLTRACE_WAIT_ENTRIES,VDI_CLIENT_OTHER,WAIT_FOR_RESULTS,WAITFOR,"
		+ "WAITFOR_TASKSHUTDOWN,WAIT_XTP_RECOVERY,WAIT_XTP_HOST_WAIT,WAIT_XTP_OFFLINE_CKPT_NEW_LOG,WAIT_XTP_CKPT_CLOSE,"
		+ "XE_DISPATCHER_JOIN,XE_DISPATCHER_WAIT,XE_TIMER_EVENT,XE_LIVE_TARGET_TVF";
	СписокФоновых = "N'" + СтрЗаменить(Фоновые, ",", "', N'") + "'";
	// без переводов строк и "|" в значениях: одна строка ответа - одна запись
	Чистый = "REPLACE(REPLACE(REPLACE(ISNULL(%1, N''), CHAR(13), N' '), CHAR(10), N' '), N'|', N'/')";
	Инструкция = "SUBSTRING(t.text, qs.statement_start_offset / 2 + 1, (CASE qs.statement_end_offset WHEN -1 "
		+ "THEN DATALENGTH(t.text) ELSE qs.statement_end_offset END - qs.statement_start_offset) / 2 + 1)";
	ТопКэша =
	"WITH q AS (SELECT TOP (10) * FROM sys.dm_exec_query_stats ORDER BY %2 DESC)
	|SELECT N'%1|' + CAST(qs.total_worker_time / 1000 AS nvarchar(20)) + N'|' + CAST(qs.execution_count AS nvarchar(20))
	|	+ N'|' + CAST(qs.total_elapsed_time / 1000 AS nvarchar(20)) + N'|' + CAST(qs.total_logical_reads AS nvarchar(20))
	|	+ N'|' + ISNULL(DB_NAME(CONVERT(int, pa.value)), N'') + N'|' + %3
	|FROM q AS qs
	|	CROSS APPLY sys.dm_exec_sql_text(qs.sql_handle) AS t
	|	OUTER APPLY (SELECT a.value FROM sys.dm_exec_plan_attributes(qs.plan_handle) AS a WHERE a.attribute = N'dbid') AS pa
	|ORDER BY qs.%2 DESC;";
	ТекстИнструкции = СтрШаблон(Чистый, Инструкция);

	Возврат
	"SET NOCOUNT ON;
	|SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;
	|SELECT N'T|' + CAST(SUM(u.unallocated_extent_page_count) * 8 / 1024 AS nvarchar(20)) + N'|'
	|	+ CAST(SUM(u.version_store_reserved_page_count) * 8 / 1024 AS nvarchar(20))
	|FROM tempdb.sys.dm_db_file_space_usage AS u;
	|SELECT TOP (1) N'S|' + CAST(s.session_id AS nvarchar(10)) + N'|' + CAST(s.elapsed_time_seconds AS nvarchar(20))
	|	+ N'|' + ISNULL(DB_NAME(es.database_id), N'') + N'|' + " + СтрШаблон(Чистый, "es.host_name") + " + N'|' + "
		+ СтрШаблон(Чистый, "es.program_name") + "
	|FROM sys.dm_tran_active_snapshot_database_transactions AS s
	|	LEFT JOIN sys.dm_exec_sessions AS es ON es.session_id = s.session_id
	|ORDER BY s.elapsed_time_seconds DESC;
	|SELECT TOP (30) N'X|' + CAST(st.session_id AS nvarchar(10)) + N'|'
	|	+ CAST(DATEDIFF(second, ta.transaction_begin_time, GETDATE()) AS nvarchar(20)) + N'|'
	|	+ CAST(ISNULL(r.blocking_session_id, 0) AS nvarchar(10)) + N'|' + ISNULL(r.wait_type, N'') + N'|'
	|	+ CAST(ISNULL(r.wait_time, 0) AS nvarchar(20)) + N'|' + ISNULL(DB_NAME(es.database_id), N'') + N'|'
	|	+ " + СтрШаблон(Чистый, "es.host_name") + " + N'|' + " + СтрШаблон(Чистый, "es.program_name") + " + N'|'
	|	+ " + СтрШаблон(Чистый, "LEFT(t.text, 4000)") + "
	|FROM sys.dm_tran_session_transactions AS st
	|	JOIN sys.dm_tran_active_transactions AS ta ON ta.transaction_id = st.transaction_id
	|	JOIN sys.dm_exec_sessions AS es ON es.session_id = st.session_id
	|	LEFT JOIN sys.dm_exec_requests AS r ON r.session_id = st.session_id
	|	OUTER APPLY sys.dm_exec_sql_text(r.sql_handle) AS t
	|WHERE es.is_user_process = 1
	|	AND (ta.transaction_begin_time <= DATEADD(second, -" + Формат(ПорогТранзакции, "ЧГ=0; ЧН=0") + ", GETDATE())
	|		OR r.blocking_session_id > 0)
	|ORDER BY ta.transaction_begin_time;
	|" + СтрШаблон(ТопКэша, "C", "total_worker_time", ТекстИнструкции) + "
	|" + СтрШаблон(ТопКэша, "F", "execution_count", ТекстИнструкции) + "
	|SELECT N'W|' + w.wait_type + N'|' + CAST(w.wait_time_ms AS nvarchar(20)) + N'|' + CAST(w.signal_wait_time_ms AS nvarchar(20))
	|FROM sys.dm_os_wait_stats AS w
	|WHERE w.wait_time_ms > 0
	|	AND w.wait_type NOT IN (" + СписокФоновых + ");";

КонецФункции

// Пакет T-SQL давности статистик (только чтение). Строки ответа:
//  A|БД|таблица|строк|часов с обновления|дата обновления|изменений - самая старая изменённая статистика таблицы
//  E|БД|ошибка - БД не прочитана (нет прав, недоступна)
//
// Параметры:
//  БазыСервера - Соответствие - НРег(имя БД) -> имя ИБ.
//  МинСтрок - Число - таблицы меньше не рассматриваются.
//
// Возвращаемое значение:
//  Строка - текст пакета.
Функция ТекстЗапросаСтатистикиSQL(БазыСервера, МинСтрок)

	Имена = Новый Массив;
	Для Каждого КЗ Из БазыСервера Цикл
		Имена.Добавить("N'" + СтрЗаменить(КЗ.Ключ, "'", "''") + "'");
	КонецЦикла;
	Возврат
	"SET NOCOUNT ON;
	|DECLARE @r TABLE (db sysname, tbl sysname, rws bigint, hrs decimal(18, 1) NULL, upd datetime NULL, mods bigint NULL);
	|DECLARE @db sysname, @s nvarchar(max);
	|DECLARE c CURSOR LOCAL FAST_FORWARD FOR
	|	SELECT d.name FROM sys.databases AS d
	|	WHERE d.state_desc = N'ONLINE' AND LOWER(d.name) IN (" + СтрСоединить(Имена, ", ") + ");
	|OPEN c;
	|FETCH NEXT FROM c INTO @db;
	|WHILE @@FETCH_STATUS = 0
	|BEGIN
	|	SET @s = N'USE ' + QUOTENAME(@db) + N';
	|SELECT TOP (5) DB_NAME(), t.name, p.rws, DATEDIFF(minute, x.upd, GETDATE()) / 60.0, x.upd, x.mods
	|FROM sys.tables AS t
	|	CROSS APPLY (SELECT SUM(ps.row_count) AS rws FROM sys.dm_db_partition_stats AS ps
	|		WHERE ps.object_id = t.object_id AND ps.index_id IN (0, 1)) AS p
	|	OUTER APPLY (SELECT MIN(CASE WHEN sp.modification_counter > 0 THEN sp.last_updated END) AS upd,
	|		SUM(sp.modification_counter) AS mods
	|		FROM sys.stats AS st CROSS APPLY sys.dm_db_stats_properties(st.object_id, st.stats_id) AS sp
	|		WHERE st.object_id = t.object_id) AS x
	|WHERE p.rws >= @min
	|ORDER BY p.rws DESC;';
	|	BEGIN TRY
	|		INSERT INTO @r EXEC sp_executesql @s, N'@min bigint', @min = " + Формат(МинСтрок, "ЧГ=0; ЧН=0") + ";
	|	END TRY
	|	BEGIN CATCH
	|		SELECT N'E|' + @db + N'|' + REPLACE(ERROR_MESSAGE(), N'|', N'/');
	|	END CATCH;
	|	FETCH NEXT FROM c INTO @db;
	|END;
	|CLOSE c;
	|DEALLOCATE c;
	|SELECT N'A|' + db + N'|' + tbl + N'|' + CAST(rws AS nvarchar(20)) + N'|' + ISNULL(CAST(hrs AS nvarchar(20)), N'0')
	|	+ N'|' + ISNULL(CONVERT(nvarchar(19), upd, 120), N'') + N'|' + CAST(ISNULL(mods, 0) AS nvarchar(20))
	|FROM @r;";

КонецФункции

// Выполняет пакет T-SQL через sqlcmd из временного файла UTF-8, вывод в UTF-8 без обрезки значений.
//
// Параметры:
//  СерверSQL - Строка - имя экземпляра.
//  Текст - Строка - пакет T-SQL.
//
// Возвращаемое значение:
//  Структура - см. ВыполнитьКоманду.
Функция ВыполнитьПакетSQL(СерверSQL, Текст)

	ФайлЗапроса = ПолучитьИмяВременногоФайла("sql");
	ЗаписьФайла = Новый ЗаписьТекста(ФайлЗапроса, КодировкаТекста.UTF8);
	ЗаписьФайла.Записать(Текст);
	ЗаписьФайла.Закрыть();
	// -y 0: длинные тексты без обрезки (несовместим с -W и -h, заголовки отсекает разбор по виду строки);
	// -f 65001: кириллица в текстах запросов; -I: QUOTED_IDENTIFIER ON для DMV с xml
	Ответ = ВыполнитьКоманду(КомандаSQL(СерверSQL) + " -b -I -y 0 -f 65001 -i """ + ФайлЗапроса + """", "UTF-8");
	УдалитьФайлы(ФайлЗапроса);
	Возврат Ответ;

КонецФункции

// Размер сеансовых данных кластеров (srvinfo\reg_<порт>\snccntx*, ИТС 5860) и свободное место на их диске.
// Каталог srvinfo - настройка КаталогSrvinfo.<сервер> или общая КаталогSrvinfo
// (по умолчанию C:\Program Files\1cv8\srvinfo); чужой сервер - через \\<сервер>\<диск>$, как в СборТЖ.
// Тревога - свободно меньше ПорогСвободноДискСеансовыхДанныхМБ (10240), не чаще раза в час.
//
// Параметры:
//  Счетчики - Соответствие - см. ДобавитьСчетчикСнимка.
//
// Возвращаемое значение:
//  Строка - итог для журнала.
Функция СнимокСеансовыхДанных(Счетчики)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	С.Сервер1С.Наименование КАК Сервер1С
	|ИЗ
	|	РегистрСведений.СерверыИБазы КАК С
	|ГДЕ
	|	С.Сервер1С <> ЗНАЧЕНИЕ(Справочник.Сервер1С.ПустаяСсылка)";
	Выборка = Запрос.Выполнить().Выбрать();

	ОбщийКаталог = Строка(Настройка("КаталогSrvinfo", "C:\Program Files\1cv8\srvinfo"));
	ПорогСвободно = ЧислоСнимка(Настройка("ПорогСвободноДискСеансовыхДанныхМБ", 10240));
	ЭтотКомпьютер = ВРег(ИмяКомпьютера());
	Итоги = Новый Массив;
	Обойдённые = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Части = СтрРазделить(СокрЛП(Выборка.Сервер1С) + ":", ":");
		Хост = СокрЛП(Части[0]);
		Порт = ?(ЗначениеЗаполнено(Части[1]), СокрЛП(Части[1]), "1541");
		Если НЕ ЗначениеЗаполнено(Хост) ИЛИ Обойдённые.Получить(ВРег(Хост + ":" + Порт)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Обойдённые.Вставить(ВРег(Хост + ":" + Порт), Истина);
		// у каждого кластера свой srvinfo (параметр -d службы ragent): настройка на хост:порт, затем из службы
		// @skip-check query-in-loop - цикл по серверам 1С (единицы), чтение одной настройки
		Каталог = Строка(Настройка("КаталогSrvinfo." + Хост + ":" + Порт, ""));
		Если НЕ ЗначениеЗаполнено(Каталог) Тогда
			Каталог = КаталогSrvinfoИзСлужбы(Хост, Порт, ЭтотКомпьютер);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Каталог) Тогда
			Каталог = Строка(Настройка("КаталогSrvinfo." + Хост, ОбщийКаталог));
		КонецЕсли;
		Путь = КаталогТЖДляЧтения(Хост, СокрЛП(Каталог) + "\reg_" + Порт, ЭтотКомпьютер);

		РазмерБайт = 0;
		Для Каждого КаталогДанных Из НайтиФайлы(Путь, "snccntx*", Ложь) Цикл
			Если НЕ КаталогДанных.ЭтоКаталог() Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Файл Из НайтиФайлы(КаталогДанных.ПолноеИмя, "*", Истина) Цикл
				Если НЕ Файл.ЭтоКаталог() Тогда
					РазмерБайт = РазмерБайт + Файл.Размер();
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		РазмерМБ = Окр(РазмерБайт / 1048576, 1);
		ДобавитьСчетчикСнимка(Счетчики, Хост, "Сеансовые данные reg_" + Порт + ", МБ", РазмерМБ);

		Корень = КореньДиска(Путь);
		СвободноМБ = СвободноНаДискеМБ(Корень);
		Если СвободноМБ >= 0 Тогда
			ДобавитьСчетчикСнимка(Счетчики, Хост, "Диск сеансовых данных reg_" + Порт + ": свободно, МБ", СвободноМБ);
			Если СвободноМБ < ПорогСвободно Тогда
				ТревогаСнимка("snccntx " + Хост + ":" + Порт, СтрШаблон(
					"Сервер %1: на диске сеансовых данных кластера %2 (%3) свободно %4 МБ (порог %5), сеансовые данные %6 МБ (ИТС 5860)",
					Хост, Порт, Корень, Формат(СвободноМБ, "ЧГ=0; ЧН=0"), ПорогСвободно, Формат(РазмерМБ, "ЧГ=0; ЧН=0")), 3600);
			КонецЕсли;
		КонецЕсли;
		Итоги.Добавить(СтрШаблон("%1:%2 snccntx %3 МБ, свободно %4 МБ", Хост, Порт, Формат(РазмерМБ, "ЧГ=0; ЧН=0"),
			Формат(СвободноМБ, "ЧГ=0; ЧН=0")));
	КонецЦикла;
	Возврат СтрСоединить(Итоги, "; ");

КонецФункции

// Каталог srvinfo кластера из командной строки службы ragent с "-regport <Порт>": значение параметра -d.
//
// Параметры:
//  Хост - Строка - компьютер сервера 1С.
//  Порт - Строка - порт регистратора кластера (1541, 8541, ...).
//  ЭтотКомпьютер - Строка - ВРег(ИмяКомпьютера()).
//
// Возвращаемое значение:
//  Строка - каталог srvinfo или пустая строка, если служба не найдена.
Функция КаталогSrvinfoИзСлужбы(Хост, Порт, ЭтотКомпьютер)

	Узел = ?(ВРег(Хост) = ЭтотКомпьютер ИЛИ ВРег(Хост) = "LOCALHOST", "", " /node:""" + Хост + """");
	// wmic при выводе в файл пишет UTF-16
	Ответ = ВыполнитьКоманду("wmic" + Узел + " service where ""PathName like '%ragent%'"" get PathName /value", "UTF-16");
	Если Ответ.КодВозврата <> 0 Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого СтрокаВывода Из СтрРазделить(Ответ.Вывод, Символы.ПС, Ложь) Цикл
		Текст = СокрЛП(СтрокаВывода);
		Если СтрНайти(Текст, "-regport " + Порт + " ") = 0 И НЕ СтрЗаканчиваетсяНа(Текст, "-regport " + Порт) Тогда
			Продолжить;
		КонецЕсли;
		Позиция = СтрНайти(Текст, " -d ");
		Если Позиция = 0 Тогда
			Возврат "";
		КонецЕсли;
		Значение = СокрЛ(Сред(Текст, Позиция + 4));
		Если СтрНачинаетсяС(Значение, """") Тогда
			Конец = СтрНайти(Значение, """", , 2);
			Возврат ?(Конец = 0, Сред(Значение, 2), Сред(Значение, 2, Конец - 2));
		КонецЕсли;
		Конец = СтрНайти(Значение, " ");
		Возврат ?(Конец = 0, Значение, Лев(Значение, Конец - 1));
	КонецЦикла;
	Возврат "";

КонецФункции

// Корень диска пути: "X:\" для локального пути, "\\сервер\шара\" для UNC.
//
// Параметры:
//  Путь - Строка - путь к каталогу.
//
// Возвращаемое значение:
//  Строка - корень диска.
Функция КореньДиска(Путь)

	Если СтрНачинаетсяС(Путь, "\\") Тогда
		Части = СтрРазделить(Сред(Путь, 3), "\", Ложь);
		Если Части.Количество() >= 2 Тогда
			Возврат "\\" + Части[0] + "\" + Части[1] + "\";
		КонецЕсли;
		Возврат Путь;
	КонецЕсли;
	Возврат Лев(Путь, 3);

КонецФункции

// Свободное место на диске по последнему числу вывода «dir /-c» (байт свободно).
//
// Параметры:
//  Корень - Строка - корень диска, см. КореньДиска.
//
// Возвращаемое значение:
//  Число - свободно, МБ; -1 - не удалось определить.
Функция СвободноНаДискеМБ(Корень)

	Ответ = ВыполнитьКоманду("dir /-c """ + Корень + """");
	Если Ответ.КодВозврата <> 0 Тогда
		Возврат -1;
	КонецЕсли;
	Строки = СтрРазделить(Ответ.Вывод, Символы.ПС, Ложь);
	Если Строки.Количество() = 0 Тогда
		Возврат -1;
	КонецЕсли;
	// последняя строка: "<N> папок  <байт> байт свободно" / "<N> Dir(s)  <bytes> bytes free"
	Последняя = СокрЛП(Строки[Строки.ВГраница()]);
	Цифры = "";
	Для Позиция = 1 По СтрДлина(Последняя) Цикл
		Символ = Сред(Последняя, Позиция, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		ИначеЕсли ЗначениеЗаполнено(Цифры) И Символ <> " " И Символ <> Символы.НПП Тогда
			Цифры = Цифры + " ";
		КонецЕсли;
	КонецЦикла;
	Числа = СтрРазделить(Цифры, " ", Ложь);
	Если Числа.Количество() = 0 Тогда
		Возврат -1;
	КонецЕсли;
	Возврат Окр(Число(Числа[Числа.ВГраница()]) / 1048576);

КонецФункции

// Перезаписывает набор рбфСнимокСейчас по Вид и Сервер. Ключи с одинаковым ВРег пропускаются
// (измерения строки в SQL Server сравниваются без регистра).
//
// Параметры:
//  Вид - Строка - вид строк снимка.
//  Сервер - Строка - сервер 1С или SQL.
//  Строки - Массив из Структура - см. НоваяСтрокаСнимка.
//  Время - Дата - момент снимка.
Процедура ЗаписатьСнимок(Вид, Сервер, Строки, Время)

	Набор = РегистрыСведений.рбфСнимокСейчас.СоздатьНаборЗаписей();
	Набор.Отбор.Вид.Установить(Вид);
	Набор.Отбор.Сервер.Установить(Лев(Сервер, 100));
	Ключи = Новый Соответствие;
	Для Каждого СтрокаСнимка Из Строки Цикл
		Ключ = Лев(СокрЛП(СтрокаСнимка.Ключ), 150);
		Если Ключи.Получить(ВРег(Ключ)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Ключи.Вставить(ВРег(Ключ), Истина);
		Запись = Набор.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, СтрокаСнимка);
		Запись.Вид = Вид;
		Запись.Сервер = Лев(Сервер, 100);
		Запись.Ключ = Ключ;
		Запись.Время = Время;
		Запись.База = Лев(СтрокаСнимка.База, 100);
		Запись.Пользователь = Лев(СтрокаСнимка.Пользователь, 100);
	КонецЦикла;
	Набор.Записать(Истина);

КонецПроцедуры

// Пустая строка снимка для ЗаписатьСнимок.
//
// Возвращаемое значение:
//  Структура - Ключ, База, Пользователь, Текст (Строка), Сеанс, SPID, БлокированЛ, БлокированСУБД,
//   ДлительностьСек, ПамятьМБ, Значение, Значение2 (Число).
Функция НоваяСтрокаСнимка()

	Возврат Новый Структура("Ключ,База,Пользователь,Текст,Сеанс,SPID,БлокированЛ,БлокированСУБД,"
		+ "ДлительностьСек,ПамятьМБ,Значение,Значение2", "", "", "", "", 0, 0, 0, 0, 0, 0, 0, 0);

КонецФункции

// Добавляет значение счётчика сервера для записи в рбфСчетчики (ПринятьСчетчики по серверу).
//
// Параметры:
//  Счетчики - Соответствие - сервер -> Соответствие: имя счётчика -> Число.
//  Сервер - Строка - сервер.
//  Имя - Строка - имя счётчика.
//  Значение - Число - значение.
Процедура ДобавитьСчетчикСнимка(Счетчики, Сервер, Имя, Значение)

	Значения = Счетчики.Получить(Сервер);
	Если Значения = Неопределено Тогда
		Значения = Новый Соответствие;
		Счетчики.Вставить(Сервер, Значения);
	КонецЕсли;
	Значения.Вставить(Имя, Значение);

КонецПроцедуры

// Тревога снимка в Telegram не чаще раза в ИнтервалСек на ключ (отметка - в НастройкиПравилРеестра).
//
// Параметры:
//  Ключ - Строка - ключ тревоги.
//  Текст - Строка - сообщение.
//  ИнтервалСек - Число - минимальный интервал повтора.
Процедура ТревогаСнимка(Ключ, Текст, ИнтервалСек)

	КлючТревоги = Лев("Тревога " + Ключ, 100);
	Прошлая = ДатаИзISO(Строка(Настройка(КлючТревоги, "")));
	Если ЗначениеЗаполнено(Прошлая) И ТекущаяДатаСеанса() - Прошлая < ИнтервалСек Тогда
		Возврат;
	КонецЕсли;
	ЗаписатьНастройку(КлючТревоги, Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	ОтправитьТелеграм(Текст);

КонецПроцедуры

// Число из строки вывода rac или sqlcmd; нечисловое и пустое - 0.
//
// Параметры:
//  Значение - Строка, Число, Неопределено - значение.
//
// Возвращаемое значение:
//  Число - значение.
Функция ЧислоСнимка(Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Текст = СтрЗаменить(СокрЛП(Строка(Значение)), ",", ".");
	Если ПустаяСтрока(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Текст);
	Исключение
		// не число (например, "yes" или текст ошибки) - считаем нулём
		Возврат 0;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СборТЖ

// Серверы, ТЖ которых читает рбфСборТЖ, с их настройками: строки «Агент.<Сервер>» в НастройкиПравилРеестра
// и серверы рбфНастройкиТЖ, у которых включён хотя бы один показатель базы.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Сервер - Строка - имя сервера.
//   * Каталог - Строка - каталог ТЖ, доступный rphost base_list (локальный или UNC).
//   * ПропускатьСобытия - Соответствие - имя события -> Истина.
//   * МаксДлинаТекста - Число - предельная длина текстов события.
//   * ПакетСобытий - Число - событий в одном вызове ПринятьВыполненияТЖ.
//   * ТопНаСобытие - Число - строк агрегатов на вид события.
Функция СерверыСбораТЖ()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПОДСТРОКА(Агенты.Параметр, 7, 44) КАК Сервер
	|ПОМЕСТИТЬ ВТСерверы
	|ИЗ
	|	РегистрСведений.НастройкиПравилРеестра КАК Агенты
	|ГДЕ
	|	Агенты.Параметр ПОДОБНО ""Агент.%""
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	НастройкиБаз.Сервер1С
	|ИЗ
	|	РегистрСведений.рбфНастройкиТЖ КАК НастройкиБаз
	|ГДЕ
	|	НастройкиБаз.ИмяБазы1С <> """"
	|	И (НастройкиБаз.ДолгийЗапрос
	|			ИЛИ НастройкиБаз.ОжиданиеНаБлокировке1С
	|			ИЛИ НастройкиБаз.ОжиданиеНаБлокировкеСУБД
	|			ИЛИ НастройкиБаз.Взаимоблокировка1С
	|			ИЛИ НастройкиБаз.ВзаимоблокировкаСУБД
	|			ИЛИ НастройкиБаз.ОшибкаТЖ
	|			ИЛИ НастройкиБаз.Транзакции
	|			ИЛИ НастройкиБаз.СерверныйВызов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСерверы.Сервер КАК Сервер,
	|	ЕСТЬNULL(Агенты.Значение, """") КАК Настройки,
	|	ЕСТЬNULL(НастройкиСервера.КаталогЛогов, """") КАК КаталогЛогов
	|ИЗ
	|	ВТСерверы КАК ВТСерверы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиПравилРеестра КАК Агенты
	|		ПО (Агенты.Параметр = ""Агент."" + ВТСерверы.Сервер)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.рбфНастройкиТЖ КАК НастройкиСервера
	|		ПО (НастройкиСервера.Сервер1С = ВТСерверы.Сервер)
	|			И (НастройкиСервера.ИмяБазы1С = """")";
	Выборка = Запрос.Выполнить().Выбрать();

	КаталогПоУмолчанию = Строка(Настройка("КаталогЛоговТЖ", "D:\logs_1c\rbf"));
	ЭтотКомпьютер = ВРег(ИмяКомпьютера());
	Результат = Новый Массив;
	Добавленные = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		// в рбфНастройкиТЖ сервер записан с портом кластера (S2019:1541, S2019:8541), а logcfg и файлы ТЖ - одни на машину
		ИмяСервера = СокрЛП(СтрРазделить(СокрЛП(Выборка.Сервер) + ":", ":")[0]);
		Если НЕ ЗначениеЗаполнено(ИмяСервера) ИЛИ Добавленные.Получить(ВРег(ИмяСервера)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Добавленные.Вставить(ВРег(ИмяСервера), Истина);

		Настройки = РазобратьНастройкиАгента(Строка(Выборка.Настройки));
		Если НЕ Настройки.ОтправлятьСобытия Тогда
			Продолжить;
		КонецЕсли;
		Каталог = Настройки.КаталогТЖ;
		Если НЕ ЗначениеЗаполнено(Каталог) Тогда
			Каталог = ?(ЗначениеЗаполнено(Выборка.КаталогЛогов), Выборка.КаталогЛогов, КаталогПоУмолчанию);
		КонецЕсли;
		Пропускать = Новый Соответствие;
		Для Каждого ИмяСобытия Из Настройки.ПропускатьСобытия Цикл
			Пропускать.Вставить(ВРег(СокрЛП(Строка(ИмяСобытия))), Истина);
		КонецЦикла;

		НастройкиСервера = Новый Структура;
		НастройкиСервера.Вставить("Сервер", ИмяСервера);
		НастройкиСервера.Вставить("Каталог", КаталогТЖДляЧтения(ИмяСервера, СокрЛП(Каталог), ЭтотКомпьютер));
		НастройкиСервера.Вставить("ПропускатьСобытия", Пропускать);
		НастройкиСервера.Вставить("МаксДлинаТекста", Макс(Настройки.МаксДлинаТекста, 0));
		НастройкиСервера.Вставить("ПакетСобытий", ?(Настройки.ПакетСобытий > 0 И Настройки.ПакетСобытий <= 5000,
			Настройки.ПакетСобытий, 2000));
		НастройкиСервера.Вставить("ТопНаСобытие", ?(Настройки.ТопНаСобытие > 0, Настройки.ТопНаСобытие, 100));
		Результат.Добавить(НастройкиСервера);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Каталог ТЖ, как его видит rphost base_list: для своего компьютера и UNC - как есть,
// локальный путь чужого сервера X:\... - через административную шару \\<сервер>\X$\....
//
// Параметры:
//  Сервер - Строка - имя сервера.
//  Каталог - Строка - каталог ТЖ из настроек сервера.
//  ЭтотКомпьютер - Строка - ВРег(ИмяКомпьютера()) процесса, где работает задание.
//
// Возвращаемое значение:
//  Строка - путь для чтения.
Функция КаталогТЖДляЧтения(Сервер, Каталог, ЭтотКомпьютер)

	ИмяСервера = ВРег(Сервер);
	ЭтоСвойКомпьютер = (ИмяСервера = ЭтотКомпьютер
		ИЛИ ИмяСервера = ВРег(СтрРазделить(ЭтотКомпьютер, ".")[0])
		ИЛИ ВРег(СтрРазделить(ИмяСервера, ".")[0]) = ЭтотКомпьютер);
	Если ЭтоСвойКомпьютер ИЛИ СтрНачинаетсяС(Каталог, "\\") Тогда
		Возврат Каталог;
	КонецЕсли;
	Если СтрДлина(Каталог) >= 2 И Сред(Каталог, 2, 1) = ":" Тогда
		Возврат "\\" + Сервер + "\" + Лев(Каталог, 1) + "$" + Сред(Каталог, 3);
	КонецЕсли;
	Возврат Каталог;

КонецФункции

// Прочитанные позиции файлов ТЖ всех серверов.
//
// Возвращаемое значение:
//  Соответствие - ВРег(сервер) -> Соответствие: ПутьХеш -> Смещение.
Функция ПозицииФайловТЖ()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Позиции.Сервер КАК Сервер,
	|	Позиции.ПутьХеш КАК ПутьХеш,
	|	Позиции.Смещение КАК Смещение
	|ИЗ
	|	РегистрСведений.рбфПозицииФайловТЖ КАК Позиции";
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		КлючСервера = ВРег(СокрЛП(Выборка.Сервер));
		ПозицииСервера = Результат.Получить(КлючСервера);
		Если ПозицииСервера = Неопределено Тогда
			ПозицииСервера = Новый Соответствие;
			Результат.Вставить(КлючСервера, ПозицииСервера);
		КонецЕсли;
		ПозицииСервера.Вставить(Выборка.ПутьХеш, Выборка.Смещение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Дочитывает файлы ТЖ одного сервера, записывает события и затем позиции (одним набором).
// Ошибка записи событий - исключение, позиции не сдвигаются: следующий запуск перечитает то же
// (Ид события от смещения не зависит, повтор перезаписывает строки).
//
// Параметры:
//  НастройкиСервера - Структура - см. СерверыСбораТЖ.
//  ПозицииСервера - Соответствие, Неопределено - см. ПозицииФайловТЖ; Неопределено - первый запуск.
//  Лимиты - Структура - Событий, ДоМс, Записано: общие лимиты запуска.
//
// Возвращаемое значение:
//  Строка - итог для журнала.
Функция СобратьТЖСервера(НастройкиСервера, ПозицииСервера, Лимиты)

	Каталог = НастройкиСервера.Каталог;
	Если НЕ ЗначениеЗаполнено(Каталог) Тогда
		Возврат "каталог ТЖ не задан";
	КонецЕсли;
	КаталогФайл = Новый Файл(Каталог);
	Если НЕ КаталогФайл.Существует() Тогда
		ВызватьИсключение "нет доступа к каталогу ТЖ " + Каталог;
	КонецЕсли;

	Сейчас = ТекущаяДатаСеанса();
	ТекущийЧас = Формат(Сейчас, "ДФ=yyMMddHH");
	ПервыйЗапуск = (ПозицииСервера = Неопределено);
	События = Новый Массив;
	Видели = Новый Соответствие;
	НовыеПозиции = Новый Массив;
	Файлов = 0;

	// файлы текущего и прошлого часа - поиском по имени: в каталоге десятки тысяч файлов (каждый процесс,
	// в том числе каждый запуск rac, раз в час заводит файл в каждом журнале), почти все пустые; перебор всех
	// с временем изменения и записью позиций каждого занимал основную часть минуты сбора (22.10.2026)
	ФайлыЧасов = НайтиФайлы(Каталог, Формат(Сейчас - 3600, "ДФ=yyMMddHH") + ".log", Истина);
	Для Каждого Файл Из НайтиФайлы(Каталог, ТекущийЧас + ".log", Истина) Цикл
		ФайлыЧасов.Добавить(Файл);
	КонецЦикла;
	Для Каждого Файл Из ФайлыЧасов Цикл
		ИмяЧаса = Файл.ИмяБезРасширения;
		Размер = Файл.Размер();
		Если Размер <= 3 Тогда
			// пустой файл или только BOM (таких ~98%): событий нет, позицию не храним - когда файл вырастет,
			// он прочитается с начала (BOM пропускается)
			Продолжить;
		КонецЕсли;
		Файлов = Файлов + 1;
		Путь = Файл.ПолноеИмя;
		ПутьХеш = ХешMD5ТЖ(Путь);
		Смещение = ?(ПервыйЗапуск, Размер, ПозицииСервера.Получить(ПутьХеш));
		Если Смещение = Неопределено ИЛИ Смещение > Размер Тогда
			Смещение = 0; // новый или пересозданный файл
		КонецЕсли;

		Если Смещение < Размер И Лимиты.Событий > 0 И ТекущаяУниверсальнаяДатаВМиллисекундах() < Лимиты.ДоМс Тогда
			Контекст = Новый Структура;
			Контекст.Вставить("Сервер", НастройкиСервера);
			Контекст.Вставить("Процесс", ИмяКаталогаФайлаТЖ(Файл.Путь));
			Контекст.Вставить("ИмяФайла", Файл.Имя);
			Контекст.Вставить("ДлинныйЛог", СтрНайти(ВРег(Файл.Путь), "\LONGEVENTS\") > 0);
			Контекст.Вставить("ЭтоТекущийЧас", ИмяЧаса = ТекущийЧас);
			Попытка
				Контекст.Вставить("Час", Дата(2000 + Число(Лев(ИмяЧаса, 2)), Число(Сред(ИмяЧаса, 3, 2)),
					Число(Сред(ИмяЧаса, 5, 2)), Число(Сред(ИмяЧаса, 7, 2)), 0, 0));
				Смещение = ПрочитатьСобытияФайлаТЖ(Путь, Смещение, Размер, Контекст, События, Видели, Лимиты);
			Исключение
				// файл занят или не читается: позиция остаётся прежней, следующий запуск попробует снова
				ЗаписьЖурналаРегистрации("Мониторинг.СборТЖ", УровеньЖурналаРегистрации.Предупреждение, , ,
					Путь + ": " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЕсли;

		НовыеПозиции.Добавить(Новый Структура("Путь,ПутьХеш,Смещение", Путь, ПутьХеш, Смещение));
	КонецЦикла;

	Записано = 0;
	Пропущено = 0;
	Пакет = НастройкиСервера.ПакетСобытий;
	Индекс = 0;
	Пока Индекс < События.Количество() Цикл
		Часть = Новый Массив;
		Пока Индекс < События.Количество() И Часть.Количество() < Пакет Цикл
			Часть.Добавить(События[Индекс]);
			Индекс = Индекс + 1;
		КонецЦикла;
		Итог = рбфАнализСервер.ПринятьВыполненияТЖ(НастройкиСервера.Сервер, Часть);
		Записано = Записано + Итог.written;
		Пропущено = Пропущено + Итог.skipped;
	КонецЦикла;
	Лимиты.Записано = Лимиты.Записано + Записано;

	ИмяСервера = Лев(НастройкиСервера.Сервер, 100);
	Набор = РегистрыСведений.рбфПозицииФайловТЖ.СоздатьНаборЗаписей();
	Набор.Отбор.Сервер.Установить(ИмяСервера);
	Для Каждого Позиция Из НовыеПозиции Цикл
		Запись = Набор.Добавить();
		Запись.Сервер = ИмяСервера;
		Запись.ПутьХеш = Позиция.ПутьХеш;
		Запись.Путь = Позиция.Путь;
		Запись.Смещение = Позиция.Смещение;
		Запись.Изменено = Сейчас;
	КонецЦикла;
	Набор.Записать(Истина);

	Возврат СтрШаблон("файлов %1, событий %2, записано %3, пропущено %4%5", Файлов, События.Количество(),
		Записано, Пропущено, ?(ПервыйЗапуск, " (первый запуск: с конца файлов)", ""));

КонецФункции

// Читает файл ТЖ с байтового смещения и добавляет его события в События.
// Не больше 16 МБ за раз; последнее событие не берётся, если файл текущего часа (может быть недописано)
// или прочитан не до конца. BOM в начале файла пропускается.
//
// Параметры:
//  Путь - Строка - полное имя файла.
//  Смещение - Число - сколько байт уже прочитано.
//  Размер - Число - размер файла, байт.
//  Контекст - Структура - Сервер, Процесс, ИмяФайла, ЭтоТекущийЧас, Час.
//  События - Массив из Соответствие - куда добавлять события (формат ПринятьВыполненияТЖ).
//  Видели - Соответствие - Ид уже добавленных событий: копии одного события из разных логов.
//  Лимиты - Структура - см. СобратьТЖСервера.
//
// Возвращаемое значение:
//  Число - новое смещение, байт: начало первого необработанного события.
Функция ПрочитатьСобытияФайлаТЖ(Путь, Смещение, Размер, Контекст, События, Видели, Лимиты)

	МаксБайт = 16777216;
	Байт = Мин(Размер - Смещение, МаксБайт);
	Буфер = Новый БуферДвоичныхДанных(Байт);
	Прочитано = 0;
	Поток = ФайловыеПотоки.ОткрытьДляЧтения(Путь);
	Попытка
		Поток.Перейти(Смещение, ПозицияВПотоке.Начало);
		Пока Прочитано < Байт Цикл
			Порция = Поток.Прочитать(Буфер, Прочитано, Байт - Прочитано);
			Если Порция <= 0 Тогда
				Прервать;
			КонецЕсли;
			Прочитано = Прочитано + Порция;
		КонецЦикла;
		Поток.Закрыть();
	Исключение
		Поток.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Если Прочитано = 0 Тогда
		Возврат Смещение;
	КонецЕсли;
	ДоКонца = (Смещение + Прочитано >= Размер);

	Пропуск = 0;
	Если Смещение = 0 И Прочитано >= 3
		И Буфер.Получить(0) = 239 И Буфер.Получить(1) = 187 И Буфер.Получить(2) = 191 Тогда
		Пропуск = 3;
	КонецЕсли;
	Если Прочитано = Пропуск Тогда
		Возврат Смещение + Прочитано;
	КонецЕсли;
	Текст = ПолучитьСтрокуИзБуфераДвоичныхДанных(Буфер.Прочитать(Пропуск, Прочитано - Пропуск), КодировкаТекста.UTF8);

	Начала = НачалаСобытийТЖ(Текст);
	Если Начала.Количество() = 0 Тогда
		// хвост длинного значения или недописанная первая строка текущего файла
		Возврат ?(ДоКонца И Контекст.ЭтоТекущийЧас, Смещение, Смещение + Прочитано);
	КонецЕсли;
	Полных = Начала.Количество();
	Если Контекст.ЭтоТекущийЧас ИЛИ НЕ ДоКонца Тогда
		Полных = Полных - 1;
	КонецЕсли;
	Если Полных = 0 И НЕ ДоКонца Тогда
		// одно событие длиннее 16 МБ: пропускаем порцию, чтобы не стоять на месте
		Возврат Смещение + Прочитано;
	КонецЕсли;

	Обработано = 0;
	ДлинаТекста = СтрДлина(Текст);
	Для Номер = 0 По Полных - 1 Цикл
		Если Лимиты.Событий <= 0 ИЛИ ТекущаяУниверсальнаяДатаВМиллисекундах() >= Лимиты.ДоМс Тогда
			Прервать;
		КонецЕсли;
		Начало = Начала[Номер];
		Конец = ?(Номер + 1 < Начала.Количество(), Начала[Номер + 1], ДлинаТекста + 1);
		Обработано = Номер + 1;
		// ошибка разбора одного события не должна останавливать файл: позиция иначе не двигается
		Попытка
			Событие = СобытиеФайлаТЖ(СокрП(Сред(Текст, Начало, Конец - Начало)), Контекст);
		Исключение
			ЗаписьЖурналаРегистрации("Мониторинг.СборТЖ", УровеньЖурналаРегистрации.Предупреждение, , ,
				Путь + ": событие пропущено: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
				+ Символы.ПС + Лев(Сред(Текст, Начало, Конец - Начало), 300));
			Событие = Неопределено;
		КонецПопытки;
		Если Событие = Неопределено ИЛИ Видели.Получить(Событие.Получить("id")) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Видели.Вставить(Событие.Получить("id"), Истина);
		События.Добавить(Событие);
		Лимиты.Событий = Лимиты.Событий - 1;
	КонецЦикла;

	Если Обработано = Начала.Количество() Тогда
		Возврат Смещение + Прочитано;
	КонецЕсли;
	Граница = Начала[Обработано];
	Возврат Смещение + Пропуск
		+ ПолучитьБуферДвоичныхДанныхИзСтроки(Лев(Текст, Граница - 1), КодировкаТекста.UTF8, Ложь).Размер;

КонецФункции

// Позиции (номер символа) начал событий ТЖ: строки вида "мм:сс.дробь-длительность,".
//
// Параметры:
//  Текст - Строка - прочитанная часть файла.
//
// Возвращаемое значение:
//  Массив из Число - позиции первых символов строк-заголовков.
Функция НачалаСобытийТЖ(Текст)

	Начала = Новый Массив;
	Позиция = 1;
	Для Каждого СтрокаФайла Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Если Сред(СтрокаФайла, 3, 1) = ":" И Сред(СтрокаФайла, 6, 1) = "."
			И СтрНайтиПоРегулярномуВыражению(Лев(СтрокаФайла, 40), "^[0-9]{2}:[0-9]{2}\.[0-9]+-[0-9]+,").НачальнаяПозиция = 1 Тогда
			Начала.Добавить(Позиция);
		КонецЕсли;
		Позиция = Позиция + СтрДлина(СтрокаФайла) + 1;
	КонецЦикла;
	Возврат Начала;

КонецФункции

// Событие ТЖ в формате ПринятьВыполненияТЖ (как New-TjEvent агента) или Неопределено,
// если событие не собирается. Ключ Ид - как у агента: сервер|каталог rphost|файл|мм:сс.дробь|длительность|
// событие|t:connectID - копии из разных логов одного сервера дают один Ид.
//
// Параметры:
//  Текст - Строка - текст события.
//  Контекст - Структура - см. ПрочитатьСобытияФайлаТЖ.
//
// Возвращаемое значение:
//  Соответствие, Неопределено - событие.
Функция СобытиеФайлаТЖ(Текст, Контекст)

	Тире = СтрНайти(Текст, "-");
	// без проверки СтрНайти с начальной позицией 0 падает («Недопустимое значение параметра 4»),
	// и файл не дочитывается никогда (21.10.2026: лог 1C_Locks 119 МБ стоял с 17:13)
	Если Тире < 8 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запятая1 = СтрНайти(Текст, ",", , Тире);
	Запятая2 = ?(Запятая1 = 0 ИЛИ Запятая1 >= СтрДлина(Текст), 0, СтрНайти(Текст, ",", , Запятая1 + 1));
	Если Тире < 8 ИЛИ Запятая2 = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИмяСобытия = Сред(Текст, Запятая1 + 1, Запятая2 - Запятая1 - 1);
	// из лога длинных событий (LongEvents) берутся события любого вида
	Если НЕ Контекст.ДлинныйЛог
		И СтрНайти(",DBMSSQL,SDBL,CALL,SCALL,TLOCK,TTIMEOUT,TDEADLOCK,EXCP,QERR,CONN,PROC,CLSTR,", "," + ИмяСобытия + ",") = 0
		ИЛИ Контекст.Сервер.ПропускатьСобытия.Получить(ВРег(ИмяСобытия)) <> Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Свойства = рбфАнализСервер.СвойстваСобытияТЖ(Текст);
	// прод-журнал: из CONN и CLSTR в регистр - только обрывы и ошибки (с описанием), PROC - все (старт/падение процессов)
	Если (ИмяСобытия = "CONN" ИЛИ ИмяСобытия = "CLSTR") И НЕ Контекст.ДлинныйЛог
		И НЕ ЗначениеЗаполнено(СвойствоТЖ(Свойства, "Descr")) И НЕ ЗначениеЗаполнено(СвойствоТЖ(Свойства, "Exception")) Тогда
		Возврат Неопределено;
	КонецЕсли;
	// канал оповещений клиента: send висит до 60 с в ожидании и почти не тратит CPU - это не нагрузка
	Если ИмяСобытия = "CALL" И СвойствоТЖ(Свойства, "IName") = "IVResourceRemoteConnection"
		И СвойствоТЖ(Свойства, "MName") = "send" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Минуты = Лев(Текст, 2);
	Секунды = Сред(Текст, 4, 2);
	Дробь = Сред(Текст, 7, Тире - 7);
	Длительность = Сред(Текст, Тире + 1, Запятая1 - Тире - 1);
	Ключ = СтрШаблон("%1|%2|%3|%4:%5.%6|%7|%8|%9", Контекст.Сервер.Сервер, Контекст.Процесс, Контекст.ИмяФайла,
		Минуты, Секунды, Дробь, Длительность, ИмяСобытия, СвойствоТЖ(Свойства, "t:connectID"));
	МаксТекст = Контекст.Сервер.МаксДлинаТекста;

	Событие = Новый Соответствие;
	Событие.Вставить("id", ХешMD5ТЖ(Ключ));
	Событие.Вставить("time", XMLСтрока(Контекст.Час + Число(Минуты) * 60 + Число(Секунды)));
	Событие.Вставить("us", Число(Лев(Дробь + "000000", 6)));
	Событие.Вставить("event", ИмяСобытия);
	Событие.Вставить("ms", Окр(Число(Длительность) / 1000, 3));
	ДобавитьТекстТЖ(Событие, "db", СвойствоТЖ(Свойства, "p:processName"));
	ДобавитьТекстТЖ(Событие, "usr", СвойствоТЖ(Свойства, "Usr"));
	ДобавитьЧислоТЖ(Событие, "session", СвойствоТЖ(Свойства, "SessionID"));
	ДобавитьЧислоТЖ(Событие, "connect", СвойствоТЖ(Свойства, "t:connectID"));
	ДобавитьЧислоТЖ(Событие, "client", СвойствоТЖ(Свойства, "t:clientID"));
	ДобавитьТекстТЖ(Событие, "app", СвойствоТЖ(Свойства, "t:applicationName"));
	ДобавитьТекстТЖ(Событие, "computer", СвойствоТЖ(Свойства, "t:computerName"));
	Части = СтрРазделить(Контекст.Процесс, "_");
	ДобавитьТекстТЖ(Событие, "pid", ?(Части.Количество() > 1 И ТолькоЦифрыТЖ(Части[Части.ВГраница()]),
		Части[Части.ВГраница()], Контекст.Процесс));
	ДобавитьЧислоТЖ(Событие, "dbpid", СвойствоТЖ(Свойства, "dbpid"));
	Если СвойствоТЖ(Свойства, "trans") = "1" Тогда
		Событие.Вставить("trans", Истина);
	КонецЕсли;
	Если Свойства.Получить("Rows") <> Неопределено Тогда
		ДобавитьЧислоТЖ(Событие, "rows", СвойствоТЖ(Свойства, "Rows"));
	Иначе
		ДобавитьЧислоТЖ(Событие, "rows", СвойствоТЖ(Свойства, "RowsAffected"));
	КонецЕсли;
	// SDBL фиксации пишется с двумя Func: "Func=Transaction,Func=CommitTransaction", СвойстваСобытияТЖ
	// оставляет первое - вид завершения транзакции берём из текста
	Если ИмяСобытия = "SDBL" И СтрНайти(Текст, ",Func=CommitTransaction") > 0 Тогда
		Событие.Вставить("func", "CommitTransaction");
	ИначеЕсли ИмяСобытия = "SDBL" И СтрНайти(Текст, ",Func=RollbackTransaction") > 0 Тогда
		Событие.Вставить("func", "RollbackTransaction");
	Иначе
		ДобавитьТекстТЖ(Событие, "func", СвойствоТЖ(Свойства, "Func"));
	КонецЕсли;
	// ресурсы серверного вызова (CALL/SCALL): Memory может быть отрицательной - память освобождена
	ДобавитьЧислоТЖ(Событие, "cpu", СвойствоТЖ(Свойства, "CpuTime"));
	ДобавитьЦелоеСоЗнакомТЖ(Событие, "mem", СвойствоТЖ(Свойства, "Memory"));
	ДобавитьЧислоТЖ(Событие, "mempeak", СвойствоТЖ(Свойства, "MemoryPeak"));
	ДобавитьЧислоТЖ(Событие, "inb", СвойствоТЖ(Свойства, "InBytes"));
	ДобавитьЧислоТЖ(Событие, "outb", СвойствоТЖ(Свойства, "OutBytes"));
	Контекст1С = СвойствоТЖ(Свойства, "Context");
	Если ЗначениеЗаполнено(Контекст1С) Тогда
		Строки = Новый Массив;
		Для Каждого СтрокаКонтекста Из СтрРазделить(Контекст1С, Символы.ПС, Ложь) Цикл
			Если ЗначениеЗаполнено(СокрЛП(СтрокаКонтекста)) Тогда
				Строки.Добавить(СокрЛП(СтрокаКонтекста));
			КонецЕсли;
		КонецЦикла;
		Если Строки.Количество() > 0 Тогда
			ДобавитьТекстТЖ(Событие, "ctxTop", Строки[0]);
			ДобавитьТекстТЖ(Событие, "ctxLast", Строки[Строки.ВГраница()]);
		КонецЕсли;
		ДобавитьТекстТЖ(Событие, "ctx", Контекст1С, МаксТекст);
	КонецЕсли;
	ДобавитьТекстТЖ(Событие, "sdbl", СвойствоТЖ(Свойства, "Sdbl"), МаксТекст);
	ДобавитьТекстТЖ(Событие, "sql", СвойствоТЖ(Свойства, "Sql"), МаксТекст);
	ДобавитьТекстТЖ(Событие, "locks", СвойствоТЖ(Свойства, "Locks"), МаксТекст);
	ДобавитьТекстТЖ(Событие, "wait", СвойствоТЖ(Свойства, "WaitConnections"));
	ДобавитьТекстТЖ(Событие, "deadlock", СвойствоТЖ(Свойства, "DeadlockConnectionIntersections"), МаксТекст);
	ДобавитьТекстТЖ(Событие, "exception", СвойствоТЖ(Свойства, "Exception"));
	Описание = СвойствоТЖ(Свойства, "Descr");
	Если НЕ ЗначениеЗаполнено(Описание) Тогда
		// PROC/CLSTR/CONN: текст события - в свойстве Txt
		Описание = СвойствоТЖ(Свойства, "Txt");
	КонецЕсли;
	ДобавитьТекстТЖ(Событие, "descr", Описание, МаксТекст);
	// ожидание на блокировке СУБД (<dbmslocks/>): свойства lk* - строкой "lkp=1 ... lksrc=N" в locks
	// (реквизит Блокировки; у DBMSSQL свойства Locks нет). ЖдалСоединения не заполняется: это признак ожидания TLOCK.
	// Виновника по lksrc ищет рбфАнализСервер.ЗаполнитьВиновниковБлокировокСУБД
	Если ИмяСобытия = "DBMSSQL" Тогда
		ЧастиБлокировки = Новый Массив;
		Для Каждого ИмяСвойства Из СтрРазделить("lkp,lkpid,lkpto,lka,lkaid,lkato,lksrc", ",") Цикл
			Значение = СвойствоТЖ(Свойства, ИмяСвойства);
			Если ЗначениеЗаполнено(Значение) Тогда
				ЧастиБлокировки.Добавить(ИмяСвойства + "=" + Значение);
			КонецЕсли;
		КонецЦикла;
		ДобавитьТекстТЖ(Событие, "locks", СтрСоединить(ЧастиБлокировки, " "));
	КонецЕсли;
	Возврат Событие;

КонецФункции

// Значение свойства события ТЖ строкой; нет свойства - пустая строка.
Функция СвойствоТЖ(Свойства, Имя)

	Значение = Свойства.Получить(Имя);
	Возврат ?(Значение = Неопределено, "", СокрЛП(Значение));

КонецФункции

// Непустой текст - в событие, длинный обрезается до МаксДлина (0 - без ограничения).
Процедура ДобавитьТекстТЖ(Событие, Ключ, Значение, МаксДлина = 0)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;
	Событие.Вставить(Ключ, ?(МаксДлина > 0 И СтрДлина(Значение) > МаксДлина, Лев(Значение, МаксДлина), Значение));

КонецПроцедуры

// Целое из цифр - в событие числом; иначе поле не передаётся.
Процедура ДобавитьЧислоТЖ(Событие, Ключ, Значение)

	Если ТолькоЦифрыТЖ(Значение) И СтрДлина(Значение) <= 15 Тогда
		Событие.Вставить(Ключ, Число(Значение));
	КонецЕсли;

КонецПроцедуры

// Целое со знаком минус или без - в событие числом; иначе поле не передаётся.
Процедура ДобавитьЦелоеСоЗнакомТЖ(Событие, Ключ, Значение)

	Если СтрНачинаетсяС(Значение, "-") Тогда
		Модуль = Сред(Значение, 2);
		Если ТолькоЦифрыТЖ(Модуль) И СтрДлина(Модуль) <= 14 Тогда
			Событие.Вставить(Ключ, -Число(Модуль));
		КонецЕсли;
	Иначе
		ДобавитьЧислоТЖ(Событие, Ключ, Значение);
	КонецЕсли;

КонецПроцедуры

Функция ТолькоЦифрыТЖ(Значение)

	Возврат ЗначениеЗаполнено(Значение)
		И СтрНайтиПоРегулярномуВыражению(Значение, "^[0-9]+$").НачальнаяПозиция > 0;

КонецФункции

// Имя каталога, в котором лежит файл ТЖ (rphost_<pid>).
Функция ИмяКаталогаФайлаТЖ(КаталогФайла)

	Части = СтрРазделить(КаталогФайла, "\/", Ложь);
	Возврат ?(Части.Количество() = 0, "", Части[Части.ВГраница()]);

КонецФункции

// MD5 строки (UTF-8), hex в нижнем регистре - как Get-Md5Hex агента.
Функция ХешMD5ТЖ(Текст)

	Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеш.Добавить(Текст);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));

КонецФункции

// Блокировки СУБД: читает XE-сессию rbf_blocking каждого SQL-сервера, где есть базы с включёнными
// ОжиданиеНаБлокировкеСУБД или ВзаимоблокировкаСУБД, пишет SQLBLOCK/SQLDEADLOCK в рбфВыполненияТЖ
// и дозаполняет виновников SQLBLOCK за последний час.
//
// Параметры:
//  Лимиты - Структура - см. СобратьТЖСервера.
//
// Возвращаемое значение:
//  Строка - итог для журнала.
Функция СобратьБлокировкиСУБД(Лимиты)

	Итоги = Новый Массив;
	Для Каждого Сервер Из СерверыБлокировокСУБД() Цикл
		Если Лимиты.Событий <= 0 ИЛИ ТекущаяУниверсальнаяДатаВМиллисекундах() >= Лимиты.ДоМс Тогда
			Итоги.Добавить("sql:" + Сервер.Ключ + ": отложен до следующего запуска");
			Продолжить;
		КонецЕсли;
		Попытка
			Итоги.Добавить("sql:" + Сервер.Ключ + ": " + СобратьБлокировкиСервераSQL(Сервер.Ключ, Сервер.Значение, Лимиты));
		Исключение
			Итоги.Добавить("sql:" + Сервер.Ключ + ": ОШИБКА");
			ЗаписьЖурналаРегистрации("Мониторинг.СборТЖ", УровеньЖурналаРегистрации.Ошибка, , ,
				"sql:" + Сервер.Ключ + ": " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Если Итоги.Количество() = 0 Тогда
		Возврат "Блокировки СУБД: не включены";
	КонецЕсли;

	рбфАнализСервер.ЗаполнитьВиновниковБлокировокСУБД(ТекущаяДатаСеанса() - 3600);
	Возврат СтрСоединить(Итоги, "; ");

КонецФункции

// SQL-серверы баз реестра, где включены показатели СУБД в рбфНастройкиТЖ, с картой их баз.
// Пустой сервер БД - localhost, как в остальных правилах.
//
// Возвращаемое значение:
//  Соответствие - имя SQL-сервера -> Соответствие: НРег(имя БД) -> Структура:
//   * ИмяБазы1С - Строка - имя ИБ в кластере.
//   * Сервер - Строка - сервер 1С без порта (поле Сервер событий ТЖ).
//   * Ожидания - Булево - включён ОжиданиеНаБлокировкеСУБД.
//   * Взаимоблокировки - Булево - включён ВзаимоблокировкаСУБД.
Функция СерверыБлокировокСУБД()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	С.Сервер1С.Наименование КАК Сервер1С,
	|	С.ИмяБазы1С КАК ИмяБазы1С,
	|	С.СерверБД.Наименование КАК СерверБД,
	|	С.ИмяБазыБД КАК ИмяБазыБД,
	|	ЕСТЬNULL(Н.ОжиданиеНаБлокировкеСУБД, ЛОЖЬ) КАК Ожидания,
	|	ЕСТЬNULL(Н.ВзаимоблокировкаСУБД, ЛОЖЬ) КАК Взаимоблокировки
	|ИЗ
	|	РегистрСведений.СерверыИБазы КАК С
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.рбфНастройкиТЖ КАК Н
	|		ПО (Н.Сервер1С = С.Сервер1С.Наименование)
	|			И (Н.ИмяБазы1С = С.ИмяБазы1С)
	|ГДЕ
	|	С.ИмяБазыБД <> """"
	|	И С.Тип <> ЗНАЧЕНИЕ(Перечисление.ТипБазы.Архивная)";
	Выборка = Запрос.Выполнить().Выбрать();

	Все = Новый Соответствие;
	Включённые = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		СерверSQL = ?(ЗначениеЗаполнено(Выборка.СерверБД), СокрЛП(Выборка.СерверБД), "localhost");
		Базы = Все.Получить(СерверSQL);
		Если Базы = Неопределено Тогда
			Базы = Новый Соответствие;
			Все.Вставить(СерверSQL, Базы);
		КонецЕсли;
		Ключ = НРег(СокрЛП(Выборка.ИмяБазыБД));
		Прежняя = Базы.Получить(Ключ);
		// одну БД могут описывать несколько строк реестра - берём строку с включёнными показателями
		Если Прежняя = Неопределено ИЛИ Выборка.Ожидания ИЛИ Выборка.Взаимоблокировки Тогда
			Базы.Вставить(Ключ, Новый Структура("ИмяБазы1С,Сервер,Ожидания,Взаимоблокировки",
				СокрЛП(Выборка.ИмяБазы1С), СокрЛП(СтрРазделить(СокрЛП(Выборка.Сервер1С) + ":", ":")[0]),
				Выборка.Ожидания, Выборка.Взаимоблокировки));
		КонецЕсли;
		Если Выборка.Ожидания ИЛИ Выборка.Взаимоблокировки Тогда
			Включённые.Вставить(СерверSQL, Истина);
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Соответствие;
	Для Каждого КЗ Из Включённые Цикл
		Результат.Вставить(КЗ.Ключ, Все.Получить(КЗ.Ключ));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Дочитывает XE-сессию rbf_blocking одного SQL-сервера с позиции рбфПозицииФайловТЖ
// (Сервер = "sql:<сервер>", ПутьХеш = MD5("rbf_blocking"), Путь = file_name, Смещение = file_offset).
// Первый запуск - с начала файлов, события не старше 2 ч. Позиция недействительна (файл удалён
// ротацией) - читается заново с начала: повторы безопасны, Ид от позиции не зависит.
//
// Параметры:
//  СерверSQL - Строка - имя экземпляра SQL Server.
//  Базы - Соответствие - см. СерверыБлокировокСУБД.
//  Лимиты - Структура - см. СобратьТЖСервера.
//
// Возвращаемое значение:
//  Строка - итог для журнала.
Функция СобратьБлокировкиСервераSQL(СерверSQL, Базы, Лимиты)

	КлючПозиции = Лев("sql:" + СерверSQL, 100);
	ПутьХеш = ХешMD5ТЖ("rbf_blocking");
	Позиция = РегистрыСведений.рбфПозицииФайловТЖ.СоздатьМенеджерЗаписи();
	Позиция.Сервер = КлючПозиции;
	Позиция.ПутьХеш = ПутьХеш;
	Позиция.Прочитать();
	ИмяФайла = ?(Позиция.Выбран(), СокрЛП(Позиция.Путь), "");
	Смещение = ?(Позиция.Выбран(), Позиция.Смещение, 0);
	Предел = Мин(Лимиты.Событий, 5000);

	Ответ = ПрочитатьXE(СерверSQL, ИмяФайла, Смещение, Предел);
	Если (Ответ.КодВозврата <> 0 ИЛИ СтрНайти(Ответ.Вывод, "Sqlcmd:") > 0) И ЗначениеЗаполнено(ИмяФайла) Тогда
		ЗаписьЖурналаРегистрации("Мониторинг.СборТЖ", УровеньЖурналаРегистрации.Предупреждение, , ,
			КлючПозиции + ": позиция " + ИмяФайла + ":" + Формат(Смещение, "ЧГ=0; ЧН=0")
			+ " не читается, читаю с начала: " + Лев(Ответ.Вывод, 500));
		ИмяФайла = "";
		Смещение = 0;
		Ответ = ПрочитатьXE(СерверSQL, ИмяФайла, Смещение, Предел);
	КонецЕсли;
	Если Ответ.КодВозврата <> 0 ИЛИ СтрНайти(Ответ.Вывод, "Sqlcmd:") > 0 Тогда
		ВызватьИсключение "XE rbf_blocking не прочитана: " + Лев(Ответ.Вывод, 1000);
	КонецЕсли;

	// события одного блока XE имеют общий file_offset, а чтение с позиции начинается со следующего блока:
	// если упёрлись в предел, последний блок мог прочитаться не целиком - позиция встаёт на предыдущий
	Строк = 0;
	Пары = Новый Массив;
	События = Новый Соответствие; // сервер событий -> Соответствие: Ид -> событие
	Для Каждого СтрокаОтвета Из СтрРазделить(Ответ.Вывод, Символы.ПС, Ложь) Цикл
		Части = СтрРазделить(СокрЛП(СтрокаОтвета), "|", Истина);
		Если Части.Количество() <> 5 ИЛИ НЕ ТолькоЦифрыТЖ(Части[1]) Тогда
			Продолжить;
		КонецЕсли;
		Строк = Строк + 1;
		Пара = Части[0] + "|" + Части[1];
		Если Пары.Количество() = 0 ИЛИ Пары[Пары.ВГраница()] <> Пара Тогда
			Пары.Добавить(Пара);
		КонецЕсли;
		Попытка
			ТекстXML = ПолучитьСтрокуИзДвоичныхДанных(Base64Значение(Части[4]), КодировкаТекста.UTF16);
			Разбор = РазобратьСобытиеXE(ТекстXML);
			Если Части[2] = "blocked_process_report" Тогда
				Событие = СобытиеБлокировкиСУБД(СерверSQL, Базы, Разбор, Части[3]);
			Иначе
				Событие = СобытиеВзаимоблокировкиСУБД(СерверSQL, Базы, Разбор, ТекстXML);
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации("Мониторинг.СборТЖ", УровеньЖурналаРегистрации.Предупреждение, , ,
				КлючПозиции + ": событие XE не разобрано: " + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Продолжить;
		КонецПопытки;
		Если Событие = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьСобытиеСУБД(События, Событие);
	КонецЦикла;

	Записано = 0;
	Всего = 0;
	Для Каждого КЗ Из События Цикл
		Пакет = Новый Массив;
		Для Каждого Элемент Из КЗ.Значение Цикл
			Пакет.Добавить(Элемент.Значение);
		КонецЦикла;
		УчестьЗаписанныеДлительности(Пакет);
		Всего = Всего + Пакет.Количество();
		Итог = рбфАнализСервер.ПринятьВыполненияТЖ(КЗ.Ключ, Пакет);
		Записано = Записано + Итог.written;
	КонецЦикла;
	Лимиты.Записано = Лимиты.Записано + Записано;
	Лимиты.Событий = Лимиты.Событий - Строк;

	Если Пары.Количество() > 0 Тогда
		Последняя = Пары[Пары.ВГраница()];
		Если Строк >= Предел И Пары.Количество() > 1 Тогда
			Последняя = Пары[Пары.ВГраница() - 1];
		КонецЕсли;
		Части = СтрРазделить(Последняя, "|");
		Позиция.Сервер = КлючПозиции;
		Позиция.ПутьХеш = ПутьХеш;
		Позиция.Путь = Части[0];
		Позиция.Смещение = Число(Части[1]);
		Позиция.Изменено = ТекущаяДатаСеанса();
		Позиция.Записать(Истина);
	КонецЕсли;

	Возврат СтрШаблон("событий XE %1, эпизодов %2, записано %3", Строк, Всего, Записано);

КонецФункции

// Выполняет пакет T-SQL чтения rbf_blocking*.xel через sqlcmd (временный файл запроса).
//
// Возвращаемое значение:
//  Структура - см. ВыполнитьКоманду.
Функция ПрочитатьXE(СерверSQL, ИмяФайла, Смещение, Предел)

	ФайлЗапроса = ФайлЗапросаXE(ИмяФайла, Смещение, Предел);
	// -y 0: длинные значения без обрезки; несовместим с -W и -h, строки заголовка отсекает разбор (5 частей).
	// -I: QUOTED_IDENTIFIER ON, без него методы типа xml (value) не выполняются
	Ответ = ВыполнитьКоманду(КомандаSQL(СерверSQL) + " -b -I -y 0 -i """ + ФайлЗапроса + """");
	УдалитьФайлы(ФайлЗапроса);
	Возврат Ответ;

КонецФункции

// Временный файл пакета T-SQL чтения rbf_blocking*.xel. Строка ответа:
// "file_name|file_offset|object_name|имя таблицы ожидания|event_data в base64 (UTF-16LE)" -
// base64, чтобы XML с переводами строк и кириллицей прошёл через вывод sqlcmd одной строкой.
//
// Параметры:
//  ИмяФайла - Строка - file_name позиции; пусто - чтение с начала файлов, события не старше 2 ч.
//  Смещение - Число - file_offset позиции.
//  Предел - Число - не больше событий.
//
// Возвращаемое значение:
//  Строка - путь к временному файлу.
Функция ФайлЗапросаXE(ИмяФайла, Смещение, Предел)

	Если ЗначениеЗаполнено(ИмяФайла) Тогда
		Позиция = "DECLARE @f nvarchar(260) = N'" + СтрЗаменить(ИмяФайла, "'", "''") + "', @o bigint = "
			+ Формат(Смещение, "ЧГ=0; ЧН=0") + ";";
	Иначе
		Позиция = "DECLARE @f nvarchar(260) = NULL, @o bigint = NULL;";
	КонецЕсли;
	Текст =
	"SET NOCOUNT ON;
	|" + Позиция + "
	|SELECT TOP (" + Формат(Предел, "ЧГ=0; ЧН=0") + ")
	|	x.file_name + N'|' + CAST(x.file_offset AS nvarchar(20)) + N'|' + x.object_name + N'|'
	|	+ ISNULL(OBJECT_NAME(c.e.value('(event/data[@name=""object_id""]/value)[1]', 'int'),
	|		c.e.value('(event/data[@name=""database_id""]/value)[1]', 'int')), N'')
	|	+ N'|' + CAST(N'' AS xml).value('xs:base64Binary(sql:column(""b.v""))', 'varchar(max)')
	|FROM sys.fn_xe_file_target_read_file(N'rbf_blocking*.xel', NULL, @f, @o) AS x
	|	CROSS APPLY (SELECT CAST(x.event_data AS xml) AS e) AS c
	|	CROSS APPLY (SELECT CAST(x.event_data AS varbinary(max)) AS v) AS b
	|WHERE x.object_name IN (N'blocked_process_report', N'xml_deadlock_report')
	|	AND (@f IS NOT NULL
	|		OR c.e.value('(event/@timestamp)[1]', 'datetimeoffset(3)') >= DATEADD(hour, -2, SYSDATETIMEOFFSET()));";

	ФайлЗапроса = ПолучитьИмяВременногоФайла("sql");
	ЗаписьФайла = Новый ЗаписьТекста(ФайлЗапроса, КодировкаТекста.ANSI);
	ЗаписьФайла.Записать(Текст);
	ЗаписьФайла.Закрыть();
	Возврат ФайлЗапроса;

КонецФункции

// Разбор XML события XE без схемы: имя и время события, поля data (ключ "<имя>.value" / "<имя>.text"),
// процессы (blocked-process, blocking-process, process-list взаимоблокировки) с атрибутами и inputbuf,
// Ид жертв взаимоблокировки.
//
// Параметры:
//  ТекстXML - Строка - event_data.
//
// Возвращаемое значение:
//  Структура - Имя, Время (Строка, UTC), Данные (Соответствие), Процессы (Массив из Соответствие,
//   ключ "#роль" - родительский элемент), Жертвы (Массив из Строка).
Функция РазобратьСобытиеXE(ТекстXML)

	Результат = Новый Структура("Имя,Время,Данные,Процессы,Жертвы", "", "", Новый Соответствие,
		Новый Массив, Новый Массив);
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ТекстXML);
	ИмяДанных = "";
	ТекущийЭлемент = "";
	Роль = "";
	Процесс = Неопределено;
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ТекущийЭлемент = Чтение.ЛокальноеИмя;
			Если ТекущийЭлемент = "event" Тогда
				Результат.Имя = Строка(Чтение.ЗначениеАтрибута("name"));
				Результат.Время = Строка(Чтение.ЗначениеАтрибута("timestamp"));
			ИначеЕсли ТекущийЭлемент = "data" И Процесс = Неопределено И НЕ ЗначениеЗаполнено(Роль) Тогда
				ИмяДанных = Строка(Чтение.ЗначениеАтрибута("name"));
			ИначеЕсли ТекущийЭлемент = "blocked-process" ИЛИ ТекущийЭлемент = "blocking-process"
				ИЛИ ТекущийЭлемент = "process-list" Тогда
				Роль = ТекущийЭлемент;
			ИначеЕсли ТекущийЭлемент = "process" И ЗначениеЗаполнено(Роль) Тогда
				Процесс = Новый Соответствие;
				Процесс.Вставить("#роль", Роль);
				Для Н = 0 По Чтение.КоличествоАтрибутов() - 1 Цикл
					Процесс.Вставить(Чтение.ИмяАтрибута(Н), Чтение.ЗначениеАтрибута(Н));
				КонецЦикла;
				Результат.Процессы.Добавить(Процесс);
			ИначеЕсли ТекущийЭлемент = "victimProcess" Тогда
				Результат.Жертвы.Добавить(Строка(Чтение.ЗначениеАтрибута("id")));
			КонецЕсли;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Имя = Чтение.ЛокальноеИмя;
			Если Имя = "process" Тогда
				Процесс = Неопределено;
			ИначеЕсли Имя = "blocked-process" ИЛИ Имя = "blocking-process" ИЛИ Имя = "process-list" Тогда
				Роль = "";
			ИначеЕсли Имя = "data" И Процесс = Неопределено И НЕ ЗначениеЗаполнено(Роль) Тогда
				ИмяДанных = "";
			КонецЕсли;
			ТекущийЭлемент = "";
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.Текст ИЛИ Чтение.ТипУзла = ТипУзлаXML.СекцияCDATA Тогда
			Если ТекущийЭлемент = "inputbuf" И Процесс <> Неопределено Тогда
				Процесс.Вставить("inputbuf", СокрЛП(Чтение.Значение));
			ИначеЕсли ЗначениеЗаполнено(ИмяДанных) И Процесс = Неопределено И НЕ ЗначениеЗаполнено(Роль)
				И (ТекущийЭлемент = "value" ИЛИ ТекущийЭлемент = "text")
				И Результат.Данные.Получить(ИмяДанных + "." + ТекущийЭлемент) = Неопределено Тогда
				Результат.Данные.Вставить(ИмяДанных + "." + ТекущийЭлемент, СокрЛП(Чтение.Значение));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

// Событие SQLBLOCK (формат ПринятьВыполненияТЖ) из blocked_process_report. Ид - MD5 от
// сервер|БД|spid|xactid|waitresource ждущего: повторы эпизода (раз в 5 с) дают один Ид.
//
// Параметры:
//  СерверSQL - Строка - имя SQL-сервера.
//  Базы - Соответствие - см. СерверыБлокировокСУБД.
//  Разбор - Структура - см. РазобратьСобытиеXE.
//  Таблица - Строка - имя таблицы хранения по object_id события (OBJECT_NAME), может быть пустым.
//
// Возвращаемое значение:
//  Соответствие, Неопределено - событие; Неопределено - база без ОжиданиеНаБлокировкеСУБД или нет данных.
Функция СобытиеБлокировкиСУБД(СерверSQL, Базы, Разбор, Таблица)

	Ждущий = ПроцессXE(Разбор, "blocked-process");
	Блокирующий = ПроцессXE(Разбор, "blocking-process");
	ИмяБД = СвойствоТЖ(Разбор.Данные, "database_name.value");
	База = Базы.Получить(НРег(ИмяБД));
	Время = ВремяСобытияXE(Разбор.Время);
	Если Ждущий = Неопределено ИЛИ Время = Неопределено ИЛИ База <> Неопределено И НЕ База.Ожидания Тогда
		Возврат Неопределено;
	КонецЕсли;

	Spid = СвойствоТЖ(Ждущий, "spid");
	Ресурс = СвойствоТЖ(Ждущий, "waitresource");
	Ключ = НРег(СтрШаблон("SQLBLOCK|%1|%2|%3|%4|%5", СерверSQL, ИмяБД, Spid, СвойствоТЖ(Ждущий, "xactid"), Ресурс));
	Ожидание = СвойствоТЖ(Ждущий, "waittime");
	Если НЕ ТолькоЦифрыТЖ(Ожидание) Тогда
		Ожидание = Формат(Окр(Число("0" + ТолькоЦифрыСтроки(СвойствоТЖ(Разбор.Данные, "duration.value"))) / 1000),
			"ЧГ=0; ЧН=0");
	КонецЕсли;

	Событие = НовоеСобытиеСУБД(ХешMD5ТЖ(Ключ), "SQLBLOCK", Время, СерверSQL, ИмяБД, База, Ждущий);
	Событие.Вставить("ms", Число("0" + ТолькоЦифрыСтроки(Ожидание)));
	ДобавитьТекстТЖ(Событие, "waitres", СокрЛП(Таблица) + "|" + Ресурс, 400);
	Режим = СвойствоТЖ(Разбор.Данные, "lock_mode.text");
	ДобавитьТекстТЖ(Событие, "lockmode", ?(ЗначениеЗаполнено(Режим), Режим, СвойствоТЖ(Ждущий, "lockMode")), 20);
	Описание = Новый Массив;
	Описание.Добавить("Ждущий: " + ОписаниеПроцессаSQL(Ждущий));
	Если Блокирующий <> Неопределено Тогда
		ДобавитьЧислоТЖ(Событие, "blkspid", СвойствоТЖ(Блокирующий, "spid"));
		ДобавитьТекстТЖ(Событие, "blksql", СвойствоТЖ(Блокирующий, "inputbuf"));
		Описание.Добавить("Блокирующий: " + ОписаниеПроцессаSQL(Блокирующий));
	КонецЕсли;
	Событие.Вставить("descr", СтрСоединить(Описание, Символы.ПС));
	Возврат Событие;

КонецФункции

// Событие SQLDEADLOCK (формат ПринятьВыполненияТЖ) из xml_deadlock_report: XML события целиком -
// в deadlock (Взаимоблокировка), жертва и участники - в descr (Описание).
//
// Параметры:
//  СерверSQL - Строка - имя SQL-сервера.
//  Базы - Соответствие - см. СерверыБлокировокСУБД.
//  Разбор - Структура - см. РазобратьСобытиеXE.
//  ТекстXML - Строка - event_data.
//
// Возвращаемое значение:
//  Соответствие, Неопределено - событие; Неопределено - база без ВзаимоблокировкаСУБД или нет данных.
Функция СобытиеВзаимоблокировкиСУБД(СерверSQL, Базы, Разбор, ТекстXML)

	ИдЖертвы = ?(Разбор.Жертвы.Количество() > 0, Разбор.Жертвы[0], "");
	Жертва = Неопределено;
	Другой = Неопределено;
	Для Каждого Процесс Из Разбор.Процессы Цикл
		Если Жертва = Неопределено И СвойствоТЖ(Процесс, "id") = ИдЖертвы Тогда
			Жертва = Процесс;
		ИначеЕсли Другой = Неопределено Тогда
			Другой = Процесс;
		КонецЕсли;
	КонецЦикла;
	Если Жертва = Неопределено Тогда
		Жертва = Другой;
		Другой = Неопределено;
	КонецЕсли;
	Время = ВремяСобытияXE(Разбор.Время);
	Если Жертва = Неопределено ИЛИ Время = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИмяБД = СвойствоТЖ(Разбор.Данные, "database_name.value");
	Если НЕ ЗначениеЗаполнено(ИмяБД) Тогда
		ИмяБД = СвойствоТЖ(Жертва, "currentdbname");
	КонецЕсли;
	База = Базы.Получить(НРег(ИмяБД));
	Если База <> Неопределено И НЕ База.Взаимоблокировки Тогда
		Возврат Неопределено;
	КонецЕсли;

	Ключ = НРег(СтрШаблон("SQLDEADLOCK|%1|%2|%3", СерверSQL, Разбор.Время, ИдЖертвы));
	Событие = НовоеСобытиеСУБД(ХешMD5ТЖ(Ключ), "SQLDEADLOCK", Время, СерверSQL, ИмяБД, База, Жертва);
	ДобавитьЧислоТЖ(Событие, "ms", СвойствоТЖ(Жертва, "waittime"));
	ДобавитьТекстТЖ(Событие, "waitres", "|" + СвойствоТЖ(Жертва, "waitresource"), 400);
	ДобавитьТекстТЖ(Событие, "lockmode", СвойствоТЖ(Жертва, "lockMode"), 20);
	ДобавитьТекстТЖ(Событие, "deadlock", ТекстXML);
	Описание = Новый Массив;
	Описание.Добавить("Жертва: " + ОписаниеПроцессаSQL(Жертва));
	Для Каждого Процесс Из Разбор.Процессы Цикл
		Если Процесс = Жертва Тогда
			Продолжить;
		КонецЕсли;
		Если Процесс = Другой Тогда
			ДобавитьЧислоТЖ(Событие, "blkspid", СвойствоТЖ(Процесс, "spid"));
			ДобавитьТекстТЖ(Событие, "blksql", СвойствоТЖ(Процесс, "inputbuf"));
		КонецЕсли;
		Описание.Добавить("Участник: " + ОписаниеПроцессаSQL(Процесс)
			+ Символы.ПС + "    " + Лев(СвойствоТЖ(Процесс, "inputbuf"), 1000));
	КонецЦикла;
	Событие.Вставить("descr", СтрСоединить(Описание, Символы.ПС));
	Возврат Событие;

КонецФункции

// Общие поля события СУБД: сервер событий - сервер 1С базы (как у DBMSSQL), база - имя ИБ из реестра,
// иначе имя БД SQL; dbpid, компьютер, приложение, текст SQL и транзакция - процесса Процесс.
Функция НовоеСобытиеСУБД(Ид, ИмяСобытия, Время, СерверSQL, ИмяБД, База, Процесс)

	Событие = Новый Соответствие;
	Событие.Вставить("id", Ид);
	Событие.Вставить("#server", ?(База = Неопределено ИЛИ НЕ ЗначениеЗаполнено(База.Сервер), СерверSQL, База.Сервер));
	Событие.Вставить("time", XMLСтрока(Время.Дата));
	Событие.Вставить("us", Время.Мкс);
	Событие.Вставить("event", ИмяСобытия);
	ДобавитьТекстТЖ(Событие, "db", ?(База = Неопределено ИЛИ НЕ ЗначениеЗаполнено(База.ИмяБазы1С), ИмяБД, База.ИмяБазы1С));
	ДобавитьЧислоТЖ(Событие, "dbpid", СвойствоТЖ(Процесс, "spid"));
	ДобавитьТекстТЖ(Событие, "app", СвойствоТЖ(Процесс, "clientapp"));
	ДобавитьТекстТЖ(Событие, "computer", СвойствоТЖ(Процесс, "hostname"));
	ДобавитьТекстТЖ(Событие, "sql", СвойствоТЖ(Процесс, "inputbuf"));
	Если ТолькоЦифрыТЖ(СвойствоТЖ(Процесс, "trancount")) И СвойствоТЖ(Процесс, "trancount") <> "0" Тогда
		Событие.Вставить("trans", Истина);
	КонецЕсли;
	Возврат Событие;

КонецФункции

// Первый процесс XE с ролью (родительским элементом) Роль.
Функция ПроцессXE(Разбор, Роль)

	Для Каждого Процесс Из Разбор.Процессы Цикл
		Если Процесс.Получить("#роль") = Роль Тогда
			Возврат Процесс;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Время события XE (атрибут timestamp, UTC "2026-10-21T12:34:11.718Z") в местном времени сервера 1С.
//
// Возвращаемое значение:
//  Структура, Неопределено - Дата (Дата), Мкс (Число); Неопределено - время не разобрано.
Функция ВремяСобытияXE(ВремяUTC)

	Если СтрДлина(ВремяUTC) < 19 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		ДатаUTC = XMLЗначение(Тип("Дата"), Лев(ВремяUTC, 19));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Дробь = "";
	Если Сред(ВремяUTC, 20, 1) = "." Тогда
		Дробь = ТолькоЦифрыСтроки(Сред(ВремяUTC, 21, 7));
	КонецЕсли;
	Возврат Новый Структура("Дата,Мкс", МестноеВремя(ДатаUTC, ЧасовойПояс()), Число(Лев(Дробь + "000000", 6)));

КонецФункции

// Строка процесса SQL для Описание: spid, логин, хост, приложение, БД, состояние транзакции.
Функция ОписаниеПроцессаSQL(Процесс)

	Части = Новый Массив;
	Для Каждого Поле Из СтрРазделить("spid,loginname,hostname,clientapp,currentdbname,status,trancount,xactid,"
		+ "waittime,lockMode,waitresource,lasttranstarted,lastbatchstarted,isolationlevel", ",") Цикл
		Значение = СвойствоТЖ(Процесс, Поле);
		Если ЗначениеЗаполнено(Значение) Тогда
			Части.Добавить(Поле + "=" + Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

// Только цифры строки (остальные символы выбрасываются).
Функция ТолькоЦифрыСтроки(Текст)

	Цифры = Новый Массив;
	Для Н = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Н, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Цифры.Добавить(Символ);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Цифры);

КонецФункции

// Добавляет событие СУБД в группу его сервера; повтор того же Ид (эпизод SQLBLOCK)
// оставляет максимальную длительность и время отчёта с ней.
Процедура ДобавитьСобытиеСУБД(События, Событие)

	Сервер = Событие.Получить("#server");
	Событие.Удалить("#server");
	Группа = События.Получить(Сервер);
	Если Группа = Неопределено Тогда
		Группа = Новый Соответствие;
		События.Вставить(Сервер, Группа);
	КонецЕсли;
	Прежнее = Группа.Получить(Событие.Получить("id"));
	Если Прежнее = Неопределено
		ИЛИ ЧислоТЖ(Событие.Получить("ms")) >= ЧислоТЖ(Прежнее.Получить("ms")) Тогда
		Группа.Вставить(Событие.Получить("id"), Событие);
	КонецЕсли;

КонецПроцедуры

// Число из поля события или 0.
Функция ЧислоТЖ(Значение)

	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, 0);

КонецФункции

// Повтор эпизода, уже записанного прошлым запуском: если записанная длительность больше,
// событие получает её и записанное время (перезапись идёт целиком через ПринятьВыполненияТЖ).
//
// Параметры:
//  Пакет - Массив из Соответствие - события СУБД.
Процедура УчестьЗаписанныеДлительности(Пакет)

	Идентификаторы = Новый Массив;
	Для Каждого Событие Из Пакет Цикл
		Идентификаторы.Добавить(Событие.Получить("id"));
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ид КАК Ид,
	|	Т.Время КАК Время,
	|	Т.Микросекунды КАК Микросекунды,
	|	Т.ДлительностьМс КАК ДлительностьМс
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	Т.Ид В (&Идентификаторы)";
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);
	Записанные = Запрос.Выполнить().Выгрузить();
	Записанные.Индексы.Добавить("Ид");
	Для Каждого Событие Из Пакет Цикл
		Записанная = Записанные.Найти(Событие.Получить("id"), "Ид");
		Если Записанная <> Неопределено И Записанная.ДлительностьМс > ЧислоТЖ(Событие.Получить("ms")) Тогда
			Событие.Вставить("ms", Записанная.ДлительностьМс);
			Событие.Вставить("time", XMLСтрока(Записанная.Время));
			Событие.Вставить("us", Записанная.Микросекунды);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Добавляет событие выборки рбфВыполненияТЖ в агрегат по ключу Event-Key агента.
// TLOCK: свойства Regions в регистре нет - вместо него первое слово Блокировки (пространство).
//
// Параметры:
//  ГруппыСервера - Соответствие - ид группы -> Соответствие (base, event, key, count, dur_sum_ms, dur_max_ms, example).
//  Выборка - ВыборкаИзРезультатаЗапроса - строка запроса АгрегатыТЖ.
Процедура ДобавитьВАгрегатТЖ(ГруппыСервера, Выборка)

	База = ?(ЗначениеЗаполнено(Выборка.База), СокрЛП(Выборка.База), "(сервер)");
	ИмяСобытия = СокрЛП(Выборка.Событие);
	Контекст1С = СокрЛП(Выборка.КонтекстСтрока);
	Если ИмяСобытия = "CALL" Тогда
		Ключ = ?(ЗначениеЗаполнено(Контекст1С), Контекст1С, СокрЛП(Выборка.Функция));
		Пример = СокрЛП(Выборка.Пользователь) + " " + Выборка.КонтекстПолный;
	ИначеЕсли ИмяСобытия = "DBMSSQL" Тогда
		Ключ = ?(ЗначениеЗаполнено(Контекст1С), Контекст1С,
			Лев(СтрЗаменитьПоРегулярномуВыражению(Выборка.ТекстSQL, "[ \t\r\n]+", " "), 200));
		Пример = Выборка.ТекстSQL;
	ИначеЕсли ИмяСобытия = "TLOCK" Тогда
		Ключ = СтрРазделить(СокрЛП(Выборка.Блокировки) + " ", " ")[0] + " | " + Контекст1С;
		Пример = Выборка.Блокировки + " " + Выборка.ЖдалСоединения;
	ИначеЕсли ИмяСобытия = "TTIMEOUT" Тогда
		Ключ = СокрЛП(Выборка.ЖдалСоединения) + " | " + Контекст1С;
		Пример = Выборка.КонтекстПолный;
	ИначеЕсли ИмяСобытия = "TDEADLOCK" Тогда
		Ключ = Контекст1С;
		Пример = Выборка.Взаимоблокировка;
	Иначе
		Строки = СтрРазделить(СтрЗаменить(Выборка.Описание, Символы.ВК, ""), Символы.ПС, Ложь);
		Ключ = "";
		Для Каждого СтрокаОписания Из Строки Цикл
			Если ЗначениеЗаполнено(СокрЛП(СтрокаОписания)) Тогда
				Ключ = СокрЛП(СтрокаОписания);
			КонецЕсли;
		КонецЦикла;
		Пример = Выборка.Описание;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		Ключ = "(без контекста)";
	КонецЕсли;
	Ключ = Лев(СтрЗаменитьПоРегулярномуВыражению(Ключ, "[ \t\r\n]+", " "), 300);

	ИдГруппы = База + Символы.ПС + ИмяСобытия + Символы.ПС + Ключ;
	Агрегат = ГруппыСервера.Получить(ИдГруппы);
	Если Агрегат = Неопределено Тогда
		Агрегат = Новый Соответствие;
		Агрегат.Вставить("base", База);
		Агрегат.Вставить("event", ИмяСобытия);
		Агрегат.Вставить("key", Ключ);
		Агрегат.Вставить("count", 0);
		Агрегат.Вставить("dur_sum_ms", 0);
		Агрегат.Вставить("dur_max_ms", 0);
		Агрегат.Вставить("example", "");
		ГруппыСервера.Вставить(ИдГруппы, Агрегат);
	КонецЕсли;
	Мс = Окр(Выборка.ДлительностьМс);
	Агрегат.Вставить("count", Агрегат.Получить("count") + 1);
	Агрегат.Вставить("dur_sum_ms", Агрегат.Получить("dur_sum_ms") + Мс);
	Если Мс >= Агрегат.Получить("dur_max_ms") ИЛИ НЕ ЗначениеЗаполнено(Агрегат.Получить("example")) Тогда
		Агрегат.Вставить("dur_max_ms", Макс(Агрегат.Получить("dur_max_ms"), Мс));
		Агрегат.Вставить("example", Лев(Пример, 2000));
	КонецЕсли;

КонецПроцедуры

// Не больше Топ агрегатов на вид события: самые долгие по сумме, затем самые частые (как агент).
//
// Параметры:
//  ГруппыСервера - Соответствие - см. ДобавитьВАгрегатТЖ.
//  Топ - Число - строк на вид события.
//
// Возвращаемое значение:
//  Массив из Соответствие - события для ПринятьСобытияТЖ.
Функция ТопАгрегатовТЖ(ГруппыСервера, Топ)

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Агрегат");
	Таблица.Колонки.Добавить("Событие");
	Таблица.Колонки.Добавить("Сумма");
	Таблица.Колонки.Добавить("Количество");
	Для Каждого КЗ Из ГруппыСервера Цикл
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.Агрегат = КЗ.Значение;
		СтрокаТаблицы.Событие = КЗ.Значение.Получить("event");
		СтрокаТаблицы.Сумма = КЗ.Значение.Получить("dur_sum_ms");
		СтрокаТаблицы.Количество = КЗ.Значение.Получить("count");
	КонецЦикла;
	Таблица.Сортировать("Сумма Убыв, Количество Убыв");

	Взято = Новый Соответствие;
	Результат = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Взятых = ?(Взято.Получить(СтрокаТаблицы.Событие) = Неопределено, 0, Взято.Получить(СтрокаТаблицы.Событие));
		Если Взятых < Топ Тогда
			Результат.Добавить(СтрокаТаблицы.Агрегат);
			Взято.Вставить(СтрокаТаблицы.Событие, Взятых + 1);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецОбласти
