	Разделы.Добавить(Новый Структура("Имя,Заголовок", "Удалены", "Удалены (архив на SHARE)"));
	Разделы.Добавить(Новый Структура("Имя,Заголовок", "СкороОтключение", "Скоро отключение"));
	Разделы.Добавить(Новый Структура("Имя,Заголовок", "ИстёкСрок", "Тестовые базы: наступила дата отключения"));
	Разделы.Добавить(Новый Структура("Имя,Заголовок", "НовыеБезВладельца", "Новые базы без владельца"));
	Разделы.Добавить(Новый Структура("Имя,Заголовок", "РабочиеБезВладельца", "Рабочие базы без владельца (автоматически не отключаются)"));
	Разделы.Добавить(Новый Структура("Имя,Заголовок", "БезБэкапа", "Рабочие базы без свежего полного бэкапа"));
	Разделы.Добавить(Новый Структура("Имя,Заголовок", "БыстрыйРост", "Базы, быстро растущие за неделю (отчёт «Рост таблиц баз»)"));
	Разделы.Добавить(Новый Структура("Имя,Заголовок", "Нагрузка", "Нагрузка серверов за сутки (отчёты «Нагрузка серверов» и «Проблемы производительности (ТЖ)»)"));
	Разделы.Добавить(Новый Структура("Имя,Заголовок", "НеучтённыеSQL", "Базы в SQL без записи в реестре"));
	Разделы.Добавить(Новый Структура("Имя,Заголовок", "НеучтённыеИБ", "ИБ в кластерах без записи в реестре (порт / имя)"));
	Разделы.Добавить(Новый Структура("Имя,Заголовок", "ВТестовые", "Переведены в тестовые по имени"));

	ПисемВладельцам = 0;
	Для Каждого КЗ Из Сводка.Владельцам Цикл
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КЗ.Ключ, "Наименование, Почта, WinЛогин");
		// Уволенным (учётка в AD отключена или удалена) не пишем: базам нужен новый владелец
		Состояние = СостояниеУчёткиВAD(Реквизиты.WinЛогин, Реквизиты.Почта);
		Если Состояние = "отключена" Или Состояние = "не найдена" Тогда
			ДобавитьВСводку(Сводка, "ВладелецУволен", Реквизиты.Наименование + " (учётка в AD " + Состояние
				+ "), событий по его базам: " + КЗ.Значение.Количество() + " - назначьте базам нового владельца");
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Реквизиты.Почта) Тогда
			ДобавитьВСводку(Сводка, "ВладелецУволен", Реквизиты.Наименование
				+ ": в справочнике нет почты, письмо по " + КЗ.Значение.Количество() + " событ. не отправлено");
			Продолжить;
		КонецЕсли;
		Адреса = Новый Массив;
		Адреса.Добавить(Реквизиты.Почта);
		ОтправитьПисьмоНаАдреса(Адреса, "Реестр баз: ваши базы требуют внимания (" + КЗ.Значение.Количество() + ")",
			"<p>Здравствуйте!</p><p>" + СтрСоединить(КЗ.Значение, "</p><p>") + "</p>"
			+ "<p>Это автоматическое письмо реестра баз base_list.</p>");
		ПисемВладельцам = ПисемВладельцам + 1;
	КонецЦикла;

	Текст = "";
	Событий = 0;
	Для Каждого Раздел Из Разделы Цикл
		Строки = Сводка.Разделы.Получить(Раздел.Имя);
		Если Строки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Событий = Событий + Строки.Количество();
		Текст = Текст + "<p><b>" + Раздел.Заголовок + " (" + Строки.Количество() + "):</b><br>"
			+ СтрСоединить(Строки, "<br>") + "</p>";
	КонецЦикла;

	ЗаписьЖурналаРегистрации("ПравилаРеестра.Сводка", УровеньЖурналаРегистрации.Информация, , ,
		"Событий в сводке " + Событий + ", писем владельцам " + ПисемВладельцам);

	Если Событий = 0 Тогда
		Возврат;
	КонецЕсли;

	Тема = "Реестр баз: сводка за " + Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy") + " (" + Событий + ")";
	ОтправитьПисьмо(Неопределено, Тема, Текст);
	ОтправитьТелеграм(Тема + Символы.ПС + Символы.ПС + ТекстБезHTML(Текст));

КонецПроцедуры

// Отправка письма через учётную запись БСП. Сбой почты пишется в журнал и не прерывает правило.
//
// Параметры:
//  Адреса - Массив из Строка - получатели.
//  Тема - Строка - тема письма.
//  ТекстHTML - Строка - текст письма в формате HTML.
Процедура ОтправитьПисьмоНаАдреса(Адреса, Тема, ТекстHTML)

	Если Адреса.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Попытка
		МодульРегламентныеЗадания.ОтправитьПисьмоПоБСП(Адреса, Тема, ТекстHTML);
	Исключение
		// Сбой почты не должен прерывать правило - иначе оставшиеся кандидаты в этом
		// прогоне не обрабатываются вообще, а не только не получают письмо.
		ЗаписьЖурналаРегистрации("ПравилаРеестра.Почта", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Не удалось отправить письмо """ + Тема + """: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Путь к rac той версии платформы, на которой работает нужный кластер:
// у каждого кластера своя версия, поэтому одной утилитой обойтись нельзя.
//
// Параметры:
//  Сервер1С - СправочникСсылка.Сервер1С - сервер кластера в виде "имя:порт".
//
// Возвращаемое значение:
//  Структура, Неопределено - поля Путь и ПортRAS (Строка);
//   Неопределено, если версия платформы для порта неизвестна.
Функция ПутьКRac(Сервер1С)

	// Соответствие портов и версий платформы заполняет задание <<Обновление кластеров>>.
	// Значения ниже - резерв, если автоопределение ещё не отработало.
	Версии = Новый Соответствие;
	ЗапросВерсий = Новый Запрос("ВЫБРАТЬ КластерыПлатформы.ПортКластера КАК Порт, КластерыПлатформы.ВерсияПлатформы КАК Версия ИЗ РегистрСведений.КластерыПлатформы КАК КластерыПлатформы");
	ВыборкаВерсий = ЗапросВерсий.Выполнить().Выбрать();
	Пока ВыборкаВерсий.Следующий() Цикл
		Версии.Вставить(СокрЛП(ВыборкаВерсий.Порт), СокрЛП(ВыборкаВерсий.Версия));
	КонецЦикла;
	Если Версии.Количество() = 0 Тогда
		Версии.Вставить("1541", "8.3.27.2214");
		Версии.Вставить("4541", "8.3.27.2130_v2");
		Версии.Вставить("7541", "8.3.21.1624");
		Версии.Вставить("8541", "8.3.27.2074");
	КонецЕсли;

	Порт = "1541";
	Части = СтрРазделить(Строка(Сервер1С), ":", Ложь);
	Если Части.Количество() > 1 Тогда
		Порт = СокрЛП(Части[1]);
	КонецЕсли;

	Версия = Версии.Получить(Порт);
	Если Версия = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Путь,ПортRAS",
		"C:\Program Files\1cv8\" + Версия + "\bin\rac.exe", Формат(Число(Порт) + 4, "ЧГ=0"));

КонецФункции

// Выполняет консольную команду и возвращает её вывод.
//
// Параметры:
//  КоманднаяСтрока - Строка - команда для cmd.exe.
//  Кодировка - Строка - кодировка вывода команды (по умолчанию cp866, у Java-утилит - UTF-8).
//
// Возвращаемое значение:
//  Структура - поля КодВозврата (Число) и Вывод (Строка, stdout и stderr).
Функция ВыполнитьКоманду(КоманднаяСтрока, Кодировка = "cp866")

	ФайлВывода = ПолучитьИмяВременногоФайла("out");
	КодВозврата = 0;
	Попытка
		// Внешние кавычки обязательны: если строка после /c начинается с кавычки (путь к rac.exe
		// с пробелами), cmd срезает первую и последнюю кавычку и команда ломается.
		ЗапуститьПриложение("cmd.exe /c """ + КоманднаяСтрока + " > """ + ФайлВывода + """ 2>&1""", , Истина, КодВозврата);
	Исключение
		Возврат Новый Структура("КодВозврата,Вывод", -1, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Вывод = "";
	Попытка
		Чтение = Новый ЧтениеТекста(ФайлВывода, Кодировка);
		Вывод = Чтение.Прочитать();
		Чтение.Закрыть();
		УдалитьФайлы(ФайлВывода);
	Исключение
		Вывод = "";
	КонецПопытки;

	Возврат Новый Структура("КодВозврата,Вывод", КодВозврата, ?(Вывод = Неопределено, "", Вывод));

КонецФункции

// Логин и пароль администратора кластера хранятся вне конфигурации.
//
// Возвращаемое значение:
//  Структура, Неопределено - поля Пользователь и Пароль (Строка);
//   Неопределено, если файл не прочитан или в нём нет двух значений через табуляцию.
Функция УчётнаяЗаписьКластера()

	Путь = Настройка("ФайлУчётнойЗаписиКластера", "C:\Kirill\OwnerGuard\cluster.cred");
	Попытка
		Чтение = Новый ЧтениеТекста(Путь, "UTF-8");
		Строка = СокрЛП(Чтение.Прочитать());
		Чтение.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Части = СтрРазделить(Строка, Символы.Таб, Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Пользователь,Пароль", СокрЛП(Части[0]), СокрЛП(Части[1]));

КонецФункции

// Есть ли сейчас сеансы в базе. Активную базу не отключаем.
//
// Параметры:
//  Сервер1С - СправочникСсылка.Сервер1С - сервер кластера.
//  ИмяБазы1С - Строка - имя информационной базы в кластере.
//
// Возвращаемое значение:
//  Структура - поля Ошибка (Строка, пусто при успехе) и Сеансы (Массив из Строка вида "пользователь @ хост").
Функция АктивныеСеансы(Сервер1С, ИмяБазы1С)

	Результат = Новый Структура("Ошибка,Сеансы", "", Новый Массив);

	Rac = ПутьКRac(Сервер1С);
	Если Rac = Неопределено Тогда
		Результат.Ошибка = "Неизвестный кластер: " + Строка(Сервер1С);
		Возврат Результат;
	КонецЕсли;

	Учётка = УчётнаяЗаписьКластера();
	Если Учётка = Неопределено Тогда
		Результат.Ошибка = "Не удалось прочитать учётную запись администратора кластера";
		Возврат Результат;
	КонецЕсли;

	База = "localhost:" + Rac.ПортRAS;
	Ответ = ВыполнитьКоманду("""" + Rac.Путь + """ " + База + " cluster list");
	Кластер = "";
	Для Каждого Строка Из СтрРазделить(Ответ.Вывод, Символы.ПС, Ложь) Цикл
		Если СтрНачинаетсяС(СокрЛП(Строка), "cluster") Тогда
			Части = СтрРазделить(Строка, ":", Ложь);
			Если Части.Количество() > 1 Тогда
				Кластер = СокрЛП(Части[1]);
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если НЕ ЗначениеЗаполнено(Кластер) Тогда
		Результат.Ошибка = "Не удалось определить кластер: " + Ответ.Вывод;
		Возврат Результат;
	КонецЕсли;

	ИдентификаторБазы = ИдентификаторИБ(Rac, База, Кластер, Учётка, ИмяБазы1С);
	Если НЕ ЗначениеЗаполнено(ИдентификаторБазы) Тогда
		Результат.Ошибка = "Информационная база не найдена в кластере";
		Возврат Результат;
	КонецЕсли;

	Ответ = ВыполнитьКоманду("""" + Rac.Путь + """ " + База + " session list --cluster=" + Кластер
		+ " --cluster-user=" + Учётка.Пользователь + " --cluster-pwd=" + Учётка.Пароль);

	ТекущаяИБ = ""; Пользователь = ""; Хост = ""; Приложение = "";
	Для Каждого Строка Из СтрРазделить(Ответ.Вывод, Символы.ПС, Ложь) Цикл
		Стр = СокрЛП(Строка);
		Если Стр = "" Тогда
			// Фоновые задания, COM/WS/HTTP/OData-соединения и консоль кластера не считаются
			// использованием базы человеком - иначе регламентное задание, стартующее ровно
			// в момент проверки, само же и отменяет отключение своей базы.
			Если ТекущаяИБ = ИдентификаторБазы И ЭтоПользовательскийСеанс(Приложение, Пользователь) Тогда
				Результат.Сеансы.Добавить(Пользователь + " @ " + Хост);
			КонецЕсли;
			ТекущаяИБ = ""; Пользователь = ""; Хост = ""; Приложение = "";
			Продолжить;
		КонецЕсли;
		Если СтрНачинаетсяС(Стр, "infobase ") Или СтрНачинаетсяС(Стр, "infobase:") Тогда
			ТекущаяИБ = СокрЛП(Сред(Стр, СтрНайти(Стр, ":") + 1));
		ИначеЕсли СтрНачинаетсяС(Стр, "user-name") Тогда
			Пользователь = СокрЛП(Сред(Стр, СтрНайти(Стр, ":") + 1));
		ИначеЕсли СтрНачинаетсяС(Стр, "host") Тогда
			Хост = СокрЛП(Сред(Стр, СтрНайти(Стр, ":") + 1));
		ИначеЕсли СтрНачинаетсяС(Стр, "app-id") Тогда
			Приложение = СокрЛП(Сред(Стр, СтрНайти(Стр, ":") + 1));
		КонецЕсли;
	КонецЦикла;
	Если ТекущаяИБ = ИдентификаторБазы И ЭтоПользовательскийСеанс(Приложение, Пользователь) Тогда
		Результат.Сеансы.Добавить(Пользователь + " @ " + Хост);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ИдентификаторИБ(Rac, База, Кластер, Учётка, ИмяБазы1С)

	Ответ = ВыполнитьКоманду("""" + Rac.Путь + """ " + База + " infobase summary list --cluster=" + Кластер
		+ " --cluster-user=" + Учётка.Пользователь + " --cluster-pwd=" + Учётка.Пароль);

	Текущий = "";
	Для Каждого Строка Из СтрРазделить(Ответ.Вывод, Символы.ПС, Ложь) Цикл
		Стр = СокрЛП(Строка);
		Если СтрНачинаетсяС(Стр, "infobase") Тогда
			Текущий = СокрЛП(Сред(Стр, СтрНайти(Стр, ":") + 1));
		ИначеЕсли СтрНачинаетсяС(Стр, "name") Тогда
			Если СокрЛП(Сред(Стр, СтрНайти(Стр, ":") + 1)) = ИмяБазы1С Тогда
				Возврат Текущий;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Перевод базы в OFFLINE и удаление информационной базы из кластера.
//
// Параметры:
//  База - Структура - поля Сервер1С, ИмяБазы1С, СерверБД, ИмяБазыБД, Тип, Владелец.
//  Причина - Строка - причина отключения для письма и статуса.
//  Правило - Строка - имя правила в регистре КонтрольБаз.
// Отключение базы правилом: OFFLINE в СУБД и удаление ИБ из кластера, если в базе нет
// пользовательских сеансов. Итог пишется в сводку и в письмо владельцу.
//
// Параметры:
//  База - см. ОписаниеБазы.
//  Причина - Строка - причина отключения для сводки и владельца.
//  Правило - Строка - имя правила в КонтрольБаз.
//  Сводка - см. НоваяСводка.
Процедура ОтключитьБазу(База, Причина, Правило, Сводка)

	// База без кластера (только БД в СУБД): сеансов 1С в ней быть не может, проверять негде
	Если ЗначениеЗаполнено(База.Сервер1С) Тогда
		Проверка = АктивныеСеансы(База.Сервер1С, База.ИмяБазы1С);
	Иначе
		Проверка = Новый Структура("Ошибка,Сеансы", "", Новый Массив);
	КонецЕсли;

	Если ЗначениеЗаполнено(Проверка.Ошибка) Тогда
		ОбновитьСтатус(Правило, База.Сервер1С, База.ИмяБазы1С, "отключение отменено: " + Проверка.Ошибка);
		ЗаписьЖурналаРегистрации("ПравилаРеестра." + Правило, УровеньЖурналаРегистрации.Предупреждение, , ,
			База.ИмяБазы1С + ": " + Проверка.Ошибка);
		ДобавитьВСводку(Сводка, "ОтключениеОтменено", СтрокаБазы(База) + ": не удалось проверить сеансы - " + Проверка.Ошибка);
		Возврат;
	КонецЕсли;

	Если Проверка.Сеансы.Количество() > 0 Тогда
		ДобавитьВСводку(Сводка, "ОтключениеОтменено", СтрокаБазы(База) + " (" + Причина + "): база используется - "
			+ СтрСоединить(Проверка.Сеансы, ", "), База.Владелец,
			"<b>" + База.ИмяБазы1С + "</b> (" + Строка(База.Сервер1С) + ") подлежала отключению (" + Причина
			+ "), но ею пользуются, поэтому отключение отменено. Устраните причину, иначе проверка повторится."
			+ ПутьКБазеHTML(База));
		ОбновитьСтатус(Правило, База.Сервер1С, База.ИмяБазы1С, "активна, отключение отменено");
		Возврат;
	КонецЕсли;

	Связи = СвязиБазы(База.ИмяБазы1С);
	Если ЗначениеЗаполнено(Связи) Тогда
		ДобавитьВСводку(Сводка, "Связи", СтрокаБазы(База) + " отключается, а в реестре связей у неё: " + Связи);
	КонецЕсли;

	Статус = Новый Массив;

	// 1. база СУБД в OFFLINE
	СерверSQL = ?(ЗначениеЗаполнено(База.СерверБД), Строка(База.СерверБД), "localhost");
	Команда = КомандаSQL(СерверSQL) + " -b -Q ""ALTER DATABASE [" + База.ИмяБазыБД + "] SET OFFLINE WITH ROLLBACK AFTER 60""";
	Ответ = ВыполнитьКоманду(Команда);
	Если Ответ.КодВозврата = 0 Тогда
		Статус.Добавить("СУБД: OFFLINE");
	Иначе
		Статус.Добавить("СУБД: ошибка (" + Ответ.КодВозврата + ") " + Лев(Ответ.Вывод, 200));
	КонецЕсли;

	// 2. удаление информационной базы из кластера, файлы базы остаются
	Если ЗначениеЗаполнено(База.Сервер1С) Тогда
		Статус.Добавить(УдалитьИБИзКластера(База.Сервер1С, База.ИмяБазы1С));
	Иначе
		Статус.Добавить("кластер: база не зарегистрирована ни в одном кластере");
	КонецЕсли;

	ОбновитьСтатус(Правило, База.Сервер1С, База.ИмяБазы1С, СтрСоединить(Статус, "; "), ТекущаяДатаСеанса());

	ВернутьДо = Формат(ТекущаяДатаСеанса() + Настройка("СрокДоУдаленияОтключённойДней", 30) * 86400, "ДФ=dd.MM.yyyy");
	ДобавитьВСводку(Сводка, "Отключены", СтрокаБазы(База) + ": " + Причина + ". " + СтрСоединить(Статус, "; ")
		+ ". Удаление после " + ВернутьДо, База.Владелец,
		"<b>" + База.ИмяБазы1С + "</b> (" + Строка(База.Сервер1С) + ") отключена: " + Причина + ". "
		+ "Файлы базы сохранены. Если база нужна, верните её сами до <b>" + ВернутьДо + "</b>: в base_list откройте "
		+ "реестр «Серверы и базы», при отключении по сроку сначала продлите дату отключения, затем выделите базу "
		+ "и нажмите «Вернуть базу». Через 5 минут база снова будет доступна, а вы станете её владельцем. "
		+ "<b>После этой даты база будет удалена.</b>" + ПутьКБазеHTML(База));

	ЗаписьЖурналаРегистрации("ПравилаРеестра." + Правило, УровеньЖурналаРегистрации.Информация, , ,
		База.ИмяБазы1С + " отключена: " + СтрСоединить(Статус, "; "));

КонецПроцедуры

// Удаляет информационную базу из кластера 1С; база данных в СУБД не трогается.
//
// Параметры:
//  Сервер1С - СправочникСсылка.Сервер1С, Строка - сервер кластера вида "имя:порт".
//  ИмяБазы1С - Строка - имя информационной базы.
//
// Возвращаемое значение:
//  Строка - итог для статуса и письма.
Функция УдалитьИБИзКластера(Сервер1С, ИмяБазы1С)

	Rac = ПутьКRac(Сервер1С);
	Учётка = УчётнаяЗаписьКластера();
	Если Rac = Неопределено ИЛИ Учётка = Неопределено Тогда
		Возврат "кластер: нет данных для подключения";
	КонецЕсли;

	Адрес = "localhost:" + Rac.ПортRAS;
	Кластер = ИдентификаторКластера(Rac, Адрес);
	Если НЕ ЗначениеЗаполнено(Кластер) Тогда
		Возврат "кластер: не удалось определить кластер";
	КонецЕсли;

	ИдентификаторБазы = ИдентификаторИБ(Rac, Адрес, Кластер, Учётка, ИмяБазы1С);
	Если НЕ ЗначениеЗаполнено(ИдентификаторБазы) Тогда
		Возврат "кластер: ИБ не найдена";
	КонецЕсли;

	Ответ = ВыполнитьКоманду("""" + Rac.Путь + """ " + Адрес + " infobase drop --cluster=" + Кластер
		+ " --cluster-user=" + Учётка.Пользователь + " --cluster-pwd=" + Учётка.Пароль + " --infobase=" + ИдентификаторБазы);
	Возврат ?(Ответ.КодВозврата = 0, "кластер: ИБ удалена", "кластер: удалить не удалось " + Лев(Ответ.Вывод, 200));

КонецФункции

// Идентификатор кластера по адресу RAS.
//
// Параметры:
//  Rac - Структура - результат ПутьКRac.
//  Адрес - Строка - адрес RAS вида "localhost:1545".
//
// Возвращаемое значение:
//  Строка - идентификатор первого кластера; пусто, если не найден.
Функция ИдентификаторКластера(Rac, Адрес)

	Ответ = ВыполнитьКоманду("""" + Rac.Путь + """ " + Адрес + " cluster list");
	Для Каждого Строка Из СтрРазделить(Ответ.Вывод, Символы.ПС, Ложь) Цикл
		Стр = СокрЛП(Строка);
		Если СтрНачинаетсяС(Стр, "cluster") И СтрНайти(Стр, ":") > 0 Тогда
			Возврат СокрЛП(Сред(Стр, СтрНайти(Стр, ":") + 1));
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Записи вывода rac: блоки строк «ключ : значение», разделённые пустой строкой.
//
// Параметры:
//  Вывод - Строка - вывод команды rac.
//
// Возвращаемое значение:
//  Массив из Соответствие - по записи на блок: ключ - имя поля rac, значение - Строка без кавычек.
Функция ЗаписиВыводаRac(Вывод)

	Записи = Новый Массив;
	Запись = Неопределено;
	Для Каждого ТекстСтроки Из СтрРазделить(Вывод, Символы.ПС, Истина) Цикл
		Стр = СокрЛП(ТекстСтроки);
		Позиция = СтрНайти(Стр, ":");
		Если Позиция = 0 Тогда
			Запись = Неопределено;
			Продолжить;
		КонецЕсли;
		Если Запись = Неопределено Тогда
			Запись = Новый Соответствие;
			Записи.Добавить(Запись);
		КонецЕсли;
		Значение = СокрЛП(Сред(Стр, Позиция + 1));
		Если СтрДлина(Значение) > 1 И СтрНачинаетсяС(Значение, """") И СтрЗаканчиваетсяНа(Значение, """") Тогда
			Значение = СтрЗаменить(Сред(Значение, 2, СтрДлина(Значение) - 2), """""", """");
		КонецЕсли;
		Запись.Вставить(СокрЛП(Лев(Стр, Позиция - 1)), Значение);
	КонецЦикла;
	Возврат Записи;

КонецФункции

// Имена всех информационных баз кластера одним вызовом rac.
//
// Параметры:
//  Rac - Структура - результат ПутьКRac.
//  Адрес - Строка - адрес RAS.
//  Кластер - Строка - идентификатор кластера.
//  Учётка - Структура, Неопределено - результат УчётнаяЗаписьКластера; Неопределено - без учётных данных.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - ключ: идентификатор базы, значение: имя базы.
Функция ИменаИБКластера(Rac, Адрес, Кластер, Учётка)

	// Учётка = Неопределено - кластер без администраторов (8541), rac без учётных данных
	Ответ = ВыполнитьКоманду("""" + Rac.Путь + """ " + Адрес + " infobase summary list --cluster=" + Кластер
		+ ?(Учётка = Неопределено, "", " --cluster-user=" + Учётка.Пользователь + " --cluster-pwd=" + Учётка.Пароль));

	Имена = Новый Соответствие;
	Для Каждого Запись Из ЗаписиВыводаRac(Ответ.Вывод) Цикл
		Если ЗначениеЗаполнено(Запись.Получить("infobase")) И ЗначениеЗаполнено(Запись.Получить("name")) Тогда
			Имена.Вставить(Запись.Получить("infobase"), Запись.Получить("name"));
		КонецЕсли;
	КонецЦикла;
	Возврат Имена;

КонецФункции

// Признак сеанса, открытого человеком. Фоновые задания, внешние соединения и сервисы
// входом в базу не считаются: они идут по расписанию и в неиспользуемой базе.
// Неизвестное приложение с заполненным пользователем считаем пользовательским -
// это безопаснее, когда по простою решают судьбу базы.
//
// Параметры:
//  Приложение - Строка - app-id сеанса из rac.
//  Пользователь - Строка - user-name сеанса из rac.
//
// Возвращаемое значение:
//  Булево
Функция ЭтоПользовательскийСеанс(Приложение, Пользователь)

	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		Возврат Ложь;
	КонецЕсли;
	Служебные = СтрРазделить("backgroundjob,systembackgroundjob,comconnection,wsconnection,"
		+ "httpserviceconnection,odataconnection,integrationservice,jobscheduler,srvrconsole,ras", ",");
	Возврат Служебные.Найти(НРег(Приложение)) = Неопределено;

КонецФункции

// Последний пользовательский сеанс каждой базы сервера записывает в АктивностьБаз.
//
// Параметры:
//  Сервер - Строка - представление сервера 1С, как в СостояниеБаз (например, S2019:1541).
//  Сеансы - Массив из Соответствие - результат ЗаписиВыводаRac для rac session list.
//  ИменаИБ - Соответствие - результат ИменаИБКластера.
Процедура ЗаписатьАктивностьБаз(Сервер, Сеансы, ИменаИБ)

	Последние = Новый Соответствие;
	Для Каждого Сеанс Из Сеансы Цикл
		Если НЕ ЭтоПользовательскийСеанс(ЗначениеПоля(Сеанс, "app-id"), ЗначениеПоля(Сеанс, "user-name")) Тогда
			Продолжить;
		КонецЕсли;
		ИмяБазы = ИменаИБ.Получить(ЗначениеПоля(Сеанс, "infobase"));
		Если НЕ ЗначениеЗаполнено(ИмяБазы) Тогда
			Продолжить;
		КонецЕсли;
		Когда = ДатаИзISO(ЗначениеПоля(Сеанс, "last-active-at"));
		Если НЕ ЗначениеЗаполнено(Когда) Тогда
			Когда = ДатаИзISO(ЗначениеПоля(Сеанс, "started-at"));
		КонецЕсли;
		Лучший = Последние.Получить(ИмяБазы);
		Если Лучший = Неопределено ИЛИ Когда > Лучший.Когда Тогда
			Последние.Вставить(ИмяБазы, Новый Структура("Когда, Кто, Откуда",
				Когда, ЗначениеПоля(Сеанс, "user-name"), ЗначениеПоля(Сеанс, "host")));
		КонецЕсли;
	КонецЦикла;

	Для Каждого КЗ Из Последние Цикл
		ЗаписатьПоследнююАктивность(Сервер, КЗ.Ключ, КЗ.Значение.Когда, КЗ.Значение.Кто, КЗ.Значение.Откуда);
	КонецЦикла;

КонецПроцедуры

// Обновляет запись АктивностьБаз, если активность новее сохранённой.
//
// Параметры:
//  Сервер - Строка - представление сервера 1С.
//  ИмяБазы - Строка - имя базы в кластере.
//  Когда - Дата - время активности.
//  Кто - Строка - пользователь.
//  Откуда - Строка - компьютер.
Процедура ЗаписатьПоследнююАктивность(Сервер, ИмяБазы, Когда, Кто, Откуда)

	МенеджерЗаписи = РегистрыСведений.АктивностьБаз.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Сервер = Сервер;
	МенеджерЗаписи.ИмяБазы = ИмяБазы;
	МенеджерЗаписи.Прочитать();
	Если ЗначениеЗаполнено(МенеджерЗаписи.ПоследняяАктивность) И МенеджерЗаписи.ПоследняяАктивность >= Когда Тогда
		Возврат;
	КонецЕсли;
	МенеджерЗаписи.Сервер = Сервер;
	МенеджерЗаписи.ИмяБазы = ИмяБазы;
	МенеджерЗаписи.ПоследняяАктивность = Когда;
	МенеджерЗаписи.КтоПоследний = Кто;
	МенеджерЗаписи.ОткудаПоследний = Откуда;
	МенеджерЗаписи.ДнейПростоя = Макс(0, Цел((ТекущаяДатаСеанса() - Когда) / 86400));
	МенеджерЗаписи.Записать(Истина);

КонецПроцедуры

// Однократно переносит историю, накопленную прежним внешним скриптом мониторинга
// (CSV в настройке ФайлИсторииАктивности). Признак переноса - настройка ИсторияАктивностиПеренесена.
Процедура ПеренестиИсториюАктивности()

	Если ЗначениеЗаполнено(Настройка("ИсторияАктивностиПеренесена", "")) Тогда
		Возврат;
	КонецЕсли;

	// Путь по умолчанию - место, где прежний скрипт хранил историю.
	ИмяФайла = Настройка("ФайлИсторииАктивности", "C:\Kirill\ClusterCheck\1c-last-activity-state.csv"); // BSLLS:UsingHardcodePath-off
	ФайлИстории = Новый Файл(ИмяФайла);
	Если ФайлИстории.Существует() Тогда
		Попытка
			ЗагрузитьИсториюАктивности(ИмяФайла);
		Исключение
			ЗаписьЖурналаРегистрации("Мониторинг.Активность", УровеньЖурналаРегистрации.Ошибка, , ,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	ЗаписатьНастройку("ИсторияАктивностиПеренесена", "1");

КонецПроцедуры

// Запоминает, с какого момента сеансы сервера 1С наблюдаются, если это ещё не задано.
// Без начала наблюдения простой базы не считается: молчание сервера - не простой.
//
// Параметры:
//  Сервер - Строка - представление сервера 1С.
//  Начало - Дата - начало наблюдения.
Процедура ОтметитьНачалоНаблюдения(Сервер, Начало)

	Параметр = "НаблюдениеАктивностиС " + Сервер;
	Если НЕ ЗначениеЗаполнено(Настройка(Параметр, "")) Тогда
		ЗаписатьНастройку(Параметр, XMLСтрока(Начало));
	КонецЕсли;

КонецПроцедуры

// Записывает значение в регистр НастройкиПравилРеестра.
//
// Параметры:
//  Параметр - Строка - имя настройки.
//  Значение - Строка, Число - значение настройки.
Процедура ЗаписатьНастройку(Параметр, Значение)

	МенеджерЗаписи = РегистрыСведений.НастройкиПравилРеестра.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Параметр = Параметр;
	МенеджерЗаписи.Значение = Значение;
	МенеджерЗаписи.Записать(Истина);

КонецПроцедуры

// Переносит последнюю пользовательскую активность из CSV прежнего скрипта мониторинга
// (1c-last-activity.ps1, кластер S2019:1541, время в UTC) и начало его наблюдения.
//
// Параметры:
//  ИмяФайла - Строка - путь к 1c-last-activity-state.csv.
Процедура ЗагрузитьИсториюАктивности(ИмяФайла)

	Сервер = "S2019:1541";
	Начало = ТекущаяДатаСеанса();
	Перенесено = 0;
	Чтение = Новый ЧтениеТекста(ИмяФайла, КодировкаТекста.UTF8);
	Колонки = Новый Соответствие;
	ТекстСтроки = Чтение.ПрочитатьСтроку();
	Пока ТекстСтроки <> Неопределено Цикл
		Поля = СтрРазделить(СтрЗаменить(ТекстСтроки, """", ""), ";", Истина);
		ЭтоЗаголовок = (Колонки.Количество() = 0);
		Если ЭтоЗаголовок Тогда
			Для Индекс = 0 По Поля.ВГраница() Цикл
				Колонки.Вставить(Поля[Индекс], Индекс);
			КонецЦикла;
		КонецЕсли;
		// Неполные строки файла пропускаем.
		Если НЕ ЭтоЗаголовок И Поля.Количество() >= Колонки.Количество() Тогда
			Первое = ДатаИзISO(Поля[Колонки["FirstObservedAt"]]);
			Если ЗначениеЗаполнено(Первое) Тогда
				Начало = Мин(Начало, МестноеВремя(Первое));
			КонецЕсли;
			Когда = ДатаИзISO(Поля[Колонки["LastUserActivityAt"]]);
			Если ЗначениеЗаполнено(Когда) Тогда
				ЗаписатьПоследнююАктивность(Сервер, Поля[Колонки["InfobaseName"]], МестноеВремя(Когда),
					Поля[Колонки["LastUserActivityName"]], Поля[Колонки["LastUserHost"]]);
				Перенесено = Перенесено + 1;
			КонецЕсли;
		КонецЕсли;
		ТекстСтроки = Чтение.ПрочитатьСтроку();
	КонецЦикла;
	Чтение.Закрыть();

	ОтметитьНачалоНаблюдения(Сервер, Начало);
	ЗаписьЖурналаРегистрации("Мониторинг.Активность", УровеньЖурналаРегистрации.Информация, , ,
		"Перенесена история из " + ИмяФайла + ": баз с активностью " + Перенесено + ", наблюдение с " + Начало);

КонецПроцедуры

// Пересчитывает ДнейПростоя всех баз реестра; базы без записи получают её.
// Простой считается от последней активности, а если её не было - от начала наблюдения
// за сервером. Сервер, который ещё ни разу не удалось опросить, даёт -1 (неизвестно).
Процедура ПересчитатьДниПростоя()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СерверыИБазы.Сервер1С.Наименование КАК Сервер,
	|	СерверыИБазы.ИмяБазы1С КАК ИмяБазы,
	|	ЕСТЬNULL(АктивностьБаз.ПоследняяАктивность, ДАТАВРЕМЯ(1, 1, 1)) КАК ПоследняяАктивность,
	|	ЕСТЬNULL(АктивностьБаз.ДнейПростоя, -2) КАК ДнейПростоя,
	|	НЕ АктивностьБаз.ИмяБазы ЕСТЬ NULL КАК ЕстьЗапись,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Наблюдение.Значение КАК СТРОКА(30)), """") КАК НачалоНаблюдения
	|ИЗ
	|	РегистрСведений.СерверыИБазы КАК СерверыИБазы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АктивностьБаз КАК АктивностьБаз
	|		ПО СерверыИБазы.Сервер1С.Наименование = АктивностьБаз.Сервер
	|			И СерверыИБазы.ИмяБазы1С = АктивностьБаз.ИмяБазы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиПравилРеестра КАК Наблюдение
	|		ПО (Наблюдение.Параметр = ""НаблюдениеАктивностиС "" + СерверыИБазы.Сервер1С.Наименование)
	|ГДЕ
	|	СерверыИБазы.Сервер1С <> ЗНАЧЕНИЕ(Справочник.Сервер1С.ПустаяСсылка)
	|	И СерверыИБазы.ИмяБазы1С <> """"";
	Выборка = Запрос.Выполнить().Выбрать();

	Сейчас = ТекущаяДатаСеанса();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.ПоследняяАктивность) Тогда
			Дней = Макс(0, Цел((Сейчас - Выборка.ПоследняяАктивность) / 86400));
		ИначеЕсли ЗначениеЗаполнено(Выборка.НачалоНаблюдения) Тогда
			Дней = Макс(0, Цел((Сейчас - ДатаИзISO(Выборка.НачалоНаблюдения)) / 86400));
		Иначе
			Дней = -1;
		КонецЕсли;
		Если Выборка.ЕстьЗапись И Выборка.ДнейПростоя = Дней Тогда
			Продолжить;
		КонецЕсли;
		МенеджерЗаписи = РегистрыСведений.АктивностьБаз.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Сервер = Выборка.Сервер;
		МенеджерЗаписи.ИмяБазы = Выборка.ИмяБазы;
		МенеджерЗаписи.Прочитать();
		МенеджерЗаписи.Сервер = Выборка.Сервер;
		МенеджерЗаписи.ИмяБазы = Выборка.ИмяБазы;
		МенеджерЗаписи.ДнейПростоя = Дней;
		МенеджерЗаписи.Записать(Истина);
	КонецЦикла;

КонецПроцедуры

// Запреты регламентных заданий и сеансов по базам всех кластеров сервера.
// Флаги хранятся в реестре кластера (1CV8Clst.lst), а не в самой базе, поэтому
// пароли пользователей баз не нужны: у каждой базы он свой.
// Запись базы в файле - строка "{uuid,"имя",...", следующая за ней строка
// "{запрет сеансов,с,по,...},запрет заданий,выдача лицензий,...".
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - ключ: "порт|ИМЯ БАЗЫ" (имя в верхнем регистре),
//   значение: Структура с полями ЗаданияЗапрещены и СеансыЗапрещены (Булево).
Функция ЗапретыИзРеестровКластеров()

	Результат = Новый Соответствие;

	// Каталоги служб кластеров: <корень>\srvinfo*\reg_<порт> или <корень>\srvinfo*\<каталог>\reg_<порт>.
	Корень = Настройка("КаталогСлужбКластеров", "D:\1cv8");
	Реестры = Новый Массив;
	Для Каждого Каталог Из НайтиФайлы(Корень, "srvinfo*", Ложь) Цикл
		Если НЕ Каталог.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Вложенный Из НайтиФайлы(Каталог.ПолноеИмя, "*", Ложь) Цикл
			Если НЕ Вложенный.ЭтоКаталог() Тогда
				Продолжить;
			ИначеЕсли СтрНачинаетсяС(НРег(Вложенный.Имя), "reg_") Тогда
				Реестры.Добавить(Вложенный);
			Иначе
				Для Каждого Реестр Из НайтиФайлы(Вложенный.ПолноеИмя, "reg_*", Ложь) Цикл
					Если Реестр.ЭтоКаталог() Тогда
						Реестры.Добавить(Реестр);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Для Каждого Реестр Из Реестры Цикл

		ИмяФайла = Реестр.ПолноеИмя + ПолучитьРазделительПути() + "1CV8Clst.lst";
		ФайлРеестра = Новый Файл(ИмяФайла);
		Если НЕ ФайлРеестра.Существует() Тогда
			Продолжить;
		КонецЕсли;
		Порт = Сред(Реестр.Имя, 5);

		Попытка
			Чтение = Новый ЧтениеТекста(ИмяФайла, КодировкаТекста.UTF8);
			Текст = Чтение.Прочитать();
			Чтение.Закрыть();
		Исключение
			ЗаписьЖурналаРегистрации("Мониторинг.Доступность", УровеньЖурналаРегистрации.Предупреждение, , ,
				"Не прочитан реестр кластера " + ИмяФайла + ": "
				+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Продолжить;
		КонецПопытки;
		Если НЕ ЗначениеЗаполнено(Текст) Тогда
			Продолжить;
		КонецЕсли;

		Строки = СтрРазделить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, Ложь);
		Для Индекс = 0 По Строки.Количество() - 2 Цикл
			Заголовок = Строки[Индекс];
			Блок = Строки[Индекс + 1];
			Если СтрДлина(Заголовок) < 40 ИЛИ Лев(Заголовок, 1) <> "{" ИЛИ Сред(Заголовок, 38, 2) <> ",""" Тогда
				Продолжить;
			КонецЕсли;
			Если СтрДлина(Блок) < 20 ИЛИ Лев(Блок, 1) <> "{" ИЛИ Сред(Блок, 3, 1) <> "," ИЛИ Сред(Блок, 18, 1) <> "," Тогда
				Продолжить;
			КонецЕсли;
			КонецИмени = СтрНайти(Заголовок, """,""", НаправлениеПоиска.СНачала, 40);
			ПозицияЗаданий = СтрНайти(Блок, "},");
			Если КонецИмени = 0 ИЛИ ПозицияЗаданий = 0 Тогда
				Продолжить;
			КонецЕсли;
			Имя = СокрЛП(Сред(Заголовок, 40, КонецИмени - 40));
			Результат.Вставить(Порт + "|" + ВРег(Имя), Новый Структура("ЗаданияЗапрещены,СеансыЗапрещены",
				Сред(Блок, ПозицияЗаданий + 2, 1) = "1", Сред(Блок, 2, 1) = "1"));
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Уведомление в Telegram. У сервера нет доступа к api.telegram.org, а прежний релей на VPS
// 45.86.181.152 больше не существует. Сообщение кладётся файлом в очередь, её забирает
// наблюдатель на станции 88.44 (C:\claude\tgbridge\baselist_outbox.ps1) и отправляет
// через туннель бота; токен бота на сервере 1С не хранится.
//
// Параметры:
//  Текст - Строка - текст сообщения (обычный текст, без HTML).
Процедура ОтправитьТелеграм(Текст)

	Каталог = Настройка("КаталогОчередиТелеграм", "D:\1cv8\baselist_cfg\tg_outbox");
	Если Прав(Каталог, 1) <> "\" Тогда
		Каталог = Каталог + "\";
	КонецЕсли;

	Попытка
		Документ = Новый ТекстовыйДокумент;
		Документ.УстановитьТекст(Текст);
		// временное имя, затем переименование: наблюдатель не заберёт недописанный файл
		ИмяФайла = Каталог + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd_HHmmss") + "_" + Строка(Новый УникальныйИдентификатор);
		Документ.Записать(ИмяФайла + ".tmp", КодировкаТекста.UTF8);
		ПереместитьФайл(ИмяФайла + ".tmp", ИмяФайла + ".txt");
	Исключение
		ЗаписьЖурналаРегистрации("Мониторинг.Телеграм", УровеньЖурналаРегистрации.Предупреждение, , ,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Текст сводки для Telegram: HTML письма в обычный текст.
//
// Параметры:
//  ТекстHTML - Строка - текст сводки в формате HTML.
//
// Возвращаемое значение:
//  Строка - обычный текст.
Функция ТекстБезHTML(ТекстHTML)

	Текст = СтрЗаменить(ТекстHTML, "<br>", Символы.ПС);
	Текст = СтрЗаменить(Текст, "</p><p>", Символы.ПС + Символы.ПС);
	Для Каждого Тег Из СтрРазделить("<p>,</p>,<b>,</b>,<i>,</i>", ",") Цикл
		Текст = СтрЗаменить(Текст, Тег, "");
	КонецЦикла;
	Возврат СокрЛП(Текст);

КонецФункции

