////////////////////////////////////////////////////////////////////////////////
// Раздел «Анализ»: общая шапка форм (период, база, доп. фильтр), условия отбора
// по рбфСобытияТЖ и разбор свойств события ТЖ из поля Пример.
//
// Формы показывают только то, что есть в регистрах base_list: почасовые агрегаты ТЖ
// от агентов (рбфСобытияТЖ) и замеры счётчиков (рбфСчетчики). Плана запроса, значений
// параметров, графа взаимоблокировки в агрегатах нет - их даст tj-analyzer, а до тех пор
// на месте этих данных пишется НетДанных().
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Подпись на месте данных, которые base_list сам не собирает.
//
// Возвращаемое значение:
//  Строка - текст подписи.
Функция НетДанных() Экспорт

	Возврат "нет данных: нужен tj-analyzer";

КонецФункции

// Заполняет общую шапку формы раздела: варианты периода, списки баз и серверов,
// период по умолчанию «Последние 3 часа». Доп. фильтр скрыт до нажатия ссылки.
// Форма должна иметь реквизиты ВидПериода, НачалоПериода, КонецПериода, ТолькоВремя,
// ВремяС, ВремяПо, База, Сервер, ТекстСодержит, МинДлительность и группу ГруппаДопФильтр.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма раздела.
Процедура ЗаполнитьШапку(Форма) Экспорт

	Элементы = Форма.Элементы;
	Элементы.ВидПериода.СписокВыбора.Очистить();
	Для Каждого Вид Из ВидыПериода() Цикл
		Элементы.ВидПериода.СписокВыбора.Добавить(Вид);
	КонецЦикла;
	Элементы.ВидПериода.РежимВыбораИзСписка = Истина;

	Форма.ВидПериода = "Последние 3 часа";
	Границы = ГраницыПериода(Форма.ВидПериода, Форма.НачалоПериода, Форма.КонецПериода);
	Форма.НачалоПериода = Границы.Начало;
	Форма.КонецПериода = Границы.Конец;
	Форма.ВремяС = Дата(1, 1, 1);
	Форма.ВремяПо = Дата(1, 1, 1, 23, 59, 59);
	Элементы.ГруппаДопФильтр.Видимость = Ложь;

	Списки = ЗначенияДляОтбора();
	Если Элементы.Найти("База") <> Неопределено Тогда
		Элементы.База.СписокВыбора.ЗагрузитьЗначения(Списки.Базы);
		Элементы.База.КнопкаВыпадающегоСписка = Истина;
	КонецЕсли;
	Элементы.Сервер.СписокВыбора.ЗагрузитьЗначения(Списки.Серверы);
	Элементы.Сервер.КнопкаВыпадающегоСписка = Истина;

КонецПроцедуры

// Отбор из шапки формы. Границы периода пересчитываются по виду периода и
// записываются обратно в форму, чтобы пользователь видел фактический интервал.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма раздела.
//
// Возвращаемое значение:
//  Структура - Начало, Конец, ТолькоВремя, ЧасС, ЧасПо, База, Сервер, ТекстСодержит, МинДлительностьМс.
Функция Отбор(Форма) Экспорт

	Границы = ГраницыПериода(Форма.ВидПериода, Форма.НачалоПериода, Форма.КонецПериода);
	Форма.НачалоПериода = Границы.Начало;
	Форма.КонецПериода = Границы.Конец;

	Результат = Новый Структура;
	Результат.Вставить("Начало", Границы.Начало);
	Результат.Вставить("Конец", Границы.Конец);
	Результат.Вставить("ТолькоВремя", Форма.ТолькоВремя);
	Результат.Вставить("ЧасС", Час(Форма.ВремяС));
	Результат.Вставить("ЧасПо", Час(Форма.ВремяПо));
	Результат.Вставить("База", "");
	Если Форма.Элементы.Найти("База") <> Неопределено Тогда
		Результат.База = СокрЛП(Форма.База);
	КонецЕсли;
	Результат.Вставить("Сервер", СокрЛП(Форма.Сервер));
	Результат.Вставить("ТекстСодержит", СокрЛП(Форма.ТекстСодержит));
	Результат.Вставить("МинДлительностьМс", Форма.МинДлительность * 1000);
	Возврат Результат;

КонецФункции

// Условие ГДЕ по рбфСобытияТЖ (псевдоним таблицы - Т) для отбора шапки;
// параметры условия устанавливаются в запрос. Агрегаты почасовые, поэтому начало
// периода округляется до начала часа.
//
// Параметры:
//  Запрос - Запрос - запрос, в который устанавливаются параметры.
//  Отбор - Структура - см. Отбор.
//  События - Массив из Строка, Неопределено - имена событий ТЖ; Неопределено - все события.
//
// Возвращаемое значение:
//  Строка - текст условия без слова ГДЕ.
Функция УсловиеОтбораТЖ(Запрос, Отбор, События) Экспорт

	Условия = Новый Массив;
	Условия.Добавить("Т.Час МЕЖДУ &НачалоОтбора И &КонецОтбора");
	Запрос.УстановитьПараметр("НачалоОтбора", НачалоЧаса(Отбор.Начало));
	Запрос.УстановитьПараметр("КонецОтбора", Отбор.Конец);

	Если События <> Неопределено Тогда
		Условия.Добавить("Т.Событие В (&СобытияОтбора)");
		Запрос.УстановитьПараметр("СобытияОтбора", События);
	КонецЕсли;

	Если Отбор.ТолькоВремя Тогда
		Условия.Добавить("ЧАС(Т.Час) МЕЖДУ &ЧасС И &ЧасПо");
		Запрос.УстановитьПараметр("ЧасС", Отбор.ЧасС);
		Запрос.УстановитьПараметр("ЧасПо", Отбор.ЧасПо);
	КонецЕсли;
	Если ЗначениеЗаполнено(Отбор.База) Тогда
		Условия.Добавить("Т.База = &БазаОтбора");
		Запрос.УстановитьПараметр("БазаОтбора", Отбор.База);
	КонецЕсли;
	Если ЗначениеЗаполнено(Отбор.Сервер) Тогда
		Условия.Добавить("Т.Сервер = &СерверОтбора");
		Запрос.УстановитьПараметр("СерверОтбора", Отбор.Сервер);
	КонецЕсли;
	Если ЗначениеЗаполнено(Отбор.ТекстСодержит) Тогда
		Условия.Добавить("Т.Ключ ПОДОБНО &ШаблонОтбора СПЕЦСИМВОЛ ""~""");
		Запрос.УстановитьПараметр("ШаблонОтбора", "%" + ЭкранироватьДляПодобно(Отбор.ТекстСодержит) + "%");
	КонецЕсли;
	Если Отбор.МинДлительностьМс > 0 Тогда
		Условия.Добавить("Т.ДлительностьМаксМс >= &МинДлительностьМс");
		Запрос.УстановитьПараметр("МинДлительностьМс", Отбор.МинДлительностьМс);
	КонецЕсли;

	Возврат СтрСоединить(Условия, Символы.ПС + "	И ");

КонецФункции

// Разбирает строку события технологического журнала на свойства:
//   34:56.123456-15,DBMSSQL,4,p:processName=base,Usr=Иванов,Sql='SELECT ...',Context="..."
// Значения в одинарных или двойных кавычках могут содержать запятые и переводы строк,
// кавычка внутри значения удваивается. Обрезанное значение (Пример хранится до 2000 символов)
// берётся до конца строки. Части без "=" (время, имя события, уровень) пропускаются.
//
// Параметры:
//  Текст - Строка - строка события ТЖ.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - имя свойства -> Строка; повторное свойство не перезаписывает первое.
Функция СвойстваСобытияТЖ(Текст) Экспорт

	Свойства = Новый Соответствие;
	Длина = СтрДлина(Текст);
	Поз = 1;
	Пока Поз <= Длина Цикл

		Начало = Поз;
		Пока Поз <= Длина Цикл
			Символ = Сред(Текст, Поз, 1);
			Если Символ = "=" ИЛИ Символ = "," Тогда
				Прервать;
			КонецЕсли;
			Поз = Поз + 1;
		КонецЦикла;
		Имя = СокрЛП(Сред(Текст, Начало, Поз - Начало));
		Если Поз > Длина Тогда
			Прервать;
		КонецЕсли;
		Если Сред(Текст, Поз, 1) = "," Тогда
			Поз = Поз + 1;
			Продолжить;
		КонецЕсли;
		Поз = Поз + 1; // "="

		Кавычка = Сред(Текст, Поз, 1);
		Если Кавычка = "'" ИЛИ Кавычка = """" Тогда
			Части = Новый Массив;
			Поз = Поз + 1;
			Пока Поз <= Длина Цикл
				Конец = СтрНайти(Текст, Кавычка, , Поз);
				Если Конец = 0 Тогда
					Части.Добавить(Сред(Текст, Поз));
					Поз = Длина + 1;
					Прервать;
				КонецЕсли;
				Части.Добавить(Сред(Текст, Поз, Конец - Поз));
				Если Сред(Текст, Конец + 1, 1) = Кавычка Тогда
					Части.Добавить(Кавычка);
					Поз = Конец + 2;
				Иначе
					Поз = Конец + 1;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Значение = СтрСоединить(Части);
			// после закрывающей кавычки - запятая перед следующим свойством
			Пока Поз <= Длина И Сред(Текст, Поз, 1) <> "," Цикл
				Поз = Поз + 1;
			КонецЦикла;
		Иначе
			Конец = СтрНайти(Текст, ",", , Поз);
			Если Конец = 0 Тогда
				Конец = Длина + 1;
			КонецЕсли;
			Значение = СокрЛП(Сред(Текст, Поз, Конец - Поз));
			Поз = Конец;
		КонецЕсли;
		Поз = Поз + 1; // ","

		Если ЗначениеЗаполнено(Имя) И Свойства.Получить(Имя) = Неопределено Тогда
			Свойства.Вставить(Имя, Значение);
		КонецЕсли;

	КонецЦикла;

	Возврат Свойства;

КонецФункции

// Первое заполненное из свойств с указанными именами.
//
// Параметры:
//  Свойства - Соответствие - см. СвойстваСобытияТЖ.
//  Имена - Строка - имена свойств через запятую в порядке предпочтения.
//
// Возвращаемое значение:
//  Строка - значение или пустая строка.
Функция ЗначениеСвойства(Свойства, Имена) Экспорт

	Для Каждого Имя Из СтрРазделить(Имена, ",", Ложь) Цикл
		Значение = Свойства.Получить(СокрЛП(Имя));
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Текст «Имя = Значение» по строке на свойство, кроме перечисленных.
//
// Параметры:
//  Свойства - Соответствие - см. СвойстваСобытияТЖ.
//  Исключить - Строка - имена свойств через запятую, которые показываются на своих страницах.
//
// Возвращаемое значение:
//  Строка - многострочный текст.
Функция ПредставлениеСвойств(Свойства, Исключить = "") Экспорт

	Лишние = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить(Исключить, ",", Ложь) Цикл
		Лишние.Вставить(СокрЛП(Имя), Истина);
	КонецЦикла;
	Строки = Новый Массив;
	Для Каждого КЗ Из Свойства Цикл
		Если Лишние.Получить(КЗ.Ключ) = Неопределено Тогда
			Строки.Добавить(КЗ.Ключ + " = " + КЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Строки параметров запроса из текста Sql события DBMSSQL: платформа дописывает их
// после текста запроса строками вида "p_0: значение".
//
// Параметры:
//  ТекстSQL - Строка - свойство Sql.
//
// Возвращаемое значение:
//  Строка - параметры по строке на параметр или пустая строка.
Функция ПараметрыЗапросаSQL(ТекстSQL) Экспорт

	Параметры = Новый Массив;
	Для Каждого Строка Из СтрРазделить(ТекстSQL, Символы.ПС, Ложь) Цикл
		Строка = СокрЛП(Строка);
		Двоеточие = СтрНайти(Строка, ":");
		Если СтрНачинаетсяС(Строка, "p_") И Двоеточие > 3 И ТолькоЦифры(Сред(Строка, 3, Двоеточие - 3)) Тогда
			Параметры.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Параметры, Символы.ПС);

КонецФункции

// Текст для страницы подробностей: значение или подпись «нет данных».
//
// Параметры:
//  Значение - Строка - данные страницы.
//
// Возвращаемое значение:
//  Строка - значение или НетДанных().
Функция ИлиНетДанных(Значение) Экспорт

	Возврат ?(ЗначениеЗаполнено(Значение), Значение, НетДанных());

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВидыПериода()

	Виды = Новый Массив;
	Виды.Добавить("Последние 3 часа");
	Виды.Добавить("Сегодня");
	Виды.Добавить("Произвольный интервал");
	Возврат Виды;

КонецФункции

// Границы периода по виду периода шапки.
//
// Параметры:
//  ВидПериода - Строка - «Последние 3 часа», «Сегодня» или «Произвольный интервал».
//  НачалоПериода - Дата - начало произвольного интервала.
//  КонецПериода - Дата - конец произвольного интервала; пустой - текущий момент.
//
// Возвращаемое значение:
//  Структура - Начало, Конец.
Функция ГраницыПериода(ВидПериода, НачалоПериода, КонецПериода)

	Сейчас = ТекущаяДатаСеанса();
	Если ВидПериода = "Сегодня" Тогда
		Возврат Новый Структура("Начало,Конец", НачалоДня(Сейчас), КонецДня(Сейчас));
	ИначеЕсли ВидПериода = "Произвольный интервал" Тогда
		Возврат Новый Структура("Начало,Конец", НачалоПериода,
			?(ЗначениеЗаполнено(КонецПериода), КонецПериода, Сейчас));
	КонецЕсли;
	Возврат Новый Структура("Начало,Конец", Сейчас - 3 * 3600, Сейчас);

КонецФункции

// Базы и серверы, по которым за последние 30 дней есть данные ТЖ или счётчиков.
//
// Возвращаемое значение:
//  Структура - Базы, Серверы - Массив из Строка.
Функция ЗначенияДляОтбора()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.База КАК База
	|ИЗ
	|	РегистрСведений.рбфСобытияТЖ КАК Т
	|ГДЕ
	|	Т.Час >= &Граница
	|	И Т.База <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	База
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Сервер КАК Сервер
	|ИЗ
	|	РегистрСведений.рбфСобытияТЖ КАК Т
	|ГДЕ
	|	Т.Час >= &Граница
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	С.Сервер
	|ИЗ
	|	РегистрСведений.рбфСчетчики КАК С
	|ГДЕ
	|	С.Время >= &Граница
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сервер";
	Запрос.УстановитьПараметр("Граница", ТекущаяДатаСеанса() - 30 * 86400);
	Результаты = Запрос.ВыполнитьПакет();
	Возврат Новый Структура("Базы,Серверы",
		Результаты[0].Выгрузить().ВыгрузитьКолонку("База"),
		Результаты[1].Выгрузить().ВыгрузитьКолонку("Сервер"));

КонецФункции

Функция ТолькоЦифры(Текст)

	Для Н = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Н, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрДлина(Текст) > 0;

КонецФункции

Функция ЭкранироватьДляПодобно(Текст)

	Результат = СтрЗаменить(Текст, "~", "~~");
	Для Каждого Символ Из СтрРазделить("%,_,[,],^", ",") Цикл
		Результат = СтрЗаменить(Результат, Символ, "~" + Символ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
