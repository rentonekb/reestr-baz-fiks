////////////////////////////////////////////////////////////////////////////////
// Раздел «Анализ»: общая шапка форм (период, база, доп. фильтр), условия отбора
// по рбфСобытияТЖ и разбор свойств события ТЖ из поля Пример.
//
// Формы показывают только то, что есть в регистрах base_list: почасовые агрегаты ТЖ
// от агентов (рбфСобытияТЖ) и замеры счётчиков (рбфСчетчики). Плана запроса, значений
// параметров, графа взаимоблокировки в агрегатах нет - их даст tj-analyzer, а до тех пор
// на месте этих данных пишется НетДанных().
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Подпись на месте данных, которые base_list сам не собирает.
//
// Возвращаемое значение:
//  Строка - текст подписи.
Функция НетДанных() Экспорт

	Возврат "нет данных: нужен tj-analyzer";

КонецФункции

// Заполняет общую шапку формы раздела: варианты периода, списки баз и серверов,
// период по умолчанию «Последние 3 часа». Доп. фильтр скрыт до нажатия ссылки.
// Форма должна иметь реквизиты ВидПериода, НачалоПериода, КонецПериода, ТолькоВремя,
// ВремяС, ВремяПо, База, Сервер, ТекстСодержит, МинДлительность и группу ГруппаДопФильтр.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма раздела.
Процедура ЗаполнитьШапку(Форма) Экспорт

	Элементы = Форма.Элементы;
	Элементы.ВидПериода.СписокВыбора.Очистить();
	Для Каждого Вид Из ВидыПериода() Цикл
		Элементы.ВидПериода.СписокВыбора.Добавить(Вид);
	КонецЦикла;
	Элементы.ВидПериода.РежимВыбораИзСписка = Истина;

	Форма.ВидПериода = "Последние 3 часа";
	Границы = ГраницыПериода(Форма.ВидПериода, Форма.НачалоПериода, Форма.КонецПериода);
	Форма.НачалоПериода = Границы.Начало;
	Форма.КонецПериода = Границы.Конец;
	Форма.ВремяС = Дата(1, 1, 1);
	Форма.ВремяПо = Дата(1, 1, 1, 23, 59, 59);
	Элементы.ГруппаДопФильтр.Видимость = Ложь;

	Списки = ЗначенияДляОтбора();
	Если Элементы.Найти("База") <> Неопределено Тогда
		Элементы.База.СписокВыбора.ЗагрузитьЗначения(Списки.Базы);
		Элементы.База.КнопкаВыпадающегоСписка = Истина;
	КонецЕсли;
	Элементы.Сервер.СписокВыбора.ЗагрузитьЗначения(Списки.Серверы);
	Элементы.Сервер.КнопкаВыпадающегоСписка = Истина;

КонецПроцедуры

// Отбор из шапки формы. Границы периода пересчитываются по виду периода и
// записываются обратно в форму, чтобы пользователь видел фактический интервал.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма раздела.
//
// Возвращаемое значение:
//  Структура - Начало, Конец, ТолькоВремя, ЧасС, ЧасПо, База, Сервер, ТекстСодержит, МинДлительностьМс.
Функция Отбор(Форма) Экспорт

	Границы = ГраницыПериода(Форма.ВидПериода, Форма.НачалоПериода, Форма.КонецПериода);
	Форма.НачалоПериода = Границы.Начало;
	Форма.КонецПериода = Границы.Конец;

	Результат = Новый Структура;
	Результат.Вставить("Начало", Границы.Начало);
	Результат.Вставить("Конец", Границы.Конец);
	Результат.Вставить("ТолькоВремя", Форма.ТолькоВремя);
	Результат.Вставить("ЧасС", Час(Форма.ВремяС));
	Результат.Вставить("ЧасПо", Час(Форма.ВремяПо));
	Результат.Вставить("База", "");
	Если Форма.Элементы.Найти("База") <> Неопределено Тогда
		Результат.База = СокрЛП(Форма.База);
	КонецЕсли;
	Результат.Вставить("Сервер", СокрЛП(Форма.Сервер));
	Результат.Вставить("ТекстСодержит", СокрЛП(Форма.ТекстСодержит));
	Результат.Вставить("МинДлительностьМс", Форма.МинДлительность * 1000);
	Возврат Результат;

КонецФункции

// Условие ГДЕ по рбфСобытияТЖ (псевдоним таблицы - Т) для отбора шапки;
// параметры условия устанавливаются в запрос. Агрегаты почасовые, поэтому начало
// периода округляется до начала часа.
//
// Параметры:
//  Запрос - Запрос - запрос, в который устанавливаются параметры.
//  Отбор - Структура - см. Отбор.
//  События - Массив из Строка, Неопределено - имена событий ТЖ; Неопределено - все события.
//
// Возвращаемое значение:
//  Строка - текст условия без слова ГДЕ.
Функция УсловиеОтбораТЖ(Запрос, Отбор, События) Экспорт

	Условия = Новый Массив;
	Условия.Добавить("Т.Час МЕЖДУ &НачалоОтбора И &КонецОтбора");
	Запрос.УстановитьПараметр("НачалоОтбора", НачалоЧаса(Отбор.Начало));
	Запрос.УстановитьПараметр("КонецОтбора", Отбор.Конец);

	Если События <> Неопределено Тогда
		Условия.Добавить("Т.Событие В (&СобытияОтбора)");
		Запрос.УстановитьПараметр("СобытияОтбора", События);
	КонецЕсли;

	Если Отбор.ТолькоВремя Тогда
		Условия.Добавить("ЧАС(Т.Час) МЕЖДУ &ЧасС И &ЧасПо");
		Запрос.УстановитьПараметр("ЧасС", Отбор.ЧасС);
		Запрос.УстановитьПараметр("ЧасПо", Отбор.ЧасПо);
	КонецЕсли;
	Если ЗначениеЗаполнено(Отбор.База) Тогда
		Условия.Добавить("Т.База = &БазаОтбора");
		Запрос.УстановитьПараметр("БазаОтбора", Отбор.База);
	КонецЕсли;
	Если ЗначениеЗаполнено(Отбор.Сервер) Тогда
		Условия.Добавить("Т.Сервер = &СерверОтбора");
		Запрос.УстановитьПараметр("СерверОтбора", Отбор.Сервер);
	КонецЕсли;
	Если ЗначениеЗаполнено(Отбор.ТекстСодержит) Тогда
		Условия.Добавить("Т.Ключ ПОДОБНО &ШаблонОтбора СПЕЦСИМВОЛ ""~""");
		Запрос.УстановитьПараметр("ШаблонОтбора", "%" + ЭкранироватьДляПодобно(Отбор.ТекстСодержит) + "%");
	КонецЕсли;
	Если Отбор.МинДлительностьМс > 0 Тогда
		Условия.Добавить("Т.ДлительностьМаксМс >= &МинДлительностьМс");
		Запрос.УстановитьПараметр("МинДлительностьМс", Отбор.МинДлительностьМс);
	КонецЕсли;

	Возврат СтрСоединить(Условия, Символы.ПС + "	И ");

КонецФункции

// Условие ГДЕ по рбфВыполненияТЖ (псевдоним таблицы - Т) для отбора шапки; параметры условия
// устанавливаются в запрос. В отличие от УсловиеОтбораТЖ отбор идёт по полю Время (отдельные события),
// «Текст содержит» ищется в точке контекста, пользователе и началах текстов запроса 1С и SQL.
//
// Параметры:
//  Запрос - Запрос - запрос, в который устанавливаются параметры.
//  Отбор - Структура - см. Отбор.
//  События - Массив из Строка, Неопределено - имена событий ТЖ; Неопределено - все события.
//
// Возвращаемое значение:
//  Строка - текст условия без слова ГДЕ.
Функция УсловиеОтбораВыполненийТЖ(Запрос, Отбор, События) Экспорт

	Условия = Новый Массив;
	Условия.Добавить("Т.Время МЕЖДУ &НачалоОтбора И &КонецОтбора");
	Запрос.УстановитьПараметр("НачалоОтбора", Отбор.Начало);
	Запрос.УстановитьПараметр("КонецОтбора", Отбор.Конец);

	Если События <> Неопределено Тогда
		Условия.Добавить("Т.Событие В (&СобытияОтбора)");
		Запрос.УстановитьПараметр("СобытияОтбора", События);
	КонецЕсли;

	Если Отбор.ТолькоВремя Тогда
		Условия.Добавить("ЧАС(Т.Время) МЕЖДУ &ЧасС И &ЧасПо");
		Запрос.УстановитьПараметр("ЧасС", Отбор.ЧасС);
		Запрос.УстановитьПараметр("ЧасПо", Отбор.ЧасПо);
	КонецЕсли;
	Если ЗначениеЗаполнено(Отбор.База) Тогда
		Условия.Добавить("Т.База = &БазаОтбора");
		Запрос.УстановитьПараметр("БазаОтбора", Отбор.База);
	КонецЕсли;
	Если ЗначениеЗаполнено(Отбор.Сервер) Тогда
		Условия.Добавить("Т.Сервер = &СерверОтбора");
		Запрос.УстановитьПараметр("СерверОтбора", Отбор.Сервер);
	КонецЕсли;
	Если ЗначениеЗаполнено(Отбор.ТекстСодержит) Тогда
		Условия.Добавить("(Т.КонтекстТочка ПОДОБНО &ШаблонОтбора СПЕЦСИМВОЛ ""~""
		|		ИЛИ Т.Пользователь ПОДОБНО &ШаблонОтбора СПЕЦСИМВОЛ ""~""
		|		ИЛИ ПОДСТРОКА(Т.ТекстЗапроса1С, 1, 1024) ПОДОБНО &ШаблонОтбора СПЕЦСИМВОЛ ""~""
		|		ИЛИ ПОДСТРОКА(Т.ТекстSQL, 1, 1024) ПОДОБНО &ШаблонОтбора СПЕЦСИМВОЛ ""~"")");
		Запрос.УстановитьПараметр("ШаблонОтбора", "%" + ТекстДляПодобно(Отбор.ТекстСодержит) + "%");
	КонецЕсли;
	Если Отбор.МинДлительностьМс > 0 Тогда
		Условия.Добавить("Т.ДлительностьМс >= &МинДлительностьМс");
		Запрос.УстановитьПараметр("МинДлительностьМс", Отбор.МинДлительностьМс);
	КонецЕсли;

	Возврат СтрСоединить(Условия, Символы.ПС + "	И ");

КонецФункции

// Экранирует служебные символы ПОДОБНО (спецсимвол «~») в тексте, который ищется как есть.
//
// Параметры:
//  Текст - Строка - искомый текст.
//
// Возвращаемое значение:
//  Строка - текст для шаблона ПОДОБНО ... СПЕЦСИМВОЛ "~".
Функция ТекстДляПодобно(Текст) Экспорт

	Возврат ЭкранироватьДляПодобно(Текст);

КонецФункции

// Разбирает строку события технологического журнала на свойства:
//   34:56.123456-15,DBMSSQL,4,p:processName=base,Usr=Иванов,Sql='SELECT ...',Context="..."
// Значения в одинарных или двойных кавычках могут содержать запятые и переводы строк,
// кавычка внутри значения удваивается. Обрезанное значение (Пример хранится до 2000 символов)
// берётся до конца строки. Части без "=" (время, имя события, уровень) пропускаются.
//
// Параметры:
//  Текст - Строка - строка события ТЖ.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - имя свойства -> Строка; повторное свойство не перезаписывает первое.
Функция СвойстваСобытияТЖ(Текст) Экспорт

	Свойства = Новый Соответствие;
	Длина = СтрДлина(Текст);
	Поз = 1;
	Пока Поз <= Длина Цикл

		Начало = Поз;
		Пока Поз <= Длина Цикл
			Символ = Сред(Текст, Поз, 1);
			Если Символ = "=" ИЛИ Символ = "," Тогда
				Прервать;
			КонецЕсли;
			Поз = Поз + 1;
		КонецЦикла;
		Имя = СокрЛП(Сред(Текст, Начало, Поз - Начало));
		Если Поз > Длина Тогда
			Прервать;
		КонецЕсли;
		Если Сред(Текст, Поз, 1) = "," Тогда
			Поз = Поз + 1;
			Продолжить;
		КонецЕсли;
		Поз = Поз + 1; // "="

		Кавычка = Сред(Текст, Поз, 1);
		Если Кавычка = "'" ИЛИ Кавычка = """" Тогда
			Части = Новый Массив;
			Поз = Поз + 1;
			Пока Поз <= Длина Цикл
				Конец = СтрНайти(Текст, Кавычка, , Поз);
				Если Конец = 0 Тогда
					Части.Добавить(Сред(Текст, Поз));
					Поз = Длина + 1;
					Прервать;
				КонецЕсли;
				Части.Добавить(Сред(Текст, Поз, Конец - Поз));
				Если Сред(Текст, Конец + 1, 1) = Кавычка Тогда
					Части.Добавить(Кавычка);
					Поз = Конец + 2;
				Иначе
					Поз = Конец + 1;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Значение = СтрСоединить(Части);
			// после закрывающей кавычки - запятая перед следующим свойством
			Пока Поз <= Длина И Сред(Текст, Поз, 1) <> "," Цикл
				Поз = Поз + 1;
			КонецЦикла;
		Иначе
			// "Имя=" в конце текста: начальная позиция за концом строки недопустима для СтрНайти
			Конец = ?(Поз > Длина, 0, СтрНайти(Текст, ",", , Поз));
			Если Конец = 0 Тогда
				Конец = Длина + 1;
			КонецЕсли;
			Значение = СокрЛП(Сред(Текст, Поз, Конец - Поз));
			Поз = Конец;
		КонецЕсли;
		Поз = Поз + 1; // ","

		Если ЗначениеЗаполнено(Имя) И Свойства.Получить(Имя) = Неопределено Тогда
			Свойства.Вставить(Имя, Значение);
		КонецЕсли;

	КонецЦикла;

	Возврат Свойства;

КонецФункции

// Первое заполненное из свойств с указанными именами.
//
// Параметры:
//  Свойства - Соответствие - см. СвойстваСобытияТЖ.
//  Имена - Строка - имена свойств через запятую в порядке предпочтения.
//
// Возвращаемое значение:
//  Строка - значение или пустая строка.
Функция ЗначениеСвойства(Свойства, Имена) Экспорт

	Для Каждого Имя Из СтрРазделить(Имена, ",", Ложь) Цикл
		Значение = Свойства.Получить(СокрЛП(Имя));
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Текст «Имя = Значение» по строке на свойство, кроме перечисленных.
//
// Параметры:
//  Свойства - Соответствие - см. СвойстваСобытияТЖ.
//  Исключить - Строка - имена свойств через запятую, которые показываются на своих страницах.
//
// Возвращаемое значение:
//  Строка - многострочный текст.
Функция ПредставлениеСвойств(Свойства, Исключить = "") Экспорт

	Лишние = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить(Исключить, ",", Ложь) Цикл
		Лишние.Вставить(СокрЛП(Имя), Истина);
	КонецЦикла;
	Строки = Новый Массив;
	Для Каждого КЗ Из Свойства Цикл
		Если Лишние.Получить(КЗ.Ключ) = Неопределено Тогда
			Строки.Добавить(КЗ.Ключ + " = " + КЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Строки параметров запроса из текста Sql события DBMSSQL: платформа дописывает их
// после текста запроса строками вида "p_0: значение".
//
// Параметры:
//  ТекстSQL - Строка - свойство Sql.
//
// Возвращаемое значение:
//  Строка - параметры по строке на параметр или пустая строка.
Функция ПараметрыЗапросаSQL(ТекстSQL) Экспорт

	Параметры = Новый Массив;
	Для Каждого Строка Из СтрРазделить(ТекстSQL, Символы.ПС, Ложь) Цикл
		Строка = СокрЛП(Строка);
		Двоеточие = СтрНайти(Строка, ":");
		Если СтрНачинаетсяС(Строка, "p_") И Двоеточие > 3 И ТолькоЦифры(Сред(Строка, 3, Двоеточие - 3)) Тогда
			Параметры.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Параметры, Символы.ПС);

КонецФункции

// Текст для страницы подробностей: значение или подпись «нет данных».
//
// Параметры:
//  Значение - Строка - данные страницы.
//
// Возвращаемое значение:
//  Строка - значение или НетДанных().
Функция ИлиНетДанных(Значение) Экспорт

	Возврат ?(ЗначениеЗаполнено(Значение), Значение, НетДанных());

КонецФункции

// Отдельные события ТЖ от агента (POST rbf-admin/tj-events, контракт docs/tj-events-schema.md).
// Каждое событие пишется набором с отбором по Ид: повторная отправка перезаписывает строку.
// При записи считаются ШаблонХеш, ТекстЗапроса1С (DBMSSQL текущей ИБ) и ВиновникИд (TLOCK/TTIMEOUT).
//
// Параметры:
//  Сервер - Строка - имя сервера из конфигурации агента.
//  События - Массив из Соответствие - события в формате контракта.
//
// Возвращаемое значение:
//  Структура - ok (Булево), written, skipped (Число).
Функция ПринятьВыполненияТЖ(Сервер, События) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	ИмяСервера = Лев(СокрЛП(Сервер), 100);
	ИмяТекущейБазы = ВРег(ИмяТекущейИнформационнойБазы());
	Карта = Неопределено;
	Записано = 0;
	Пропущено = 0;
	Идентификаторы = Новый Массив;
	МинВремя = Неопределено;
	СоединенияСБлокировками = СоединенияСБлокировкамиТЖ(ИмяСервера, События);

	Для Каждого Событие Из События Цикл
		Время = ДатаСобытияТЖ(Событие.Получить("time"));
		Ид = Лев(СтрокаИзJSON(Событие.Получить("id")), 36);
		Если Время = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Ид) Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		// Commit/Rollback нужны только как границы транзакций виновников: соединения без TLOCK не пишем
		Если ЭтоЗавершениеТранзакцииТЖ(Событие)
			И СоединенияСБлокировками.Получить(КлючСоединенияТЖ(Событие)) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Набор = РегистрыСведений.рбфВыполненияТЖ.СоздатьНаборЗаписей();
		Набор.Отбор.Ид.Установить(Ид);
		Запись = Набор.Добавить();
		Запись.Ид = Ид;
		Запись.Время = Время;
		Запись.Сервер = ИмяСервера;
		Запись.Микросекунды = ЧислоИзJSON(Событие.Получить("us"), 999999);
		Запись.База = Лев(СтрокаИзJSON(Событие.Получить("db")), 150);
		Запись.Событие = ВРег(Лев(СтрокаИзJSON(Событие.Получить("event")), 20));
		Запись.ДлительностьМс = ЧислоИзJSON(Событие.Получить("ms"), 999999999999.999);
		Запись.Пользователь = Лев(СтрокаИзJSON(Событие.Получить("usr")), 150);
		Запись.СеансИд = ЧислоИзJSON(Событие.Получить("session"), 9999999999);
		Запись.СоединениеИд = ЧислоИзJSON(Событие.Получить("connect"), 9999999999);
		Запись.КлиентИд = ЧислоИзJSON(Событие.Получить("client"), 9999999999);
		Запись.Приложение = Лев(СтрокаИзJSON(Событие.Получить("app")), 50);
		Запись.Компьютер = Лев(СтрокаИзJSON(Событие.Получить("computer")), 100);
		Запись.Процесс = Лев(СтрокаИзJSON(Событие.Получить("pid")), 20);
		Запись.dbpid = ЧислоИзJSON(Событие.Получить("dbpid"), 9999999999);
		Запись.Транзакция = (Событие.Получить("trans") = Истина);
		Запись.Строк = ЧислоИзJSON(Событие.Получить("rows"), 999999999999999);
		Запись.Функция = Лев(СтрокаИзJSON(Событие.Получить("func")), 50);
		Запись.КонтекстПолный = СтрокаИзJSON(Событие.Получить("ctx"));
		Запись.КонтекстТочка = Лев(СтрокаИзJSON(Событие.Получить("ctxTop")), 500);
		Запись.КонтекстСтрока = Лев(СтрокаИзJSON(Событие.Получить("ctxLast")), 500);
		Если ЗначениеЗаполнено(Запись.КонтекстПолный)
			И НЕ (ЗначениеЗаполнено(Запись.КонтекстТочка) И ЗначениеЗаполнено(Запись.КонтекстСтрока)) Тогда
			Строки = НепустыеСтроки(Запись.КонтекстПолный);
			Если Строки.Количество() > 0 Тогда
				Запись.КонтекстТочка = Лев(Строки[0], 500);
				Запись.КонтекстСтрока = Лев(Строки[Строки.ВГраница()], 500);
			КонецЕсли;
		КонецЕсли;
		Запись.ТекстЗапроса1С = СтрокаИзJSON(Событие.Получить("sdbl"));
		Запись.ТекстSQL = СтрокаИзJSON(Событие.Получить("sql"));
		Запись.Блокировки = СтрокаИзJSON(Событие.Получить("locks"));
		Запись.ЖдалСоединения = Лев(СокрЛП(СтрокаИзJSON(Событие.Получить("wait"))), 200);
		Запись.Взаимоблокировка = СтрокаИзJSON(Событие.Получить("deadlock"));
		Запись.Исключение = Лев(СтрокаИзJSON(Событие.Получить("exception")), 100);
		Запись.Описание = СтрокаИзJSON(Событие.Получить("descr"));
		Запись.БлокирующийSpid = ЧислоИзJSON(Событие.Получить("blkspid"), 9999999999);
		Запись.РесурсОжидания = Лев(СтрокаИзJSON(Событие.Получить("waitres")), 400);
		Запись.РежимБлокировки = Лев(СтрокаИзJSON(Событие.Получить("lockmode")), 20);
		Запись.ТекстSQLВиновника = СтрокаИзJSON(Событие.Получить("blksql"));

		Если Запись.Событие = "DBMSSQL" И НЕ ЗначениеЗаполнено(Запись.ТекстЗапроса1С)
			И ЗначениеЗаполнено(Запись.ТекстSQL) И ВРег(Запись.База) = ИмяТекущейБазы Тогда
			Если Карта = Неопределено Тогда
				Карта = КартаИменТаблиц();
			КонецЕсли;
			Если Карта.Количество() > 0 Тогда
				Запись.ТекстЗапроса1С = ПеревестиИменаХранения(ТекстЗапросаБезОбёртки(Запись.ТекстSQL), Карта);
			КонецЕсли;
		КонецЕсли;
		ТекстШаблона = ?(ЗначениеЗаполнено(Событие.Получить("sdbl")), Запись.ТекстЗапроса1С, Запись.ТекстSQL);
		Если ЗначениеЗаполнено(ТекстШаблона) Тогда
			Запись.ШаблонХеш = ШаблонХеш(ТекстШаблона);
		КонецЕсли;

		Набор.Записать(Истина);
		Записано = Записано + 1;
		Идентификаторы.Добавить(Ид);
		Если МинВремя = Неопределено ИЛИ Время < МинВремя Тогда
			МинВремя = Время;
		КонецЕсли;
	КонецЦикла;

	ЗаполнитьВиновниковБлокировок(Идентификаторы, ИмяСервера, МинВремя);

	Возврат Новый Структура("ok,written,skipped", Истина, Записано, Пропущено);

КонецФункции

// MD5 нормализованного текста запроса: обёртка sp_executesql снята, хвост параметров (p_0: ...) отброшен,
// строковые и числовые литералы, 0x..., @P1 заменены на ?, пробельные символы схлопнуты.
//
// Параметры:
//  Текст - Строка - текст Sdbl или Sql события ТЖ.
//
// Возвращаемое значение:
//  Строка - hex MD5 из 32 символов; для пустого текста - пустая строка.
Функция ШаблонХеш(Текст) Экспорт

	Нормализованный = НормализованныйТекстЗапроса(Текст);
	Если НЕ ЗначениеЗаполнено(Нормализованный) Тогда
		Возврат "";
	КонецЕсли;
	Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеш.Добавить(Нормализованный);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));

КонецФункции

// Нормализованный текст запроса, по которому считается ШаблонХеш (см. ШаблонХеш).
//
// Параметры:
//  Текст - Строка - текст Sdbl или Sql.
//
// Возвращаемое значение:
//  Строка - шаблон запроса.
Функция НормализованныйТекстЗапроса(Текст) Экспорт

	Результат = ТекстЗапросаБезОбёртки(Строка(Текст));
	Хвост = СтрНайтиПоРегулярномуВыражению(Результат, "[\r\n][ \t]*p_[0-9]+:");
	Если Хвост.НачальнаяПозиция > 0 Тогда
		Результат = Лев(Результат, Хвост.НачальнаяПозиция - 1);
	КонецЕсли;
	Результат = СтрЗаменитьПоРегулярномуВыражению(Результат, "'([^']|'')*'", "?");
	Результат = ЗаменитьЛексемыЧисел(Результат);
	Результат = СтрЗаменитьПоРегулярномуВыражению(Результат, "[ \t\r\n]+", " ");
	Возврат СокрЛП(Результат);

КонецФункции

// Текст запроса из вызова {call sp_executesql(N'...', ...)}: первый строковый аргумент без экранирования ''.
// Текст без такой обёртки возвращается как есть.
//
// Параметры:
//  Текст - Строка - текст Sql из ТЖ.
//
// Возвращаемое значение:
//  Строка - текст запроса.
Функция ТекстЗапросаБезОбёртки(Текст) Экспорт

	Начало = СтрНайти(НРег(Текст), "sp_executesql(n'");
	Если Начало = 0 ИЛИ Начало > 20 Тогда
		Возврат Текст;
	КонецЕсли;
	Позиция = Начало + СтрДлина("sp_executesql(n'");
	Длина = СтрДлина(Текст);
	Части = Новый Массив;
	НачалоЧасти = Позиция;
	Пока Позиция <= Длина Цикл
		Если Сред(Текст, Позиция, 1) = "'" Тогда
			Если Сред(Текст, Позиция + 1, 1) = "'" Тогда
				Части.Добавить(Сред(Текст, НачалоЧасти, Позиция - НачалоЧасти + 1));
				Позиция = Позиция + 2;
				НачалоЧасти = Позиция;
				Продолжить;
			КонецЕсли;
			Прервать;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Части.Добавить(Сред(Текст, НачалоЧасти, Позиция - НачалоЧасти));
	Возврат СтрСоединить(Части);

КонецФункции

// Карта имён хранения текущей ИБ (base_list) в имена метаданных: таблицы (_Reference139 -> Справочник.Имя)
// и поля (_Fld456RRef -> Реквизит). Кэш - рбфИменаТаблицТЖ; перестраивается, если пуст или старше суток
// (дата построения - запись с ИмяХранения = "*").
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - ключ: имя хранения как в СУБД, значение: имя метаданных.
Функция КартаИменТаблиц() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	База = Лев(ИмяТекущейИнформационнойБазы(), 150);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Имена.ИмяХранения КАК ИмяХранения,
	|	Имена.ИмяМетаданных КАК ИмяМетаданных
	|ИЗ
	|	РегистрСведений.рбфИменаТаблицТЖ КАК Имена
	|ГДЕ
	|	Имена.База = &База";
	Запрос.УстановитьПараметр("База", База);
	Выборка = Запрос.Выполнить().Выбрать();

	Карта = Новый Соответствие;
	Построена = Дата(1, 1, 1);
	Пока Выборка.Следующий() Цикл
		Если Выборка.ИмяХранения = "*" Тогда
			Попытка
				Построена = XMLЗначение(Тип("Дата"), Выборка.ИмяМетаданных);
			Исключение
				Построена = Дата(1, 1, 1);
			КонецПопытки;
		Иначе
			Карта.Вставить(Выборка.ИмяХранения, Выборка.ИмяМетаданных);
		КонецЕсли;
	КонецЦикла;

	Если Карта.Количество() = 0 ИЛИ ТекущаяДатаСеанса() - Построена > 86400 Тогда
		Карта = ПостроитьКартуИменТаблиц(База);
	КонецЕсли;
	Возврат Карта;

КонецФункции

// Перевод текста SQL или свойства Locks по карте имён хранения: _Reference139 -> Справочник.Имя,
// _Fld456RRef -> Реквизит. Имена из Locks без подчёркивания (AccumRg123, Fld456) ищутся с ним.
// Неизвестные имена остаются как есть.
//
// Параметры:
//  Текст - Строка - текст SQL или Locks.
//  Карта - Соответствие, Неопределено - результат КартаИменТаблиц(); не задана - берётся из кэша.
//
// Возвращаемое значение:
//  Строка - текст с именами метаданных.
Функция ПеревестиИменаХранения(Текст, Карта = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;
	Если Карта = Неопределено Тогда
		Карта = КартаИменТаблиц();
	КонецЕсли;

	Совпадения = СтрНайтиВсеПоРегулярномуВыражению(Текст, "[A-Za-z_][A-Za-z0-9_]*");
	Части = Новый Массив;
	Позиция = 1;
	Для Каждого Совпадение Из Совпадения Цикл
		Имя = Совпадение.Значение;
		Перевод = Карта.Получить(Имя);
		Если Перевод = Неопределено И НЕ СтрНачинаетсяС(Имя, "_")
			И СтрНайтиПоРегулярномуВыражению(Имя, "[0-9]").НачальнаяПозиция > 0 Тогда
			Перевод = Карта.Получить("_" + Имя);
		КонецЕсли;
		Если Перевод = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Части.Добавить(Сред(Текст, Позиция, Совпадение.НачальнаяПозиция - Позиция));
		Части.Добавить(Перевод);
		Позиция = Совпадение.НачальнаяПозиция + Совпадение.Длина;
	КонецЦикла;
	Части.Добавить(Сред(Текст, Позиция));
	Возврат СтрСоединить(Части);

КонецФункции

// Настройки выполнений ТЖ из общей строки рбфНастройкиТЖ (пустые Сервер1С и ИмяБазы1С).
//
// Возвращаемое значение:
//  Структура:
//   * ГлубинаДней - Число - ГлубинаВыполненийДней, по умолчанию 14.
//   * СлужебныеЗапросы - Массив из Строка - подстроки служебных запросов платформы
//                        (СлужебныеЗапросы по строке; пусто - список по умолчанию из контракта).
Функция НастройкиВыполненийТЖ() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Запись = РегистрыСведений.рбфНастройкиТЖ.СоздатьМенеджерЗаписи();
	Запись.Сервер1С = "";
	Запись.ИмяБазы1С = "";
	Запись.Прочитать();

	ГлубинаДней = ?(Запись.Выбран() И Запись.ГлубинаВыполненийДней > 0, Запись.ГлубинаВыполненийДней, 14);
	СлужебныеЗапросы = ?(Запись.Выбран(), НепустыеСтроки(Запись.СлужебныеЗапросы), Новый Массив);
	Если СлужебныеЗапросы.Количество() = 0 Тогда
		СлужебныеЗапросы = СлужебныеЗапросыПоУмолчанию();
	КонецЕсли;
	Возврат Новый Структура("ГлубинаДней,СлужебныеЗапросы", ГлубинаДней, СлужебныеЗапросы);

КонецФункции

// Подстроки служебных запросов платформы по умолчанию (docs/tj-events-schema.md).
//
// Возвращаемое значение:
//  Массив из Строка - подстроки.
Функция СлужебныеЗапросыПоУмолчанию() Экспорт

	Возврат СтрРазделить("FROM Config,FROM Params,FROM ConfigSave,SchemaStorage,DBSchema,_YearOffset,"
		+ "sp_reset_connection,FROM Files,FROM ConfigCAS,IBVersion,_SystemSettings,_CommonSettings,"
		+ "_FrmDtSettings,_UsersWorkHistory", ",", Ложь);

КонецФункции

// ВиновникИд для блокировок СУБД (SQLBLOCK) без виновника со Временем не раньше НачалоОкна:
// последнее DBMSSQL той же базы с dbpid = БлокирующийSpid и Временем в [начало ожидания - 10 мин;
// начало ожидания], начало ожидания = Время - ДлительностьМс/1000. Не найден - ВиновникИд остаётся пустым.
//
// Параметры:
//  НачалоОкна - Дата - самое раннее Время дозаполняемых строк.
Процедура ЗаполнитьВиновниковБлокировокСУБД(НачалоОкна) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ж.Ид КАК Ид,
	|	Ж.База КАК База,
	|	Ж.Время КАК Время,
	|	Ж.ДлительностьМс КАК ДлительностьМс,
	|	Ж.БлокирующийSpid КАК БлокирующийSpid
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Ж
	|ГДЕ
	|	Ж.Время >= &НачалоОкна
	|	И Ж.Событие = ""SQLBLOCK""
	|	И Ж.ВиновникИд = """"
	|	И Ж.БлокирующийSpid > 0";
	Запрос.УстановитьПараметр("НачалоОкна", НачалоОкна);
	Выборка = Запрос.Выполнить().Выбрать();

	ТипДата = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя));
	Ожидания = Новый ТаблицаЗначений;
	Ожидания.Колонки.Добавить("Ид", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(36)));
	Ожидания.Колонки.Добавить("База", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	Ожидания.Колонки.Добавить("Spid", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
	Ожидания.Колонки.Добавить("ВремяС", ТипДата);
	Ожидания.Колонки.Добавить("НачалоОжидания", ТипДата);
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Ожидания.Добавить();
		НоваяСтрока.Ид = Выборка.Ид;
		НоваяСтрока.База = Выборка.База;
		НоваяСтрока.Spid = Выборка.БлокирующийSpid;
		НоваяСтрока.НачалоОжидания = Выборка.Время - Цел(Выборка.ДлительностьМс / 1000);
		НоваяСтрока.ВремяС = НоваяСтрока.НачалоОжидания - 600;
	КонецЦикла;
	Если Ожидания.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	О.Ид КАК Ид,
	|	О.База КАК База,
	|	О.Spid КАК Spid,
	|	О.ВремяС КАК ВремяС,
	|	О.НачалоОжидания КАК НачалоОжидания
	|ПОМЕСТИТЬ Ожидания
	|ИЗ
	|	&Ожидания КАК О
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	О.Ид КАК Ид,
	|	Р.Ид КАК ВиновникИд,
	|	Р.Время КАК Время,
	|	Р.Микросекунды КАК Микросекунды
	|ИЗ
	|	Ожидания КАК О
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.рбфВыполненияТЖ КАК Р
	|		ПО (Р.База = О.База)
	|			И (Р.dbpid = О.Spid)
	|			И (Р.Время >= О.ВремяС)
	|			И (Р.Время <= О.НачалоОжидания)
	|			И (Р.Событие = ""DBMSSQL"")
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ид,
	|	Время УБЫВ,
	|	Микросекунды УБЫВ";
	Запрос.УстановитьПараметр("Ожидания", Ожидания);
	Выборка = Запрос.Выполнить().Выбрать();

	Виновники = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Если Виновники.Получить(Выборка.Ид) = Неопределено Тогда
			Виновники.Вставить(Выборка.Ид, Выборка.ВиновникИд);
		КонецЕсли;
	КонецЦикла;

	Для Каждого КлючЗначение Из Виновники Цикл
		Набор = РегистрыСведений.рбфВыполненияТЖ.СоздатьНаборЗаписей();
		Набор.Отбор.Ид.Установить(КлючЗначение.Ключ);
		Набор.Прочитать();
		Если Набор.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Набор[0].ВиновникИд = КлючЗначение.Значение;
		Набор.Записать(Истина);
	КонецЦикла;

КонецПроцедуры

// Имя текущей информационной базы: Ref из строки соединения клиент-серверной ИБ
// (у base_list совпадает с p:processName в ТЖ), для файловой - пустая строка.
//
// Возвращаемое значение:
//  Строка - имя ИБ в кластере.
Функция ИмяТекущейИнформационнойБазы() Экспорт

	Возврат СокрЛП(НСтр(СтрокаСоединенияИнформационнойБазы(), "Ref"));

КонецФункции

// Состояния «висит» (Инфостарт 2819638) для событий рбфВыполненияТЖ. Для CALL/SCALL берётся сам вызов,
// для остальных событий - охватывающий вызов того же соединения (Сервер, База, СоединениеИд, окончание
// события внутри [окончание вызова - длительность; окончание вызова]). По событиям того же соединения
// в пределах вызова считаются время СУБД (DBMSSQL, DBPOSTGRS) и ожидание блокировок (TLOCK, TTIMEOUT),
// виновник которых - фоновое задание. Состояние:
//  - «Мешает фоновое» - ожидание блокировок фонового не меньше половины вызова;
//  - «Идёт запрос к СУБД» - время СУБД не меньше половины вызова;
//  - «Клиента нет, а вызов идёт» - у вызова нет клиента (t:clientID пуст, в том числе фоновое задание);
//  - «Сервер ждёт клиента» - остальное: СУБД и блокировки не заняты, клиент есть.
// Время в ТЖ - окончание события с точностью до секунды, поэтому граница вызова расширена на 1 с.
//
// Параметры:
//  Идентификаторы - Массив из Строка - Ид событий рбфВыполненияТЖ.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - Ид события;
//   * Значение - Структура - Состояние (Строка), ВызовСек (Число), СУБДСек (Число), ФоновоеСек (Число);
//                у событий без охватывающего вызова в ТЖ ключа нет.
Функция СостоянияВызовов(Идентификаторы) Экспорт

	Результат = Новый Соответствие;
	Если Идентификаторы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);
	Запрос.УстановитьПараметр("СобытияВызова", СтрРазделить("CALL,SCALL", ","));
	Запрос.УстановитьПараметр("СобытияСУБД", СтрРазделить("DBMSSQL,DBPOSTGRS", ","));
	Запрос.УстановитьПараметр("СобытияОжидания", СтрРазделить("TLOCK,TTIMEOUT", ","));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ид КАК Ид,
	|	Т.Сервер КАК Сервер,
	|	Т.База КАК База,
	|	Т.СоединениеИд КАК СоединениеИд,
	|	Т.Время КАК Время
	|ПОМЕСТИТЬ ВТСобытия
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	Т.Ид В(&Идентификаторы)
	|	И Т.СоединениеИд <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Е.Ид КАК Ид,
	|	Выз.Ид КАК ВызовИд,
	|	Выз.Сервер КАК Сервер,
	|	Выз.База КАК База,
	|	Выз.СоединениеИд КАК СоединениеИд,
	|	ДОБАВИТЬКДАТЕ(Выз.Время, СЕКУНДА, -1 - ВЫРАЗИТЬ(Выз.ДлительностьМс / 1000 КАК ЧИСЛО(15, 0))) КАК Начало,
	|	ДОБАВИТЬКДАТЕ(Выз.Время, СЕКУНДА, 1) КАК Окончание,
	|	Выз.ДлительностьМс КАК ДлительностьМс,
	|	Выз.КлиентИд КАК КлиентИд,
	|	Выз.Приложение КАК Приложение
	|ПОМЕСТИТЬ ВТВызовы
	|ИЗ
	|	ВТСобытия КАК Е
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.рбфВыполненияТЖ КАК Выз
	|		ПО (Выз.СоединениеИд = Е.СоединениеИд)
	|			И (Выз.Сервер = Е.Сервер)
	|			И (Выз.База = Е.База)
	|			И (Выз.Событие В (&СобытияВызова))
	|			И (Выз.Время >= Е.Время)
	|			И (ДОБАВИТЬКДАТЕ(Выз.Время, СЕКУНДА, -1 - ВЫРАЗИТЬ(Выз.ДлительностьМс / 1000 КАК ЧИСЛО(15, 0))) <= Е.Время)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Выз.Ид КАК Ид,
	|	Выз.ВызовИд КАК ВызовИд,
	|	Выз.ДлительностьМс КАК ДлительностьМс,
	|	Выз.КлиентИд КАК КлиентИд,
	|	Выз.Приложение КАК Приложение,
	|	СУММА(ВЫБОР
	|			КОГДА Д.Событие В (&СобытияСУБД)
	|				ТОГДА Д.ДлительностьМс
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СУБДМс,
	|	СУММА(ВЫБОР
	|			КОГДА Д.Событие В (&СобытияОжидания)
	|					И Вин.Приложение = ""BackgroundJob""
	|				ТОГДА Д.ДлительностьМс
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ФоновоеМс
	|ИЗ
	|	ВТВызовы КАК Выз
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.рбфВыполненияТЖ КАК Д
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.рбфВыполненияТЖ КАК Вин
	|			ПО (Вин.Ид = Д.ВиновникИд)
	|		ПО (Д.СоединениеИд = Выз.СоединениеИд)
	|			И (Д.Сервер = Выз.Сервер)
	|			И (Д.База = Выз.База)
	|			И (Д.Время МЕЖДУ Выз.Начало И Выз.Окончание)
	|			И (Д.Событие В (&СобытияСУБД)
	|				ИЛИ Д.Событие В (&СобытияОжидания))
	|
	|СГРУППИРОВАТЬ ПО
	|	Выз.Ид,
	|	Выз.ВызовИд,
	|	Выз.ДлительностьМс,
	|	Выз.КлиентИд,
	|	Выз.Приложение
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ид,
	|	ДлительностьМс";
	Выборка = Запрос.Выполнить().Выбрать();

	// при вложенных вызовах берётся самый короткий охватывающий (первый по упорядочиванию)
	Пока Выборка.Следующий() Цикл
		Если Результат[Выборка.Ид] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ВызовМс = Макс(Выборка.ДлительностьМс, 1);
		// без событий соединения ВЫБОР даёт 0, поэтому суммы не NULL
		СУБДМс = Мин(Выборка.СУБДМс, ВызовМс);
		ФоновоеМс = Мин(Выборка.ФоновоеМс, ВызовМс);
		Если ФоновоеМс * 2 >= ВызовМс Тогда
			Состояние = "Мешает фоновое";
		ИначеЕсли СУБДМс * 2 >= ВызовМс Тогда
			Состояние = "Идёт запрос к СУБД";
		ИначеЕсли Выборка.КлиентИд = 0 Тогда
			Состояние = "Клиента нет, а вызов идёт";
		Иначе
			Состояние = "Сервер ждёт клиента";
		КонецЕсли;
		Результат.Вставить(Выборка.Ид, Новый Структура("Состояние,ВызовСек,СУБДСек,ФоновоеСек", Состояние,
			Выборка.ДлительностьМс / 1000, СУБДМс / 1000, ФоновоеМс / 1000));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Признаки неоптимального запроса по стандарту ИТС «Типичные причины неоптимальной работы запросов»
// (content/5842): соединение с виртуальной таблицей или подзапросом, ИЛИ в условии соединения и в ГДЕ,
// подзапрос в условии, виртуальная таблица без параметров, точка от поля, которое обычно составного
// типа (Регистратор, Субконто, Объект и т.п.). Эвристика по лексемам текста без разбора запроса:
// признак - повод посмотреть, а не доказательство.
//
// Параметры:
//  ТекстЗапроса - Строка - текст запроса 1С (SDBL).
//
// Возвращаемое значение:
//  Массив из Строка - описания найденных признаков без повторов.
Функция ПризнакиНеоптимальногоЗапроса(ТекстЗапроса) Экспорт

	Признаки = Новый Массив;
	Если НЕ ЗначениеЗаполнено(ТекстЗапроса) Тогда
		Возврат Признаки;
	КонецЕсли;

	Лексемы = ЛексемыЗапроса(ТекстЗапроса);
	Количество = Лексемы.Количество();
	Для Индекс = 0 По Количество - 1 Цикл
		Лексема = Лексемы[Индекс];
		Если Лексема = "СОЕДИНЕНИЕ" Или Лексема = "JOIN" Тогда
			// источник соединения - до ПО на том же уровне скобок
			Позиция = Индекс + 1;
			Глубина = 0;
			Источник = Новый Массив;
			Пока Позиция < Количество Цикл
				Текущая = Лексемы[Позиция];
				Если Глубина = 0 И (Текущая = "ПО" Или Текущая = "ON") Тогда
					Прервать;
				КонецЕсли;
				Глубина = Глубина + ?(Текущая = "(", 1, ?(Текущая = ")", -1, 0));
				Источник.Добавить(Текущая);
				Позиция = Позиция + 1;
			КонецЦикла;
			Если Источник.Количество() > 1 И Источник[0] = "(" И (Источник[1] = "ВЫБРАТЬ" Или Источник[1] = "SELECT") Тогда
				ДобавитьПризнак(Признаки, "соединение с подзапросом (вынести во временную таблицу)");
			ИначеЕсли Источник.Количество() > 0 И ЭтоВиртуальнаяТаблица(Источник[0]) Тогда
				ДобавитьПризнак(Признаки, "соединение с виртуальной таблицей " + Источник[0]
					+ " (вынести во временную таблицу)");
			КонецЕсли;
			Условие = ЛексемыУсловия(Лексемы, Позиция + 1);
			Если Условие.Найти("ИЛИ") <> Неопределено Или Условие.Найти("OR") <> Неопределено Тогда
				ДобавитьПризнак(Признаки, "ИЛИ в условии соединения");
			КонецЕсли;
			Если ЕстьПодзапрос(Условие) Тогда
				ДобавитьПризнак(Признаки, "подзапрос в условии соединения");
			КонецЕсли;
		ИначеЕсли Лексема = "ГДЕ" Или Лексема = "WHERE" Тогда
			Условие = ЛексемыУсловия(Лексемы, Индекс + 1);
			Если Условие.Найти("ИЛИ") <> Неопределено Или Условие.Найти("OR") <> Неопределено Тогда
				ДобавитьПризнак(Признаки, "ИЛИ в условии ГДЕ (индекс может не использоваться)");
			КонецЕсли;
			Если ЕстьПодзапрос(Условие) Тогда
				ДобавитьПризнак(Признаки, "подзапрос в условии ГДЕ");
			КонецЕсли;
		ИначеЕсли ЭтоВиртуальнаяТаблица(Лексема) И Индекс + 2 < Количество
			И Лексемы[Индекс + 1] = "(" И Лексемы[Индекс + 2] = ")" Тогда
			ДобавитьПризнак(Признаки, "виртуальная таблица " + Лексема + " без параметров отбора");
		ИначеЕсли НЕ СтрНачинаетсяС(Лексема, "&") И СтрНайти(Лексема, ".") > 0 Тогда
			Части = СтрРазделить(Лексема, ".", Ложь);
			Для Номер = 1 По Части.Количество() - 2 Цикл
				Если СоставныеПоля().Найти(Части[Номер]) <> Неопределено Тогда
					ДобавитьПризнак(Признаки, "точка от поля составного типа: " + Лексема
						+ " (использовать ВЫРАЗИТЬ)");
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Возврат Признаки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Лексемы запроса в верхнем регистре: без комментариев //, скобки и разделители - отдельными лексемами.
Функция ЛексемыЗапроса(ТекстЗапроса)

	Строки = Новый Массив;
	Для Каждого Строка Из СтрРазделить(ТекстЗапроса, Символы.ПС) Цикл
		Позиция = СтрНайти(Строка, "//");
		Строки.Добавить(?(Позиция = 0, Строка, Лев(Строка, Позиция - 1)));
	КонецЦикла;
	Текст = ВРег(СтрСоединить(Строки, " "));
	Для Каждого Разделитель Из СтрРазделить("( ) ; = ,", " ") Цикл
		Текст = СтрЗаменить(Текст, Разделитель, " " + Разделитель + " ");
	КонецЦикла;
	Текст = СтрЗаменить(СтрЗаменить(Текст, Символы.Таб, " "), Символы.ВК, " ");
	Возврат СтрРазделить(Текст, " ", Ложь);

КонецФункции

// Лексемы условия, начиная с Начало: до ключевого слова следующей части запроса на том же уровне скобок
// или до закрывающей скобки охватывающего подзапроса.
Функция ЛексемыУсловия(Лексемы, Начало)

	Стоп = СтрРазделить("СОЕДИНЕНИЕ,JOIN,ЛЕВОЕ,ПРАВОЕ,ВНУТРЕННЕЕ,ПОЛНОЕ,LEFT,RIGHT,INNER,FULL,ГДЕ,WHERE,"
		+ "СГРУППИРОВАТЬ,GROUP,УПОРЯДОЧИТЬ,ORDER,ОБЪЕДИНИТЬ,UNION,ИМЕЮЩИЕ,HAVING,ПОМЕСТИТЬ,INTO,ИТОГИ,TOTALS,"
		+ "ДЛЯ,FOR,;", ",");
	Условие = Новый Массив;
	Глубина = 0;
	Для Индекс = Начало По Лексемы.Количество() - 1 Цикл
		Лексема = Лексемы[Индекс];
		Если Глубина = 0 И Стоп.Найти(Лексема) <> Неопределено Тогда
			Прервать;
		КонецЕсли;
		Глубина = Глубина + ?(Лексема = "(", 1, ?(Лексема = ")", -1, 0));
		Если Глубина < 0 Тогда
			Прервать;
		КонецЕсли;
		Условие.Добавить(Лексема);
	КонецЦикла;
	Возврат Условие;

КонецФункции

Функция ЕстьПодзапрос(Лексемы)

	Для Индекс = 0 По Лексемы.Количество() - 2 Цикл
		Если Лексемы[Индекс] = "(" И (Лексемы[Индекс + 1] = "ВЫБРАТЬ" Или Лексемы[Индекс + 1] = "SELECT") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЭтоВиртуальнаяТаблица(Лексема)

	Части = СтрРазделить(Лексема, ".", Ложь);
	Если Части.Количество() < 3 Тогда
		Возврат Ложь;
	КонецЕсли;
	Виды = СтрРазделить("ОСТАТКИ,ОБОРОТЫ,ОСТАТКИИОБОРОТЫ,СРЕЗПОСЛЕДНИХ,СРЕЗПЕРВЫХ,ОБОРОТЫДТКТ,ДВИЖЕНИЯССУБКОНТО,"
		+ "BALANCE,TURNOVERS,BALANCEANDTURNOVERS,SLICELAST,SLICEFIRST,DRCRTURNOVERS,RECORDSWITHEXTDIMENSIONS", ",");
	Возврат Виды.Найти(Части[Части.Количество() - 1]) <> Неопределено;

КонецФункции

// Имена полей, которые в типовых конфигурациях обычно составного типа.
Функция СоставныеПоля()

