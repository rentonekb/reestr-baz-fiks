// Границы периода по виду периода шапки.
//
// Параметры:
//  ВидПериода - Строка - «Последние 3 часа», «Сегодня» или «Произвольный интервал».
//  НачалоПериода - Дата - начало произвольного интервала.
//  КонецПериода - Дата - конец произвольного интервала; пустой - текущий момент.
//
// Возвращаемое значение:
//  Структура - Начало, Конец.
Функция ГраницыПериода(ВидПериода, НачалоПериода, КонецПериода)

	Сейчас = ТекущаяДатаСеанса();
	Если ВидПериода = "Сегодня" Тогда
		Возврат Новый Структура("Начало,Конец", НачалоДня(Сейчас), КонецДня(Сейчас));
	ИначеЕсли ВидПериода = "Произвольный интервал" Тогда
		Возврат Новый Структура("Начало,Конец", НачалоПериода,
			?(ЗначениеЗаполнено(КонецПериода), КонецПериода, Сейчас));
	КонецЕсли;
	Возврат Новый Структура("Начало,Конец", Сейчас - 3 * 3600, Сейчас);

КонецФункции

// Базы и серверы, по которым за последние 30 дней есть данные ТЖ или счётчиков.
//
// Возвращаемое значение:
//  Структура - Базы, Серверы - Массив из Строка.
Функция ЗначенияДляОтбора()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.База КАК База
	|ИЗ
	|	РегистрСведений.рбфСобытияТЖ КАК Т
	|ГДЕ
	|	Т.Час >= &Граница
	|	И Т.База <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	База
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Сервер КАК Сервер
	|ИЗ
	|	РегистрСведений.рбфСобытияТЖ КАК Т
	|ГДЕ
	|	Т.Час >= &Граница
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	С.Сервер
	|ИЗ
	|	РегистрСведений.рбфСчетчики КАК С
	|ГДЕ
	|	С.Время >= &Граница
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сервер";
	Запрос.УстановитьПараметр("Граница", ТекущаяДатаСеанса() - 30 * 86400);
	Результаты = Запрос.ВыполнитьПакет();
	Возврат Новый Структура("Базы,Серверы",
		Результаты[0].Выгрузить().ВыгрузитьКолонку("База"),
		Результаты[1].Выгрузить().ВыгрузитьКолонку("Сервер"));

КонецФункции

Функция ТолькоЦифры(Текст)

	Для Н = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Н, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрДлина(Текст) > 0;

КонецФункции

Функция ЭкранироватьДляПодобно(Текст)

	Результат = СтрЗаменить(Текст, "~", "~~");
	Для Каждого Символ Из СтрРазделить("%,_,[,],^", ",") Цикл
		Результат = СтрЗаменить(Результат, Символ, "~" + Символ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// ВиновникИд для TLOCK/TTIMEOUT с непустым ЖдалСоединения: записанные сейчас и строки без виновника
// того же сервера с Время не раньше часа до самого раннего события пакета. Методика ИТС (metod8dev i8106006):
// виновник - TLOCK соединения из ЖдалСоединения в пределах его транзакции, наложивший блокировку,
// несовместимую с ожидаемой. Начало транзакции - последний SDBL CommitTransaction/RollbackTransaction
// соединения до начала ожидания, нет его - начало ожидания минус 10 минут. Для каждого соединения
// по порядку, среди TLOCK после начала транзакции и до начала ожидания:
//  0 - то же пространство, не обе Shared и совпадают значения общих полей Locks;
//  1 - то же пространство; 2 - любой TLOCK. Везде самый поздний: он точно в текущей транзакции виновника.
// Если TLOCK нет - последний SDBL/DBMSSQL соединения после начала транзакции и до Время,
// кроме SDBL CommitTransaction/RollbackTransaction.
//
// Параметры:
//  Идентификаторы - Массив из Строка - Ид записанных событий.
//  Сервер - Строка - сервер пакета.
//  МинВремя - Дата - самое раннее Время событий пакета.
Процедура ЗаполнитьВиновниковБлокировок(Идентификаторы, Сервер, МинВремя)

	Если Идентификаторы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ж.Ид КАК Ид,
	|	Ж.Сервер КАК Сервер,
	|	Ж.База КАК База,
	|	Ж.Время КАК Время,
	|	Ж.ДлительностьМс КАК ДлительностьМс,
	|	Ж.ЖдалСоединения КАК ЖдалСоединения,
	|	ПОДСТРОКА(Ж.Блокировки, 1, 2000) КАК Блокировки
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Ж
	|ГДЕ
	|	Ж.Событие В (""TLOCK"", ""TTIMEOUT"")
	|	И Ж.ЖдалСоединения <> """"
	|	И Ж.ВиновникИд = """"
	|	И (Ж.Ид В (&Идентификаторы)
	|			ИЛИ Ж.Сервер = &Сервер
	|				И Ж.Время >= &ЧасДоПакета)";
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);
	Запрос.УстановитьПараметр("Сервер", Сервер);
	Запрос.УстановитьПараметр("ЧасДоПакета", МинВремя - 3600);
	Выборка = Запрос.Выполнить().Выбрать();

	ТипДата = Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя));
	Ожидания = Новый ТаблицаЗначений;
	Ожидания.Колонки.Добавить("Ид", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(36)));
	Ожидания.Колонки.Добавить("Сервер", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
	Ожидания.Колонки.Добавить("База", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	Ожидания.Колонки.Добавить("Соединение", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
	Ожидания.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0)));
	Ожидания.Колонки.Добавить("ВремяС", ТипДата);
	Ожидания.Колонки.Добавить("НачалоОжидания", ТипДата);
	Ожидания.Колонки.Добавить("ВремяПо", ТипДата);
	Ожидания.Колонки.Добавить("Шаблон", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(250)));
	ЗаписиЖертв = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		НачалоОжидания = Выборка.Время - Цел(Выборка.ДлительностьМс / 1000);
		ЗаписиЖертв.Вставить(Выборка.Ид, ЗаписиБлокировок(Выборка.Блокировки));
		Пространство = ПространствоБлокировок(Выборка.Блокировки);
		Шаблон = ?(ЗначениеЗаполнено(Пространство), ЭкранироватьДляПодобно(Пространство) + "%", "");
		Порядок = 0;
		Для Каждого Соединение Из СтрРазделить(Выборка.ЖдалСоединения, ",; ", Ложь) Цикл
			Если НЕ СтрокаИзЦифр(Соединение) Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = Ожидания.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка, "Ид,Сервер,База");
			НоваяСтрока.Соединение = Число(Соединение);
			НоваяСтрока.Порядок = Порядок;
			НоваяСтрока.НачалоОжидания = НачалоОжидания;
			НоваяСтрока.ВремяС = НачалоОжидания - 600;
			НоваяСтрока.ВремяПо = Выборка.Время;
			НоваяСтрока.Шаблон = Шаблон;
			Порядок = Порядок + 1;
		КонецЦикла;
	КонецЦикла;
	Если Ожидания.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	О.Ид КАК Ид,
	|	О.Сервер КАК Сервер,
	|	О.База КАК База,
	|	О.Соединение КАК Соединение,
	|	О.Порядок КАК Порядок,
	|	О.ВремяС КАК ВремяС,
	|	О.НачалоОжидания КАК НачалоОжидания,
	|	О.ВремяПо КАК ВремяПо,
	|	О.Шаблон КАК Шаблон
	|ПОМЕСТИТЬ Ожидания
	|ИЗ
	|	&Ожидания КАК О
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	О.Ид КАК Ид,
	|	О.Порядок КАК Порядок,
	|	""Т"" КАК Вид,
	|	ВЫБОР
	|		КОГДА О.Шаблон <> """"
	|				И ПОДСТРОКА(Р.Блокировки, 1, 200) ПОДОБНО О.Шаблон СПЕЦСИМВОЛ ""~""
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ТоЖеПространство,
	|	Р.Время КАК Время,
	|	Р.Микросекунды КАК Микросекунды,
	|	Р.Ид КАК ВиновникИд,
	|	ПОДСТРОКА(Р.Блокировки, 1, 2000) КАК Блокировки
	|ИЗ
	|	Ожидания КАК О
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.рбфВыполненияТЖ КАК Р
	|		ПО (Р.Сервер = О.Сервер)
	|			И (Р.База = О.База)
	|			И (Р.СоединениеИд = О.Соединение)
	|			И (Р.Время >= О.ВремяС)
	|			И (Р.Время <= О.НачалоОжидания)
	|			И (Р.Событие = ""TLOCK"")
	|			И (Р.Ид <> О.Ид)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	О.Ид,
	|	О.Порядок,
	|	""К"",
	|	ЛОЖЬ,
	|	Р.Время,
	|	Р.Микросекунды,
	|	Р.Ид,
	|	""""
	|ИЗ
	|	Ожидания КАК О
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.рбфВыполненияТЖ КАК Р
	|		ПО (Р.Сервер = О.Сервер)
	|			И (Р.База = О.База)
	|			И (Р.СоединениеИд = О.Соединение)
	|			И (Р.Время >= О.ВремяС)
	|			И (Р.Время <= О.НачалоОжидания)
	|			И (Р.Событие = ""SDBL"")
	|			И (Р.Функция В (""CommitTransaction"", ""RollbackTransaction""))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	О.Ид,
	|	О.Порядок,
	|	""З"",
	|	ЛОЖЬ,
	|	Р.Время,
	|	Р.Микросекунды,
	|	Р.Ид,
	|	""""
	|ИЗ
	|	Ожидания КАК О
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.рбфВыполненияТЖ КАК Р
	|		ПО (Р.Сервер = О.Сервер)
	|			И (Р.База = О.База)
	|			И (Р.СоединениеИд = О.Соединение)
	|			И (Р.Время > О.ВремяС)
	|			И (Р.Время <= О.ВремяПо)
	|			И (Р.Событие В (""SDBL"", ""DBMSSQL""))
	|			И (НЕ(Р.Событие = ""SDBL""
	|					И Р.Функция В (""CommitTransaction"", ""RollbackTransaction"")))
	|			И (Р.Ид <> О.Ид)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ид,
	|	Порядок,
	|	Время,
	|	Микросекунды";
	Запрос.УстановитьПараметр("Ожидания", Ожидания);
	Кандидаты = Запрос.Выполнить().Выгрузить();

	Виновники = Новый Соответствие;
	Для Каждого Ожидание Из Ожидания Цикл
		Если Виновники.Получить(Ожидание.Ид) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Строки = Кандидаты.НайтиСтроки(Новый Структура("Ид,Порядок", Ожидание.Ид, Ожидание.Порядок));
		ВиновникИд = ВиновникВТранзакции(Строки, Ожидание.НачалоОжидания, ЗаписиЖертв.Получить(Ожидание.Ид));
		Если ЗначениеЗаполнено(ВиновникИд) Тогда
			Виновники.Вставить(Ожидание.Ид, ВиновникИд);
		КонецЕсли;
	КонецЦикла;

	Для Каждого КлючЗначение Из Виновники Цикл
		Набор = РегистрыСведений.рбфВыполненияТЖ.СоздатьНаборЗаписей();
		Набор.Отбор.Ид.Установить(КлючЗначение.Ключ);
		Набор.Прочитать();
		Если Набор.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Набор[0].ВиновникИд = КлючЗначение.Значение;
		Набор.Записать(Истина);
	КонецЦикла;

КонецПроцедуры

// Соединения (база|соединение), у которых есть TLOCK в пакете или в рбфВыполненияТЖ сервера
// за 10 минут до самого раннего Commit/Rollback пакета. Пусто, если в пакете нет Commit/Rollback.
//
// Параметры:
//  Сервер - Строка - сервер пакета.
//  События - Массив из Соответствие - события пакета в формате контракта.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - ключ КлючСоединенияТЖ, значение Истина.
Функция СоединенияСБлокировкамиТЖ(Сервер, События)

	Соединения = Новый Соответствие;
	НачалоОкна = Неопределено;
	Для Каждого Событие Из События Цикл
		Если ВРег(СтрокаИзJSON(Событие.Получить("event"))) = "TLOCK" Тогда
			Соединения.Вставить(КлючСоединенияТЖ(Событие), Истина);
		ИначеЕсли ЭтоЗавершениеТранзакцииТЖ(Событие) Тогда
			Время = ДатаСобытияТЖ(Событие.Получить("time"));
			Если Время <> Неопределено И (НачалоОкна = Неопределено ИЛИ Время < НачалоОкна) Тогда
				НачалоОкна = Время;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если НачалоОкна = Неопределено Тогда
		Возврат Соединения;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.База КАК База,
	|	Т.СоединениеИд КАК СоединениеИд
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	Т.Сервер = &Сервер
	|	И Т.Время >= &НачалоОкна
	|	И Т.Событие = ""TLOCK""";
	Запрос.УстановитьПараметр("Сервер", Сервер);
	Запрос.УстановитьПараметр("НачалоОкна", НачалоОкна - 600);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Соединения.Вставить(ВРег(Выборка.База) + "|" + Формат(Выборка.СоединениеИд, "ЧГ=0; ЧН=0"), Истина);
	КонецЦикла;
	Возврат Соединения;

КонецФункции

// Ключ соединения события ТЖ для СоединенияСБлокировкамиТЖ: "БАЗА|соединение".
Функция КлючСоединенияТЖ(Событие)

	Возврат ВРег(Лев(СтрокаИзJSON(Событие.Получить("db")), 150)) + "|"
		+ Формат(ЧислоИзJSON(Событие.Получить("connect"), 9999999999), "ЧГ=0; ЧН=0");

КонецФункции

// SDBL CommitTransaction / RollbackTransaction.
Функция ЭтоЗавершениеТранзакцииТЖ(Событие)

	Если ВРег(СтрокаИзJSON(Событие.Получить("event"))) <> "SDBL" Тогда
		Возврат Ложь;
	КонецЕсли;
	ИмяФункции = СтрокаИзJSON(Событие.Получить("func"));
	Возврат ИмяФункции = "CommitTransaction" ИЛИ ИмяФункции = "RollbackTransaction";

КонецФункции

// Первое слово поля Блокировки до пробела или точки, например InfoRg331.
//
// Параметры:
//  Блокировки - Строка - начало поля Блокировки события TLOCK.
//
// Возвращаемое значение:
//  Строка - пространство блокировок или пустая строка.
Функция ПространствоБлокировок(Блокировки)

	Текст = СокрЛП(СтрЗаменить(Блокировки, "'", ""));
	Для Н = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Н, 1);
		Если Символ = " " ИЛИ Символ = "." ИЛИ Символ = "," ИЛИ ПустаяСтрока(Символ) Тогда
			Возврат Лев(Текст, Н - 1);
		КонецЕсли;
	КонецЦикла;
	Возврат Текст;

КонецФункции

// Виновник одного соединения из ЖдалСоединения по правилам ЗаполнитьВиновниковБлокировок.
//
// Параметры:
//  Строки - Массив из СтрокаТаблицыЗначений - события соединения по возрастанию времени:
//   Вид (Т - TLOCK, К - Commit/Rollback, З - SDBL/DBMSSQL), ТоЖеПространство, ВиновникИд, Блокировки.
//  НачалоОжидания - Дата - начало ожидания жертвы.
//  ЗаписиЖертвы - Массив из Структура - результат ЗаписиБлокировок для Блокировки жертвы.
//
// Возвращаемое значение:
//  Строка - Ид события-виновника или пустая строка.
Функция ВиновникВТранзакции(Строки, НачалоОжидания, ЗаписиЖертвы)

	Несовместимый = "";
	ТоЖеПространство = "";
	ЛюбойTLOCK = "";
	ПоследнийЗапрос = "";
	Для Каждого Событие Из Строки Цикл
		Если Событие.Вид = "К" Тогда
			// транзакция завершилась до начала ожидания - её блокировки уже сняты
			Несовместимый = "";
			ТоЖеПространство = "";
			ЛюбойTLOCK = "";
			ПоследнийЗапрос = "";
		ИначеЕсли Событие.Вид = "З" Тогда
			ПоследнийЗапрос = Событие.ВиновникИд;
		Иначе
			ЛюбойTLOCK = Событие.ВиновникИд;
			Если Событие.ТоЖеПространство Тогда
				ТоЖеПространство = Событие.ВиновникИд;
				Если ЗаписиЖертвы <> Неопределено
					И БлокировкиНесовместимы(ЗаписиЖертвы, ЗаписиБлокировок(Событие.Блокировки)) Тогда
					Несовместимый = Событие.ВиновникИд;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если ЗначениеЗаполнено(Несовместимый) Тогда
		Возврат Несовместимый;
	ИначеЕсли ЗначениеЗаполнено(ТоЖеПространство) Тогда
		Возврат ТоЖеПространство;
	ИначеЕсли ЗначениеЗаполнено(ЛюбойTLOCK) Тогда
		Возврат ЛюбойTLOCK;
	КонецЕсли;
	Возврат ПоследнийЗапрос;

КонецФункции

// Разбор поля Locks события TLOCK: записи через запятую вида
// "InfoRg331.DIMS Exclusive Fld332=0 Fld333="текст"" (значения в кавычках могут содержать пробелы и запятые).
//
// Параметры:
//  Блокировки - Строка - значение поля Блокировки.
//
// Возвращаемое значение:
//  Массив из Структура - Пространство (Строка), Режим (Строка), Поля (Соответствие: имя поля - значение).
Функция ЗаписиБлокировок(Блокировки)

	Записи = Новый Массив;
	Текст = СтрЗаменить(Блокировки, "'", "");
	Для Каждого ТекстЗаписи Из РазделитьВнеКавычек(Текст, ",") Цикл
		Слова = РазделитьВнеКавычек(ТекстЗаписи, " ");
		Если Слова.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Запись = Новый Структура("Пространство,Режим,Поля", Слова[0], "", Новый Соответствие);
		Для Н = 1 По Слова.Количество() - 1 Цикл
			Позиция = СтрНайти(Слова[Н], "=");
			Если Позиция = 0 Тогда
				Запись.Режим = Слова[Н];
			Иначе
				Запись.Поля.Вставить(Лев(Слова[Н], Позиция - 1), Сред(Слова[Н], Позиция + 1));
			КонецЕсли;
		КонецЦикла;
		Записи.Добавить(Запись);
	КонецЦикла;
	Возврат Записи;

КонецФункции

// Есть ли пара записей с одним пространством, не обе Shared, у которых совпадают значения
// всех общих полей (поле, которого нет в записи, - весь диапазон значений).
//
// Параметры:
//  ЗаписиЖертвы - Массив из Структура - см. ЗаписиБлокировок.
//  ЗаписиВиновника - Массив из Структура - см. ЗаписиБлокировок.
//
// Возвращаемое значение:
//  Булево - Истина, если блокировки пересекаются.
Функция БлокировкиНесовместимы(ЗаписиЖертвы, ЗаписиВиновника)

	Для Каждого Ждёт Из ЗаписиЖертвы Цикл
		Для Каждого Держит Из ЗаписиВиновника Цикл
			Если Ждёт.Пространство <> Держит.Пространство
				ИЛИ Ждёт.Режим = "Shared" И Держит.Режим = "Shared" Тогда
				Продолжить;
			КонецЕсли;
			Совпадают = Истина;
			Для Каждого Поле Из Ждёт.Поля Цикл
				Значение = Держит.Поля.Получить(Поле.Ключ);
				Если Значение <> Неопределено И Значение <> Поле.Значение Тогда
					Совпадают = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Совпадают Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Части строки между разделителями, стоящими вне двойных кавычек; пустые части пропускаются.
Функция РазделитьВнеКавычек(Текст, Разделитель)

	Части = Новый Массив;
	ВКавычках = Ложь;
	Начало = 1;
	Длина = СтрДлина(Текст);
	Для Н = 1 По Длина + 1 Цикл
		Символ = ?(Н > Длина, Разделитель, Сред(Текст, Н, 1));
		Если Символ = """" Тогда
			ВКавычках = НЕ ВКавычках;
		ИначеЕсли Символ = Разделитель И (НЕ ВКавычках ИЛИ Н > Длина) Тогда
			Часть = СокрЛП(Сред(Текст, Начало, Н - Начало));
			Если ЗначениеЗаполнено(Часть) Тогда
				Части.Добавить(Часть);
			КонецЕсли;
			Начало = Н + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Части;

КонецФункции

// Перестроение кэша рбфИменаТаблицТЖ по ПолучитьСтруктуруХраненияБазыДанных (имена как в СУБД).
//
// Параметры:
//  База - Строка - имя текущей ИБ.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - карта имён хранения.
Функция ПостроитьКартуИменТаблиц(База)

	Карта = Новый Соответствие;
	Структура = ПолучитьСтруктуруХраненияБазыДанных(, Истина);
	Для Каждого Таблица Из Структура Цикл
		ИмяТаблицы = Таблица.ИмяТаблицы;
		Если НЕ ЗначениеЗаполнено(ИмяТаблицы) И ЗначениеЗаполнено(Таблица.Метаданные) Тогда
			ИмяТаблицы = Строка(Таблица.Метаданные) + "." + Таблица.Назначение;
		КонецЕсли;
		Если ЗначениеЗаполнено(Таблица.ИмяТаблицыХранения) И ЗначениеЗаполнено(ИмяТаблицы) Тогда
			Карта.Вставить(Таблица.ИмяТаблицыХранения, ИмяТаблицы);
		КонецЕсли;
		Для Каждого Поле Из Таблица.Поля Цикл
			// стандартные поля (_IDRRef, _Description) одинаковы во всех таблицах - первое значение
			Если ЗначениеЗаполнено(Поле.ИмяПоляХранения) И ЗначениеЗаполнено(Поле.ИмяПоля)
				И Карта.Получить(Поле.ИмяПоляХранения) = Неопределено Тогда
				Карта.Вставить(Поле.ИмяПоляХранения, Поле.ИмяПоля);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Набор = РегистрыСведений.рбфИменаТаблицТЖ.СоздатьНаборЗаписей();
	Набор.Отбор.База.Установить(База);
	Для Каждого КлючЗначение Из Карта Цикл
		Если СтрДлина(КлючЗначение.Ключ) > 150 Тогда
			Продолжить;
		КонецЕсли;
		Запись = Набор.Добавить();
		Запись.База = База;
		Запись.ИмяХранения = КлючЗначение.Ключ;
		Запись.ИмяМетаданных = Лев(КлючЗначение.Значение, 300);
	КонецЦикла;
	Запись = Набор.Добавить();
	Запись.База = База;
	Запись.ИмяХранения = "*";
	Запись.ИмяМетаданных = XMLСтрока(ТекущаяДатаСеанса());
	Набор.Записать(Истина);

	Возврат Карта;

КонецФункции

// Замена числовых литералов (12, 1.5, 0x1A2B) и параметров @P1 на ?; цифры внутри имён не трогаются.
Функция ЗаменитьЛексемыЧисел(Текст)

	Совпадения = СтрНайтиВсеПоРегулярномуВыражению(Текст, "0x[0-9A-Fa-f]+|@P[0-9]+|[A-Za-zА-Яа-яЁё_#][A-Za-zА-Яа-яЁё0-9_#]*|[0-9]+(\.[0-9]+)?");
	Части = Новый Массив;
	Позиция = 1;
	Для Каждого Совпадение Из Совпадения Цикл
		Первый = Лев(Совпадение.Значение, 1);
		Если НЕ (Первый = "@" ИЛИ СтрНайти("0123456789", Первый) > 0) Тогда
			Продолжить;
		КонецЕсли;
		Части.Добавить(Сред(Текст, Позиция, Совпадение.НачальнаяПозиция - Позиция));
		Части.Добавить("?");
		Позиция = Совпадение.НачальнаяПозиция + Совпадение.Длина;
	КонецЦикла;
	Части.Добавить(Сред(Текст, Позиция));
	Возврат СтрСоединить(Части);

КонецФункции

Функция ДатаСобытияТЖ(Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") ИЛИ СтрДлина(СокрЛП(Значение)) < 19 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат XMLЗначение(Тип("Дата"), Лев(СокрЛП(Значение), 19));
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция СтрокаИзJSON(Значение)

	Возврат ?(Значение = Неопределено ИЛИ Значение = Null, "", Строка(Значение));

КонецФункции

// Число из JSON в пределах реквизита: нечисловое - 0, дробная часть целых полей отбрасывается записью.
Функция ЧислоИзJSON(Значение, Максимум)

	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Макс(-Максимум, Мин(Значение, Максимум));

КонецФункции

Функция НепустыеСтроки(Текст)

	Результат = Новый Массив;
	Для Каждого СтрокаТекста Из СтрРазделить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(СтрокаТекста)) Тогда
			Результат.Добавить(СокрЛП(СтрокаТекста));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СтрокаИзЦифр(Текст)

	Возврат ЗначениеЗаполнено(Текст) И СтрНайтиПоРегулярномуВыражению(Текст, "^[0-9]+$").НачальнаяПозиция > 0;

КонецФункции

#КонецОбласти
