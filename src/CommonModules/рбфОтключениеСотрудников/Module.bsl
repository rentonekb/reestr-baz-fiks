// Отключение сотрудника: поиск по фамилии в AD и на MikroTik, блокировка учётки AD,
// ppp secret, завершение сеансов VPN/RDP/SMB, добавление ящика в архив почты.
// Внешние действия выполняет скрипт C:\Kirill\OwnerGuard\Offboard-Employee.ps1 на сервере 1С;
// доступы он берёт из offboard.cred рядом с собой, в конфигурации паролей нет.
// Доступно только полным пользователям.

#Область ПрограммныйИнтерфейс

// Ищет сотрудника по фамилии.
//
// Параметры:
//  Фамилия - Строка - фамилия или её начало.
//
// Возвращаемое значение:
//  Строка - ответ скрипта в JSON: {Ok, Error, Users: [{Login, Name, Mail, Enabled, LastLogon,
//   Description, Secrets: [...], Vpn: [...], Sessions: [...]}]}.
Функция НайтиСотрудника(Знач Фамилия) Экспорт

	ПроверитьПраво();
	Запрос = Новый Структура("Mode, Surname", "Find", СокрЛП(Фамилия));
	Возврат ВыполнитьСкрипт(Запрос);

КонецФункции

// Отключает сотрудника: AD, выбранные ppp secret, сеансы VPN/RDP/SMB. Бэкапы делает скрипт.
//
// Параметры:
//  Логин - Строка - sAMAccountName.
//  Секреты - Массив из Строка - имена ppp secret к отключению.
//
// Возвращаемое значение:
//  Строка - ответ скрипта в JSON: {Ok, Error, Login, Mail, Backup, Steps: [{Step, Ok, Text}]}.
Функция ОтключитьСотрудника(Знач Логин, Знач Секреты) Экспорт

	ПроверитьПраво();
	Запрос = Новый Структура("Mode, Login, Secrets, Who", "Block", СокрЛП(Логин), Секреты,
		Строка(ПараметрыСеанса.ТекущийПользователь));
	Ответ = ВыполнитьСкрипт(Запрос);
	ЗаписьЖурналаРегистрации(СобытиеЖурнала(), УровеньЖурналаРегистрации.Информация, , ,
		"Отключение " + Логин + ": " + Ответ);
	Возврат Ответ;

КонецФункции

// Добавляет почтовый ящик в архив почты (расширение АрхивПочты): учётная запись БСП с IMAP Яндекса
// и элемент справочника апПочтовыеЯщики с включённой загрузкой.
//
// Параметры:
//  Почта - Строка - адрес ящика.
//  ПарольПриложения - Строка - пароль приложения IMAP из Яндекс 360.
//
// Возвращаемое значение:
//  Строка - текст результата для пользователя.
Функция ДобавитьЯщикВАрхив(Знач Почта, Знач ПарольПриложения) Экспорт

	ПроверитьПраво();
	Почта = НРег(СокрЛП(Почта));
	Если НЕ ЗначениеЗаполнено(Почта) ИЛИ СтрНайти(Почта, "@") = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Не указан адрес ящика.'");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ПарольПриложения) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан пароль приложения.'");
	КонецЕсли;
	Если Метаданные.Справочники.Найти("апПочтовыеЯщики") = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Расширение АрхивПочты не подключено.'");
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	МенеджерЯщиков = Справочники["апПочтовыеЯщики"];
	Если ЗначениеЗаполнено(МенеджерЯщиков.НайтиПоНаименованию(Почта, Истина)) Тогда
		Возврат СтрШаблон(НСтр("ru = 'Ящик %1 уже есть в архиве почты.'"), Почта);
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		УчетнаяЗапись = Справочники.УчетныеЗаписиЭлектроннойПочты.НайтиПоРеквизиту("АдресЭлектроннойПочты", Почта);
		Если ЗначениеЗаполнено(УчетнаяЗапись) Тогда
			ОбъектУчетки = УчетнаяЗапись.ПолучитьОбъект();
		Иначе
			ОбъектУчетки = Справочники.УчетныеЗаписиЭлектроннойПочты.СоздатьЭлемент();
			ОбъектУчетки.Наименование = Почта;
			ОбъектУчетки.АдресЭлектроннойПочты = Почта;
		КонецЕсли;
		// Настройки как у уже работающих ящиков архива (m.sologub@ и др.)
		ОбъектУчетки.ПротоколВходящейПочты = "IMAP";
		ОбъектУчетки.СерверВходящейПочты = "imap.yandex.ru";
		ОбъектУчетки.ПортСервераВходящейПочты = 993;
		ОбъектУчетки.ИспользоватьЗащищенноеСоединениеДляВходящейПочты = Истина;
		ОбъектУчетки.Пользователь = Почта;
		ОбъектУчетки.ИспользоватьДляПолучения = Истина;
		ОбъектУчетки.Записать();
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ОбъектУчетки.Ссылка, ПарольПриложения);

		Ящик = МенеджерЯщиков.СоздатьЭлемент();
		Ящик.Наименование = Почта;
		Ящик.УчетнаяЗапись = ОбъектУчетки.Ссылка;
		Ящик.КаталогХранения = "\\192.168.88.35\share\Backup_Mail";
		Ящик.Загружать = Истина;
		Ящик.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(СобытиеЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			"Ящик " + Почта + ": " + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;

	ЗаписьЖурналаРегистрации(СобытиеЖурнала(), УровеньЖурналаРегистрации.Информация, , ,
		"Ящик " + Почта + " добавлен в архив почты");
	Возврат СтрШаблон(НСтр("ru = 'Ящик %1 добавлен в архив почты. Загрузка начнётся при ближайшем запуске
		|регламентного задания (раз в час).'"), Почта);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьПраво()

	Если НЕ Пользователи.ЭтоПолныеПользователи() Тогда
		ВызватьИсключение НСтр("ru = 'Отключать сотрудников могут только администраторы.'");
	КонецЕсли;

КонецПроцедуры

Функция СобытиеЖурнала()

	Возврат НСтр("ru = 'ОтключениеСотрудников'", ОбщегоНазначения.КодОсновногоЯзыка());

КонецФункции

// Запускает скрипт с параметрами в JSON-файле и возвращает его ответ (JSON).
Функция ВыполнитьСкрипт(Параметры)

	ФайлЗапроса = ПолучитьИмяВременногоФайла("json");
	ФайлОтвета = ПолучитьИмяВременногоФайла("json");

	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(ФайлЗапроса, КодировкаТекста.UTF8, Ложь);
	ЗаписатьJSON(Запись, Параметры);
	Запись.Закрыть();

	КоманднаяСтрока = СтрШаблон("powershell.exe -NoProfile -ExecutionPolicy Bypass -File ""%1"" -In ""%2"" -Out ""%3""",
		"C:\Kirill\OwnerGuard\Offboard-Employee.ps1", ФайлЗапроса, ФайлОтвета);
	КодВозврата = 0;
	ЗапуститьПриложение(КоманднаяСтрока, , Истина, КодВозврата);

	Ответ = "";
	Файл = Новый Файл(ФайлОтвета);
	Если Файл.Существует() Тогда
		Чтение = Новый ЧтениеТекста(ФайлОтвета, КодировкаТекста.UTF8);
		Ответ = Чтение.Прочитать();
		Чтение.Закрыть();
	КонецЕсли;
	УдалитьФайлы(ФайлЗапроса);
	УдалитьФайлы(ФайлОтвета);

	Если НЕ ЗначениеЗаполнено(Ответ) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Скрипт отключения не вернул ответ (код %1).'"), КодВозврата);
	КонецЕсли;
	Возврат Ответ;

КонецФункции

#КонецОбласти
