// Создание кластера 1С по схеме AL: на S2019 служба агента и служба RAS, на 192.168.88.63 агент той же версии
// как рабочий сервер только для сервиса лицензирования, требования назначения функциональности как в кластере 1541.
// Внешние действия выполняет скрипт C:\Tools\Cluster1C\Cluster1C.ps1 на сервере 1С под учёткой рабочего процесса.
// Пароль AL\service.1c для новых служб хранится в безопасном хранилище; учётка администратора кластера -
// в C:\Kirill\OwnerGuard\cluster.cred, как у правил реестра. Доступно только полноправным пользователям.

#Область ПрограммныйИнтерфейс

// Сведения для формы создания кластера.
//
// Возвращаемое значение:
//  Структура:
//   * Версии - Массив из Строка - версии платформы, у которых есть ragent, ras и rac на S2019 и ragent на 88.63;
//   * СвободныйПорт - Число - первый свободный на обоих серверах порт агента вида N540, 0 - нет;
//   * ПарольСохранён - Булево - пароль service.1c уже в безопасном хранилище;
//   * Текст - Строка - службы 1С на серверах или ошибка получения сведений.
Функция Сведения() Экспорт

	ПроверитьПраво();
	Результат = Новый Структура("Версии, СвободныйПорт, ПарольСохранён, Текст", Новый Массив, 0, ПарольСохранён(), "");
	Ответ = ВыполнитьСкрипт(Новый Структура("Mode", "Info"));
	Если НЕ Ответ.Ok Тогда
		Результат.Текст = НСтр("ru = 'Сведения о серверах не получены:'") + " " + Ответ.Error;
		Возврат Результат;
	КонецЕсли;

	Для Каждого Версия Из Ответ.Info.Versions Цикл
		Результат.Версии.Добавить(Версия);
	КонецЦикла;
	Результат.СвободныйПорт = Ответ.Info.FreePort;
	Результат.Текст = НСтр("ru = 'Службы 1С на S2019:'") + " " + СтрСоединить(Ответ.Info.Central, ", ") + Символы.ПС
		+ НСтр("ru = 'Службы 1С на 88.63:'") + " " + СтрСоединить(Ответ.Info.Lic, ", ");
	Возврат Результат;

КонецФункции

// Сохраняет пароль AL\service.1c в безопасное хранилище.
//
// Параметры:
//  Пароль - Строка - пароль учётной записи, под которой работают службы 1С.
Процедура СохранитьПароль(Знач Пароль) Экспорт

	ПроверитьПраво();
	УстановитьПривилегированныйРежим(Истина);
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ВладелецПароля(), Пароль, КлючПароля());

КонецПроцедуры

// Проверяет параметры и возвращает план создания, ничего не меняя.
//
// Параметры:
//  Имя - Строка - имя кластера и служб (латиница).
//  Версия - Строка - версия платформы.
//  Порт - Число - порт агента вида N540.
//
// Возвращаемое значение:
//  Строка - план или причина отказа.
Функция Проверить(Знач Имя, Знач Версия, Знач Порт) Экспорт

	ПроверитьПраво();
	Запрос = Новый Структура("Mode, Name, Version, Port", "Plan", СокрЛП(Имя), СокрЛП(Версия), Порт);
	Возврат ТекстОтвета(ВыполнитьСкрипт(Запрос), НСтр("ru = 'Можно создавать'"));

КонецФункции

// Создаёт службы и кластер, назначает рабочий сервер 88.63 и требования назначения функциональности.
// При ошибке скрипт удаляет созданное этим запуском.
//
// Параметры:
//  Имя - Строка - имя кластера и служб (латиница).
//  Версия - Строка - версия платформы.
//  Порт - Число - порт агента вида N540.
//
// Возвращаемое значение:
//  Строка - итог по шагам; при успехе начинается с «Кластер создан».
Функция Создать(Знач Имя, Знач Версия, Знач Порт) Экспорт

	ПроверитьПраво();
	УстановитьПривилегированныйРежим(Истина);
	Пароль = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВладелецПароля(), КлючПароля());
	УстановитьПривилегированныйРежим(Ложь);
	Если НЕ ЗначениеЗаполнено(Пароль) Тогда
		Возврат НСтр("ru = 'Не задан пароль AL\service.1c: введите его в форме, он сохранится в безопасном хранилище.'");
	КонецЕсли;

	Запрос = Новый Структура("Mode, Name, Version, Port, Password, Who", "Create", СокрЛП(Имя), СокрЛП(Версия), Порт,
		Пароль, Строка(ПараметрыСеанса.ТекущийПользователь));
	Ответ = ВыполнитьСкрипт(Запрос);
	Текст = ТекстОтвета(Ответ, СтрШаблон(НСтр("ru = 'Кластер создан: %1, порт кластера %2, RAS %3'"),
		СокрЛП(Имя), Формат(Порт + 1, "ЧГ=0"), Формат(Порт + 5, "ЧГ=0")));
	ЗаписьЖурналаРегистрации(СобытиеЖурнала(),
		?(Ответ.Ok, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Ошибка), , , Текст);
	Возврат Текст;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьПраво()

	Если НЕ Пользователи.ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение НСтр("ru = 'Создавать кластеры 1С могут только администраторы.'");
	КонецЕсли;

КонецПроцедуры

Функция ВладелецПароля()

	Возврат "РеестрБазФикс.Кластеры1С";

КонецФункции

Функция КлючПароля()

	Возврат "ПарольService1C";

КонецФункции

Функция ПарольСохранён()

	УстановитьПривилегированныйРежим(Истина);
	Возврат ЗначениеЗаполнено(ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВладелецПароля(), КлючПароля()));

КонецФункции

Функция СобытиеЖурнала()

	Возврат НСтр("ru = 'Кластеры1С'", ОбщегоНазначения.КодОсновногоЯзыка());

КонецФункции

// Текст для формы: шаги скрипта и итог.
Функция ТекстОтвета(Ответ, ТекстУспеха)

	Строки = Новый Массив;
	Строки.Добавить(?(Ответ.Ok, ТекстУспеха, НСтр("ru = 'Ошибка:'") + " " + Ответ.Error));
	Если Ответ.Свойство("Steps") И ТипЗнч(Ответ.Steps) = Тип("Массив") Тогда
		Для Каждого Шаг Из Ответ.Steps Цикл
			Строки.Добавить(?(Шаг.Ok, "[+] ", "[-] ") + Шаг.Step + ": " + Шаг.Text);
		КонецЦикла;
	КонецЕсли;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Запускает скрипт с параметрами в JSON-файле и возвращает его ответ.
// Файл запроса может содержать пароль: удаляется сразу после работы скрипта, в том числе при ошибке.
//
// Возвращаемое значение:
//  Структура - ответ скрипта {Ok, Error, Mode, Steps, Info}; при сбое запуска - Ok = Ложь и Error.
Функция ВыполнитьСкрипт(Параметры)

	ФайлЗапроса = ПолучитьИмяВременногоФайла("json");
	ФайлОтвета = ПолучитьИмяВременногоФайла("json");
	КодВозврата = 0;
	Попытка
		Запись = Новый ЗаписьJSON;
		Запись.ОткрытьФайл(ФайлЗапроса, КодировкаТекста.UTF8, Ложь);
		ЗаписатьJSON(Запись, Параметры);
		Запись.Закрыть();
		КоманднаяСтрока = СтрШаблон("powershell.exe -NoProfile -ExecutionPolicy Bypass -File ""%1"" -In ""%2"" -Out ""%3""",
			"C:\Tools\Cluster1C\Cluster1C.ps1", ФайлЗапроса, ФайлОтвета);
		ЗапуститьПриложение(КоманднаяСтрока, , Истина, КодВозврата);
	Исключение
		УдалитьФайлы(ФайлЗапроса);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьФайлы(ФайлЗапроса);

	Ответ = Неопределено;
	Файл = Новый Файл(ФайлОтвета);
	Если Файл.Существует() Тогда
		Попытка
			Чтение = Новый ЧтениеJSON;
			Чтение.ОткрытьФайл(ФайлОтвета, "UTF-8"); // у ЧтениеJSON кодировка - только строкой
			Ответ = ПрочитатьJSON(Чтение);
			Чтение.Закрыть();
		Исключение
			Ответ = Неопределено;
		КонецПопытки;
	КонецЕсли;
	УдалитьФайлы(ФайлОтвета);

	Если ТипЗнч(Ответ) <> Тип("Структура") ИЛИ НЕ Ответ.Свойство("Ok") Тогда
		Возврат Новый Структура("Ok, Error, Steps", Ложь,
			СтрШаблон(НСтр("ru = 'скрипт Cluster1C.ps1 не вернул ответ (код %1)'"), КодВозврата), Новый Массив);
	КонецЕсли;
	Возврат Ответ;

КонецФункции

#КонецОбласти
