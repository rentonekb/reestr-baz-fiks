#Область СлужебныйПрограммныйИнтерфейс

// Регистрация регламентных заданий расширения в подсистеме БСП «Регламентные задания».
// Оба задания обращаются к внешним ресурсам (СУБД и кластер 1С), поэтому помечены
// признаком РаботаетСВнешнимиРесурсами: БСП сама отключит их в копии информационной базы.
//
// Параметры:
//  Настройки - ТаблицаЗначений - см. РегламентныеЗаданияПереопределяемый.ПриОпределенииНастроекРегламентныхЗаданий.
&После("ПриОпределенииНастроекРегламентныхЗаданий")
Процедура рбфПриОпределенииНастроекРегламентныхЗаданий(Настройки)

	Настройка = Настройки.Добавить();
	Настройка.РегламентноеЗадание = Метаданные.РегламентныеЗадания.КонтрольВладельцевБаз;
	Настройка.РаботаетСВнешнимиРесурсами = Истина;
	Настройка.ДоступноВМоделиСервиса = Ложь;

	Настройка = Настройки.Добавить();
	Настройка.РегламентноеЗадание = Метаданные.РегламентныеЗадания.КонтрольСрокаАктуальности;
	Настройка.РаботаетСВнешнимиРесурсами = Истина;
	Настройка.ДоступноВМоделиСервиса = Ложь;

КонецПроцедуры

#КонецОбласти
