////////////////////////////////////////////////////////////////////////////////
// Раздел «Анализ»: клиентские действия общей шапки форм (выбор периода, доп. фильтр)
// и просмотр текста подробностей в отдельном окне.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Открывает стандартный диалог периода; выбранный период переводит шапку
// в «Произвольный интервал».
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с реквизитами ВидПериода, НачалоПериода, КонецПериода.
Процедура ВыбратьПериод(Форма) Экспорт

	Диалог = Новый ДиалогРедактированияСтандартногоПериода;
	Диалог.Период = Новый СтандартныйПериод(Форма.НачалоПериода, Форма.КонецПериода);
	Диалог.Показать(Новый ОписаниеОповещения("ВыбратьПериодЗавершение", рбфАнализКлиент, Форма));

КонецПроцедуры

// Продолжение ВыбратьПериод.
//
// Параметры:
//  Период - СтандартныйПериод, Неопределено - выбранный период.
//  Форма - ФормаКлиентскогоПриложения - форма раздела.
Процедура ВыбратьПериодЗавершение(Период, Форма) Экспорт

	Если Период = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Форма.ВидПериода = "Произвольный интервал";
	Форма.НачалоПериода = Период.ДатаНачала;
	Форма.КонецПериода = Период.ДатаОкончания;

КонецПроцедуры

// Показывает или скрывает группу дополнительного фильтра шапки.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с группой ГруппаДопФильтр.
Процедура ПереключитьДопФильтр(Форма) Экспорт

	Группа = Форма.Элементы.ГруппаДопФильтр;
	Группа.Видимость = НЕ Группа.Видимость;

КонецПроцедуры

// Показывает текст в отдельном окне (команда «Открыть в отдельном окне»).
//
// Параметры:
//  Текст - Строка - текст страницы подробностей.
//  Заголовок - Строка - заголовок окна.
Процедура ОткрытьТекст(Текст, Заголовок) Экспорт

	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(Текст);
	Документ.Показать(Заголовок);

КонецПроцедуры

// Открывает журнал регистрации с отбором по сеансу, пользователю и интервалу события ТЖ.
// Журнал открывается только для базы base_list (обработка ЖурналРегистрации БСП); для других баз
// показываются готовые параметры отбора: ЖР другой базы отсюда не прочитать.
//
// Параметры:
//  ОтборЖурнала - Структура - ЭтаБаза, Отбор, Текст (см. рбфСобытияТЖСервер.ОтборЖурналаРегистрации).
Процедура НайтиВЖурналеРегистрации(ОтборЖурнала) Экспорт

	Если ОтборЖурнала.ЭтаБаза Тогда
		Попытка
			ОткрытьФорму("Обработка.ЖурналРегистрации.Форма.ЖурналРегистрации", ОтборЖурнала.Отбор);
			Возврат;
		Исключение
			// формы БСП нет или она не принимает отбор - показываются параметры для ручного отбора
			ОписаниеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		ОткрытьТекст(ОтборЖурнала.Текст + Символы.ПС + Символы.ПС + "Журнал не открылся: " + ОписаниеОшибки,
			"Отбор журнала регистрации");
		Возврат;
	КонецЕсли;
	ОткрытьТекст(ОтборЖурнала.Текст, "Отбор журнала регистрации");

КонецПроцедуры

#КонецОбласти
