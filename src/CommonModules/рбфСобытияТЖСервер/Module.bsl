////////////////////////////////////////////////////////////////////////////////
// Детальные события технологического журнала (регистр рбфВыполненияТЖ) для раздела «Анализ»:
// приём пакетов от tj-analyzer / агента (rbf-admin/tj-events), карта имён таблиц СУБД
// в имена метаданных (рбфИменаТаблицБаз, rbf-admin/tj-storage), поиск виновника
// ожидания на блокировке, сведения для форм и очистка по глубине хранения.
//
// Почасовые агрегаты рбфСобытияТЖ для этого не годятся: в них один пример за час
// и последняя строка контекста, а для разбора как у 1С-Монитора нужны отдельные события
// со всем стеком, сеансом, соединением и текстом запроса 1С.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Пакетная запись событий ТЖ (метод rbf-admin/tj-events). Повторная отправка того же события
// (тот же Ид) пропускается. После записи для ожиданий на блокировке ищется виновник.
//
// Параметры:
//  Сервер - Строка - имя сервера 1С, с которого собран ТЖ.
//  События - Массив из Соответствие - события, поля - см. docs/tj-events-schema.md.
//
// Возвращаемое значение:
//  Структура - received, written, duplicates, culprits.
Функция ПринятьВыполненияТЖ(Сервер, События) Экспорт

	Если ТипЗнч(События) <> Тип("Массив") Тогда
		ВызватьИсключение "events должен быть массивом";
	КонецЕсли;
	Если События.Количество() > МаксимумСобытийВПакете() Тогда
		ВызватьИсключение СтрШаблон("в пакете %1 событий, допускается не больше %2",
			Формат(События.Количество(), "ЧГ="), Формат(МаксимумСобытийВПакете(), "ЧГ="));
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	ИмяСервера = Лев(СокрЛП(Сервер), 50);
	Сейчас = ТекущаяДатаСеанса();
	СлужебныеСлова = СлужебныеСлова();
	Карты = Новый Соответствие; // база -> карта имён таблиц

	// идентификаторы пакета; уже записанные события пропускаются
	Записи = Новый Массив;
	Идентификаторы = Новый Массив;
	ВПакете = Новый Соответствие;
	Для Каждого Событие Из События Цикл
		Если ТипЗнч(Событие) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Ид = ИдСобытия(ИмяСервера, Событие);
		Если ВПакете.Получить(Ид) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ВПакете.Вставить(Ид, Истина);
		Идентификаторы.Добавить(Ид);
		Записи.Добавить(Новый Структура("Ид,Событие", Ид, Событие));
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ид КАК Ид
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	Т.Ид В(&Идентификаторы)";
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);
	Записанные = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Записанные.Вставить(Выборка.Ид, Истина);
	КонецЦикла;

	// набор без отбора и запись без замещения: добавляются только новые записи
	Набор = РегистрыСведений.рбфВыполненияТЖ.СоздатьНаборЗаписей();
	Жертвы = Новый Массив;
	Для Каждого Элемент Из Записи Цикл
		Если Записанные.Получить(Элемент.Ид) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Запись = Набор.Добавить();
		ЗаполнитьЗапись(Запись, Элемент.Ид, ИмяСервера, Элемент.Событие, СлужебныеСлова, Карты);
		Запись.Получено = Сейчас;
		Если (Запись.Событие = "TLOCK" ИЛИ Запись.Событие = "TTIMEOUT") И ЗначениеЗаполнено(Запись.ЖдалСоединения) Тогда
			Жертвы.Добавить(Запись.Ид);
		КонецЕсли;
	КонецЦикла;
	Если Набор.Количество() > 0 Тогда
		Набор.Записать(Ложь);
	КонецЕсли;

	// виновник ищется после записи всего пакета: его события часто приходят тем же пакетом
	Найдено = 0;
	Для Каждого Ид Из Жертвы Цикл
		// @skip-check query-in-loop - по каждому ожиданию свой поиск событий соединения-виновника
		Если ЗаполнитьВиновника(Ид) Тогда
			Найдено = Найдено + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("received,written,duplicates,culprits", События.Количество(), Набор.Количество(),
		События.Количество() - Набор.Количество(), Найдено);

КонецФункции

// Загрузка карты имён таблиц базы (метод rbf-admin/tj-storage): карта базы заменяется целиком.
//
// Параметры:
//  База - Строка - имя информационной базы в кластере.
//  Таблицы - Массив из Соответствие - storage (имя хранения, _Reference139), name (Справочник.Контрагенты).
//
// Возвращаемое значение:
//  Число - сколько имён записано.
Функция ПринятьИменаТаблиц(База, Таблицы) Экспорт

	Если ТипЗнч(Таблицы) <> Тип("Массив") Тогда
		ВызватьИсключение "tables должен быть массивом";
	КонецЕсли;
	Имена = Новый Соответствие;
	Для Каждого Таблица Из Таблицы Цикл
		Если ТипЗнч(Таблица) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Имена.Вставить(СтрокаПоля(Таблица, "storage"), СтрокаПоля(Таблица, "name"));
	КонецЦикла;
	Возврат ЗаписатьИменаТаблиц(База, Имена);

КонецФункции

// Карта имён таблиц базы, в которой работает base_list: ПолучитьСтруктуруХраненияБазыДанных
// даёт её только для своей базы. Выполняется командой очереди ОбновитьИменаТаблиц
// и в суточном цикле.
//
// Возвращаемое значение:
//  Число - сколько имён записано.
Функция ОбновитьИменаТаблицТекущейБазы() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Структура = ПолучитьСтруктуруХраненияБазыДанных(, Истина);
	Имена = Новый Соответствие;
	Для Каждого Строка Из Структура Цикл
		Если ЗначениеЗаполнено(Строка.ИмяТаблицыХранения) И ЗначениеЗаполнено(Строка.ИмяТаблицы) Тогда
			Имена.Вставить(Строка.ИмяТаблицыХранения, Строка.ИмяТаблицы);
		КонецЕсли;
	КонецЦикла;
	Возврат ЗаписатьИменаТаблиц(ИмяТекущейБазы(), Имена);

КонецФункции

// Карта имён таблиц базы для замены в текстах запросов и пространствах блокировок.
//
// Параметры:
//  База - Строка - имя информационной базы.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - имя хранения в верхнем регистре -> имя метаданных.
Функция КартаИмён(База) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Карта = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	И.ИмяХранения КАК ИмяХранения,
	|	И.Метаданные КАК Метаданные
	|ИЗ
	|	РегистрСведений.рбфИменаТаблицБаз КАК И
	|ГДЕ
	|	И.База = &База";
	Запрос.УстановитьПараметр("База", База);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Карта.Вставить(Выборка.ИмяХранения, Выборка.Метаданные);
	КонецЦикла;
	Возврат Карта;

КонецФункции

// Заменяет имена хранения (_Reference139, _AccumRg123_VT45) в тексте на имена метаданных.
//
// Параметры:
//  Текст - Строка - текст SQL.
//  Карта - Соответствие - см. КартаИмён.
//
// Возвращаемое значение:
//  Строка - текст с именами метаданных; пустая строка, если карта пуста.
Функция ИменаВТерминах1С(Текст, Карта) Экспорт

	Если Карта.Количество() = 0 ИЛИ НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;
	Части = Новый Массив;
	Длина = СтрДлина(Текст);
	Поз = 1;
	Пока Поз <= Длина Цикл
		Начало = СтрНайти(Текст, "_", , Поз);
		Если Начало = 0 Тогда
			Части.Добавить(Сред(Текст, Поз));
			Прервать;
		КонецЕсли;
		Конец = Начало + 1;
		Пока Конец <= Длина И ЭтоСимволИмени(Сред(Текст, Конец, 1)) Цикл
			Конец = Конец + 1;
		КонецЦикла;
		Замена = Неопределено;
		Если Начало = 1 ИЛИ НЕ ЭтоСимволИмени(Сред(Текст, Начало - 1, 1)) Тогда
			Замена = Карта.Получить(ВРег(Сред(Текст, Начало, Конец - Начало)));
		КонецЕсли;
		Если Замена = Неопределено Тогда
			Части.Добавить(Сред(Текст, Поз, Конец - Поз));
		Иначе
			Части.Добавить(Сред(Текст, Поз, Начало - Поз));
			Части.Добавить(Замена);
		КонецЕсли;
		Поз = Конец;
	КонецЦикла;
	Возврат СтрСоединить(Части);

КонецФункции

// Представление пространства блокировки: AccumRg123.DIMS -> РегистрНакопления.Остатки (DIMS).
//
// Параметры:
//  Пространство - Строка - пространство из свойства Locks.
//  Карта - Соответствие - см. КартаИмён.
//
// Возвращаемое значение:
//  Строка - представление.
Функция ПредставлениеПространства(Пространство, Карта) Экспорт

	Если НЕ ЗначениеЗаполнено(Пространство) Тогда
		Возврат "";
	КонецЕсли;
	Точка = СтрНайти(Пространство, ".");
	Таблица = ?(Точка = 0, Пространство, Лев(Пространство, Точка - 1));
	Вид = ?(Точка = 0, "", Сред(Пространство, Точка + 1));
	Имя = Карта.Получить(ВРег("_" + Таблица));
	Если Имя = Неопределено Тогда
		Возврат Пространство;
	КонецЕсли;
	Возврат Имя + ?(ЗначениеЗаполнено(Вид), " (" + Вид + ")", "");

КонецФункции

// Ищет и записывает виновника ожидания на блокировке: последнее событие соединения
// из WaitConnections до окончания ожидания (кроме фиксации и отмены транзакции).
// Начало транзакции виновника - первое его событие после предыдущей фиксации или отмены.
//
// Параметры:
//  Ид - Строка - идентификатор события TLOCK / TTIMEOUT.
//
// Возвращаемое значение:
//  Булево - виновник найден и записан.
Функция ЗаполнитьВиновника(Ид) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Набор = РегистрыСведений.рбфВыполненияТЖ.СоздатьНаборЗаписей();
	Набор.Отбор.Ид.Установить(Ид);
	Набор.Прочитать();
	Если Набор.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Жертва = Набор[0];
	Если ЗначениеЗаполнено(Жертва.ВиновникИд) Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого Соединение Из СтрРазделить(Жертва.ЖдалСоединения, ",", Ложь) Цикл
		НомерСоединения = ЧислоИзСтроки(Соединение);
		Если НомерСоединения = 0 Тогда
			Продолжить;
		КонецЕсли;
		// @skip-check query-in-loop - соединений в WaitConnections одно-два
		Виновник = ПоследнееСобытиеСоединения(Жертва.Сервер, Жертва.База, НомерСоединения, Жертва.Момент);
		Если Виновник = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Жертва.ВиновникИд = Виновник.Ид;
		Жертва.ВиновникСоединение = НомерСоединения;
		Жертва.ВиновникПользователь = Виновник.Пользователь;
		Жертва.ВиновникСеанс = Виновник.СеансИд;
		Жертва.ВиновникНачалоТранзакции = ДатаМомента(НачалоТранзакции(Жертва.Сервер, Жертва.База, НомерСоединения,
			Виновник.Момент));
		Набор.Записать(Истина);
		Возврат Истина;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Последнее событие соединения не позже момента (кроме фиксации и отмены транзакции).
//
// Параметры:
//  Сервер - Строка - сервер.
//  База - Строка - база.
//  Соединение - Число - t:connectID.
//  Момент - Число - момент, мкс от 01.01.2000.
//
// Возвращаемое значение:
//  Структура, Неопределено - Ид, Момент, Пользователь, СеансИд, Событие.
Функция ПоследнееСобытиеСоединения(Сервер, База, Соединение, Момент) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ид КАК Ид,
	|	Т.Момент КАК Момент,
	|	Т.Пользователь КАК Пользователь,
	|	Т.СеансИд КАК СеансИд,
	|	Т.Событие КАК Событие
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	Т.Сервер = &Сервер
	|	И Т.База = &База
	|	И Т.СоединениеИд = &Соединение
	|	И Т.Момент МЕЖДУ &Граница И &Момент
	|	И НЕ Т.ФункцияSDBL В (""CommitTransaction"", ""RollbackTransaction"")
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.Момент УБЫВ";
	Запрос.УстановитьПараметр("Сервер", Сервер);
	Запрос.УстановитьПараметр("База", База);
	Запрос.УстановитьПараметр("Соединение", Соединение);
	Запрос.УстановитьПараметр("Момент", Момент);
	// транзакция, державшая блокировку, дольше часа - редкость; граница ограничивает выборку по индексу
	Запрос.УстановитьПараметр("Граница", Момент - 3600 * 1000000);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Ид,Момент,Пользователь,СеансИд,Событие", Выборка.Ид, Выборка.Момент,
		Выборка.Пользователь, Выборка.СеансИд, Выборка.Событие);

КонецФункции

// Последний запрос (SDBL, DBMSSQL) соединения не позже момента - для виновника, у которого последнее
// событие - сама блокировка (TLOCK) без текста запроса.
//
// Параметры:
//  Сервер - Строка - сервер.
//  База - Строка - база.
//  Соединение - Число - t:connectID.
//  Момент - Число - момент, мкс от 01.01.2000.
//  НачалоТранзакции - Число - момент начала транзакции; запросы раньше него не берутся.
//
// Возвращаемое значение:
//  Строка - Ид события или пустая строка.
Функция ПоследнийЗапросСоединения(Сервер, База, Соединение, Момент, НачалоТранзакции) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ид КАК Ид
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	Т.Сервер = &Сервер
	|	И Т.База = &База
	|	И Т.СоединениеИд = &Соединение
	|	И Т.Момент МЕЖДУ &Граница И &Момент
	|	И Т.Событие В (""SDBL"", ""DBMSSQL"", ""DBPOSTGRS"")
	|	И Т.ФункцияSDBL = """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.Момент УБЫВ";
	Запрос.УстановитьПараметр("Сервер", Сервер);
	Запрос.УстановитьПараметр("База", База);
	Запрос.УстановитьПараметр("Соединение", Соединение);
	Запрос.УстановитьПараметр("Момент", Момент);
	Запрос.УстановитьПараметр("Граница", ?(ЗначениеЗаполнено(НачалоТранзакции), НачалоТранзакции,
		Момент - 3600 * 1000000));
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ид, "");

КонецФункции

// Момент даты (мкс от 01.01.2000).
//
// Параметры:
//  Значение - Дата - дата.
//
// Возвращаемое значение:
//  Число - момент; 0 для пустой даты.
Функция МоментДаты(Значение) Экспорт

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат (Значение - Дата(2000, 1, 1)) * 1000000;

КонецФункции

// Все поля события для формы; запрос 1С для DBMSSQL дополняется по карте имён, если не был заполнен при записи.
//
// Параметры:
//  Ид - Строка - идентификатор события.
//
// Возвращаемое значение:
//  Структура, Неопределено - поля регистра рбфВыполненияТЖ; Неопределено - события нет.
Функция ДанныеСобытия(Ид) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Набор = РегистрыСведений.рбфВыполненияТЖ.СоздатьНаборЗаписей();
	Набор.Отбор.Ид.Установить(Ид);
	Набор.Прочитать();
	Если Набор.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запись = Набор[0];
	Данные = Новый Структура;
	Для Каждого Поле Из Метаданные.РегистрыСведений.рбфВыполненияТЖ.Измерения Цикл
		Данные.Вставить(Поле.Имя, Запись[Поле.Имя]);
	КонецЦикла;
	Для Каждого Поле Из Метаданные.РегистрыСведений.рбфВыполненияТЖ.Ресурсы Цикл
		Данные.Вставить(Поле.Имя, Запись[Поле.Имя]);
	КонецЦикла;
	Для Каждого Поле Из Метаданные.РегистрыСведений.рбфВыполненияТЖ.Реквизиты Цикл
		Данные.Вставить(Поле.Имя, Запись[Поле.Имя]);
	КонецЦикла;
	Если НЕ ЗначениеЗаполнено(Данные.ТекстЗапроса1С) И ЗначениеЗаполнено(Данные.ТекстSQL) Тогда
		Данные.ТекстЗапроса1С = ИменаВТерминах1С(Данные.ТекстSQL, КартаИмён(Данные.База));
	КонецЕсли;
	Возврат Данные;

КонецФункции

// Параметры отбора журнала регистрации для события: пользователь, сеанс и интервал ±1 минута.
//
// Параметры:
//  Данные - Структура - см. ДанныеСобытия.
//
// Возвращаемое значение:
//  Структура - ЭтаБаза (Булево - событие из базы base_list), Отбор (Пользователь, Сеанс, ДатаНачала,
//              ДатаОкончания), Текст (параметры для ручного отбора в другой базе).
Функция ОтборЖурналаРегистрации(Данные) Экспорт

	Отбор = Новый Структура;
	Отбор.Вставить("ДатаНачала", Данные.Время - 60);
	Отбор.Вставить("ДатаОкончания", Данные.Время + 60);
	Если ЗначениеЗаполнено(Данные.Пользователь) Тогда
		Отбор.Вставить("Пользователь", Данные.Пользователь);
	КонецЕсли;
	Если ЗначениеЗаполнено(Данные.СеансИд) Тогда
		Отбор.Вставить("Сеанс", Данные.СеансИд);
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("База: %1 (сервер %2)", Данные.База, Данные.Сервер));
	Строки.Добавить("Откройте базу -> Администрирование -> Журнал регистрации -> Отбор:");
	Строки.Добавить("  Интервал: " + Формат(Отбор.ДатаНачала, "ДФ='dd.MM.yyyy HH:mm:ss'") + " - "
		+ Формат(Отбор.ДатаОкончания, "ДФ='dd.MM.yyyy HH:mm:ss'"));
	Строки.Добавить("  Пользователь: " + ?(ЗначениеЗаполнено(Данные.Пользователь), Данные.Пользователь, "<нет в ТЖ>"));
	Строки.Добавить("  Сеанс: " + ?(ЗначениеЗаполнено(Данные.СеансИд), Формат(Данные.СеансИд, "ЧГ="), "<нет в ТЖ>"));
	Строки.Добавить("  Компьютер: " + Данные.Компьютер + ", приложение: " + Данные.Приложение);
	Строки.Добавить("");
	Строки.Добавить("Событие ТЖ: " + Данные.Событие + " в " + Формат(Данные.Время, "ДФ='dd.MM.yyyy HH:mm:ss'")
		+ ", длительность " + Формат(Данные.ДлительностьМс / 1000, "ЧДЦ=3; ЧН=0") + " с");

	Возврат Новый Структура("ЭтаБаза,Отбор,Текст", ВРег(Данные.База) = ВРег(ИмяТекущейБазы()), Отбор,
		СтрСоединить(Строки, Символы.ПС));

КонецФункции

// Удаляет события старше глубины хранения (настройка ХранитьВыполненияТЖДней, по умолчанию 14).
// За один вызов удаляется не больше ОчисткаВыполненийТЖЗаПроход записей (по умолчанию 100 000).
//
// Возвращаемое значение:
//  Число - сколько записей удалено.
Функция ОчиститьВыполненияТЖ() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Граница = ТекущаяДатаСеанса() - ПравилаРеестраБаз.Настройка("ХранитьВыполненияТЖДней", 14) * 86400;
	Предел = ПравилаРеестраБаз.Настройка("ОчисткаВыполненийТЖЗаПроход", 100000);
	Удалено = 0;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 10000
	|	Т.Ид КАК Ид
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	Т.Время < &Граница";
	Запрос.УстановитьПараметр("Граница", Граница);
	Пока Удалено < Предел Цикл
		// @skip-check query-in-loop - удаление порциями по 10 000
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		Пока Выборка.Следующий() Цикл
			Набор = РегистрыСведений.рбфВыполненияТЖ.СоздатьНаборЗаписей();
			Набор.Отбор.Ид.Установить(Выборка.Ид);
			Набор.Записать(Истина);
			Удалено = Удалено + 1;
		КонецЦикла;
	КонецЦикла;
	Возврат Удалено;

КонецФункции

// Имя информационной базы, в которой работает base_list, из строки соединения (Ref=).
//
// Возвращаемое значение:
//  Строка - имя базы в кластере или пустая строка для файловой базы.
Функция ИмяТекущейБазы() Экспорт

	Для Каждого Часть Из СтрРазделить(СтрокаСоединенияИнформационнойБазы(), ";", Ложь) Цикл
		Если СтрНачинаетсяС(ВРег(СокрЛП(Часть)), "REF=") Тогда
			Возврат СтрЗаменить(Сред(СокрЛП(Часть), 5), """", "");
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Момент события (мкс от 01.01.2000) в дату с точностью до секунды.
//
// Параметры:
//  Момент - Число - момент.
//
// Возвращаемое значение:
//  Дата - дата; пустая дата для нулевого момента.
Функция ДатаМомента(Момент) Экспорт

	Если НЕ ЗначениеЗаполнено(Момент) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Возврат Дата(2000, 1, 1) + Цел(Момент / 1000000);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция МаксимумСобытийВПакете()

	Возврат 5000;

КонецФункции

// Заполняет запись регистра по событию из JSON.
Процедура ЗаполнитьЗапись(Запись, Ид, Сервер, Событие, СлужебныеСлова, Карты)

	Запись.Ид = Ид;
	Запись.Сервер = Сервер;
	Запись.База = Лев(СтрокаПоля(Событие, "base"), 100);
	Запись.Событие = ВРег(Лев(СтрокаПоля(Событие, "event"), 20));

	ТекстВремени = СтрокаПоля(Событие, "time");
	Запись.Время = ДатаИзСтроки(ТекстВремени);
	Микросекунды = Сред(ТекстВремени, 21, 6);
	Микросекунды = ЧислоИзСтроки(Микросекунды + Лев("000000", 6 - СтрДлина(Микросекунды)));
	Запись.Момент = (Запись.Время - Дата(2000, 1, 1)) * 1000000 + Микросекунды;

	ДлительностьМкс = ЧислоПоля(Событие, "duration_us");
	Если ДлительностьМкс = 0 Тогда
		ДлительностьМкс = ЧислоПоля(Событие, "duration_ms") * 1000;
	КонецЕсли;
	Запись.ДлительностьМс = ДлительностьМкс / 1000;

	Запись.Пользователь = Лев(СтрокаПоля(Событие, "usr"), 100);
	Запись.СеансИд = ЧислоПоля(Событие, "session");
	Запись.СоединениеИд = ЧислоПоля(Событие, "connect");
	Запись.КлиентИд = ЧислоПоля(Событие, "client");
	Запись.Приложение = Лев(СтрокаПоля(Событие, "app"), 50);
	Запись.Компьютер = Лев(СтрокаПоля(Событие, "computer"), 100);
	Запись.ПроцессСУБД = ЧислоПоля(Событие, "dbpid");
	Запись.Транзакция = Лев(СтрокаПоля(Событие, "trans"), 20);
	Запись.Строк = Макс(ЧислоПоля(Событие, "rows"), ЧислоПоля(Событие, "rows_affected"));
	Запись.ФункцияSDBL = Лев(СтрокаПоля(Событие, "func"), 50);

	Контекст = СтрЗаменить(СтрокаПоля(Событие, "context"), Символы.ВК, "");
	Запись.КонтекстПолный = Контекст;
	Строки = Новый Массив;
	Для Каждого Строка Из СтрРазделить(Контекст, Символы.ПС, Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Строка)) Тогда
			Строки.Добавить(СокрЛП(Строка));
		КонецЕсли;
	КонецЦикла;
	Если Строки.Количество() > 0 Тогда
		Запись.КонтекстТочка = Лев(Строки[0], 300);
		Запись.КонтекстСтрока = Лев(Строки[Строки.ВГраница()], 300);
	КонецЕсли;

	ТекстSDBL = СтрокаПоля(Событие, "sdbl");
	Запись.ТекстSQL = СтрокаПоля(Событие, "sql");
	Если ЗначениеЗаполнено(ТекстSDBL) Тогда
		Запись.ТекстЗапроса1С = ТекстSDBL;
	ИначеЕсли ЗначениеЗаполнено(Запись.ТекстSQL) Тогда
		Карта = Карты.Получить(Запись.База);
		Если Карта = Неопределено Тогда
			// @skip-check query-in-loop - карта читается один раз на базу пакета
			Карта = КартаИмён(Запись.База);
			Карты.Вставить(Запись.База, Карта);
		КонецЕсли;
		Запись.ТекстЗапроса1С = ИменаВТерминах1С(Запись.ТекстSQL, Карта);
	КонецЕсли;

	ТекстЗапроса = ?(ЗначениеЗаполнено(ТекстSDBL), ТекстSDBL, Запись.ТекстSQL);
	Запись.Служебный = ЗначениеЗаполнено(ТекстЗапроса) И ЕстьСлужебноеСлово(ТекстЗапроса, СлужебныеСлова);

	Запись.Пространства = СтрокаПоля(Событие, "locks");
	Запись.ЖдалСоединения = Лев(СтрокаПоля(Событие, "wait_connections"), 200);
	Запись.ПересеченияВзаимоблокировки = СтрокаПоля(Событие, "deadlock");
	Если ЗначениеЗаполнено(Запись.Пространства) Тогда
		Запись.Пространство = Лев(ПервоеСлово(Запись.Пространства), 150);
	ИначеЕсли ЗначениеЗаполнено(Запись.ПересеченияВзаимоблокировки) Тогда
		// "соединение1 соединение2 пространство режим поля, ..."
		Пересечения = СтрРазделить(Запись.ПересеченияВзаимоблокировки, ",", Ложь);
		Слова = ?(Пересечения.Количество() = 0, Новый Массив, СтрРазделить(Пересечения[0], " ", Ложь));
		Если Слова.Количество() > 2 Тогда
			Запись.Пространство = Лев(Слова[2], 150);
		КонецЕсли;
	КонецЕсли;

	Запись.Исключение = Лев(СтрокаПоля(Событие, "exception"), 100);
	Запись.Описание = СтрокаПоля(Событие, "descr");

	ХешШаблона = СтрокаПоля(Событие, "template_hash");
	Если НЕ ЗначениеЗаполнено(ХешШаблона) Тогда
		Если ЗначениеЗаполнено(ТекстЗапроса) Тогда
			Шаблон = НормализованныйШаблон(ТекстЗапроса);
		ИначеЕсли ЗначениеЗаполнено(Запись.Пространство) Тогда
			Шаблон = Запись.Пространство;
		ИначеЕсли ЗначениеЗаполнено(Запись.Описание) Тогда
			Шаблон = НормализованныйШаблон(Запись.Описание);
		Иначе
			Шаблон = Запись.КонтекстТочка + "|" + Запись.КонтекстСтрока;
		КонецЕсли;
		ХешШаблона = MD5(Запись.Событие + "|" + Шаблон);
	КонецЕсли;
	Запись.ШаблонХеш = Лев(ХешШаблона, 32);

КонецПроцедуры

// Шаблон запроса для группировки: строковые литералы, числа и параметры @P1 / p_0 заменяются на "?",
// пробельные символы схлопываются. Разбирается не больше 1500 символов: дальше шаблоны одного
// запроса не различаются, а разбор по символам медленный (отправитель может прислать template_hash сам).
Функция НормализованныйШаблон(Текст)

	// платформа дописывает значения параметров DBMSSQL после текста строками "p_0: ..."
	Исходный = Текст;
	Параметры = СтрНайти(Исходный, Символы.ПС + "p_0:");
	Если Параметры > 0 Тогда
		Исходный = Лев(Исходный, Параметры - 1);
	КонецЕсли;
	Длина = Мин(СтрДлина(Исходный), 1500);
	Цифры = "0123456789";

	Части = Новый Массив;
	Предыдущий = "";
	Поз = 1;
	Пока Поз <= Длина Цикл
		Символ = Сред(Исходный, Поз, 1);
		Если Символ = "'" Тогда
			// строковый литерал, удвоенная кавычка внутри - часть литерала
			Конец = Поз + 1;
			Пока Конец <= Длина Цикл
				Если Сред(Исходный, Конец, 1) = "'" Тогда
					Если Сред(Исходный, Конец + 1, 1) = "'" Тогда
						Конец = Конец + 2;
						Продолжить;
					КонецЕсли;
					Прервать;
				КонецЕсли;
				Конец = Конец + 1;
			КонецЦикла;
			Части.Добавить("?");
			Поз = Конец + 1;
			Предыдущий = "?";
			Продолжить;
		ИначеЕсли СтрНайти(Цифры, Символ) > 0 И НЕ ЭтоСимволИмени(Предыдущий) Тогда
			// число, в том числе 0x0A1B и 12.5
			Пока Поз <= Длина И СтрНайти("0123456789ABCDEFabcdefxX.", Сред(Исходный, Поз, 1)) > 0 Цикл
				Поз = Поз + 1;
			КонецЦикла;
			Части.Добавить("?");
			Предыдущий = "?";
			Продолжить;
		ИначеЕсли Символ = "@" И ВРег(Сред(Исходный, Поз + 1, 1)) = "P" Тогда
			Поз = Поз + 2;
			Пока Поз <= Длина И СтрНайти(Цифры, Сред(Исходный, Поз, 1)) > 0 Цикл
				Поз = Поз + 1;
			КонецЦикла;
			Части.Добавить("?");
			Предыдущий = "?";
			Продолжить;
		ИначеЕсли Символ = " " ИЛИ Символ = Символы.Таб ИЛИ Символ = Символы.ПС ИЛИ Символ = Символы.ВК Тогда
			Если Предыдущий <> " " Тогда
				Части.Добавить(" ");
			КонецЕсли;
			Предыдущий = " ";
		Иначе
			Части.Добавить(Символ);
			Предыдущий = Символ;
		КонецЕсли;
		Поз = Поз + 1;
	КонецЦикла;
	Возврат ВРег(СокрЛП(СтрСоединить(Части)));

КонецФункции

// Начало транзакции соединения, в которой было событие: первое событие соединения
// после последней фиксации или отмены транзакции до этого события.
Функция НачалоТранзакции(Сервер, База, Соединение, Момент)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(Т.Момент), 0) КАК Момент
	|ПОМЕСТИТЬ Граница
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	Т.Сервер = &Сервер
	|	И Т.База = &База
	|	И Т.СоединениеИд = &Соединение
	|	И Т.Момент МЕЖДУ &Нижняя И &Момент
	|	И Т.ФункцияSDBL В (""CommitTransaction"", ""RollbackTransaction"")
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МИНИМУМ(Т.Момент) КАК Момент
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т,
	|	Граница КАК Граница
	|ГДЕ
	|	Т.Сервер = &Сервер
	|	И Т.База = &База
	|	И Т.СоединениеИд = &Соединение
	|	И Т.Момент > Граница.Момент
	|	И Т.Момент МЕЖДУ &Нижняя И &Момент";
	Запрос.УстановитьПараметр("Сервер", Сервер);
	Запрос.УстановитьПараметр("База", База);
	Запрос.УстановитьПараметр("Соединение", Соединение);
	Запрос.УстановитьПараметр("Момент", Момент);
	Запрос.УстановитьПараметр("Нижняя", Момент - 3600 * 1000000);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Момент) Тогда
		Возврат Выборка.Момент;
	КонецЕсли;
	Возврат Момент;

КонецФункции

Функция ЗаписатьИменаТаблиц(База, Имена)

	УстановитьПривилегированныйРежим(Истина);
	ИмяБазы = Лев(СокрЛП(База), 100);
	Если НЕ ЗначениеЗаполнено(ИмяБазы) Тогда
		ВызватьИсключение "не задано имя базы";
	КонецЕсли;
	Сейчас = ТекущаяДатаСеанса();
	Набор = РегистрыСведений.рбфИменаТаблицБаз.СоздатьНаборЗаписей();
	Набор.Отбор.База.Установить(ИмяБазы);
	Ключи = Новый Соответствие;
	Для Каждого КЗ Из Имена Цикл
		ИмяХранения = ВРег(Лев(СокрЛП(КЗ.Ключ), 150));
		Если НЕ ЗначениеЗаполнено(ИмяХранения) ИЛИ НЕ ЗначениеЗаполнено(КЗ.Значение)
			ИЛИ Ключи.Получить(ИмяХранения) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Ключи.Вставить(ИмяХранения, Истина);
		Запись = Набор.Добавить();
		Запись.База = ИмяБазы;
		Запись.ИмяХранения = ИмяХранения;
		Запись.Метаданные = Лев(КЗ.Значение, 300);
		Запись.Обновлено = Сейчас;
	КонецЦикла;
	Набор.Записать(Истина);
	Возврат Набор.Количество();

КонецФункции

// Слова служебных запросов платформы из настройки ТЖСлужебныеЗапросы (через запятую).
Функция СлужебныеСлова()

	Список = ПравилаРеестраБаз.Настройка("ТЖСлужебныеЗапросы",
		"Config,ConfigSave,Params,Files,SchemaStorage,DBSchema,IBVersion,_YearOffset,sp_reset_connection,"
		+ "_SystemSettings,_CommonSettings,_RepSettings,_FrmDtSettings,_UsersWorkHistory");
	Слова = Новый Массив;
	Для Каждого Слово Из СтрРазделить(Список, ",", Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Слово)) Тогда
			Слова.Добавить(ВРег(СокрЛП(Слово)));
		КонецЕсли;
	КонецЦикла;
	Возврат Слова;

КонецФункции

// Есть ли в тексте запроса служебное слово как отдельный идентификатор (Config, но не ConfigX).
Функция ЕстьСлужебноеСлово(Текст, Слова)

	ТекстВРег = ВРег(Лев(Текст, 3000));
	Длина = СтрДлина(ТекстВРег);
	Для Каждого Слово Из Слова Цикл
		ДлинаСлова = СтрДлина(Слово);
		Поз = СтрНайти(ТекстВРег, Слово);
		Пока Поз > 0 Цикл
			Слева = ?(Поз = 1, "", Сред(ТекстВРег, Поз - 1, 1));
			Справа = ?(Поз + ДлинаСлова > Длина, "", Сред(ТекстВРег, Поз + ДлинаСлова, 1));
			Если НЕ ЭтоСимволИмени(Слева) И НЕ ЭтоСимволИмени(Справа) Тогда
				Возврат Истина;
			КонецЕсли;
			Поз = СтрНайти(ТекстВРег, Слово, , Поз + 1);
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЭтоСимволИмени(Символ)

	Если СтрДлина(Символ) <> 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_", Символ) > 0;

КонецФункции

// Идентификатор события: id отправителя (хеш файл+смещение) или MD5 ключевых полей.
Функция ИдСобытия(Сервер, Событие)

	Ид = СокрЛП(СтрокаПоля(Событие, "id"));
	Если НЕ ЗначениеЗаполнено(Ид) Тогда
		Ид = MD5(Сервер + "|" + СтрокаПоля(Событие, "time") + "|" + СтрокаПоля(Событие, "event") + "|"
			+ СтрокаПоля(Событие, "connect") + "|" + СтрокаПоля(Событие, "duration_us"));
	КонецЕсли;
	Возврат Лев(Ид, 36);

КонецФункции

Функция MD5(Текст)

	Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеш.Добавить(Текст);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));

КонецФункции

Функция ПервоеСлово(Текст)

	Части = СтрРазделить(Текст, ",", Ложь);
	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Слова = СтрРазделить(СокрЛП(Части[0]), " ", Ложь);
	Возврат ?(Слова.Количество() = 0, "", Слова[0]);

КонецФункции

// Строковое поле события JSON; отсутствующее или Null - пустая строка, число - без разделителей.
Функция СтрокаПоля(Событие, Имя)

	Значение = Событие.Получить(Имя);
	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=; ЧН=0");
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

// Числовое поле события JSON: число или строка из цифр; остальное - 0.
Функция ЧислоПоля(Событие, Имя)

	Значение = Событие.Получить(Имя);
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат ЧислоИзСтроки(Значение);
	КонецЕсли;
	Возврат 0;

КонецФункции

Функция ЧислоИзСтроки(Текст)

	Значение = СокрЛП(Текст);
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

// Дата из строки ISO 8601 вида 2026-10-20T10:15:03.123456 (местное время сервера 1С).
Функция ДатаИзСтроки(Текст)

	Если СтрДлина(Текст) < 19 Тогда
		ВызватьИсключение "в событии нет времени (time) или формат не ГГГГ-ММ-ДДTчч:мм:сс: «" + Текст + "»";
	КонецЕсли;
	Возврат XMLЗначение(Тип("Дата"), Лев(Текст, 19));

КонецФункции

#КонецОбласти
