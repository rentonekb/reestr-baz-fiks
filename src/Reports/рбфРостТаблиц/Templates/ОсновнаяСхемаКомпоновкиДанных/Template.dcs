			<field>Строк</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Строк</v8:content>
				</v8:item>
			</title>
			<valueType>
				<v8:Type>xs:decimal</v8:Type>
				<v8:NumberQualifiers>
					<v8:Digits>15</v8:Digits>
					<v8:FractionDigits>0</v8:FractionDigits>
					<v8:AllowedSign>Any</v8:AllowedSign>
				</v8:NumberQualifiers>
			</valueType>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>РазмерНачало</dataPath>
			<field>РазмерНачало</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Размер в начале, МБ</v8:content>
				</v8:item>
			</title>
			<valueType>
				<v8:Type>xs:decimal</v8:Type>
				<v8:NumberQualifiers>
					<v8:Digits>15</v8:Digits>
					<v8:FractionDigits>2</v8:FractionDigits>
					<v8:AllowedSign>Any</v8:AllowedSign>
				</v8:NumberQualifiers>
			</valueType>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>РазмерКонец</dataPath>
			<field>РазмерКонец</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Размер в конце, МБ</v8:content>
				</v8:item>
			</title>
			<valueType>
				<v8:Type>xs:decimal</v8:Type>
				<v8:NumberQualifiers>
					<v8:Digits>15</v8:Digits>
					<v8:FractionDigits>2</v8:FractionDigits>
					<v8:AllowedSign>Any</v8:AllowedSign>
				</v8:NumberQualifiers>
			</valueType>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Р.Сервер1С КАК Сервер1С,
	Р.ИмяБазы1С КАК ИмяБазы1С,
	Р.Таблица КАК Таблица,
	МИНИМУМ(Р.ДатаСнимка) КАК Первая,
	МАКСИМУМ(Р.ДатаСнимка) КАК Последняя
ПОМЕСТИТЬ Границы
ИЗ
	РегистрСведений.рбфРазмерыТаблиц КАК Р
ГДЕ
	Р.ДатаСнимка МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
СГРУППИРОВАТЬ ПО
	Р.Сервер1С,
	Р.ИмяБазы1С,
	Р.Таблица
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Р.ДатаСнимка КАК ДатаСнимка,
	Р.Сервер1С КАК Сервер1С,
	Р.ИмяБазы1С КАК ИмяБазы1С,
	Р.Таблица КАК Таблица,
	ВЫБОР
		КОГДА Р.Таблица ПОДОБНО "(%"
			ТОГДА "Итог по базе"
		ИНАЧЕ "Таблица"
	КОНЕЦ КАК Вид,
	Р.РазмерМБ КАК РазмерМБ,
	Р.Строк КАК Строк,
	ВЫБОР
		КОГДА Р.ДатаСнимка = Г.Первая
			ТОГДА Р.РазмерМБ
		ИНАЧЕ 0
	КОНЕЦ КАК РазмерНачало,
	ВЫБОР
		КОГДА Р.ДатаСнимка = Г.Последняя
			ТОГДА Р.РазмерМБ
		ИНАЧЕ 0
	КОНЕЦ КАК РазмерКонец
ИЗ
	РегистрСведений.рбфРазмерыТаблиц КАК Р
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Границы КАК Г
		ПО Р.Сервер1С = Г.Сервер1С
			И Р.ИмяБазы1С = Г.ИмяБазы1С
			И Р.Таблица = Г.Таблица
ГДЕ
	Р.ДатаСнимка МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода</query>
	</dataSet>
	<calculatedField>
		<dataPath>Прирост</dataPath>
		<expression>РазмерКонец - РазмерНачало</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Прирост, МБ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:decimal</v8:Type>
			<v8:NumberQualifiers>
				<v8:Digits>15</v8:Digits>
				<v8:FractionDigits>2</v8:FractionDigits>
				<v8:AllowedSign>Any</v8:AllowedSign>
			</v8:NumberQualifiers>
		</valueType>
	</calculatedField>
	<totalField>
		<dataPath>РазмерМБ</dataPath>
		<expression>Сумма(РазмерМБ)</expression>
	</totalField>
	<totalField>
		<dataPath>Строк</dataPath>
		<expression>Сумма(Строк)</expression>
	</totalField>
	<totalField>
		<dataPath>РазмерНачало</dataPath>
		<expression>Сумма(РазмерНачало)</expression>
	</totalField>
	<totalField>
		<dataPath>РазмерКонец</dataPath>
		<expression>Сумма(РазмерКонец)</expression>
	</totalField>
	<totalField>
		<dataPath>Прирост</dataPath>
		<expression>Сумма(РазмерКонец) - Сумма(РазмерНачало)</expression>
	</totalField>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>v8:StandardPeriod</v8:Type>
		</valueType>
		<value xsi:type="v8:StandardPeriod">
			<v8:variant xsi:type="v8:StandardPeriodVariant">LastMonth</v8:variant>
		</value>
		<useRestriction>false</useRestriction>
		<denyIncompleteValues>true</denyIncompleteValues>
		<use>Always</use>
	</parameter>
	<parameter>
		<name>НачалоПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;Период.ДатаНачала</expression>
	</parameter>
	<parameter>
		<name>КонецПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;Период.ДатаОкончания</expression>
	</parameter>
