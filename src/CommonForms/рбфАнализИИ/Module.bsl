// Раздел «Анализ», страница «ИИ-анализ ТЖ»: постановка разбора ТЖ в очередь рбфЗаданияАнализаТЖ
// (ПравилаРеестраБаз.ПоставитьАнализТЖ), список заданий со статусом, сводка tj-analyzer и
// диагноз ИИ. Диагноз - JSON-массив объектов severity/title/evidence/cause/fix/verify,
// показывается таблицей; если разобрать не удалось - только текстом.
// «Пробный прогон» - только сводка: исполнитель ничего не отправляет в модель.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Каталог = ПравилаРеестраБаз.Настройка("КаталогТЖДляАнализа", "");
	ПериодПо = ТекущаяДатаСеанса();
	ПериодС = ПериодПо - 3 * 3600;
	ОбновитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПодключитьОбработчикОжидания("ОбновитьОжидающие", 30);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗадания

&НаКлиенте
Процедура ЗаданияПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьРезультат", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПробныйПрогонОбработка(Команда)

	Поставить(Истина);

КонецПроцедуры

&НаКлиенте
Процедура АнализироватьОбработка(Команда)

	Поставить(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОбработка(Команда)

	ОбновитьНаСервере();
	ПоказатьРезультат();

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодОбработка(Команда)

	Диалог = Новый ДиалогРедактированияСтандартногоПериода;
	Диалог.Период = Новый СтандартныйПериод(ПериодС, ПериодПо);
	Диалог.Показать(Новый ОписаниеОповещения("ВыбратьПериодЗавершение", ЭтотОбъект));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыбратьПериодЗавершение(Период, ДополнительныеПараметры) Экспорт

	Если Период = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПериодС = Период.ДатаНачала;
	ПериодПо = Период.ДатаОкончания;

КонецПроцедуры

&НаКлиенте
Процедура Поставить(ПробныйПрогон)

	Текст = ПоставитьНаСервере(ПробныйПрогон);
	ПоказатьПредупреждение(, Текст);
	ПоказатьРезультат();

КонецПроцедуры

&НаСервере
Функция ПоставитьНаСервере(ПробныйПрогон)

	Попытка
		Ид = ПравилаРеестраБаз.ПоставитьАнализТЖ(СокрЛП(Каталог), ПериодС, ПериодПо, ПробныйПрогон, ИмяПользователя());
	Исключение
		Возврат "Задание не поставлено: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	ОбновитьНаСервере();
	Для Каждого Строка Из Задания Цикл
		Если Строка.Ид = Ид Тогда
			Элементы.Задания.ТекущаяСтрока = Строка.ПолучитьИдентификатор();
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат ?(ПробныйПрогон, "Пробный прогон поставлен в очередь: в модель ничего не отправляется.",
		"Анализ поставлен в очередь.") + " Исполнитель берёт задания раз в минуту.";

КонецФункции

// Пока есть задания в очереди или в работе, список обновляется раз в 30 секунд.
&НаКлиенте
Процедура ОбновитьОжидающие()

	ЕстьОжидающие = Ложь;
	Для Каждого Строка Из Задания Цикл
		Если Строка.Статус = "В очереди" ИЛИ Строка.Статус = "Выполняется" Тогда
			ЕстьОжидающие = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ЕстьОжидающие Тогда
		Возврат;
	КонецЕсли;

	ТекущиеДанные = Элементы.Задания.ТекущиеДанные;
	Ид = ?(ТекущиеДанные = Неопределено, "", ТекущиеДанные.Ид);
	ОбновитьНаСервере();
	Если ЗначениеЗаполнено(Ид) Тогда
		Для Каждого Строка Из Задания Цикл
			Если Строка.Ид = Ид Тогда
				Элементы.Задания.ТекущаяСтрока = Строка.ПолучитьИдентификатор();
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	ПоказатьРезультат();

КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 100
	|	З.Ид КАК Ид,
	|	З.Создано КАК Создано,
	|	З.Статус КАК Статус,
	|	З.ПробныйПрогон КАК Пробный,
	|	З.Каталог КАК Каталог,
	|	З.ПериодС КАК ПериодС,
	|	З.ПериодПо КАК ПериодПо,
	|	З.Автор КАК Автор,
	|	З.Завершено КАК Завершено
	|ИЗ
	|	РегистрСведений.рбфЗаданияАнализаТЖ КАК З
	|
	|УПОРЯДОЧИТЬ ПО
	|	Создано УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();

	Задания.Очистить();
	Пока Выборка.Следующий() Цикл
		Строка = Задания.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Выборка);
		Строка.Статус = ПредставлениеСтатуса(Выборка.Статус);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьРезультат()

	ТекущиеДанные = Элементы.Задания.ТекущиеДанные;
	ЗаполнитьРезультат(?(ТекущиеДанные = Неопределено, "", ТекущиеДанные.Ид));

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРезультат(Ид)

	Диагноз.Очистить();
	ТекстСводка = "";
	ТекстИсходныйДиагноз = "";
	ТекстОшибка = "";
	Если НЕ ЗначениеЗаполнено(Ид) Тогда
		Возврат;
	КонецЕсли;

	Запись = РегистрыСведений.рбфЗаданияАнализаТЖ.СоздатьМенеджерЗаписи();
	Запись.Ид = Ид;
	Запись.Прочитать();
	Если НЕ Запись.Выбран() Тогда
		Возврат;
	КонецЕсли;

	Сводка = ПрочитатьJSONСтроку(Запись.Сводка);
	ТекстСводка = ?(Сводка = Неопределено, Запись.Сводка, ЗаписатьJSONКрасиво(Сводка));
	ТекстИсходныйДиагноз = Запись.Диагноз;
	ТекстОшибка = Запись.Ошибка;
	Если НЕ ЗначениеЗаполнено(ТекстСводка) Тогда
		ТекстСводка = ?(Запись.Статус = "done" ИЛИ Запись.Статус = "error", "сводки нет", "задание ещё не выполнено");
	КонецЕсли;

	Проблемы = ПрочитатьJSONСтроку(Запись.Диагноз);
	Если ТипЗнч(Проблемы) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Поля = Новый Структура("Важность,Заголовок,Доказательства,Причина,Исправление,Проверка",
		"severity", "title", "evidence", "cause", "fix", "verify");
	Для Каждого Проблема Из Проблемы Цикл
		Если ТипЗнч(Проблема) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Строка = Диагноз.Добавить();
		Для Каждого Поле Из Поля Цикл
			Строка[Поле.Ключ] = ТекстЗначения(Проблема.Получить(Поле.Значение));
		КонецЦикла;
	КонецЦикла;
	Если Диагноз.Количество() > 0 Тогда
		Элементы.СтраницыРезультата.ТекущаяСтраница = Элементы.СтраницаДиагноз;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПредставлениеСтатуса(Статус)

	Если Статус = "queued" Тогда
		Возврат "В очереди";
	ИначеЕсли Статус = "running" Тогда
		Возврат "Выполняется";
	ИначеЕсли Статус = "done" Тогда
		Возврат "Готово";
	ИначеЕсли Статус = "error" Тогда
		Возврат "Ошибка";
	КонецЕсли;
	Возврат Статус;

КонецФункции

// Значение поля диагноза строкой: массив (например, список доказательств) - по строке на элемент.
&НаСервереБезКонтекста
Функция ТекстЗначения(Значение)

	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Части = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Части.Добавить(ТекстЗначения(Элемент));
		КонецЦикла;
		Возврат СтрСоединить(Части, Символы.ПС);
	ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Возврат ЗаписатьJSONКрасиво(Значение);
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьJSONСтроку(Текст)

	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Результат = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ЗаписатьJSONКрасиво(Данные)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Unix, "  "));
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти
