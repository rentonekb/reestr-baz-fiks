// Раздел «Анализ», форма «Настройка ТЖ» (компоновка как «Настройка мониторинга» 1С-Монитора):
// слева - дерево Сервер -> Кластер -> База из реестра (СерверыИБазы), справа - показатели
// выбранного узла с флажками и индикатором «записан», внизу - настройки выбранного показателя.
// У базы - показатели ТЖ, у сервера - дамп процесса. Настройки хранятся в рбфНастройкиТЖ,
// по ним ПравилаРеестраБаз.СформироватьLogcfg собирает logcfg.xml сервера.
// Изменения узла записываются кнопкой «Записать» и при переходе на другой узел.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ Пользователи.ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение НСтр("ru = 'Настраивать технологический журнал серверов могут только администраторы.'");
	КонецЕсли;
	// без выбранного узла справа пусто и кажется, что показатели не включены: раскрываем дерево
	// и сразу показываем первую базу с включённым ТЖ
	Элементы.Дерево.НачальноеОтображениеДерева = НачальноеОтображениеДерева.РаскрыватьВсеУровни;
	ПерваяБаза = ЗаполнитьДерево();
	Если ПерваяБаза = Неопределено Тогда
		ОчиститьУзел();
	Иначе
		ЗагрузитьУзел(ПерваяБаза);
		Элементы.Дерево.ТекущаяСтрока = ПерваяБаза;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДерево

&НаКлиенте
Процедура ДеревоПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("СменитьУзел", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПоказатели

&НаКлиенте
Процедура ПоказателиПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.Показатели.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Страница = Элементы.Найти(ТекущиеДанные.Страница);
	Если Страница <> Неопределено Тогда
		Элементы.СтраницыНастроек.ТекущаяСтраница = Страница;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьОбработка(Команда)

	Ошибка = СохранитьУзел();
	Если ЗначениеЗаполнено(Ошибка) Тогда
		ПоказатьПредупреждение(, Ошибка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьLogcfgОбработка(Команда)

	ИмяСервера = ИмяСервераУзла();
	Если НЕ ЗначениеЗаполнено(ИмяСервера) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите сервер или базу в дереве.'"));
		Возврат;
	КонецЕсли;
	Ошибка = СохранитьУзел();
	Если ЗначениеЗаполнено(Ошибка) Тогда
		ПоказатьПредупреждение(, Ошибка);
		Возврат;
	КонецЕсли;
	рбфАнализКлиент.ОткрытьТекст(ТекстLogcfg(ИмяСервера), "logcfg.xml для " + ИмяСервера + " (не применён)");

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьОбработка(Команда)

	ИмяСервера = ИмяСервераУзла();
	Если НЕ ЗначениеЗаполнено(ИмяСервера) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите сервер или базу в дереве.'"));
		Возврат;
	КонецЕсли;
	Ошибка = СохранитьУзел();
	Если ЗначениеЗаполнено(Ошибка) Тогда
		ПоказатьПредупреждение(, Ошибка);
		Возврат;
	КонецЕсли;

	Текст = СтрШаблон(НСтр("ru = 'Записать новый logcfg.xml на сервер %1?
		|
		|Файл заменяется целиком по показателям всех баз сервера, текущий сохраняется как logcfg.xml.bak_<дата>.
		|Включённые показатели увеличивают объём технологического журнала: проверьте место на диске
		|и глубину хранения. Платформа подхватывает новый logcfg.xml примерно за минуту.'"), ИмяСервера);
	ПоказатьВопрос(Новый ОписаниеОповещения("ПрименитьЗавершение", ЭтотОбъект, ИмяСервера), Текст,
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОбработка(Команда)

	Ошибка = СохранитьУзел();
	Если ЗначениеЗаполнено(Ошибка) Тогда
		ПоказатьПредупреждение(, Ошибка);
		Возврат;
	КонецЕсли;
	ОбновитьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПрименитьЗавершение(Ответ, ИмяСервера) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ПоказатьПредупреждение(, ПрименитьНаСервере(ИмяСервера));

КонецПроцедуры

&НаКлиенте
Процедура СменитьУзел()

	Ид = Элементы.Дерево.ТекущаяСтрока;
	Если Ид = Неопределено ИЛИ Ид = ТекущийУзел Тогда
		Возврат;
	КонецЕсли;
	Ошибка = СменитьУзелНаСервере(Ид);
	Если ЗначениеЗаполнено(Ошибка) Тогда
		// изменения прежнего узла не записались - остаёмся на нём
		Элементы.Дерево.ТекущаяСтрока = ТекущийУзел;
		ПоказатьПредупреждение(, Ошибка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ИмяСервераУзла()

	Если ТекущийВид = "Сервер" ИЛИ ТекущийВид = "Кластер" ИЛИ ТекущийВид = "База" Тогда
		Части = СтрРазделить(ТекущийСервер1С, ":", Ложь);
		Возврат ?(Части.Количество() = 0, "", СокрЛП(Части[0]));
	КонецЕсли;
	Возврат "";

КонецФункции

&НаСервере
Процедура ОбновитьНаСервере()

	ЗаполнитьДерево();
	ОчиститьУзел();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ТекстLogcfg(ИмяСервера)

	Возврат ПравилаРеестраБаз.СформироватьLogcfg(ИмяСервера);

КонецФункции

&НаСервереБезКонтекста
Функция ПрименитьНаСервере(ИмяСервера)

	Попытка
		Возврат ПравилаРеестраБаз.ПрименитьLogcfg(ИмяСервера);
	Исключение
		Возврат "Не удалось поставить запись logcfg: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

&НаСервере
Функция СменитьУзелНаСервере(Ид)

	Ошибка = СохранитьУзел();
	Если ЗначениеЗаполнено(Ошибка) Тогда
		Возврат Ошибка;
	КонецЕсли;
	ЗагрузитьУзел(Ид);
	Возврат "";

КонецФункции

// Дерево Сервер -> Кластер -> База из реестра; у базы в скобках - число включённых показателей.
//
// Возвращаемое значение:
//  Число, Неопределено - идентификатор строки первой базы с включёнными показателями.
&НаСервере
Функция ЗаполнитьДерево()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СерверыИБазы.Сервер1С.Наименование КАК Сервер1С,
	|	СерверыИБазы.ИмяБазы1С КАК ИмяБазы1С
	|ПОМЕСТИТЬ Базы
	|ИЗ
	|	РегистрСведений.СерверыИБазы КАК СерверыИБазы
	|ГДЕ
	|	СерверыИБазы.Сервер1С <> ЗНАЧЕНИЕ(Справочник.Сервер1С.ПустаяСсылка)
	|	И СерверыИБазы.ИмяБазы1С <> """"
	|	И СерверыИБазы.Тип <> ЗНАЧЕНИЕ(Перечисление.ТипБазы.Архивная)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Базы.Сервер1С КАК Сервер1С,
	|	Базы.ИмяБазы1С КАК ИмяБазы1С,
	|	ЕСТЬNULL(ВЫБОР КОГДА Н.ДолгийЗапрос ТОГДА 1 ИНАЧЕ 0 КОНЕЦ
	|		+ ВЫБОР КОГДА Н.ОжиданиеНаБлокировке1С ИЛИ Н.ОжиданиеНаБлокировкеСУБД ТОГДА 1 ИНАЧЕ 0 КОНЕЦ
	|		+ ВЫБОР КОГДА Н.Взаимоблокировка1С ИЛИ Н.ВзаимоблокировкаСУБД ТОГДА 1 ИНАЧЕ 0 КОНЕЦ
	|		+ ВЫБОР КОГДА Н.ОшибкаТЖ ТОГДА 1 ИНАЧЕ 0 КОНЕЦ
	|		+ ВЫБОР КОГДА Н.Транзакции ТОГДА 1 ИНАЧЕ 0 КОНЕЦ
	|		+ ВЫБОР КОГДА Н.СерверныйВызов ТОГДА 1 ИНАЧЕ 0 КОНЕЦ, 0) КАК Включено
	|ИЗ
	|	Базы КАК Базы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.рбфНастройкиТЖ КАК Н
	|		ПО Базы.Сервер1С = Н.Сервер1С
	|			И Базы.ИмяБазы1С = Н.ИмяБазы1С
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сервер1С,
	|	ИмяБазы1С";
	Выборка = Запрос.Выполнить().Выбрать();

	Корень = Дерево.ПолучитьЭлементы();
	Корень.Очистить();
	Серверы = Новый Соответствие; // имя компьютера -> строка дерева
	Кластеры = Новый Соответствие; // Сервер1С -> строка дерева
	ПерваяБаза = Неопределено;
	Пока Выборка.Следующий() Цикл
		Части = СтрРазделить(Выборка.Сервер1С, ":", Ложь);
		ИмяСервера = СокрЛП(Части[0]);
		Порт = ?(Части.Количество() > 1, СокрЛП(Части[1]), "1541");

		УзелСервера = Серверы.Получить(ВРег(ИмяСервера));
		Если УзелСервера = Неопределено Тогда
			УзелСервера = Корень.Добавить();
			УзелСервера.Вид = "Сервер";
			УзелСервера.Представление = ИмяСервера;
			УзелСервера.ИмяСервера = ИмяСервера;
			УзелСервера.Сервер1С = ИмяСервера;
			Серверы.Вставить(ВРег(ИмяСервера), УзелСервера);
		КонецЕсли;

		УзелКластера = Кластеры.Получить(Выборка.Сервер1С);
		Если УзелКластера = Неопределено Тогда
			УзелКластера = УзелСервера.ПолучитьЭлементы().Добавить();
			УзелКластера.Вид = "Кластер";
			УзелКластера.Представление = "Кластер " + Порт;
			УзелКластера.ИмяСервера = ИмяСервера;
			УзелКластера.Сервер1С = Выборка.Сервер1С;
			Кластеры.Вставить(Выборка.Сервер1С, УзелКластера);
		КонецЕсли;

		УзелБазы = УзелКластера.ПолучитьЭлементы().Добавить();
		УзелБазы.Вид = "База";
		УзелБазы.ИмяСервера = ИмяСервера;
		УзелБазы.Сервер1С = Выборка.Сервер1С;
		УзелБазы.ИмяБазы1С = Выборка.ИмяБазы1С;
		УзелБазы.Представление = ПредставлениеБазы(Выборка.ИмяБазы1С, Выборка.Включено);
		Если ПерваяБаза = Неопределено И Выборка.Включено > 0 Тогда
			ПерваяБаза = УзелБазы.ПолучитьИдентификатор();
		КонецЕсли;
	КонецЦикла;
	Возврат ПерваяБаза;

КонецФункции

&НаСервере
Процедура ОчиститьУзел()

	ТекущийУзел = -1;
	ТекущийВид = "";
	ТекущийСервер1С = "";
	ТекущаяБаза = "";
	ЗаголовокУзла = НСтр("ru = 'Выберите сервер или базу'");
	Показатели.Очистить();
	Элементы.ГруппаНастройкаПоказателя.Видимость = Ложь;
	Снимок = СостояниеУзла();

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьУзел(Ид)

	Узел = Дерево.НайтиПоИдентификатору(Ид);
	Если Узел = Неопределено Тогда
		ОчиститьУзел();
		Возврат;
	КонецЕсли;
	ТекущийУзел = Ид;
	ТекущийВид = Узел.Вид;
	ТекущийСервер1С = Узел.Сервер1С;
	ТекущаяБаза = Узел.ИмяБазы1С;
	Показатели.Очистить();

	Если ТекущийВид = "Кластер" Тогда
		ЗаголовокУзла = Узел.Сервер1С + НСтр("ru = ': выберите базу кластера или сервер'");
		Элементы.ГруппаНастройкаПоказателя.Видимость = Ложь;
		Снимок = СостояниеУзла();
		Возврат;
	КонецЕсли;

	Запись = РегистрыСведений.рбфНастройкиТЖ.СоздатьМенеджерЗаписи();
	Запись.Сервер1С = ТекущийСервер1С;
	Запись.ИмяБазы1С = ТекущаяБаза;
	Запись.Прочитать();

	Элементы.ГруппаНастройкаПоказателя.Видимость = Истина;
	КаталогЛогов = Запись.КаталогЛогов;
	Если ТекущийВид = "Сервер" Тогда
		ЗаголовокУзла = СтрШаблон(НСтр("ru = 'Сервер %1: logcfg.xml собирается по всем базам сервера; каталог - для дампов'"),
			ТекущийСервер1С);
		ДобавитьПоказатель("ДампПроцесса", НСтр("ru = 'Дамп процесса'"), Запись.ДампПроцесса, "СтраницаБезНастроек");
		Элементы.Глубина.Видимость = Ложь;
	Иначе
		ЗаголовокУзла = ТекущаяБаза + " (" + ТекущийСервер1С + ")";
		ДобавитьПоказатель("ДолгийЗапрос", НСтр("ru = 'Долгий запрос'"), Запись.ДолгийЗапрос, "СтраницаДолгийЗапрос");
		ДобавитьПоказатель("ОжиданиеНаБлокировке", НСтр("ru = 'Ожидание на блокировке'"),
			Запись.ОжиданиеНаБлокировке1С ИЛИ Запись.ОжиданиеНаБлокировкеСУБД, "СтраницаОжидание");
		ДобавитьПоказатель("Взаимоблокировка", НСтр("ru = 'Взаимоблокировка'"),
			Запись.Взаимоблокировка1С ИЛИ Запись.ВзаимоблокировкаСУБД, "СтраницаВзаимоблокировка");
		ДобавитьПоказатель("ОшибкаТЖ", НСтр("ru = 'Ошибка ТЖ'"), Запись.ОшибкаТЖ, "СтраницаБезНастроек");
		ДобавитьПоказатель("Транзакции", НСтр("ru = 'Транзакции'"), Запись.Транзакции, "СтраницаБезНастроек");
		ДобавитьПоказатель("СерверныйВызов", НСтр("ru = 'Серверный вызов'"), Запись.СерверныйВызов, "СтраницаСерверныйВызов");
		Элементы.Глубина.Видимость = Истина;
	КонецЕсли;

	// значения по умолчанию для ещё не включённых показателей - как у Монитора: запросы от 5 с, глубина 2 ч
	ДолгийЗапросПорог = ?(Запись.ДолгийЗапросПорог > 0, Запись.ДолгийЗапросПорог, 5);
	СерверныйВызовПорог = ?(Запись.СерверныйВызовПорог > 0, Запись.СерверныйВызовПорог, 5);
	ОжиданиеНаБлокировке1С = Запись.ОжиданиеНаБлокировке1С;
	ОжиданиеНаБлокировкеСУБД = Запись.ОжиданиеНаБлокировкеСУБД;
	Взаимоблокировка1С = Запись.Взаимоблокировка1С;
	ВзаимоблокировкаСУБД = Запись.ВзаимоблокировкаСУБД;
	Глубина = ?(Запись.Глубина > 0, Запись.Глубина, 2);
	Снимок = СостояниеУзла();

КонецПроцедуры

&НаСервере
Процедура ДобавитьПоказатель(Имя, Представление, Включён, Страница)

	Строка = Показатели.Добавить();
	Строка.Имя = Имя;
	Строка.Показатель = Представление;
	Строка.Пометка = Включён;
	Строка.Индикатор = ?(Включён, "●", "");
	Строка.Страница = Страница;

КонецПроцедуры

// Записывает настройки выбранного узла, если они изменились после загрузки.
//
// Возвращаемое значение:
//  Строка - текст ошибки записи или пустая строка.
&НаСервере
Функция СохранитьУзел()

	Если (ТекущийВид <> "Сервер" И ТекущийВид <> "База") ИЛИ СостояниеУзла() = Снимок Тогда
		Возврат "";
	КонецЕсли;

	Запись = РегистрыСведений.рбфНастройкиТЖ.СоздатьМенеджерЗаписи();
	Запись.Сервер1С = ТекущийСервер1С;
	Запись.ИмяБазы1С = ТекущаяБаза;
	Запись.Прочитать();
	Запись.Сервер1С = ТекущийСервер1С;
	Запись.ИмяБазы1С = ТекущаяБаза;
	Запись.КаталогЛогов = СокрЛП(КаталогЛогов);

	Если ТекущийВид = "Сервер" Тогда
		Запись.ДампПроцесса = Пометка("ДампПроцесса");
	Иначе
		// отмеченный показатель блокировок без выбранного вида включает вид 1С
		Ожидание = Пометка("ОжиданиеНаБлокировке");
		Если Ожидание И НЕ ОжиданиеНаБлокировке1С И НЕ ОжиданиеНаБлокировкеСУБД Тогда
			ОжиданиеНаБлокировке1С = Истина;
		КонецЕсли;
		Взаимоблокировка = Пометка("Взаимоблокировка");
		Если Взаимоблокировка И НЕ Взаимоблокировка1С И НЕ ВзаимоблокировкаСУБД Тогда
			Взаимоблокировка1С = Истина;
		КонецЕсли;
		Запись.ДолгийЗапрос = Пометка("ДолгийЗапрос");
		Запись.ДолгийЗапросПорог = ДолгийЗапросПорог;
		Запись.ОжиданиеНаБлокировке1С = Ожидание И ОжиданиеНаБлокировке1С;
		Запись.ОжиданиеНаБлокировкеСУБД = Ожидание И ОжиданиеНаБлокировкеСУБД;
		Запись.Взаимоблокировка1С = Взаимоблокировка И Взаимоблокировка1С;
		Запись.ВзаимоблокировкаСУБД = Взаимоблокировка И ВзаимоблокировкаСУБД;
		Запись.ОшибкаТЖ = Пометка("ОшибкаТЖ");
		Запись.Транзакции = Пометка("Транзакции");
		Запись.СерверныйВызов = Пометка("СерверныйВызов");
		Запись.СерверныйВызовПорог = СерверныйВызовПорог;
		Запись.Глубина = Глубина;
	КонецЕсли;
	Запись.Изменено = ТекущаяДатаСеанса();
	Запись.Автор = Лев(ИмяПользователя(), 100);

	Попытка
		Запись.Записать();
	Исключение
		Возврат НСтр("ru = 'Настройки не записаны: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Включено = 0;
	Для Каждого Строка Из Показатели Цикл
		Строка.Индикатор = ?(Строка.Пометка, "●", "");
		Включено = Включено + ?(Строка.Пометка, 1, 0);
	КонецЦикла;
	Если ТекущийВид = "База" Тогда
		Узел = Дерево.НайтиПоИдентификатору(ТекущийУзел);
		Если Узел <> Неопределено Тогда
			Узел.Представление = ПредставлениеБазы(ТекущаяБаза, Включено);
		КонецЕсли;
	КонецЕсли;
	Снимок = СостояниеУзла();
	Возврат "";

КонецФункции

&НаСервере
Функция Пометка(Имя)

	Для Каждого Строка Из Показатели Цикл
		Если Строка.Имя = Имя Тогда
			Возврат Строка.Пометка;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Строка со всеми редактируемыми значениями узла - для проверки, были ли изменения.
&НаСервере
Функция СостояниеУзла()

	Части = Новый Массив;
	Для Каждого Показатель Из Показатели Цикл
		Части.Добавить(Показатель.Имя + "=" + Строка(Показатель.Пометка));
	КонецЦикла;
	Части.Добавить(Строка(ДолгийЗапросПорог));
	Части.Добавить(Строка(ОжиданиеНаБлокировке1С));
	Части.Добавить(Строка(ОжиданиеНаБлокировкеСУБД));
	Части.Добавить(Строка(Взаимоблокировка1С));
	Части.Добавить(Строка(ВзаимоблокировкаСУБД));
	Части.Добавить(Строка(СерверныйВызовПорог));
	Части.Добавить(СокрЛП(КаталогЛогов));
	Части.Добавить(Строка(Глубина));
	Возврат СтрСоединить(Части, "|");

КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеБазы(ИмяБазы1С, Включено)

	Возврат ИмяБазы1С + ?(Включено > 0, " (" + Включено + ")", "");

КонецФункции

#КонецОбласти
