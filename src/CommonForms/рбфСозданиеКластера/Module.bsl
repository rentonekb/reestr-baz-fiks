#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Сведения = рбфКластеры1С.Сведения();
	Для Каждого Версия Из Сведения.Версии Цикл
		Элементы.ВерсияПлатформы.СписокВыбора.Добавить(Версия);
	КонецЦикла;
	Если Сведения.Версии.Количество() > 0 Тогда
		ВерсияПлатформы = Сведения.Версии[0];
	КонецЕсли;
	ПортАгента = Сведения.СвободныйПорт;
	ПоказатьСостояниеПароля(Сведения.ПарольСохранён);
	Результат = Сведения.Текст;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьОбработка(Команда)

	Результат = ПроверитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СохранитьПарольОбработка(Команда)

	Если НЕ ЗначениеЗаполнено(Пароль) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Введите пароль AL\service.1c.'"));
		Возврат;
	КонецЕсли;
	СохранитьПарольНаСервере();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Пароль сохранён'"), ,
		НСтр("ru = 'Пароль AL\service.1c сохранён в безопасном хранилище.'"));

КонецПроцедуры

&НаКлиенте
Процедура СоздатьОбработка(Команда)

	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите имя кластера.'"));
		Возврат;
	КонецЕсли;
	Текст = СтрШаблон(НСтр("ru = 'Создать кластер «%1» (%2, порт агента %3) на S2019 и 88.63?'"),
		Имя, ВерсияПлатформы, Формат(ПортАгента, "ЧГ=0"));
	ПоказатьВопрос(Новый ОписаниеОповещения("СоздатьПослеВопроса", ЭтотОбъект), Текст, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьПослеВопроса(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Состояние(НСтр("ru = 'Создаются службы и кластер, это занимает 1-3 минуты...'"));
	Результат = СоздатьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПроверитьНаСервере()

	Возврат рбфКластеры1С.Проверить(Имя, ВерсияПлатформы, ПортАгента);

КонецФункции

&НаСервере
Функция СоздатьНаСервере()

	Если ЗначениеЗаполнено(Пароль) Тогда
		рбфКластеры1С.СохранитьПароль(Пароль);
		Пароль = "";
		ПоказатьСостояниеПароля(Истина);
	КонецЕсли;
	Возврат рбфКластеры1С.Создать(Имя, ВерсияПлатформы, ПортАгента);

КонецФункции

&НаСервере
Процедура СохранитьПарольНаСервере()

	рбфКластеры1С.СохранитьПароль(Пароль);
	Пароль = "";
	ПоказатьСостояниеПароля(Истина);

КонецПроцедуры

&НаСервере
Процедура ПоказатьСостояниеПароля(ПарольСохранён)

	Элементы.Пароль.ПодсказкаВвода = ?(ПарольСохранён,
		НСтр("ru = 'сохранён в безопасном хранилище, вводить не нужно'"),
		НСтр("ru = 'пароль AL\service.1c: сохранится в безопасном хранилище'"));

КонецПроцедуры

#КонецОбласти
