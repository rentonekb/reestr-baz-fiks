// Раздел «Анализ», страница «Найти ошибку»: вставляете в поле текст ошибки или его
// фрагмент (Ctrl+V) и нажимаете «Найти». Форма выделяет из текста ключи (имя файла,
// текст после «по причине», фразы в кавычках) и ищет их в сырых событиях ТЖ
// (рбфВыполненияТЖ) за период шапки; если там пусто - в почасовой сводке (рбфСобытияТЖ).
// В результатах - база, пользователь, компьютер, время; в подробностях - полный текст.
// «Разобрать в ИИ» ставит в очередь рбфЗаданияАнализаТЖ разбор часа найденного события.

#Область ОписаниеПеременных

// Ид строки, подробности которой уже получены: после серверного вызова платформа
// снова активизирует текущую строку, и без этой проверки форма звала бы сервер бесконечно.
&НаКлиенте
Перем ПоказаннаяСтрока;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	рбфАнализСервер.ЗаполнитьШапку(ЭтотОбъект);
	// ошибку ищут не за три часа, а за сутки: она могла случиться вчера
	ВидПериода = "Произвольный интервал";
	Сейчас = ТекущаяДатаСеанса();
	НачалоПериода = Сейчас - 24 * 3600;
	КонецПериода = Сейчас;
	// «Текст содержит» в доп. фильтре ищет по точке контекста, а не по описанию ошибки:
	// для поиска по описанию у формы своё поле
	ТекстСодержит = "";
	рбфАнализСервер.Отбор(ЭтотОбъект);
	ТекстПодробности = "Вставьте текст ошибки или его фрагмент (Ctrl+V) и нажмите «Найти».";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Подключается программно в рбфАнализСервер.ЗаполнитьШапку: выбор базы или сервера
// сразу повторяет поиск тем же текстом.
&НаКлиенте
Процедура БазаПриИзменении(Элемент)

	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		НайтиОбработка(Неопределено);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРезультаты

&НаКлиенте
Процедура РезультатыПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьПодробности", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НайтиОбработка(Команда)

	НайтиНаСервере();
	ПоказаннаяСтрока = Неопределено;
	ПоказатьПодробности();

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОбработка(Команда)

	ТекстОшибки = "";
	Результаты.Очистить();
	ФрагментыПоиска = "";
	ТекстПодробности = "";

КонецПроцедуры

&НаКлиенте
Процедура РазобратьИИОбработка(Команда)

	ПоказатьПредупреждение(, ПоставитьАнализНаСервере());

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодОбработка(Команда)

	рбфАнализКлиент.ВыбратьПериод(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ДопФильтрОбработка(Команда)

	рбфАнализКлиент.ПереключитьДопФильтр(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПоказатьПодробности()

	ТекущиеДанные = Элементы.Результаты.ТекущиеДанные;
	Ключ = ?(ТекущиеДанные = Неопределено, Неопределено, ТекущиеДанные.ПолучитьИдентификатор());
	Если Ключ = ПоказаннаяСтрока Тогда
		Возврат;
	КонецЕсли;
	ПоказаннаяСтрока = Ключ;
	ЗаполнитьПодробности(Ключ);

КонецПроцедуры

&НаСервере
Процедура НайтиНаСервере()

	Результаты.Очистить();
	ФрагментыПоиска = "";
	Текст = СокрЛП(ТекстОшибки);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		ТекстПодробности = "Вставьте текст ошибки или его фрагмент и нажмите «Найти».";
		Возврат;
	КонецЕсли;

	Отбор = рбфАнализСервер.Отбор(ЭтотОбъект);
	Поиск = рбфАнализСервер.НайтиСобытияОшибки(Отбор, Текст, 200);
	ФрагментыПоиска = Поиск.Фрагменты;
	ТекстПодробности = Поиск.Итог;
	Если ЗначениеЗаполнено(Поиск.Ошибка) Тогда
		ТекстПодробности = Поиск.Ошибка;
		Возврат;
	КонецЕсли;
	Результаты.Загрузить(Поиск.Найденные);
	Если Результаты.Количество() > 0 Тогда
		Элементы.Результаты.ТекущаяСтрока = Результаты[0].ПолучитьИдентификатор();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодробности(ИдентификаторСтроки)

	Если ИдентификаторСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Строка = Результаты.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекстПодробности = рбфАнализСервер.ПодробностиСобытияОшибки(Строка.Источник, Строка.Ид, Строка.Пример);

КонецПроцедуры

&НаСервере
Функция ПоставитьАнализНаСервере()

	ТекущиеДанные = Элементы.Результаты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат "Сначала найдите ошибку: разбор ставится по найденному событию.";
	КонецЕсли;
	Каталог = ПравилаРеестраБаз.Настройка("КаталогТЖДляАнализа", "");
	Если НЕ ЗначениеЗаполнено(Каталог) Тогда
		Каталог = ПравилаРеестраБаз.КаталогТЖАгентаПоУмолчанию(ТекущиеДанные.Сервер);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Каталог) Тогда
		Возврат "Не задан каталог ТЖ: заполните его на странице «Настройки мониторинга».";
	КонецЕсли;
	Попытка
		Ид = ПравилаРеестраБаз.ПоставитьАнализТЖ(СокрЛП(Каталог), ТекущиеДанные.Время - 3600,
			ТекущиеДанные.Время + 3600, Ложь, ИмяПользователя());
	Исключение
		Возврат "Задание не поставлено: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат "Задание поставлено в очередь: разбор часа с найденным событием."
		+ " Результат появится на странице «ИИ-анализ ТЖ» (Ид " + Лев(Ид, 8) + ").";

КонецФункции

#КонецОбласти
