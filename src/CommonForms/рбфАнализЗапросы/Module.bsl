// Раздел «Анализ», страница «Запросы»: компоновка как у 1С-Монитора.
// Слева - группы запросов по ключу агента (контекст / текст запроса) с долей суммарной
// длительности, справа - выполнения выбранной группы по часам, внизу - подробности
// выбранного выполнения из примера события ТЖ. Агрегаты почасовые, поэтому «дата
// выполнения» - час, а пользователь и тексты берутся из примера за этот час.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	рбфАнализСервер.ЗаполнитьШапку(ЭтотОбъект);
	ОбновитьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыГруппы

&НаКлиенте
Процедура ГруппыПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьВыполнения", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыВыполнения

&НаКлиенте
Процедура ВыполненияПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьПодробности", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьОбработка(Команда)

	ОбновитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодОбработка(Команда)

	рбфАнализКлиент.ВыбратьПериод(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ДопФильтрОбработка(Команда)

	рбфАнализКлиент.ПереключитьДопФильтр(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВОкнеОбработка(Команда)

	Страница = Элементы.СтраницыПодробностей.ТекущаяСтраница;
	ИмяРеквизита = СтрЗаменить(Страница.Имя, "Страница", "Текст");
	рбфАнализКлиент.ОткрытьТекст(ЭтотОбъект[ИмяРеквизита], Страница.Заголовок);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПоказатьВыполнения()

	ТекущиеДанные = Элементы.Группы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьВыполнения(ТекущиеДанные.КлючХеш, ТекущиеДанные.Событие);
	ПоказатьПодробности();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПодробности()

	ТекущиеДанные = Элементы.Выполнения.ТекущиеДанные;
	ЗаполнитьПодробности(?(ТекущиеДанные = Неопределено, Неопределено, ТекущиеДанные.ПолучитьИдентификатор()));

КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере()

	Отбор = рбфАнализСервер.Отбор(ЭтотОбъект);
	Запрос = Новый Запрос;
	Условие = рбфАнализСервер.УсловиеОтбораТЖ(Запрос, Отбор, СобытияЗапросов());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.КлючХеш КАК КлючХеш,
	|	Т.Событие КАК Событие,
	|	Т.Ключ КАК Ключ,
	|	СУММА(Т.Количество) КАК Кол,
	|	СУММА(Т.ДлительностьСуммаМс) / 1000 КАК Сек
	|ИЗ
	|	РегистрСведений.рбфСобытияТЖ КАК Т
	|ГДЕ
	|	" + Условие + "
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.КлючХеш,
	|	Т.Событие,
	|	Т.Ключ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сек УБЫВ";
	Таблица = Запрос.Выполнить().Выгрузить();
	Всего = Таблица.Итог("Сек");

	Группы.Очистить();
	Для Каждого Строка Из Таблица Цикл
		НоваяСтрока = Группы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.Доля = ?(Всего = 0, 0, Окр(Строка.Сек * 100 / Всего, 1));
	КонецЦикла;

	Если Группы.Количество() > 0 Тогда
		ЗаполнитьВыполнения(Группы[0].КлючХеш, Группы[0].Событие);
	Иначе
		Выполнения.Очистить();
	КонецЕсли;
	ЗаполнитьПодробности(?(Выполнения.Количество() = 0, Неопределено, Выполнения[0].ПолучитьИдентификатор()));

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВыполнения(КлючХеш, Событие)

	Отбор = рбфАнализСервер.Отбор(ЭтотОбъект);
	Запрос = Новый Запрос;
	Условие = рбфАнализСервер.УсловиеОтбораТЖ(Запрос, Отбор, СобытияЗапросов());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Час КАК Дата,
	|	Т.Сервер КАК Сервер,
	|	Т.База КАК База,
	|	Т.Событие КАК Событие,
	|	Т.Ключ КАК Ключ,
	|	Т.Количество КАК Кол,
	|	Т.ДлительностьМаксМс / 1000 КАК Сек,
	|	Т.ДлительностьСуммаМс / 1000 КАК СекВсего,
	|	Т.Пример КАК Пример
	|ИЗ
	|	РегистрСведений.рбфСобытияТЖ КАК Т
	|ГДЕ
	|	" + Условие + "
	|	И Т.КлючХеш = &КлючХеш
	|	И Т.Событие = &Событие
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сек УБЫВ";
	Запрос.УстановитьПараметр("КлючХеш", КлючХеш);
	Запрос.УстановитьПараметр("Событие", Событие);
	Выборка = Запрос.Выполнить().Выбрать();

	Выполнения.Очистить();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Выполнения.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		Свойства = рбфАнализСервер.СвойстваСобытияТЖ(Выборка.Пример);
		НоваяСтрока.Пользователь = рбфАнализСервер.ЗначениеСвойства(Свойства, "Usr");
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодробности(ИдентификаторСтроки)

	Строка = ?(ИдентификаторСтроки = Неопределено, Неопределено, Выполнения.НайтиПоИдентификатору(ИдентификаторСтроки));
	ТекстПлан = рбфАнализСервер.НетДанных();
	ТекстРекомендации = рбфАнализСервер.НетДанных();
	Если Строка = Неопределено Тогда
		ТекстКонтекст = "";
		ТекстSQL = "";
		Текст1С = "";
		ТекстПараметры = "";
		ТекстСведения = "";
		Возврат;
	КонецЕсли;

	Свойства = рбфАнализСервер.СвойстваСобытияТЖ(Строка.Пример);
	ЭтоSDBL = (Строка.Событие = "SDBL");

	ТекстКонтекст = рбфАнализСервер.ИлиНетДанных(рбфАнализСервер.ЗначениеСвойства(Свойства, "Context"));

	// ключ агента для DBMSSQL - текст запроса СУБД, для SDBL - текст запроса 1С
	ТекстЗапроса = рбфАнализСервер.ЗначениеСвойства(Свойства, ?(ЭтоSDBL, "Sdbl", "Sql"));
	Если НЕ ЗначениеЗаполнено(ТекстЗапроса) И НЕ ЗначениеЗаполнено(Свойства.Получить("Context")) Тогда
		ТекстЗапроса = Строка.Ключ;
	КонецЕсли;
	ТекстSQL = рбфАнализСервер.ИлиНетДанных(?(ЭтоSDBL, "", ТекстЗапроса));
	Текст1С = рбфАнализСервер.ИлиНетДанных(?(ЭтоSDBL, ТекстЗапроса, ""));
	ТекстПараметры = рбфАнализСервер.ИлиНетДанных(
		рбфАнализСервер.ПараметрыЗапросаSQL(рбфАнализСервер.ЗначениеСвойства(Свойства, "Sql")));

	Сведения = Новый Массив;
	Сведения.Добавить("Сервер = " + Строка.Сервер);
	Сведения.Добавить("База = " + Строка.База);
	Сведения.Добавить("Событие = " + Строка.Событие);
	Сведения.Добавить("Час = " + Формат(Строка.Дата, "ДФ='dd.MM.yyyy HH:mm'"));
	Сведения.Добавить("Выполнений за час = " + Строка.Кол);
	Сведения.Добавить("Длительность макс, с = " + Строка.Сек);
	Сведения.Добавить("Длительность сумма, с = " + Строка.СекВсего);
	Сведения.Добавить("Ключ группы = " + Строка.Ключ);
	Свойство = рбфАнализСервер.ПредставлениеСвойств(Свойства, "Context,Sql,Sdbl");
	Если ЗначениеЗаполнено(Свойство) Тогда
		Сведения.Добавить("");
		Сведения.Добавить("Пример события за час:");
		Сведения.Добавить(Свойство);
	ИначеЕсли ЗначениеЗаполнено(Строка.Пример) Тогда
		Сведения.Добавить("");
		Сведения.Добавить("Пример события за час:");
		Сведения.Добавить(Строка.Пример);
	КонецЕсли;
	ТекстСведения = СтрСоединить(Сведения, Символы.ПС);

КонецПроцедуры

&НаСервереБезКонтекста
Функция СобытияЗапросов()

	События = Новый Массив;
	События.Добавить("DBMSSQL");
	События.Добавить("DBPOSTGRS");
	События.Добавить("SDBL");
	Возврат События;

КонецФункции

#КонецОбласти
