// Раздел «Анализ», страница «Запросы»: компоновка как у 1С-Монитора, данные - отдельные события ТЖ
// (рбфВыполненияТЖ). Слева - запросы, сгруппированные по шаблону (литералы и параметры заменены),
// с точкой входа контекста и текстом запроса на языке 1С; служебные запросы платформы скрыты.
// Справа - выполнения выбранного шаблона с пользователем и сеансом, внизу - весь стек контекста,
// запрос 1С, SQL и сведения; «Найти в журнале регистрации» - отбор ЖР по сеансу и времени.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	рбфАнализСервер.ЗаполнитьШапку(ЭтотОбъект);
	ОбновитьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыГруппы

&НаКлиенте
Процедура ГруппыПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьВыполнения", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыВыполнения

&НаКлиенте
Процедура ВыполненияПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьПодробности", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьОбработка(Команда)

	ОбновитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодОбработка(Команда)

	рбфАнализКлиент.ВыбратьПериод(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ДопФильтрОбработка(Команда)

	рбфАнализКлиент.ПереключитьДопФильтр(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВОкнеОбработка(Команда)

	Страница = Элементы.СтраницыПодробностей.ТекущаяСтраница;
	ИмяРеквизита = СтрЗаменить(Страница.Имя, "Страница", "Текст");
	рбфАнализКлиент.ОткрытьТекст(ЭтотОбъект[ИмяРеквизита], Страница.Заголовок);

КонецПроцедуры

&НаКлиенте
Процедура НайтиВЖурналеОбработка(Команда)

	ТекущиеДанные = Элементы.Выполнения.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите выполнение запроса.'"));
		Возврат;
	КонецЕсли;
	Отбор = ОтборЖурнала(ТекущиеДанные.Ид);
	Если Отбор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	рбфАнализКлиент.НайтиВЖурналеРегистрации(Отбор);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПоказатьВыполнения()

	ТекущиеДанные = Элементы.Группы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьВыполнения(ТекущиеДанные.ШаблонХеш, ТекущиеДанные.Событие, ТекущиеДанные.База);
	ПоказатьПодробности();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПодробности()

	ТекущиеДанные = Элементы.Выполнения.ТекущиеДанные;
	ЗаполнитьПодробности(?(ТекущиеДанные = Неопределено, "", ТекущиеДанные.Ид));

КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере()

	Отбор = рбфАнализСервер.Отбор(ЭтотОбъект);
	Запрос = Новый Запрос;
	Условие = рбфАнализСервер.УсловиеОтбораВыполнений(Запрос, Отбор, СобытияЗапросов());
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 500
	|	Т.ШаблонХеш КАК ШаблонХеш,
	|	Т.Событие КАК Событие,
	|	Т.База КАК База,
	|	КОЛИЧЕСТВО(*) КАК Кол,
	|	СУММА(Т.ДлительностьМс) / 1000 КАК Сек,
	|	МАКСИМУМ(Т.ДлительностьМс) / 1000 КАК МаксСек,
	|	МАКСИМУМ(Т.Ид) КАК ИдПримера
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	" + Условие + "
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.ШаблонХеш,
	|	Т.Событие,
	|	Т.База
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сек УБЫВ";
	Таблица = Запрос.Выполнить().Выгрузить();
	Всего = Таблица.Итог("Сек");

	// пример каждого шаблона: точка входа контекста и начало запроса 1С
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ид КАК Ид,
	|	Т.КонтекстТочка КАК КонтекстТочка,
	|	ПОДСТРОКА(Т.ТекстЗапроса1С, 1, 300) КАК Запрос1С,
	|	ПОДСТРОКА(Т.ТекстSQL, 1, 300) КАК ТекстSQL
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	Т.Ид В(&Идентификаторы)";
	Запрос.УстановитьПараметр("Идентификаторы", Таблица.ВыгрузитьКолонку("ИдПримера"));
	Примеры = Запрос.Выполнить().Выгрузить();
	Примеры.Индексы.Добавить("Ид");

	Группы.Очистить();
	Для Каждого Строка Из Таблица Цикл
		НоваяСтрока = Группы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.Доля = ?(Всего = 0, 0, Окр(Строка.Сек * 100 / Всего, 1));
		Пример = Примеры.Найти(Строка.ИдПримера, "Ид");
		Если Пример <> Неопределено Тогда
			НоваяСтрока.КонтекстТочка = Пример.КонтекстТочка;
			НоваяСтрока.Запрос1С = ОднойСтрокой(?(ЗначениеЗаполнено(Пример.Запрос1С), Пример.Запрос1С,
				"SQL: " + Пример.ТекстSQL));
		КонецЕсли;
	КонецЦикла;

	СостояниеДанных = "";
	Если Группы.Количество() = 0 Тогда
		СостояниеДанных = ТекстНетСобытий();
	КонецЕсли;
	Элементы.СостояниеДанных.Видимость = ЗначениеЗаполнено(СостояниеДанных);

	Если Группы.Количество() > 0 Тогда
		ЗаполнитьВыполнения(Группы[0].ШаблонХеш, Группы[0].Событие, Группы[0].База);
	Иначе
		Выполнения.Очистить();
	КонецЕсли;
	ЗаполнитьПодробности(?(Выполнения.Количество() = 0, "", Выполнения[0].Ид));

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВыполнения(ШаблонХеш, Событие, База)

	Отбор = рбфАнализСервер.Отбор(ЭтотОбъект);
	Запрос = Новый Запрос;
	Условие = рбфАнализСервер.УсловиеОтбораВыполнений(Запрос, Отбор, СобытияЗапросов());
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 500
	|	Т.Ид КАК Ид,
	|	Т.ДлительностьМс / 1000 КАК Сек,
	|	Т.Время КАК Время,
	|	Т.Пользователь КАК Пользователь,
	|	Т.СеансИд КАК Сеанс,
	|	Т.Строк КАК Строк
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	" + Условие + "
	|	И Т.ШаблонХеш = &ШаблонХеш
	|	И Т.Событие = &Событие
	|	И Т.База = &База
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сек УБЫВ";
	Запрос.УстановитьПараметр("ШаблонХеш", ШаблонХеш);
	Запрос.УстановитьПараметр("Событие", Событие);
	Запрос.УстановитьПараметр("База", База);
	Выполнения.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодробности(Ид)

	Данные = ?(ЗначениеЗаполнено(Ид), рбфСобытияТЖСервер.ДанныеСобытия(Ид), Неопределено);
	Если Данные = Неопределено Тогда
		ТекстКонтекст = "";
		ТекстЗапрос1С = "";
		ТекстSQL = "";
		ТекстСведения = "";
		Возврат;
	КонецЕсли;

	ТекстКонтекст = ИлиПояснение(Данные.КонтекстПолный,
		НСтр("ru = 'Контекста нет: запрос выполнялся вне кода конфигурации (служебный запрос платформы) или свойство Context не пишется в ТЖ.'"));
	Если ЗначениеЗаполнено(Данные.ТекстЗапроса1С) Тогда
		ТекстЗапрос1С = Данные.ТекстЗапроса1С;
	ИначеЕсли Данные.Событие = "SDBL" Тогда
		ТекстЗапрос1С = НСтр("ru = 'Свойство Sdbl не пришло: включите его в logcfg («Настройка ТЖ», долгий запрос).'");
	Иначе
		ТекстЗапрос1С = СтрШаблон(НСтр("ru = 'Нет карты имён таблиц базы «%1»: загрузите её через rbf-admin/tj-storage (см. docs/tj-events-schema.md). До этого смотрите страницу SQL.'"),
			Данные.База);
	КонецЕсли;
	ТекстSQL = ИлиПояснение(Данные.ТекстSQL, НСтр("ru = 'Для события SDBL текста SQL нет, см. «Запрос 1С».'"));

	Сведения = Новый Массив;
	Сведения.Добавить("Сервер: " + Данные.Сервер + ", база: " + Данные.База);
	Сведения.Добавить("Событие: " + Данные.Событие + ?(ЗначениеЗаполнено(Данные.ФункцияSDBL), " (" + Данные.ФункцияSDBL + ")", ""));
	Сведения.Добавить("Окончание: " + Формат(Данные.Время, "ДФ='dd.MM.yyyy HH:mm:ss'") + ", длительность "
		+ Формат(Данные.ДлительностьМс / 1000, "ЧДЦ=3; ЧН=0") + " с");
	Сведения.Добавить("Пользователь: " + Данные.Пользователь);
	Сведения.Добавить("Сеанс (SessionID): " + Формат(Данные.СеансИд, "ЧГ=; ЧН=-"));
	Сведения.Добавить("Соединение (t:connectID): " + Формат(Данные.СоединениеИд, "ЧГ=; ЧН=-")
		+ ", клиент (t:clientID): " + Формат(Данные.КлиентИд, "ЧГ=; ЧН=-"));
	Сведения.Добавить("Приложение: " + Данные.Приложение + ", компьютер: " + Данные.Компьютер);
	Сведения.Добавить("Процесс СУБД (dbpid): " + Формат(Данные.ПроцессСУБД, "ЧГ=; ЧН=-")
		+ ", в транзакции (trans): " + Данные.Транзакция + ", строк: " + Формат(Данные.Строк, "ЧГ=; ЧН=0"));
	Сведения.Добавить("Точка входа: " + Данные.КонтекстТочка);
	Сведения.Добавить("Где выполнялось: " + Данные.КонтекстСтрока);
	Сведения.Добавить("");
	Сведения.Добавить(рбфСобытияТЖСервер.ОтборЖурналаРегистрации(Данные).Текст);
	ТекстСведения = СтрСоединить(Сведения, Символы.ПС);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтборЖурнала(Ид)

	Данные = рбфСобытияТЖСервер.ДанныеСобытия(Ид);
	Если Данные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат рбфСобытияТЖСервер.ОтборЖурналаРегистрации(Данные);

КонецФункции

&НаСервереБезКонтекста
Функция ИлиПояснение(Значение, Пояснение)

	Возврат ?(ЗначениеЗаполнено(Значение), Значение, Пояснение);

КонецФункции

&НаСервереБезКонтекста
Функция ОднойСтрокой(Текст)

	Результат = СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, Символы.ВК, " "), Символы.ПС, " "), Символы.Таб, " ");
	Пока СтрНайти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;
	Возврат СокрЛП(Результат);

КонецФункции

&НаСервереБезКонтекста
Функция ТекстНетСобытий()

	Возврат НСтр("ru = 'Детальных событий ТЖ за период нет. Их присылает tj-analyzer (export-events) или агент через rbf-admin/tj-events (docs/tj-events-schema.md); в «Настройка ТЖ» у базы должен быть включён долгий запрос.'");

КонецФункции

&НаСервереБезКонтекста
Функция СобытияЗапросов()

	События = Новый Массив;
	События.Добавить("DBMSSQL");
	События.Добавить("DBPOSTGRS");
	События.Добавить("SDBL");
	Возврат События;

КонецФункции

#КонецОбласти
