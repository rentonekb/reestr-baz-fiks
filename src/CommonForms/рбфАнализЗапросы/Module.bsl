// Раздел «Анализ», страница «Запросы»: компоновка как у 1С-Монитора по отдельным событиям ТЖ
// (рбфВыполненияТЖ). Слева - группы по шаблону запроса (ШаблонХеш) с долей суммарной длительности,
// справа - выполнения выбранной группы, внизу - контекст, запрос 1С, SQL и сведения выбранного
// выполнения. Служебные запросы платформы (НастройкиВыполненийТЖ().СлужебныеЗапросы) не показываются.
// Флаг «серверные вызовы (CALL)» переключает левую таблицу на топ-25 CALL/SCALL по последней строке
// контекста (ИТС 5906) с сортировкой по Σ длительности, Σ CpuTime или Σ MemoryPeak.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ТекущаяБаза = рбфАнализСервер.ИмяТекущейИнформационнойБазы();
	рбфАнализСервер.ЗаполнитьШапку(ЭтотОбъект);
	СписокПорядка = Элементы.ПорядокВызовов.СписокВыбора;
	СписокПорядка.Добавить("Длительность", "Σ длительности");
	СписокПорядка.Добавить("ЦП", "Σ CpuTime");
	СписокПорядка.Добавить("Память", "Σ MemoryPeak");
	Элементы.ПорядокВызовов.РежимВыбораИзСписка = Истина;
	ПорядокВызовов = "Длительность";
	ДобавитьКолонкуСостояние();
	ОбновитьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыГруппы

&НаКлиенте
Процедура ГруппыПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьВыполнения", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыВыполнения

&НаКлиенте
Процедура ВыполненияПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьПодробности", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьОбработка(Команда)

	ОбновитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодОбработка(Команда)

	рбфАнализКлиент.ВыбратьПериод(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ДопФильтрОбработка(Команда)

	рбфАнализКлиент.ПереключитьДопФильтр(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВОкнеОбработка(Команда)

	Страница = Элементы.СтраницыПодробностей.ТекущаяСтраница;
	ИмяРеквизита = СтрЗаменить(Страница.Имя, "Страница", "Текст");
	рбфАнализКлиент.ОткрытьТекст(ЭтотОбъект[ИмяРеквизита], Страница.Заголовок);

КонецПроцедуры

&НаКлиенте
Процедура НайтиВЖурналеРегистрацииОбработка(Команда)

	ТекущиеДанные = Элементы.Выполнения.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Время в ТЖ - окончание события; в ЖР событие пользователя может быть записано чуть раньше или позже
	ДатаНачала = ТекущиеДанные.Время - 60;
	ДатаОкончания = ТекущиеДанные.Время + 60;

	Если ЗначениеЗаполнено(ТекущаяБаза) И НРег(ТекущиеДанные.База) = НРег(ТекущаяБаза) Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("ДатаНачала", ДатаНачала);
		Отбор.Вставить("ДатаОкончания", ДатаОкончания);
		Если ЗначениеЗаполнено(ТекущиеДанные.Пользователь) Тогда
			Отбор.Вставить("Пользователь", ТекущиеДанные.Пользователь);
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекущиеДанные.СеансИд) Тогда
			Сеансы = Новый СписокЗначений;
			Сеансы.Добавить(ТекущиеДанные.СеансИд);
			Отбор.Вставить("Сеанс", Сеансы);
		КонецЕсли;
		ЖурналРегистрацииКлиент.ОткрытьЖурналРегистрации(Отбор, ЭтотОбъект);
		Возврат;
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить("Журнал регистрации другой базы: откройте его в базе и задайте отбор.");
	Строки.Добавить("");
	Строки.Добавить("База: " + ТекущиеДанные.База);
	Строки.Добавить("Пользователь: " + ТекущиеДанные.Пользователь);
	Строки.Добавить("Сеанс: " + Формат(ТекущиеДанные.СеансИд, "ЧГ=0"));
	Строки.Добавить("Интервал с: " + Формат(ДатаНачала, "ДФ='dd.MM.yyyy HH:mm:ss'"));
	Строки.Добавить("Интервал по: " + Формат(ДатаОкончания, "ДФ='dd.MM.yyyy HH:mm:ss'"));
	рбфАнализКлиент.ОткрытьТекст(СтрСоединить(Строки, Символы.ПС), "Отбор журнала регистрации");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПоказатьВыполнения()

	ТекущиеДанные = Элементы.Группы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьВыполнения(?(ВызовыCALL, КлючВызовов(ТекущиеДанные.Ключ), ТекущиеДанные.ШаблонХеш));
	ПоказатьПодробности();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПодробности()

	ТекущиеДанные = Элементы.Выполнения.ТекущиеДанные;
	ЗаполнитьПодробности(?(ТекущиеДанные = Неопределено, "", ТекущиеДанные.Ид));

КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере()

	Элементы.ГруппыЦПСек.Видимость = ВызовыCALL;
	Элементы.ГруппыПамятьПикМБ.Видимость = ВызовыCALL;
	Элементы.ПорядокВызовов.Доступность = ВызовыCALL;
	Если ВызовыCALL Тогда
		ОбновитьВызовыНаСервере();
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Условие = УсловиеВыполнений(Запрос);
	// отбор с исключениями служебных запросов - один проход по регистру: группы во временную таблицу,
	// из неё топ групп и итог для доли
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.ШаблонХеш КАК ШаблонХеш,
	|	МАКСИМУМ(Т.КонтекстТочка) КАК КонтекстТочка,
	|	МАКСИМУМ(ПОДСТРОКА(Т.ТекстЗапроса1С, 1, 300)) КАК Запрос1С,
	|	МАКСИМУМ(ПОДСТРОКА(Т.ТекстSQL, 1, 300)) КАК ЗапросSQL,
	|	КОЛИЧЕСТВО(*) КАК Кол,
	|	СУММА(Т.ДлительностьМс) / 1000 КАК Сек,
	|	МАКСИМУМ(Т.ДлительностьМс) / 1000 КАК СекМакс,
	|	СРЕДНЕЕ(Т.ДлительностьМс) / 1000 КАК СекСредн
	|ПОМЕСТИТЬ ВТГруппы
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	" + Условие + "
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.ШаблонХеш
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1000
	|	Г.ШаблонХеш КАК ШаблонХеш,
	|	Г.КонтекстТочка КАК КонтекстТочка,
	|	Г.Запрос1С КАК Запрос1С,
	|	Г.ЗапросSQL КАК ЗапросSQL,
	|	Г.Кол КАК Кол,
	|	Г.Сек КАК Сек,
	|	Г.СекМакс КАК СекМакс,
	|	Г.СекСредн КАК СекСредн
	|ИЗ
	|	ВТГруппы КАК Г
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сек УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Г.Сек), 0) КАК Сек
	|ИЗ
	|	ВТГруппы КАК Г";
	Результаты = Запрос.ВыполнитьПакет();
	Таблица = Результаты[1].Выгрузить();

	// доля - от суммарной длительности всех запросов периода, а не только показанных групп (ранжирование ЦУП)
	Выборка = Результаты[2].Выбрать();
	Всего = ?(Выборка.Следующий(), Выборка.Сек, 0);

	Группы.Очистить();
	Для Каждого Строка Из Таблица Цикл
		НоваяСтрока = Группы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.Доля = ?(Всего = 0, 0, Окр(Строка.Сек * 100 / Всего, 1));
		ТекстЗапроса = ?(ЗначениеЗаполнено(Строка.Запрос1С), Строка.Запрос1С, Строка.ЗапросSQL);
		ТекстЗапроса = СокрЛП(СтрЗаменить(СтрЗаменить(ТекстЗапроса, Символы.ПС, " "), Символы.Таб, " "));
		НоваяСтрока.Ключ = ?(ЗначениеЗаполнено(Строка.КонтекстТочка), Строка.КонтекстТочка + " | ", "") + ТекстЗапроса;
	КонецЦикла;

	Если Группы.Количество() > 0 Тогда
		ЗаполнитьВыполнения(Группы[0].ШаблонХеш);
	Иначе
		Выполнения.Очистить();
	КонецЕсли;
	ЗаполнитьПодробности(?(Выполнения.Количество() = 0, "", Выполнения[0].Ид));

КонецПроцедуры

// Вид «серверные вызовы»: топ-25 CALL/SCALL по последней строке контекста (ИТС 5906).
&НаСервере
Процедура ОбновитьВызовыНаСервере()

	Таблица = рбфАнализСервер.ТопВызововТЖ(рбфАнализСервер.Отбор(ЭтотОбъект), ПорядокВызовов);
	Всего = Таблица.Итог("Сек");

	Группы.Очистить();
	Для Каждого Строка Из Таблица Цикл
		НоваяСтрока = Группы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.Доля = ?(Всего = 0, 0, Окр(Строка.Сек * 100 / Всего, 1));
		НоваяСтрока.Ключ = ?(ЗначениеЗаполнено(Строка.КонтекстСтрока), Строка.КонтекстСтрока, БезКонтекста());
	КонецЦикла;

	Если Группы.Количество() > 0 Тогда
		ЗаполнитьВыполнения(КлючВызовов(Группы[0].Ключ));
	Иначе
		Выполнения.Очистить();
	КонецЕсли;
	ЗаполнитьПодробности(?(Выполнения.Количество() = 0, "", Выполнения[0].Ид));

КонецПроцедуры

// Параметры:
//  КлючГруппы - Строка - ШаблонХеш группы запросов или, в виде вызовов, последняя строка контекста.
&НаСервере
Процедура ЗаполнитьВыполнения(КлючГруппы)

	Запрос = Новый Запрос;
	Условие = УсловиеВыполнений(Запрос, НЕ ВызовыCALL);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 500
	|	Т.Ид КАК Ид,
	|	Т.Время КАК Время,
	|	Т.ДлительностьМс / 1000 КАК Сек,
	|	Т.Пользователь КАК Пользователь,
	|	Т.СеансИд КАК СеансИд,
	|	Т.Компьютер КАК Компьютер,
	|	Т.База КАК База
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	" + Условие + "
	|	И " + ?(ВызовыCALL, "Т.КонтекстСтрока", "Т.ШаблонХеш") + " = &КлючГруппы
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сек УБЫВ";
	Запрос.УстановитьПараметр("КлючГруппы", КлючГруппы);
	Выполнения.Загрузить(Запрос.Выполнить().Выгрузить());

	Состояния = рбфАнализСервер.СостоянияВызовов(Выполнения.Выгрузить(, "Ид").ВыгрузитьКолонку("Ид"));
	Для Каждого Строка Из Выполнения Цикл
		Состояние = Состояния[Строка.Ид];
		Строка.Состояние = ?(Состояние = Неопределено, "нет вызова в ТЖ", Состояние.Состояние);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодробности(Ид)

	ТекстКонтекст = "";
	Текст1С = "";
	ТекстSQL = "";
	ТекстСведения = "";
	Если НЕ ЗначениеЗаполнено(Ид) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Время КАК Время,
	|	Т.Сервер КАК Сервер,
	|	Т.База КАК База,
	|	Т.Событие КАК Событие,
	|	Т.ДлительностьМс КАК ДлительностьМс,
	|	Т.Пользователь КАК Пользователь,
	|	Т.СеансИд КАК СеансИд,
	|	Т.СоединениеИд КАК СоединениеИд,
	|	Т.КлиентИд КАК КлиентИд,
	|	Т.Приложение КАК Приложение,
	|	Т.Компьютер КАК Компьютер,
	|	Т.Процесс КАК Процесс,
	|	Т.dbpid КАК dbpid,
	|	Т.Транзакция КАК Транзакция,
	|	Т.Строк КАК Строк,
	|	Т.Функция КАК Функция,
	|	Т.ЦПМкс КАК ЦПМкс,
	|	Т.Память КАК Память,
	|	Т.ПамятьПик КАК ПамятьПик,
	|	Т.ВходБайт КАК ВходБайт,
	|	Т.ВыходБайт КАК ВыходБайт,
	|	Т.КонтекстПолный КАК КонтекстПолный,
	|	Т.ТекстЗапроса1С КАК ТекстЗапроса1С,
	|	Т.ТекстSQL КАК ТекстSQL
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	Т.Ид = &Ид";
	Запрос.УстановитьПараметр("Ид", Ид);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;

	ТекстКонтекст = рбфАнализСервер.ИлиНетДанных(Выборка.КонтекстПолный);
	ТекстSQL = рбфАнализСервер.ИлиНетДанных(Выборка.ТекстSQL);
	Если ЗначениеЗаполнено(Выборка.ТекстЗапроса1С) Тогда
		Текст1С = Выборка.ТекстЗапроса1С;
	Иначе
		Текст1С = "нет данных: запрос 1С есть у событий SDBL, а для DBMSSQL - только по базе "
			+ ТекущаяБаза + " (имена таблиц переводятся по её структуре хранения)";
	КонецЕсли;

	Сведения = Новый Массив;
	Сведения.Добавить("Время: " + Формат(Выборка.Время, "ДФ='dd.MM.yyyy HH:mm:ss'"));
	Сведения.Добавить("Сервер: " + Выборка.Сервер);
	Сведения.Добавить("База: " + Выборка.База);
	Сведения.Добавить("Событие: " + Выборка.Событие + ?(ЗначениеЗаполнено(Выборка.Функция), " (" + Выборка.Функция + ")", ""));
	Сведения.Добавить("Длительность, с: " + Формат(Выборка.ДлительностьМс / 1000, "ЧДЦ=3; ЧН=0"));
	Сведения.Добавить("Пользователь: " + Выборка.Пользователь);
	Сведения.Добавить("Сеанс: " + Формат(Выборка.СеансИд, "ЧГ=0; ЧН=0"));
	Сведения.Добавить("Соединение: " + Формат(Выборка.СоединениеИд, "ЧГ=0; ЧН=0"));
	Сведения.Добавить("Клиент: " + Формат(Выборка.КлиентИд, "ЧГ=0; ЧН=0"));
	Сведения.Добавить("Приложение: " + Выборка.Приложение);
	Сведения.Добавить("Компьютер: " + Выборка.Компьютер);
	Сведения.Добавить("Процесс: " + Выборка.Процесс);
	Сведения.Добавить("dbpid: " + Формат(Выборка.dbpid, "ЧГ=0; ЧН=0"));
	Сведения.Добавить("В транзакции: " + Формат(Выборка.Транзакция, "БЛ=нет; БИ=да"));
	Сведения.Добавить("Строк: " + Формат(Выборка.Строк, "ЧГ=0; ЧН=0"));
	Если Выборка.Событие = "CALL" ИЛИ Выборка.Событие = "SCALL" Тогда
		Сведения.Добавить("ЦП, с: " + Формат(Выборка.ЦПМкс / 1000000, "ЧДЦ=3; ЧН=0"));
		Сведения.Добавить("Память, байт: " + Формат(Выборка.Память, "ЧН=0"));
		Сведения.Добавить("Память пик, байт: " + Формат(Выборка.ПамятьПик, "ЧН=0"));
		Сведения.Добавить("Принято, байт: " + Формат(Выборка.ВходБайт, "ЧН=0"));
		Сведения.Добавить("Передано, байт: " + Формат(Выборка.ВыходБайт, "ЧН=0"));
	КонецЕсли;
	ПараметрыSQL = рбфАнализСервер.ПараметрыЗапросаSQL(Выборка.ТекстSQL);
	Если ЗначениеЗаполнено(ПараметрыSQL) Тогда
		Сведения.Добавить("");
		Сведения.Добавить("Параметры SQL:");
		Сведения.Добавить(ПараметрыSQL);
	КонецЕсли;

	Идентификаторы = Новый Массив;
	Идентификаторы.Добавить(Ид);
	Состояние = рбфАнализСервер.СостоянияВызовов(Идентификаторы)[Ид];
	Сведения.Добавить("");
	Если Состояние = Неопределено Тогда
		Сведения.Добавить("Состояние вызова: нет охватывающего CALL этого соединения в ТЖ");
	Иначе
		Сведения.Добавить("Состояние вызова: " + Состояние.Состояние
			+ " (вызов " + Формат(Состояние.ВызовСек, "ЧДЦ=3; ЧН=0")
			+ " с, СУБД " + Формат(Состояние.СУБДСек, "ЧДЦ=3; ЧН=0")
			+ " с, ожидание фонового " + Формат(Состояние.ФоновоеСек, "ЧДЦ=3; ЧН=0") + " с)");
	КонецЕсли;

	Признаки = рбфАнализСервер.ПризнакиНеоптимальногоЗапроса(Выборка.ТекстЗапроса1С);
	Если Признаки.Количество() > 0 Тогда
		Сведения.Добавить("");
		Сведения.Добавить("Признаки (стандарт ИТС «Типичные причины неоптимальной работы запросов»):");
		Для Каждого Признак Из Признаки Цикл
			Сведения.Добавить("- " + Признак);
		КонецЦикла;
	КонецЕсли;
	ТекстСведения = СтрСоединить(Сведения, Символы.ПС);

КонецПроцедуры

// Колонка «Состояние» таблицы «Выполнения» (состояние «висит» охватывающего вызова, Инфостарт 2819638)
// добавляется программно, чтобы не менять Form.form.
&НаСервере
Процедура ДобавитьКолонкуСостояние()

	Добавляемые = Новый Массив;
	Добавляемые.Добавить(Новый РеквизитФормы("Состояние",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)), "Выполнения", "Состояние"));
	ИзменитьРеквизиты(Добавляемые);

	Колонка = Элементы.Добавить("ВыполненияСостояние", Тип("ПолеФормы"), Элементы.Выполнения);
	Колонка.Вид = ВидПоляФормы.ПолеВвода;
	Колонка.ПутьКДанным = "Выполнения.Состояние";
	Колонка.ТолькоПросмотр = Истина;
	Колонка.Подсказка = "Идёт запрос к СУБД / Сервер ждёт клиента / Клиента нет, а вызов идёт / Мешает фоновое"
		+ " - по событиям ТЖ того же соединения в пределах CALL";

КонецПроцедуры

// Условие отбора шапки по рбфВыполненияТЖ для событий запросов без служебных запросов платформы.
//
// Параметры:
//  Запрос - Запрос - в него устанавливаются параметры условия.
//  БезИсключений - Булево - Истина: без исключения служебных запросов и SDBL без текста. Для выполнений
//    одной группы (отбор по ШаблонХеш): группа уже отобрана с исключениями, а НЕ ПОДОБНО по тексту SQL
//    каждой строки периода - самая дорогая часть запроса.
&НаСервере
Функция УсловиеВыполнений(Запрос, БезИсключений = Ложь)

	Отбор = рбфАнализСервер.Отбор(ЭтотОбъект);
	События = Новый Массив;
	Если ВызовыCALL Тогда
		События.Добавить("CALL");
		События.Добавить("SCALL");
		Возврат рбфАнализСервер.УсловиеОтбораВыполненийТЖ(Запрос, Отбор, События);
	КонецЕсли;
	События.Добавить("DBMSSQL");
	События.Добавить("DBPOSTGRS");
	События.Добавить("SDBL");
	Если БезИсключений Тогда
		Возврат рбфАнализСервер.УсловиеОтбораВыполненийТЖ(Запрос, Отбор, События);
	КонецЕсли;
	Условия = Новый Массив;
	Условия.Добавить(рбфАнализСервер.УсловиеОтбораВыполненийТЖ(Запрос, Отбор, События));
	// SDBL без текста - фиксации и откаты транзакций (Func=Transaction) и служебные вызовы, это не запросы
	Условия.Добавить("НЕ (Т.Событие = ""SDBL"" И ПОДСТРОКА(Т.ТекстЗапроса1С, 1, 1) = """")");

	СлужебныеЗапросы = рбфАнализСервер.НастройкиВыполненийТЖ().СлужебныеЗапросы;
	Для Номер = 1 По СлужебныеЗапросы.Количество() Цикл
		ИмяПараметра = "Служебный" + Формат(Номер, "ЧГ=0");
		Условия.Добавить("НЕ ПОДСТРОКА(Т.ТекстSQL, 1, 1024) ПОДОБНО &" + ИмяПараметра + " СПЕЦСИМВОЛ ""~""");
		Запрос.УстановитьПараметр(ИмяПараметра,
			"%" + рбфАнализСервер.ТекстДляПодобно(СлужебныеЗапросы[Номер - 1]) + "%");
	КонецЦикла;
	Возврат СтрСоединить(Условия, Символы.ПС + "	И ");

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция БезКонтекста()

	Возврат "(без контекста)";

КонецФункции

// Значение КонтекстСтрока для отбора выполнений по ключу группы вызовов.
&НаКлиентеНаСервереБезКонтекста
Функция КлючВызовов(Ключ)

	Возврат ?(Ключ = БезКонтекста(), "", Ключ);

КонецФункции

#КонецОбласти
