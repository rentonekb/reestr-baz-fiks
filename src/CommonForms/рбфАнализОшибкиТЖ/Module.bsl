// Раздел «Анализ», страница «Ошибки ТЖ»: слева - ошибки, сгруппированные по тексту (ключ агента),
// с количеством, справа - экземпляры выбранной ошибки по часам, серверам и базам,
// внизу - подробности выбранного экземпляра из примера события ТЖ.

#Область ОписаниеПеременных

// Ключи строк, для которых данные уже получены с сервера. После серверного вызова платформа
// снова активизирует текущую строку, и без этой проверки форма вызывала сервер бесконечно.
&НаКлиенте
Перем ПоказаннаяГруппа;
&НаКлиенте
Перем ПоказанныйЭкземпляр;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	рбфАнализСервер.ЗаполнитьШапку(ЭтотОбъект);
	ОбновитьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыГруппы

&НаКлиенте
Процедура ГруппыПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьЭкземпляры", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЭкземпляры

&НаКлиенте
Процедура ЭкземплярыПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьПодробности", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Подключается программно в рбфАнализСервер.ЗаполнитьШапку: выбор базы сразу обновляет данные.
&НаКлиенте
Процедура БазаПриИзменении(Элемент)

	ОбновитьОбработка(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьОбработка(Команда)

	ОбновитьНаСервере();
	// сервер заполнил экземпляры и подробности по первой строке
	ПоказаннаяГруппа = ?(Группы.Количество() = 0, Неопределено, КлючГруппы(Группы[0]));
	ПоказанныйЭкземпляр = ?(Экземпляры.Количество() = 0, Неопределено, Экземпляры[0].ПолучитьИдентификатор());

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодОбработка(Команда)

	рбфАнализКлиент.ВыбратьПериод(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ДопФильтрОбработка(Команда)

	рбфАнализКлиент.ПереключитьДопФильтр(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПоказатьЭкземпляры()

	ТекущиеДанные = Элементы.Группы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Ключ = КлючГруппы(ТекущиеДанные);
	Если Ключ = ПоказаннаяГруппа Тогда
		Возврат;
	КонецЕсли;
	ПоказаннаяГруппа = Ключ;
	ЗаполнитьЭкземпляры(ТекущиеДанные.КлючХеш, ТекущиеДанные.Событие);
	// после перезаполнения идентификаторы строк новые: подробности показываем всегда
	ПоказанныйЭкземпляр = Неопределено;
	ПоказатьПодробности();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПодробности()

	ТекущиеДанные = Элементы.Экземпляры.ТекущиеДанные;
	Ид = ?(ТекущиеДанные = Неопределено, Неопределено, ТекущиеДанные.ПолучитьИдентификатор());
	Если Ид <> Неопределено И Ид = ПоказанныйЭкземпляр Тогда
		Возврат;
	КонецЕсли;
	ПоказанныйЭкземпляр = Ид;
	ЗаполнитьПодробности(Ид);

КонецПроцедуры

&НаКлиенте
Функция КлючГруппы(СтрокаГруппы)

	Возврат СтрокаГруппы.КлючХеш + "|" + СтрокаГруппы.Событие;

КонецФункции

&НаСервере
Процедура ОбновитьНаСервере()

	Отбор = рбфАнализСервер.Отбор(ЭтотОбъект);
	Запрос = Новый Запрос;
	Условие = рбфАнализСервер.УсловиеОтбораТЖ(Запрос, Отбор, СобытияОшибок());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.КлючХеш КАК КлючХеш,
	|	Т.Событие КАК Событие,
	|	Т.Ключ КАК Текст,
	|	СУММА(Т.Количество) КАК Количество
	|ИЗ
	|	РегистрСведений.рбфСобытияТЖ КАК Т
	|ГДЕ
	|	" + Условие + "
	|	И Т.Ключ <> ""(без контекста)""
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.КлючХеш,
	|	Т.Событие,
	|	Т.Ключ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Количество УБЫВ";
	Группы.Загрузить(Запрос.Выполнить().Выгрузить());

	Если Группы.Количество() > 0 Тогда
		ЗаполнитьЭкземпляры(Группы[0].КлючХеш, Группы[0].Событие);
	Иначе
		Экземпляры.Очистить();
	КонецЕсли;
	ЗаполнитьПодробности(?(Экземпляры.Количество() = 0, Неопределено, Экземпляры[0].ПолучитьИдентификатор()));

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЭкземпляры(КлючХеш, Событие)

	Отбор = рбфАнализСервер.Отбор(ЭтотОбъект);
	Запрос = Новый Запрос;
	Условие = рбфАнализСервер.УсловиеОтбораТЖ(Запрос, Отбор, СобытияОшибок());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Час КАК Дата,
	|	Т.Сервер КАК Сервер,
	|	Т.База КАК База,
	|	Т.Событие КАК Событие,
	|	Т.Количество КАК Количество,
	|	Т.Пример КАК Пример
	|ИЗ
	|	РегистрСведений.рбфСобытияТЖ КАК Т
	|ГДЕ
	|	" + Условие + "
	|	И Т.КлючХеш = &КлючХеш
	|	И Т.Событие = &Событие
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	Запрос.УстановитьПараметр("КлючХеш", КлючХеш);
	Запрос.УстановитьПараметр("Событие", Событие);
	Экземпляры.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодробности(ИдентификаторСтроки)

	Строка = ?(ИдентификаторСтроки = Неопределено, Неопределено, Экземпляры.НайтиПоИдентификатору(ИдентификаторСтроки));
	Если Строка = Неопределено Тогда
		ТекстПодробности = "";
		Возврат;
	КонецЕсли;

	Подробности = Новый Массив;
	Подробности.Добавить("Сервер = " + Строка.Сервер);
	Подробности.Добавить("База = " + Строка.База);
	Подробности.Добавить("Событие = " + Строка.Событие);
	Подробности.Добавить("Час = " + Формат(Строка.Дата, "ДФ='dd.MM.yyyy HH:mm'"));
	Подробности.Добавить("Ошибок за час = " + Строка.Количество);
	Свойства = рбфАнализСервер.СвойстваСобытияТЖ(Строка.Пример);
	Описание = ОписаниеБезСлужебныхСтрок(рбфАнализСервер.ЗначениеСвойства(Свойства, "Descr"));
	Если ЗначениеЗаполнено(Описание) Тогда
		Подробности.Добавить("");
		Подробности.Добавить(Описание);
	КонецЕсли;
	Остальные = рбфАнализСервер.ПредставлениеСвойств(Свойства, "Descr");
	Подробности.Добавить("");
	Подробности.Добавить(?(ЗначениеЗаполнено(Остальные), Остальные,
		рбфАнализСервер.ИлиНетДанных(Строка.Пример)));
	ТекстПодробности = СтрСоединить(Подробности, Символы.ПС);

КонецПроцедуры

// Descr у EXCP начинается с места в исходниках платформы («src\...\ServerJobExecutor.cpp(1353):»)
// и GUID ошибки перед текстом: для разбора они ничего не дают.
&НаСервереБезКонтекста
Функция ОписаниеБезСлужебныхСтрок(Текст)

	Строки = Новый Массив;
	Для Каждого ТекстСтроки Из СтрРазделить(Строка(Текст), Символы.ПС, Ложь) Цикл
		Стр = СокрЛП(ТекстСтроки);
		Если СтрНайти(НРег(Стр), ".cpp(") > 0 И СтрЗаканчиваетсяНа(Стр, "):") Тогда
			Продолжить;
		КонецЕсли;
		Если СтрДлина(Стр) > 36 И Сред(Стр, 37, 1) = ":" И ЭтоGUID(Лев(Стр, 36)) Тогда
			Стр = СокрЛП(Сред(Стр, 38));
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр) Тогда
			Строки.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаСервереБезКонтекста
Функция ЭтоGUID(Текст)

	Попытка
		Возврат ЗначениеЗаполнено(Новый УникальныйИдентификатор(Текст));
	Исключение
		// не GUID - строка остаётся как есть
		Возврат Ложь;
	КонецПопытки;

КонецФункции

&НаСервереБезКонтекста
Функция СобытияОшибок()

	События = Новый Массив;
	События.Добавить("EXCP");
	События.Добавить("EXCPCNTX");
	События.Добавить("QERR");
	Возврат События;

КонецФункции

#КонецОбласти
