// Раздел «Анализ», страница «Ошибки ТЖ»: слева - ошибки, сгруппированные по тексту (ключ агента),
// с количеством, справа - экземпляры выбранной ошибки по часам, серверам и базам,
// внизу - подробности выбранного экземпляра из примера события ТЖ.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	рбфАнализСервер.ЗаполнитьШапку(ЭтотОбъект);
	ОбновитьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыГруппы

&НаКлиенте
Процедура ГруппыПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьЭкземпляры", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЭкземпляры

&НаКлиенте
Процедура ЭкземплярыПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьПодробности", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Подключается программно в рбфАнализСервер.ЗаполнитьШапку: выбор базы сразу обновляет данные.
&НаКлиенте
Процедура БазаПриИзменении(Элемент)

	ОбновитьОбработка(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьОбработка(Команда)

	ОбновитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодОбработка(Команда)

	рбфАнализКлиент.ВыбратьПериод(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ДопФильтрОбработка(Команда)

	рбфАнализКлиент.ПереключитьДопФильтр(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПоказатьЭкземпляры()

	ТекущиеДанные = Элементы.Группы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьЭкземпляры(ТекущиеДанные.КлючХеш, ТекущиеДанные.Событие);
	ПоказатьПодробности();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПодробности()

	ТекущиеДанные = Элементы.Экземпляры.ТекущиеДанные;
	ЗаполнитьПодробности(?(ТекущиеДанные = Неопределено, Неопределено, ТекущиеДанные.ПолучитьИдентификатор()));

КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере()

	Отбор = рбфАнализСервер.Отбор(ЭтотОбъект);
	Запрос = Новый Запрос;
	Условие = рбфАнализСервер.УсловиеОтбораТЖ(Запрос, Отбор, СобытияОшибок());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.КлючХеш КАК КлючХеш,
	|	Т.Событие КАК Событие,
	|	Т.Ключ КАК Текст,
	|	СУММА(Т.Количество) КАК Количество
	|ИЗ
	|	РегистрСведений.рбфСобытияТЖ КАК Т
	|ГДЕ
	|	" + Условие + "
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.КлючХеш,
	|	Т.Событие,
	|	Т.Ключ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Количество УБЫВ";
	Группы.Загрузить(Запрос.Выполнить().Выгрузить());

	Если Группы.Количество() > 0 Тогда
		ЗаполнитьЭкземпляры(Группы[0].КлючХеш, Группы[0].Событие);
	Иначе
		Экземпляры.Очистить();
	КонецЕсли;
	ЗаполнитьПодробности(?(Экземпляры.Количество() = 0, Неопределено, Экземпляры[0].ПолучитьИдентификатор()));

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЭкземпляры(КлючХеш, Событие)

	Отбор = рбфАнализСервер.Отбор(ЭтотОбъект);
	Запрос = Новый Запрос;
	Условие = рбфАнализСервер.УсловиеОтбораТЖ(Запрос, Отбор, СобытияОшибок());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Час КАК Дата,
	|	Т.Сервер КАК Сервер,
	|	Т.База КАК База,
	|	Т.Событие КАК Событие,
	|	Т.Количество КАК Количество,
	|	Т.Пример КАК Пример
	|ИЗ
	|	РегистрСведений.рбфСобытияТЖ КАК Т
	|ГДЕ
	|	" + Условие + "
	|	И Т.КлючХеш = &КлючХеш
	|	И Т.Событие = &Событие
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	Запрос.УстановитьПараметр("КлючХеш", КлючХеш);
	Запрос.УстановитьПараметр("Событие", Событие);
	Экземпляры.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодробности(ИдентификаторСтроки)

	Строка = ?(ИдентификаторСтроки = Неопределено, Неопределено, Экземпляры.НайтиПоИдентификатору(ИдентификаторСтроки));
	Если Строка = Неопределено Тогда
		ТекстПодробности = "";
		Возврат;
	КонецЕсли;

	Подробности = Новый Массив;
	Подробности.Добавить("Сервер = " + Строка.Сервер);
	Подробности.Добавить("База = " + Строка.База);
	Подробности.Добавить("Событие = " + Строка.Событие);
	Подробности.Добавить("Час = " + Формат(Строка.Дата, "ДФ='dd.MM.yyyy HH:mm'"));
	Подробности.Добавить("Ошибок за час = " + Строка.Количество);
	Свойства = рбфАнализСервер.СвойстваСобытияТЖ(Строка.Пример);
	Описание = рбфАнализСервер.ЗначениеСвойства(Свойства, "Descr");
	Если ЗначениеЗаполнено(Описание) Тогда
		Подробности.Добавить("");
		Подробности.Добавить(Описание);
	КонецЕсли;
	Остальные = рбфАнализСервер.ПредставлениеСвойств(Свойства, "Descr");
	Подробности.Добавить("");
	Подробности.Добавить(?(ЗначениеЗаполнено(Остальные), Остальные,
		рбфАнализСервер.ИлиНетДанных(Строка.Пример)));
	ТекстПодробности = СтрСоединить(Подробности, Символы.ПС);

КонецПроцедуры

&НаСервереБезКонтекста
Функция СобытияОшибок()

	События = Новый Массив;
	События.Добавить("EXCP");
	События.Добавить("EXCPCNTX");
	События.Добавить("QERR");
	Возврат События;

КонецФункции

#КонецОбласти
