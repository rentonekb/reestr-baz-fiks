// Раздел «Анализ», страницы «Блокировки» (TLOCK, TTIMEOUT) и «Взаимоблокировки» (TDEADLOCK):
// компоновка как у 1С-Монитора по отдельным событиям ТЖ (рбфВыполненияТЖ). Слева - пространства
// блокировок с количеством и суммарным ожиданием, справа - ожидания выбранного пространства,
// внизу - «Жертва» и «Виновник» (виновник ожидания - запись по ВиновникИд, у взаимоблокировки -
// последние события соединений из DeadlockConnectionIntersections) и «Схема».
// Имена хранения переводятся в имена метаданных только для текущей ИБ (карта есть только у неё).
// Вид «СУБД» - блокировки SQL Server из XE (SQLBLOCK) и взаимоблокировки SQL Server (SQLDEADLOCK):
// группы по таблице ресурса ожидания, виновник - DBMSSQL по ВиновникИд, иначе данные блокирующего процесса SQL.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Элементы.Вид.СписокВыбора.Добавить("Блокировки");
	Элементы.Вид.СписокВыбора.Добавить("Все TLOCK");
	Элементы.Вид.СписокВыбора.Добавить("Взаимоблокировки");
	Элементы.Вид.СписокВыбора.Добавить("СУБД");
	Элементы.Вид.РежимВыбораИзСписка = Истина;
	Вид = ?(Параметры.Вид = "Взаимоблокировки" ИЛИ Параметры.Вид = "СУБД", Параметры.Вид, "Блокировки");
	ТекущаяБаза = рбфАнализСервер.ИмяТекущейИнформационнойБазы();

	рбфАнализСервер.ЗаполнитьШапку(ЭтотОбъект);
	ОбновитьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОбъекты

&НаКлиенте
Процедура ОбъектыПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьСписок", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьПодробности", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьОбработка(Команда)

	ОбновитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодОбработка(Команда)

	рбфАнализКлиент.ВыбратьПериод(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ДопФильтрОбработка(Команда)

	рбфАнализКлиент.ПереключитьДопФильтр(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПоказатьСписок()

	ТекущиеДанные = Элементы.Объекты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьСписок(ТекущиеДанные.Пространство);
	ПоказатьПодробности();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПодробности()

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	ЗаполнитьПодробности(?(ТекущиеДанные = Неопределено, "", ТекущиеДанные.Ид));

КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере()

	Заголовок = ?(Вид = "СУБД", "Блокировки СУБД", Вид);
	Элементы.ГруппаВиновник.Заголовок = ?(Вид = "Взаимоблокировки", "Другие стороны", "Виновник");
	ЭтоВзаимоблокировки = (Вид = "Взаимоблокировки");
	ЭтоСУБД = (Вид = "СУБД");

	// Пространство - первое слово описания блокировки, поэтому группы собираются из групп по началу
	// описания (ПЕРВЫЕ 1000 различных начал) и складываются по пространству здесь.
	Запрос = Новый Запрос;
	Условие = УсловиеСобытий(Запрос);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1000
	|	ПОДСТРОКА(Т.Блокировки, 1, 200) КАК Описание,
	|	ПОДСТРОКА(Т.Взаимоблокировка, 1, 200) КАК ОписаниеВзаимоблокировки,
	|	Т.РесурсОжидания КАК РесурсОжидания,
	|	Т.База КАК База,
	|	КОЛИЧЕСТВО(*) КАК Количество,
	|	СУММА(Т.ДлительностьМс) / 1000 КАК Сек
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	" + Условие + "
	|
	|СГРУППИРОВАТЬ ПО
	|	ПОДСТРОКА(Т.Блокировки, 1, 200),
	|	ПОДСТРОКА(Т.Взаимоблокировка, 1, 200),
	|	Т.РесурсОжидания,
	|	Т.База
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сек УБЫВ";
	Таблица = Запрос.Выполнить().Выгрузить();

	Таблица.Колонки.Добавить("Пространство", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Объект", Новый ОписаниеТипов("Строка"));
	Карта = Неопределено;
	Для Каждого Строка Из Таблица Цикл
		Если ЭтоСУБД Тогда
			Строка.Пространство = ТаблицаРесурса(Строка.РесурсОжидания);
		ИначеЕсли ЭтоВзаимоблокировки Тогда
			Строка.Пространство = ПространствоВзаимоблокировки(Строка.ОписаниеВзаимоблокировки);
		Иначе
			Строка.Пространство = ПространствоБлокировки(Строка.Описание);
		КонецЕсли;
		Строка.Объект = Строка.Пространство;
		Если ЭтоТекущаяБаза(Строка.База) И ЗначениеЗаполнено(Строка.Пространство) Тогда
			Если Карта = Неопределено Тогда
				Карта = рбфАнализСервер.КартаИменТаблиц();
			КонецЕсли;
			Строка.Объект = рбфАнализСервер.ПеревестиИменаХранения(Строка.Пространство, Карта);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Строка.Объект) Тогда
			Строка.Объект = ?(ЭтоСУБД, "(таблица не определена)", "(пространство не указано)");
		КонецЕсли;
	КонецЦикла;
	Таблица.Свернуть("Пространство,Объект", "Количество,Сек");
	Таблица.Сортировать("Сек УБЫВ");
	Объекты.Загрузить(Таблица);

	Если Объекты.Количество() > 0 Тогда
		ЗаполнитьСписок(Объекты[0].Пространство);
	Иначе
		Список.Очистить();
	КонецЕсли;
	ЗаполнитьПодробности(?(Список.Количество() = 0, "", Список[0].Ид));

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписок(Пространство)

	ЭтоВзаимоблокировки = (Вид = "Взаимоблокировки");
	Поле = ?(ЭтоВзаимоблокировки, "Т.Взаимоблокировка", "Т.Блокировки");
	Запрос = Новый Запрос;
	Условия = Новый Массив;
	Условия.Добавить(УсловиеСобытий(Запрос));
	Если Вид = "СУБД" Тогда
		// РесурсОжидания: "<таблица>|<waitresource>"
		Условия.Добавить("Т.РесурсОжидания ПОДОБНО &ШаблонТаблицы СПЕЦСИМВОЛ ""~""");
		Запрос.УстановитьПараметр("ШаблонТаблицы", рбфАнализСервер.ТекстДляПодобно(Пространство) + "|%");
	ИначеЕсли НЕ ЗначениеЗаполнено(Пространство) Тогда
		Условия.Добавить("ПОДСТРОКА(" + Поле + ", 1, 200) = """"");
	ИначеЕсли ЭтоВзаимоблокировки Тогда
		// пересечение: "ждёт держит Пространство режим поля"
		Условия.Добавить("(ПОДСТРОКА(" + Поле + ", 1, 1024) ПОДОБНО &ШаблонТочка СПЕЦСИМВОЛ ""~""
		|		ИЛИ ПОДСТРОКА(" + Поле + ", 1, 1024) ПОДОБНО &ШаблонПробел СПЕЦСИМВОЛ ""~"")");
		Запрос.УстановитьПараметр("ШаблонТочка", "% " + рбфАнализСервер.ТекстДляПодобно(Пространство) + ".%");
		Запрос.УстановитьПараметр("ШаблонПробел", "% " + рбфАнализСервер.ТекстДляПодобно(Пространство) + " %");
	Иначе
		Условия.Добавить("(ПОДСТРОКА(" + Поле + ", 1, 200) ПОДОБНО &ШаблонТочка СПЕЦСИМВОЛ ""~""
		|		ИЛИ ПОДСТРОКА(" + Поле + ", 1, 200) ПОДОБНО &ШаблонПробел СПЕЦСИМВОЛ ""~""
		|		ИЛИ ПОДСТРОКА(" + Поле + ", 1, 200) = &Пространство)");
		Запрос.УстановитьПараметр("ШаблонТочка", рбфАнализСервер.ТекстДляПодобно(Пространство) + ".%");
		Запрос.УстановитьПараметр("ШаблонПробел", рбфАнализСервер.ТекстДляПодобно(Пространство) + " %");
		Запрос.УстановитьПараметр("Пространство", Пространство);
	КонецЕсли;

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 500
	|	Т.Ид КАК Ид,
	|	Т.Время КАК Время,
	|	Т.Событие КАК Событие,
	|	Т.ДлительностьМс / 1000 КАК Сек,
	|	Т.Пользователь КАК Пользователь,
	|	Т.КонтекстТочка КАК КонтекстТочка,
	|	Т.dbpid КАК dbpid,
	|	Т.БлокирующийSpid КАК БлокирующийSpid,
	|	Т.Компьютер КАК Компьютер,
	|	ЕСТЬNULL(Вин.Пользователь, """") КАК ПользовательВиновника
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.рбфВыполненияТЖ КАК Вин
	|		ПО (Т.ВиновникИд <> """")
	|			И (Вин.Ид = Т.ВиновникИд)
	|ГДЕ
	|	" + СтрСоединить(Условия, Символы.ПС + "	И ") + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Время УБЫВ";
	Таблица = Запрос.Выполнить().Выгрузить();
	Если Вид = "СУБД" Тогда
		// у событий SQL нет пользователя и контекста 1С: показываем хост и пару spid
		Для Каждого СтрокаТаблицы Из Таблица Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Пользователь) Тогда
				СтрокаТаблицы.Пользователь = СтрокаТаблицы.Компьютер;
			КонецЕсли;
			СтрокаТаблицы.КонтекстТочка = "spid " + Формат(СтрокаТаблицы.dbpid, "ЧГ=0; ЧН=0") + " ждёт spid "
				+ Формат(СтрокаТаблицы.БлокирующийSpid, "ЧГ=0; ЧН=0")
				+ ?(ЗначениеЗаполнено(СтрокаТаблицы.ПользовательВиновника),
					" (" + СтрокаТаблицы.ПользовательВиновника + ")", "");
		КонецЦикла;
	КонецЕсли;
	Список.Загрузить(Таблица);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодробности(Ид)

	ТекстЖертва = "";
	ТекстВиновник = "";
	ТекстСхема = "";
	Если НЕ ЗначениеЗаполнено(Ид) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ид КАК Ид,
	|	Т.Время КАК Время,
	|	Т.Сервер КАК Сервер,
	|	Т.База КАК База,
	|	Т.Событие КАК Событие,
	|	Т.ДлительностьМс КАК ДлительностьМс,
	|	Т.Пользователь КАК Пользователь,
	|	Т.СеансИд КАК СеансИд,
	|	Т.СоединениеИд КАК СоединениеИд,
	|	Т.Компьютер КАК Компьютер,
	|	Т.Транзакция КАК Транзакция,
	|	Т.КонтекстТочка КАК КонтекстТочка,
	|	Т.КонтекстСтрока КАК КонтекстСтрока,
	|	Т.ТекстЗапроса1С КАК ТекстЗапроса1С,
	|	Т.ТекстSQL КАК ТекстSQL,
	|	Т.Блокировки КАК Блокировки,
	|	Т.ЖдалСоединения КАК ЖдалСоединения,
	|	Т.Взаимоблокировка КАК Взаимоблокировка,
	|	Т.ВиновникИд КАК ВиновникИд,
	|	Т.dbpid КАК dbpid,
	|	Т.Приложение КАК Приложение,
	|	Т.БлокирующийSpid КАК БлокирующийSpid,
	|	Т.РесурсОжидания КАК РесурсОжидания,
	|	Т.РежимБлокировки КАК РежимБлокировки,
	|	Т.ТекстSQLВиновника КАК ТекстSQLВиновника,
	|	Т.Описание КАК Описание
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	Т.Ид = &Ид
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Вин.Ид КАК Ид,
	|	Вин.Время КАК Время,
	|	Вин.Сервер КАК Сервер,
	|	Вин.База КАК База,
	|	Вин.Событие КАК Событие,
	|	Вин.ДлительностьМс КАК ДлительностьМс,
	|	Вин.Пользователь КАК Пользователь,
	|	Вин.СеансИд КАК СеансИд,
	|	Вин.СоединениеИд КАК СоединениеИд,
	|	Вин.Компьютер КАК Компьютер,
	|	Вин.Транзакция КАК Транзакция,
	|	Вин.КонтекстТочка КАК КонтекстТочка,
	|	Вин.КонтекстСтрока КАК КонтекстСтрока,
	|	Вин.ТекстЗапроса1С КАК ТекстЗапроса1С,
	|	Вин.ТекстSQL КАК ТекстSQL,
	|	Вин.Блокировки КАК Блокировки,
	|	Вин.ЖдалСоединения КАК ЖдалСоединения,
	|	Вин.Взаимоблокировка КАК Взаимоблокировка,
	|	Вин.ВиновникИд КАК ВиновникИд
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.рбфВыполненияТЖ КАК Вин
	|		ПО (Вин.Ид = Т.ВиновникИд)
	|ГДЕ
	|	Т.Ид = &Ид
	|	И Т.ВиновникИд <> """"";
	Запрос.УстановитьПараметр("Ид", Ид);
	Результаты = Запрос.ВыполнитьПакет();
	Жертва = Результаты[0].Выбрать();
	Если НЕ Жертва.Следующий() Тогда
		Возврат;
	КонецЕсли;

	Карта = ?(ЭтоТекущаяБаза(Жертва.База), рбфАнализСервер.КартаИменТаблиц(), Неопределено);
	Если Жертва.Событие = "SQLBLOCK" ИЛИ Жертва.Событие = "SQLDEADLOCK" Тогда
		ЗаполнитьПодробностиСУБД(Жертва, Результаты[1].Выбрать(), Карта);
		Возврат;
	КонецЕсли;

	ТекстЖертва = ОписаниеСобытия(Жертва, Карта);

	Если Жертва.Событие = "TDEADLOCK" Тогда
		Пары = ПарыВзаимоблокировки(Жертва.Взаимоблокировка);
		ТекстВиновник = ОписаниеСторонВзаимоблокировки(Жертва, Пары, Карта);
		ТекстСхема = СхемаВзаимоблокировки(Пары, Карта);
		Возврат;
	КонецЕсли;

	Виновник = Результаты[1].Выбрать();
	Если Виновник.Следующий() Тогда
		ТекстВиновник = ОписаниеСобытия(Виновник, Карта) + Символы.ПС + Символы.ПС
			+ ОписаниеТранзакцииВиновника(Виновник, Жертва.Время - Цел(Жертва.ДлительностьМс / 1000), Карта);
	Иначе
		ТекстВиновник = "виновник не найден в ТЖ (нужен TLOCK без порога)";
	КонецЕсли;

	Схема = Новый Массив;
	Схема.Добавить("Соединение " + Формат(Жертва.СоединениеИд, "ЧГ=0; ЧН=0") + " ждало соединения: "
		+ ?(ЗначениеЗаполнено(Жертва.ЖдалСоединения), Жертва.ЖдалСоединения, "не указаны"));
	Схема.Добавить("Ожидание, с: " + Формат(Жертва.ДлительностьМс / 1000, "ЧДЦ=3; ЧН=0"));
	Схема.Добавить("");
	Схема.Добавить("Блокировки:");
	Схема.Добавить(ПереведённыйТекст(СтрЗаменить(Жертва.Блокировки, ",", "," + Символы.ПС), Карта));
	ТекстСхема = СтрСоединить(Схема, Символы.ПС);

КонецПроцедуры

// Подробности SQLBLOCK / SQLDEADLOCK. Ждущий: пользователь 1С - по DBMSSQL того же dbpid, завершённому
// после ожидания (до 10 мин), плюс данные процесса SQL; виновник - событие по ВиновникИд, иначе
// данные блокирующего процесса SQL из XE.
&НаСервере
Процедура ЗаполнитьПодробностиСУБД(Жертва, Виновник, Карта)

	ЭтоВзаимоблокировка = (Жертва.Событие = "SQLDEADLOCK");
	СтрокиОписания = СтрРазделить(Жертва.Описание, Символы.ПС, Ложь);
	НачалоОжидания = Жертва.Время - Цел(Жертва.ДлительностьМс / 1000);

	Ждущий = Новый Массив;
	Ждущий.Добавить(?(ЭтоВзаимоблокировка, "Взаимоблокировка SQL Server в ",
		"Ожидание блокировки SQL Server, последний отчёт в ") + Формат(Жертва.Время, "ДФ='dd.MM.yyyy HH:mm:ss'")
		+ ", ожидание, с: " + Формат(Жертва.ДлительностьМс / 1000, "ЧДЦ=3; ЧН=0"));
	Ждущий.Добавить("База: " + Жертва.База + ", spid " + Формат(Жертва.dbpid, "ЧГ=0; ЧН=0")
		+ ?(ЗначениеЗаполнено(Жертва.Компьютер), ", хост: " + Жертва.Компьютер, "")
		+ ?(ЗначениеЗаполнено(Жертва.Приложение), ", приложение: " + Жертва.Приложение, ""));
	Сеанс1С = СобытиеЖдущего1С(Жертва);
	Если Сеанс1С <> Неопределено Тогда
		Ждущий.Добавить("Пользователь 1С: " + Сеанс1С.Пользователь + ", сеанс " + Формат(Сеанс1С.СеансИд, "ЧГ=0; ЧН=0")
			+ ", контекст: " + Сеанс1С.КонтекстТочка);
	Иначе
		Ждущий.Добавить("Пользователь 1С: не найден в ТЖ");
	КонецЕсли;
	Для Каждого СтрокаОписания Из СтрокиОписания Цикл
		Если СтрНачинаетсяС(СтрокаОписания, "Ждущий:") ИЛИ СтрНачинаетсяС(СтрокаОписания, "Жертва:") Тогда
			Ждущий.Добавить(СтрокаОписания);
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(Жертва.ТекстSQL) Тогда
		Ждущий.Добавить("");
		Ждущий.Добавить("SQL:");
		Ждущий.Добавить(ПереведённыйТекст(Жертва.ТекстSQL, Карта));
	КонецЕсли;
	ТекстЖертва = СтрСоединить(Ждущий, Символы.ПС);

	Части = Новый Массив;
	Если Виновник.Следующий() Тогда
		Части.Добавить("По ТЖ (DBMSSQL spid " + Формат(Жертва.БлокирующийSpid, "ЧГ=0; ЧН=0") + " до начала ожидания):");
		Части.Добавить(ОписаниеСобытия(Виновник, Карта));
		Части.Добавить("----------");
	ИначеЕсли НЕ ЭтоВзаимоблокировка Тогда
		Части.Добавить("Виновник не найден в ТЖ (нужен DBMSSQL spid " + Формат(Жертва.БлокирующийSpid, "ЧГ=0; ЧН=0")
			+ " за 10 мин до " + Формат(НачалоОжидания, "ДФ=HH:mm:ss") + "), данные SQL Server:");
	КонецЕсли;
	Для Каждого СтрокаОписания Из СтрокиОписания Цикл
		Если НЕ (СтрНачинаетсяС(СтрокаОписания, "Ждущий:") ИЛИ СтрНачинаетсяС(СтрокаОписания, "Жертва:")) Тогда
			Части.Добавить(ПереведённыйТекст(СтрокаОписания, Карта));
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(Жертва.ТекстSQLВиновника) И НЕ ЭтоВзаимоблокировка Тогда
		Части.Добавить("");
		Части.Добавить("SQL блокирующего (последний пакет):");
		Части.Добавить(ПереведённыйТекст(Жертва.ТекстSQLВиновника, Карта));
	КонецЕсли;
	ТекстВиновник = СтрСоединить(Части, Символы.ПС);

	Схема = Новый Массив;
	Схема.Добавить("Ресурс: " + ПереведённыйТекст(СтрЗаменить(Жертва.РесурсОжидания, "|", " | "), Карта));
	Схема.Добавить("Режим блокировки: " + Жертва.РежимБлокировки);
	Схема.Добавить("Начало ожидания: " + Формат(НачалоОжидания, "ДФ='dd.MM.yyyy HH:mm:ss'"));
	Если ЭтоВзаимоблокировка Тогда
		Схема.Добавить("");
		Схема.Добавить("XML:");
		Схема.Добавить(Жертва.Взаимоблокировка);
	КонецЕсли;
	ТекстСхема = СтрСоединить(Схема, Символы.ПС);

КонецПроцедуры

// Событие 1С ждущего spid: первое DBMSSQL той же базы с dbpid ждущего, завершённое
// в [последний отчёт об ожидании; + 10 мин] - запрос, который и ждал блокировку.
&НаСервере
Функция СобытиеЖдущего1С(Жертва)

	Если Жертва.dbpid = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Пользователь КАК Пользователь,
	|	Т.СеансИд КАК СеансИд,
	|	Т.КонтекстТочка КАК КонтекстТочка
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	Т.База = &База
	|	И Т.Время МЕЖДУ &Начало И &Конец
	|	И Т.Событие = ""DBMSSQL""
	|	И Т.dbpid = &Spid
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.Время,
	|	Т.Микросекунды";
	Запрос.УстановитьПараметр("База", Жертва.База);
	Запрос.УстановитьПараметр("Начало", Жертва.Время);
	Запрос.УстановитьПараметр("Конец", Жертва.Время + 600);
	Запрос.УстановитьПараметр("Spid", Жертва.dbpid);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Пользователь,СеансИд,КонтекстТочка",
		Выборка.Пользователь, Выборка.СеансИд, Выборка.КонтекстТочка);

КонецФункции

// Транзакция виновника по ТЖ: события его соединения от последнего Commit/Rollback до события-виновника
// (не раньше 10 мин до него) по первый Commit/Rollback после начала ожидания жертвы (не позже 10 мин).
// Длительность - от начала до конца транзакции; границы, не найденные в ТЖ, помечаются.
&НаСервере
Функция ОписаниеТранзакцииВиновника(Виновник, НачалоОжидания, Карта)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 500
	|	Т.Время КАК Время,
	|	Т.Микросекунды КАК Микросекунды,
	|	Т.Событие КАК Событие,
	|	Т.Функция КАК Функция,
	|	Т.ДлительностьМс КАК ДлительностьМс,
	|	Т.КонтекстТочка КАК КонтекстТочка,
	|	ПОДСТРОКА(Т.Блокировки, 1, 200) КАК Блокировки
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	Т.Сервер = &Сервер
	|	И Т.База = &База
	|	И Т.СоединениеИд = &Соединение
	|	И Т.Время МЕЖДУ &Начало И &Конец
	|	И Т.Событие В (""TLOCK"", ""SDBL"", ""DBMSSQL"", ""DBPOSTGRS"")
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.Время,
	|	Т.Микросекунды";
	Запрос.УстановитьПараметр("Сервер", Виновник.Сервер);
	Запрос.УстановитьПараметр("База", Виновник.База);
	Запрос.УстановитьПараметр("Соединение", Виновник.СоединениеИд);
	Запрос.УстановитьПараметр("Начало", Виновник.Время - 600);
	Запрос.УстановитьПараметр("Конец", Макс(НачалоОжидания, Виновник.Время) + 600);
	Таблица = Запрос.Выполнить().Выгрузить();

	// начало: последний Commit/Rollback раньше события-виновника; конец: первый не раньше начала ожидания
	НомерНачала = -1;
	НомерКонца = -1;
	Для Номер = 0 По Таблица.Количество() - 1 Цикл
		Событие = Таблица[Номер];
		Если НЕ (Событие.Событие = "SDBL"
			И (Событие.Функция = "CommitTransaction" ИЛИ Событие.Функция = "RollbackTransaction")) Тогда
			Продолжить;
		КонецЕсли;
		Если Событие.Время < Виновник.Время Тогда
			НомерНачала = Номер;
		ИначеЕсли Событие.Время >= НачалоОжидания Тогда
			НомерКонца = Номер;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Первый = НомерНачала + 1;
	Последний = ?(НомерКонца >= 0, НомерКонца, Таблица.Количество() - 1);
	Если Первый > Последний Тогда
		Возврат "Транзакция виновника: событий соединения в ТЖ нет";
	КонецЕсли;

	Строки = Новый Массив;
	// время события ТЖ - его окончание; начало транзакции оцениваем по первому событию после прошлого Commit
	НачалоТранзакции = Таблица[Первый].Время - Цел(Таблица[Первый].ДлительностьМс / 1000);
	Если НомерКонца >= 0 Тогда
		Строки.Добавить("Транзакция виновника: " + ?(НомерНачала >= 0, "", "не меньше ")
			+ Формат(Таблица[НомерКонца].Время - НачалоТранзакции, "ЧН=0; ЧГ=0") + " с, "
			+ Формат(НачалоТранзакции, "ДФ=HH:mm:ss") + " - " + Формат(Таблица[НомерКонца].Время, "ДФ=HH:mm:ss")
			+ ", завершена " + ?(Таблица[НомерКонца].Функция = "RollbackTransaction", "отменой", "фиксацией"));
	Иначе
		Строки.Добавить("Транзакция виновника: с " + ?(НомерНачала >= 0, "", "не позже ")
			+ Формат(НачалоТранзакции, "ДФ=HH:mm:ss") + ", Commit/Rollback в ТЖ не найден");
	КонецЕсли;
	Строки.Добавить("Что выполнялось:");
	Для Номер = Первый По Последний Цикл
		Событие = Таблица[Номер];
		Строки.Добавить(Формат(Событие.Время, "ДФ=HH:mm:ss") + "." + Формат(Цел(Событие.Микросекунды / 1000), "ЧЦ=3; ЧВН=; ЧН=000")
			+ " " + Событие.Событие + ?(ЗначениеЗаполнено(Событие.Функция), " " + Событие.Функция, "")
			+ ", " + Формат(Событие.ДлительностьМс / 1000, "ЧДЦ=3; ЧН=0") + " с"
			+ ?(ЗначениеЗаполнено(Событие.Блокировки), ": " + ПереведённыйТекст(Событие.Блокировки, Карта), "")
			+ ?(ЗначениеЗаполнено(Событие.КонтекстТочка), " | " + Событие.КонтекстТочка, ""));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Таблица ресурса ожидания СУБД: часть РесурсОжидания до "|" (имя таблицы хранения).
&НаСервереБезКонтекста
Функция ТаблицаРесурса(РесурсОжидания)

	Позиция = СтрНайти(РесурсОжидания, "|");
	Возврат СокрЛП(?(Позиция = 0, "", Лев(РесурсОжидания, Позиция - 1)));

КонецФункции

// Описание события для колонок «Жертва» / «Виновник».
&НаСервере
Функция ОписаниеСобытия(Событие, Карта)

	Строки = Новый Массив;
	Строки.Добавить("Пользователь: " + Событие.Пользователь);
	Строки.Добавить("Сеанс: " + Формат(Событие.СеансИд, "ЧГ=0; ЧН=0")
		+ ", соединение: " + Формат(Событие.СоединениеИд, "ЧГ=0; ЧН=0")
		+ ?(ЗначениеЗаполнено(Событие.Компьютер), ", компьютер: " + Событие.Компьютер, ""));
	Строки.Добавить("Событие: " + Событие.Событие + " в " + Формат(Событие.Время, "ДФ='dd.MM.yyyy HH:mm:ss'")
		+ ", длительность, с: " + Формат(Событие.ДлительностьМс / 1000, "ЧДЦ=3; ЧН=0"));
	Строки.Добавить("В транзакции: " + Формат(Событие.Транзакция, "БЛ=нет; БИ=да"));
	Строки.Добавить("Контекст: " + Событие.КонтекстТочка);
	Если ЗначениеЗаполнено(Событие.КонтекстСтрока) И Событие.КонтекстСтрока <> Событие.КонтекстТочка Тогда
		Строки.Добавить("    ...  " + Событие.КонтекстСтрока);
	КонецЕсли;
	Если ЗначениеЗаполнено(Событие.Блокировки) Тогда
		Строки.Добавить("Блокировки: " + ПереведённыйТекст(Событие.Блокировки, Карта));
	КонецЕсли;
	Если ЗначениеЗаполнено(Событие.ТекстЗапроса1С) Тогда
		Строки.Добавить("");
		Строки.Добавить("Запрос 1С:");
		Строки.Добавить(Событие.ТекстЗапроса1С);
	ИначеЕсли ЗначениеЗаполнено(Событие.ТекстSQL) Тогда
		Строки.Добавить("");
		Строки.Добавить("SQL:");
		Строки.Добавить(Событие.ТекстSQL);
	КонецЕсли;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Стороны взаимоблокировки: последнее событие каждого соединения из пересечений
// не позже взаимоблокировки (окно - длительность события + 60 с), одним запросом.
&НаСервере
Функция ОписаниеСторонВзаимоблокировки(Жертва, Пары, Карта)

	Соединения = Новый Массив;
	Для Каждого Пара Из Пары Цикл
		Для Каждого Соединение Из СтрРазделить(Пара.Ждёт + "," + Пара.Держит, ",", Ложь) Цикл
			Номер = ЧислоИзСтроки(Соединение);
			Если Номер <> Неопределено И Соединения.Найти(Номер) = Неопределено Тогда
				Соединения.Добавить(Номер);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если Соединения.Количество() = 0 Тогда
		Возврат "стороны не указаны в DeadlockConnectionIntersections";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 100
	|	Т.Ид КАК Ид,
	|	Т.Время КАК Время,
	|	Т.Сервер КАК Сервер,
	|	Т.База КАК База,
	|	Т.Событие КАК Событие,
	|	Т.ДлительностьМс КАК ДлительностьМс,
	|	Т.Пользователь КАК Пользователь,
	|	Т.СеансИд КАК СеансИд,
	|	Т.СоединениеИд КАК СоединениеИд,
	|	Т.Компьютер КАК Компьютер,
	|	Т.Транзакция КАК Транзакция,
	|	Т.КонтекстТочка КАК КонтекстТочка,
	|	Т.КонтекстСтрока КАК КонтекстСтрока,
	|	Т.ТекстЗапроса1С КАК ТекстЗапроса1С,
	|	Т.ТекстSQL КАК ТекстSQL,
	|	Т.Блокировки КАК Блокировки
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	Т.Сервер = &Сервер
	|	И Т.База = &База
	|	И Т.СоединениеИд В (&Соединения)
	|	И Т.Время МЕЖДУ &Начало И &Конец
	|	И Т.Ид <> &Ид
	|	И Т.Событие В (""TLOCK"", ""TTIMEOUT"", ""SDBL"", ""DBMSSQL"", ""DBPOSTGRS"")
	|
	|УПОРЯДОЧИТЬ ПО
	|	Время УБЫВ";
	Запрос.УстановитьПараметр("Сервер", Жертва.Сервер);
	Запрос.УстановитьПараметр("База", Жертва.База);
	Запрос.УстановитьПараметр("Соединения", Соединения);
	Запрос.УстановитьПараметр("Начало", Жертва.Время - Окр(Жертва.ДлительностьМс / 1000) - 60);
	Запрос.УстановитьПараметр("Конец", Жертва.Время);
	Запрос.УстановитьПараметр("Ид", Жертва.Ид);
	Выборка = Запрос.Выполнить().Выбрать();

	Найденные = Новый Соответствие;
	Части = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если Найденные[Выборка.СоединениеИд] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Найденные.Вставить(Выборка.СоединениеИд, Истина);
		Части.Добавить("Соединение " + Формат(Выборка.СоединениеИд, "ЧГ=0") + ":" + Символы.ПС
			+ ОписаниеСобытия(Выборка, Карта));
	КонецЦикла;
	Для Каждого Номер Из Соединения Цикл
		Если Найденные[Номер] = Неопределено Тогда
			Части.Добавить("Соединение " + Формат(Номер, "ЧГ=0") + ": виновник не найден в ТЖ (нужен TLOCK без порога)");
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, Символы.ПС + "----------" + Символы.ПС);

КонецФункции

&НаСервере
Функция СхемаВзаимоблокировки(Пары, Карта)

	Если Пары.Количество() = 0 Тогда
		Возврат рбфАнализСервер.НетДанных();
	КонецЕсли;
	Строки = Новый Массив;
	Для Каждого Пара Из Пары Цикл
		Строки.Добавить("Соединение " + Пара.Ждёт + " ждёт соединение " + Пара.Держит + ": "
			+ ПереведённыйТекст(Пара.Пространство, Карта));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаСервереБезКонтекста
Функция ПереведённыйТекст(Текст, Карта)

	Если Карта = Неопределено Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат рбфАнализСервер.ПеревестиИменаХранения(Текст, Карта);

КонецФункции

// Пары «ждёт - держит - пространство» из DeadlockConnectionIntersections:
// "ждёт держит пространство режим поля,...".
&НаСервереБезКонтекста
Функция ПарыВзаимоблокировки(Пересечения)

	Пары = Новый Массив;
	Для Каждого Пересечение Из СтрРазделить(Пересечения, ",", Ложь) Цикл
		Слова = СтрРазделить(СокрЛП(Пересечение), " ", Ложь);
		Если Слова.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		Ждёт = Слова[0];
		Держит = Слова[1];
		Слова.Удалить(0);
		Слова.Удалить(0);
		Пары.Добавить(Новый Структура("Ждёт,Держит,Пространство", Ждёт, Держит, СтрСоединить(Слова, " ")));
	КонецЦикла;
	Возврат Пары;

КонецФункции

// Пространство блокировки - первое слово описания Locks до пробела или точки: "AccumRg123.DIMS Exclusive ..." -> "AccumRg123".
&НаСервереБезКонтекста
Функция ПространствоБлокировки(Описание)

	Текст = СокрЛП(Описание);
	Если СтрНачинаетсяС(Текст, "Space=") Тогда
		Текст = Сред(Текст, 7);
	КонецЕсли;
	Конец = СтрДлина(Текст) + 1;
	Для Каждого Разделитель Из СтрРазделить(" |.|,", "|", Ложь) Цикл
		Позиция = СтрНайти(Текст, Разделитель);
		Если Позиция > 0 И Позиция < Конец Тогда
			Конец = Позиция;
		КонецЕсли;
	КонецЦикла;
	Возврат Лев(Текст, Конец - 1);

КонецФункции

// Пространство первой пары взаимоблокировки: "ждёт держит Пространство.Индекс режим ..." -> "Пространство".
&НаСервереБезКонтекста
Функция ПространствоВзаимоблокировки(Описание)

	Слова = СтрРазделить(СокрЛП(Описание), " ", Ложь);
	Если Слова.Количество() < 3 Тогда
		Возврат "";
	КонецЕсли;
	Возврат ПространствоБлокировки(Слова[2]);

КонецФункции

&НаСервереБезКонтекста
Функция ЧислоИзСтроки(Текст)

	Значение = СокрЛП(Текст);
	Если НЕ ЗначениеЗаполнено(Значение) ИЛИ СтрНайтиПоРегулярномуВыражению(Значение, "^[0-9]+$").НачальнаяПозиция = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Число(Значение);

КонецФункции

&НаСервере
Функция ЭтоТекущаяБаза(База)

	Возврат ЗначениеЗаполнено(ТекущаяБаза) И НРег(База) = НРег(ТекущаяБаза);

КонецФункции

&НаСервере
Функция УсловиеСобытий(Запрос)

	События = Новый Массив;
	Если Вид = "Взаимоблокировки" Тогда
		События.Добавить("TDEADLOCK");
	ИначеЕсли Вид = "СУБД" Тогда
		События.Добавить("SQLBLOCK");
		События.Добавить("SQLDEADLOCK");
	Иначе
		События.Добавить("TLOCK");
		События.Добавить("TTIMEOUT");
	КонецЕсли;
	Отбор = рбфАнализСервер.Отбор(ЭтотОбъект);
	Условие = рбфАнализСервер.УсловиеОтбораВыполненийТЖ(Запрос, Отбор, События);
	// «Блокировки» - только ожидания: TLOCK без WaitConnections хранятся лишь как виновники (методика ИТС)
	Если Вид = "Блокировки" Тогда
		Условие = "(" + Условие + ")
		|	И (Т.Событие <> ""TLOCK""
		|		ИЛИ Т.ЖдалСоединения <> """")";
	КонецЕсли;
	Возврат Условие;

КонецФункции

#КонецОбласти
