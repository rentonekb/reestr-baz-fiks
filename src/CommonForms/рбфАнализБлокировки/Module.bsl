// Раздел «Анализ», страницы «Блокировки» (TLOCK, TTIMEOUT) и «Взаимоблокировки» (TDEADLOCK):
// компоновка как у 1С-Монитора, данные - отдельные события ТЖ (рбфВыполненияТЖ).
// Слева - пространства блокировок (по карте имён - регистр / справочник) с количеством
// и суммарным ожиданием, справа - ожидания по времени, внизу - «Жертва» и «Виновник»:
// пользователь, сеанс, контекст (точка входа и строка), запрос 1С, транзакция; страница «Схема».
// Виновник ожидания - последнее событие соединения из WaitConnections до конца ожидания
// (рбфСобытияТЖСервер.ЗаполнитьВиновника), у взаимоблокировки - вторая сторона из
// DeadlockConnectionIntersections.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Элементы.Вид.СписокВыбора.Добавить("Блокировки");
	Элементы.Вид.СписокВыбора.Добавить("Взаимоблокировки");
	Элементы.Вид.РежимВыбораИзСписка = Истина;
	Вид = ?(Параметры.Вид = "Взаимоблокировки", "Взаимоблокировки", "Блокировки");

	рбфАнализСервер.ЗаполнитьШапку(ЭтотОбъект);
	ОбновитьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыГруппы

&НаКлиенте
Процедура ГруппыПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьОжидания", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОжидания

&НаКлиенте
Процедура ОжиданияПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьПодробности", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьОбработка(Команда)

	ОбновитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодОбработка(Команда)

	рбфАнализКлиент.ВыбратьПериод(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ДопФильтрОбработка(Команда)

	рбфАнализКлиент.ПереключитьДопФильтр(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПоказатьОжидания()

	ТекущиеДанные = Элементы.Группы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьОжидания(ТекущиеДанные.ПространствоКлюч, ТекущиеДанные.База);
	ПоказатьПодробности();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПодробности()

	ТекущиеДанные = Элементы.Ожидания.ТекущиеДанные;
	ЗаполнитьПодробности(?(ТекущиеДанные = Неопределено, "", ТекущиеДанные.Ид));

КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере()

	Заголовок = Вид;
	ЭтоВзаимоблокировки = (Вид = "Взаимоблокировки");
	Элементы.ГруппаЖертва.Заголовок = ?(ЭтоВзаимоблокировки, НСтр("ru = 'Сторона 1 (получила взаимоблокировку)'"),
		НСтр("ru = 'Жертва (ждала)'"));
	Элементы.ГруппаВиновник.Заголовок = ?(ЭтоВзаимоблокировки, НСтр("ru = 'Сторона 2'"),
		НСтр("ru = 'Виновник (держал блокировку)'"));

	Отбор = рбфАнализСервер.Отбор(ЭтотОбъект);
	Запрос = Новый Запрос;
	Условие = рбфАнализСервер.УсловиеОтбораВыполнений(Запрос, Отбор, СобытияВида(Вид));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Пространство КАК ПространствоКлюч,
	|	Т.База КАК База,
	|	КОЛИЧЕСТВО(*) КАК Количество,
	|	СУММА(Т.ДлительностьМс) / 1000 КАК ОжиданиеСек
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	" + Условие + "
	|	И (Т.Событие <> ""TLOCK"" ИЛИ Т.ЖдалСоединения <> """")
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.Пространство,
	|	Т.База
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОжиданиеСек УБЫВ";
	// TLOCK без WaitConnections - установка блокировки без ожидания, это не проблема
	Таблица = Запрос.Выполнить().Выгрузить();

	Карты = Новый Соответствие;
	Группы.Очистить();
	Для Каждого Строка Из Таблица Цикл
		НоваяСтрока = Группы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		Карта = КартаБазы(Карты, Строка.База);
		НоваяСтрока.Пространство = ?(ЗначениеЗаполнено(Строка.ПространствоКлюч),
			рбфСобытияТЖСервер.ПредставлениеПространства(Строка.ПространствоКлюч, Карта), НСтр("ru = '<пространство не указано>'"))
			+ ?(ЗначениеЗаполнено(Отбор.База), "", " [" + Строка.База + "]");
	КонецЦикла;

	СостояниеДанных = "";
	Если Группы.Количество() = 0 Тогда
		СостояниеДанных = НСтр("ru = 'Событий за период нет. Детальные события ТЖ присылает tj-analyzer (export-events) или агент через rbf-admin/tj-events; в «Настройка ТЖ» у базы должны быть включены ожидание на блокировке и транзакции (для взаимоблокировок - ещё и взаимоблокировка).'");
	КонецЕсли;
	Элементы.СостояниеДанных.Видимость = ЗначениеЗаполнено(СостояниеДанных);

	Если Группы.Количество() > 0 Тогда
		ЗаполнитьОжидания(Группы[0].ПространствоКлюч, Группы[0].База);
	Иначе
		Ожидания.Очистить();
	КонецЕсли;
	ЗаполнитьПодробности(?(Ожидания.Количество() = 0, "", Ожидания[0].Ид));

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОжидания(ПространствоКлюч, База)

	Отбор = рбфАнализСервер.Отбор(ЭтотОбъект);
	Запрос = Новый Запрос;
	Условие = рбфАнализСервер.УсловиеОтбораВыполнений(Запрос, Отбор, СобытияВида(Вид));
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1000
	|	Т.Ид КАК Ид,
	|	Т.Время КАК Время,
	|	Т.ДлительностьМс / 1000 КАК ЖдалСек,
	|	Т.Событие КАК Событие,
	|	Т.Пользователь КАК Пользователь,
	|	Т.КонтекстТочка КАК КонтекстТочка,
	|	Т.ВиновникПользователь КАК Виновник
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	" + Условие + "
	|	И (Т.Событие <> ""TLOCK"" ИЛИ Т.ЖдалСоединения <> """")
	|	И Т.Пространство = &Пространство
	|	И Т.База = &База
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.Момент УБЫВ";
	Запрос.УстановитьПараметр("Пространство", ПространствоКлюч);
	Запрос.УстановитьПараметр("База", База);
	Ожидания.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодробности(Ид)

	Схема.Очистить();
	ТекстБлокировка = "";
	ТекстКонтекст = "";
	Данные = ?(ЗначениеЗаполнено(Ид), рбфСобытияТЖСервер.ДанныеСобытия(Ид), Неопределено);
	Если Данные = Неопределено Тогда
		ЗаполнитьСторону("Жертва", Неопределено, "");
		ЗаполнитьСторону("Виновник", Неопределено, "");
		Возврат;
	КонецЕсли;
	Карта = рбфСобытияТЖСервер.КартаИмён(Данные.База);

	Если Данные.Событие = "TDEADLOCK" Тогда
		ПоказатьВзаимоблокировку(Данные, Карта);
		Возврат;
	КонецЕсли;

	// виновник ищется и при просмотре: его события могли прийти позже ожидания
	Если НЕ ЗначениеЗаполнено(Данные.ВиновникИд) И ЗначениеЗаполнено(Данные.ЖдалСоединения) Тогда
		Если рбфСобытияТЖСервер.ЗаполнитьВиновника(Ид) Тогда
			Данные = рбфСобытияТЖСервер.ДанныеСобытия(Ид);
			Найденные = Ожидания.НайтиСтроки(Новый Структура("Ид", Ид));
			Если Найденные.Количество() > 0 Тогда
				Найденные[0].Виновник = Данные.ВиновникПользователь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	ЗаполнитьСторону("Жертва", Данные, СтрШаблон(НСтр("ru = 'ждал %1 с (%2), в транзакции: %3'"),
		Формат(Данные.ДлительностьМс / 1000, "ЧДЦ=3; ЧН=0"), Данные.Событие, Данные.Транзакция));

	Виновник = Неопределено;
	Если ЗначениеЗаполнено(Данные.ВиновникИд) Тогда
		Виновник = ВиновникСЗапросом(Данные.ВиновникИд, Данные.ВиновникНачалоТранзакции);
	КонецЕсли;
	Если Виновник = Неопределено Тогда
		ЗаполнитьСторону("Виновник", Неопределено, ?(ЗначениеЗаполнено(Данные.ЖдалСоединения),
			СтрШаблон(НСтр("ru = 'Не найден: нет событий соединения %1 до конца ожидания. Включите в «Настройка ТЖ» ожидание на блокировке и транзакции - тогда видно, кто взял блокировку.'"),
				Данные.ЖдалСоединения),
			НСтр("ru = 'В событии нет WaitConnections - платформа не указала, кого ждали.'")));
	Иначе
		ЗаполнитьСторону("Виновник", Виновник, СтрШаблон(НСтр("ru = 'начало транзакции %1, последнее событие %2 в %3'"),
			Формат(Данные.ВиновникНачалоТранзакции, "ДФ='dd.MM.yyyy HH:mm:ss'; ДП=-"), Виновник.Событие,
			Формат(Виновник.Время, "ДФ='HH:mm:ss'")));
	КонецЕсли;

	// схема: кто кого ждал
	Пары = Новый Массив;
	Для Каждого Соединение Из СтрРазделить(Данные.ЖдалСоединения, ",", Ложь) Цикл
		Держит = СокрЛП(Соединение);
		ДержитПользователь = "";
		Если Виновник <> Неопределено И Формат(Виновник.СоединениеИд, "ЧГ=") = Держит Тогда
			ДержитПользователь = Виновник.Пользователь;
		КонецЕсли;
		Пары.Добавить(Новый Структура("Ждёт,Держит,Пространство",
			ПредставлениеСоединения(Формат(Данные.СоединениеИд, "ЧГ="), Данные.Пользователь),
			ПредставлениеСоединения(Держит, ДержитПользователь),
			рбфСобытияТЖСервер.ПредставлениеПространства(Данные.Пространство, Карта)));
	КонецЦикла;
	ВывестиСхему(Пары);

	ТекстБлокировка = "Блокировки (Locks):" + Символы.ПС + ИменаПространств(Данные.Пространства, Карта)
		+ Символы.ПС + Символы.ПС + "Ждал соединения (WaitConnections): " + Данные.ЖдалСоединения;
	ТекстКонтекст = "Жертва:" + Символы.ПС + Данные.КонтекстПолный + Символы.ПС + Символы.ПС + "Виновник:" + Символы.ПС
		+ ?(Виновник = Неопределено, "-", Виновник.КонтекстПолный);

КонецПроцедуры

// TDEADLOCK: сторона 1 - соединение события (получило ошибку), сторона 2 - соединение,
// которое оно ждало по DeadlockConnectionIntersections; схема - все пересечения.
&НаСервере
Процедура ПоказатьВзаимоблокировку(Данные, Карта)

	Своё = Формат(Данные.СоединениеИд, "ЧГ=");
	Другое = "";
	Пары = Новый Массив;
	Пользователи = Новый Соответствие;
	Пользователи.Вставить(Своё, Данные.Пользователь);
	Стороны = Новый Соответствие;
	Для Каждого Пересечение Из СтрРазделить(Данные.ПересеченияВзаимоблокировки, ",", Ложь) Цикл
		Слова = СтрРазделить(СокрЛП(Пересечение), " ", Ложь);
		Если Слова.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		Ждёт = Слова[0];
		Держит = Слова[1];
		Если Ждёт = Своё И НЕ ЗначениеЗаполнено(Другое) Тогда
			Другое = Держит;
		КонецЕсли;
		Для Каждого Номер Из СтрРазделить(Ждёт + "," + Держит, ",") Цикл
			Если Стороны.Получить(Номер) = Неопределено И Номер <> Своё Тогда
				// @skip-check query-in-loop - сторон взаимоблокировки две-три
				Сторона = рбфСобытияТЖСервер.ПоследнееСобытиеСоединения(Данные.Сервер, Данные.База,
					ЧислоИзСтроки(Номер), Данные.Момент);
				Стороны.Вставить(Номер, Сторона);
				Если Сторона <> Неопределено Тогда
					Пользователи.Вставить(Номер, Сторона.Пользователь);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Слова.Удалить(0);
		Слова.Удалить(0);
		Пространство = "";
		Если Слова.Количество() > 0 Тогда
			Пространство = Слова[0];
			Слова.Удалить(0);
		КонецЕсли;
		Пары.Добавить(Новый Структура("Ждёт,Держит,Пространство", Ждёт, Держит,
			рбфСобытияТЖСервер.ПредставлениеПространства(Пространство, Карта) + " " + СтрСоединить(Слова, " ")));
	КонецЦикла;
	Если НЕ ЗначениеЗаполнено(Другое) И Пары.Количество() > 0 Тогда
		Другое = ?(Пары[0].Ждёт = Своё, Пары[0].Держит, Пары[0].Ждёт);
	КонецЕсли;
	Для Каждого Пара Из Пары Цикл
		Пара.Ждёт = ПредставлениеСоединения(Пара.Ждёт, Пользователи.Получить(Пара.Ждёт));
		Пара.Держит = ПредставлениеСоединения(Пара.Держит, Пользователи.Получить(Пара.Держит));
	КонецЦикла;
	ВывестиСхему(Пары);

	ЗаполнитьСторону("Жертва", Данные, НСтр("ru = 'получила ошибку взаимоблокировки, в транзакции: '") + Данные.Транзакция);
	Сторона = Стороны.Получить(Другое);
	Вторая = Неопределено;
	Если Сторона <> Неопределено Тогда
		Вторая = ВиновникСЗапросом(Сторона.Ид, Дата(1, 1, 1));
	КонецЕсли;
	Если Вторая = Неопределено Тогда
		ЗаполнитьСторону("Виновник", Неопределено, ?(ЗначениеЗаполнено(Другое),
			СтрШаблон(НСтр("ru = 'Нет событий соединения %1 до взаимоблокировки: включите ожидание на блокировке и транзакции в «Настройка ТЖ».'"), Другое),
			НСтр("ru = 'В событии нет DeadlockConnectionIntersections.'")));
	Иначе
		ЗаполнитьСторону("Виновник", Вторая, СтрШаблон(НСтр("ru = 'последнее событие %1 в %2'"), Вторая.Событие,
			Формат(Вторая.Время, "ДФ='HH:mm:ss'")));
	КонецЕсли;

	ТекстБлокировка = "DeadlockConnectionIntersections:" + Символы.ПС + Данные.ПересеченияВзаимоблокировки;
	ТекстКонтекст = "Сторона 1:" + Символы.ПС + Данные.КонтекстПолный + Символы.ПС + Символы.ПС + "Сторона 2:"
		+ Символы.ПС + ?(Вторая = Неопределено, "-", Вторая.КонтекстПолный);

КонецПроцедуры

// Данные события виновника; если в нём нет текста запроса (последнее событие - TLOCK),
// запрос 1С берётся из последнего запроса того же соединения в той же транзакции.
&НаСервере
Функция ВиновникСЗапросом(ИдВиновника, НачалоТранзакции)

	Виновник = рбфСобытияТЖСервер.ДанныеСобытия(ИдВиновника);
	Если Виновник = Неопределено ИЛИ ЗначениеЗаполнено(Виновник.ТекстЗапроса1С) ИЛИ ЗначениеЗаполнено(Виновник.ТекстSQL) Тогда
		Возврат Виновник;
	КонецЕсли;
	ИдЗапроса = рбфСобытияТЖСервер.ПоследнийЗапросСоединения(Виновник.Сервер, Виновник.База, Виновник.СоединениеИд,
		Виновник.Момент, рбфСобытияТЖСервер.МоментДаты(НачалоТранзакции));
	Если ЗначениеЗаполнено(ИдЗапроса) Тогда
		ЗапросВиновника = рбфСобытияТЖСервер.ДанныеСобытия(ИдЗапроса);
		Если ЗапросВиновника <> Неопределено Тогда
			Виновник.ТекстЗапроса1С = ЗапросВиновника.ТекстЗапроса1С;
			Виновник.ТекстSQL = ЗапросВиновника.ТекстSQL;
		КонецЕсли;
	КонецЕсли;
	Возврат Виновник;

КонецФункции

&НаСервере
Процедура ЗаполнитьСторону(Префикс, Данные, Транзакция)

	Если Данные = Неопределено Тогда
		ЭтотОбъект[Префикс + "Пользователь"] = "";
		ЭтотОбъект[Префикс + "Сеанс"] = "";
		ЭтотОбъект[Префикс + "Компьютер"] = "";
		ЭтотОбъект[Префикс + "КонтекстТочка"] = "";
		ЭтотОбъект[Префикс + "КонтекстСтрока"] = "";
		ЭтотОбъект[Префикс + "Транзакция"] = Транзакция;
		ЭтотОбъект[Префикс + "Запрос1С"] = "";
		Возврат;
	КонецЕсли;
	ЭтотОбъект[Префикс + "Пользователь"] = Данные.Пользователь;
	ЭтотОбъект[Префикс + "Сеанс"] = СтрШаблон(НСтр("ru = 'сеанс %1, соединение %2'"),
		Формат(Данные.СеансИд, "ЧГ=; ЧН=-"), Формат(Данные.СоединениеИд, "ЧГ=; ЧН=-"));
	ЭтотОбъект[Префикс + "Компьютер"] = Данные.Компьютер + ?(ЗначениеЗаполнено(Данные.Приложение), ", " + Данные.Приложение, "");
	ЭтотОбъект[Префикс + "КонтекстТочка"] = Данные.КонтекстТочка;
	ЭтотОбъект[Префикс + "КонтекстСтрока"] = Данные.КонтекстСтрока;
	ЭтотОбъект[Префикс + "Транзакция"] = Транзакция;
	Если ЗначениеЗаполнено(Данные.ТекстЗапроса1С) Тогда
		ЭтотОбъект[Префикс + "Запрос1С"] = Данные.ТекстЗапроса1С;
	ИначеЕсли ЗначениеЗаполнено(Данные.ТекстSQL) Тогда
		ЭтотОбъект[Префикс + "Запрос1С"] = "SQL: " + Данные.ТекстSQL;
	Иначе
		ЭтотОбъект[Префикс + "Запрос1С"] = НСтр("ru = 'запроса в событиях соединения нет'");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ВывестиСхему(Пары)

	Если Пары.Количество() = 0 Тогда
		Схема.Область("R1C1").Текст = НСтр("ru = 'Нет данных для схемы: в событии нет WaitConnections / DeadlockConnectionIntersections.'");
		Возврат;
	КонецЕсли;
	Шапка = Новый Массив;
	Шапка.Добавить(НСтр("ru = 'Ждёт (соединение, пользователь)'"));
	Шапка.Добавить(НСтр("ru = 'Держит (соединение, пользователь)'"));
	Шапка.Добавить(НСтр("ru = 'Пространство, режим, поля'"));
	Для Колонка = 1 По Шапка.Количество() Цикл
		Область = Схема.Область("R1C" + Формат(Колонка, "ЧГ="));
		Область.Текст = Шапка[Колонка - 1];
		Область.Шрифт = Новый Шрифт(, , Истина);
	КонецЦикла;
	Схема.Область("C1").ШиринаКолонки = 30;
	Схема.Область("C2").ШиринаКолонки = 30;
	Схема.Область("C3").ШиринаКолонки = 80;
	НомерСтроки = 1;
	Для Каждого Пара Из Пары Цикл
		НомерСтроки = НомерСтроки + 1;
		Префикс = "R" + Формат(НомерСтроки, "ЧГ=") + "C";
		Схема.Область(Префикс + "1").Текст = Пара.Ждёт;
		Схема.Область(Префикс + "2").Текст = Пара.Держит;
		Схема.Область(Префикс + "3").Текст = Пара.Пространство;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПредставлениеСоединения(Соединение, Пользователь)

	Возврат Соединение + ?(ЗначениеЗаполнено(Пользователь), " (" + Пользователь + ")", "");

КонецФункции

// Locks по строке на пространство, с именами метаданных по карте.
&НаСервереБезКонтекста
Функция ИменаПространств(Блокировки, Карта)

	Строки = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Блокировки, ",", Ложь) Цикл
		Слова = СтрРазделить(СокрЛП(Часть), " ", Ложь);
		Если Слова.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Слова[0] = рбфСобытияТЖСервер.ПредставлениеПространства(Слова[0], Карта);
		Строки.Добавить(СтрСоединить(Слова, " "));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаСервереБезКонтекста
Функция ЧислоИзСтроки(Текст)

	Попытка
		Возврат Число(СокрЛП(Текст));
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

&НаСервереБезКонтекста
Функция КартаБазы(Карты, База)

	Карта = Карты.Получить(База);
	Если Карта = Неопределено Тогда
		Карта = рбфСобытияТЖСервер.КартаИмён(База);
		Карты.Вставить(База, Карта);
	КонецЕсли;
	Возврат Карта;

КонецФункции

&НаСервереБезКонтекста
Функция СобытияВида(Вид)

	События = Новый Массив;
	Если Вид = "Взаимоблокировки" Тогда
		События.Добавить("TDEADLOCK");
	Иначе
		События.Добавить("TLOCK");
		События.Добавить("TTIMEOUT");
	КонецЕсли;
	Возврат События;

КонецФункции

#КонецОбласти
