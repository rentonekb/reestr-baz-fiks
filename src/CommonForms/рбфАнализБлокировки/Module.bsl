// Раздел «Анализ», страницы «Блокировки» (TLOCK, TTIMEOUT) и «Взаимоблокировки» (TDEADLOCK):
// компоновка как у 1С-Монитора по отдельным событиям ТЖ (рбфВыполненияТЖ). Слева - пространства
// блокировок с количеством и суммарным ожиданием, справа - ожидания выбранного пространства,
// внизу - «Жертва» и «Виновник» (виновник ожидания - запись по ВиновникИд, у взаимоблокировки -
// последние события соединений из DeadlockConnectionIntersections) и «Схема».
// Имена хранения переводятся в имена метаданных только для текущей ИБ (карта есть только у неё).

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Элементы.Вид.СписокВыбора.Добавить("Блокировки");
	Элементы.Вид.СписокВыбора.Добавить("Взаимоблокировки");
	Элементы.Вид.РежимВыбораИзСписка = Истина;
	Вид = ?(Параметры.Вид = "Взаимоблокировки", "Взаимоблокировки", "Блокировки");
	ТекущаяБаза = рбфАнализСервер.ИмяТекущейИнформационнойБазы();

	рбфАнализСервер.ЗаполнитьШапку(ЭтотОбъект);
	ОбновитьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОбъекты

&НаКлиенте
Процедура ОбъектыПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьСписок", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьПодробности", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьОбработка(Команда)

	ОбновитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодОбработка(Команда)

	рбфАнализКлиент.ВыбратьПериод(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ДопФильтрОбработка(Команда)

	рбфАнализКлиент.ПереключитьДопФильтр(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПоказатьСписок()

	ТекущиеДанные = Элементы.Объекты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьСписок(ТекущиеДанные.Пространство);
	ПоказатьПодробности();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПодробности()

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	ЗаполнитьПодробности(?(ТекущиеДанные = Неопределено, "", ТекущиеДанные.Ид));

КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере()

	Заголовок = Вид;
	Элементы.ГруппаВиновник.Заголовок = ?(Вид = "Взаимоблокировки", "Другие стороны", "Виновник");
	ЭтоВзаимоблокировки = (Вид = "Взаимоблокировки");

	// Пространство - первое слово описания блокировки, поэтому группы собираются из групп по началу
	// описания (ПЕРВЫЕ 1000 различных начал) и складываются по пространству здесь.
	Запрос = Новый Запрос;
	Условие = УсловиеСобытий(Запрос);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1000
	|	ПОДСТРОКА(Т.Блокировки, 1, 200) КАК Описание,
	|	ПОДСТРОКА(Т.Взаимоблокировка, 1, 200) КАК ОписаниеВзаимоблокировки,
	|	Т.База КАК База,
	|	КОЛИЧЕСТВО(*) КАК Количество,
	|	СУММА(Т.ДлительностьМс) / 1000 КАК Сек
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	" + Условие + "
	|
	|СГРУППИРОВАТЬ ПО
	|	ПОДСТРОКА(Т.Блокировки, 1, 200),
	|	ПОДСТРОКА(Т.Взаимоблокировка, 1, 200),
	|	Т.База
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сек УБЫВ";
	Таблица = Запрос.Выполнить().Выгрузить();

	Таблица.Колонки.Добавить("Пространство", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Объект", Новый ОписаниеТипов("Строка"));
	Карта = Неопределено;
	Для Каждого Строка Из Таблица Цикл
		Если ЭтоВзаимоблокировки Тогда
			Строка.Пространство = ПространствоВзаимоблокировки(Строка.ОписаниеВзаимоблокировки);
		Иначе
			Строка.Пространство = ПространствоБлокировки(Строка.Описание);
		КонецЕсли;
		Строка.Объект = Строка.Пространство;
		Если ЭтоТекущаяБаза(Строка.База) И ЗначениеЗаполнено(Строка.Пространство) Тогда
			Если Карта = Неопределено Тогда
				Карта = рбфАнализСервер.КартаИменТаблиц();
			КонецЕсли;
			Строка.Объект = рбфАнализСервер.ПеревестиИменаХранения(Строка.Пространство, Карта);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Строка.Объект) Тогда
			Строка.Объект = "(пространство не указано)";
		КонецЕсли;
	КонецЦикла;
	Таблица.Свернуть("Пространство,Объект", "Количество,Сек");
	Таблица.Сортировать("Сек УБЫВ");
	Объекты.Загрузить(Таблица);

	Если Объекты.Количество() > 0 Тогда
		ЗаполнитьСписок(Объекты[0].Пространство);
	Иначе
		Список.Очистить();
	КонецЕсли;
	ЗаполнитьПодробности(?(Список.Количество() = 0, "", Список[0].Ид));

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписок(Пространство)

	ЭтоВзаимоблокировки = (Вид = "Взаимоблокировки");
	Поле = ?(ЭтоВзаимоблокировки, "Т.Взаимоблокировка", "Т.Блокировки");
	Запрос = Новый Запрос;
	Условия = Новый Массив;
	Условия.Добавить(УсловиеСобытий(Запрос));
	Если НЕ ЗначениеЗаполнено(Пространство) Тогда
		Условия.Добавить("ПОДСТРОКА(" + Поле + ", 1, 200) = """"");
	ИначеЕсли ЭтоВзаимоблокировки Тогда
		// пересечение: "ждёт держит Пространство режим поля"
		Условия.Добавить("(ПОДСТРОКА(" + Поле + ", 1, 1024) ПОДОБНО &ШаблонТочка СПЕЦСИМВОЛ ""~""
		|		ИЛИ ПОДСТРОКА(" + Поле + ", 1, 1024) ПОДОБНО &ШаблонПробел СПЕЦСИМВОЛ ""~"")");
		Запрос.УстановитьПараметр("ШаблонТочка", "% " + рбфАнализСервер.ТекстДляПодобно(Пространство) + ".%");
		Запрос.УстановитьПараметр("ШаблонПробел", "% " + рбфАнализСервер.ТекстДляПодобно(Пространство) + " %");
	Иначе
		Условия.Добавить("(ПОДСТРОКА(" + Поле + ", 1, 200) ПОДОБНО &ШаблонТочка СПЕЦСИМВОЛ ""~""
		|		ИЛИ ПОДСТРОКА(" + Поле + ", 1, 200) ПОДОБНО &ШаблонПробел СПЕЦСИМВОЛ ""~""
		|		ИЛИ ПОДСТРОКА(" + Поле + ", 1, 200) = &Пространство)");
		Запрос.УстановитьПараметр("ШаблонТочка", рбфАнализСервер.ТекстДляПодобно(Пространство) + ".%");
		Запрос.УстановитьПараметр("ШаблонПробел", рбфАнализСервер.ТекстДляПодобно(Пространство) + " %");
		Запрос.УстановитьПараметр("Пространство", Пространство);
	КонецЕсли;

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 500
	|	Т.Ид КАК Ид,
	|	Т.Время КАК Время,
	|	Т.Событие КАК Событие,
	|	Т.ДлительностьМс / 1000 КАК Сек,
	|	Т.Пользователь КАК Пользователь,
	|	Т.КонтекстТочка КАК КонтекстТочка
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	" + СтрСоединить(Условия, Символы.ПС + "	И ") + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Время УБЫВ";
	Список.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодробности(Ид)

	ТекстЖертва = "";
	ТекстВиновник = "";
	ТекстСхема = "";
	Если НЕ ЗначениеЗаполнено(Ид) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ид КАК Ид,
	|	Т.Время КАК Время,
	|	Т.Сервер КАК Сервер,
	|	Т.База КАК База,
	|	Т.Событие КАК Событие,
	|	Т.ДлительностьМс КАК ДлительностьМс,
	|	Т.Пользователь КАК Пользователь,
	|	Т.СеансИд КАК СеансИд,
	|	Т.СоединениеИд КАК СоединениеИд,
	|	Т.Компьютер КАК Компьютер,
	|	Т.Транзакция КАК Транзакция,
	|	Т.КонтекстТочка КАК КонтекстТочка,
	|	Т.КонтекстСтрока КАК КонтекстСтрока,
	|	Т.ТекстЗапроса1С КАК ТекстЗапроса1С,
	|	Т.ТекстSQL КАК ТекстSQL,
	|	Т.Блокировки КАК Блокировки,
	|	Т.ЖдалСоединения КАК ЖдалСоединения,
	|	Т.Взаимоблокировка КАК Взаимоблокировка,
	|	Т.ВиновникИд КАК ВиновникИд
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	Т.Ид = &Ид
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	В.Ид КАК Ид,
	|	В.Время КАК Время,
	|	В.Сервер КАК Сервер,
	|	В.База КАК База,
	|	В.Событие КАК Событие,
	|	В.ДлительностьМс КАК ДлительностьМс,
	|	В.Пользователь КАК Пользователь,
	|	В.СеансИд КАК СеансИд,
	|	В.СоединениеИд КАК СоединениеИд,
	|	В.Компьютер КАК Компьютер,
	|	В.Транзакция КАК Транзакция,
	|	В.КонтекстТочка КАК КонтекстТочка,
	|	В.КонтекстСтрока КАК КонтекстСтрока,
	|	В.ТекстЗапроса1С КАК ТекстЗапроса1С,
	|	В.ТекстSQL КАК ТекстSQL,
	|	В.Блокировки КАК Блокировки,
	|	В.ЖдалСоединения КАК ЖдалСоединения,
	|	В.Взаимоблокировка КАК Взаимоблокировка,
	|	В.ВиновникИд КАК ВиновникИд
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.рбфВыполненияТЖ КАК В
	|		ПО (В.Ид = Т.ВиновникИд)
	|ГДЕ
	|	Т.Ид = &Ид
	|	И Т.ВиновникИд <> """"";
	Запрос.УстановитьПараметр("Ид", Ид);
	Результаты = Запрос.ВыполнитьПакет();
	Жертва = Результаты[0].Выбрать();
	Если НЕ Жертва.Следующий() Тогда
		Возврат;
	КонецЕсли;

	Карта = ?(ЭтоТекущаяБаза(Жертва.База), рбфАнализСервер.КартаИменТаблиц(), Неопределено);
	ТекстЖертва = ОписаниеСобытия(Жертва, Карта);

	Если Жертва.Событие = "TDEADLOCK" Тогда
		Пары = ПарыВзаимоблокировки(Жертва.Взаимоблокировка);
		ТекстВиновник = ОписаниеСторонВзаимоблокировки(Жертва, Пары, Карта);
		ТекстСхема = СхемаВзаимоблокировки(Пары, Карта);
		Возврат;
	КонецЕсли;

	Виновник = Результаты[1].Выбрать();
	Если Виновник.Следующий() Тогда
		ТекстВиновник = ОписаниеСобытия(Виновник, Карта);
	Иначе
		ТекстВиновник = "виновник не найден в ТЖ (нужен TLOCK без порога)";
	КонецЕсли;

	Схема = Новый Массив;
	Схема.Добавить("Соединение " + Формат(Жертва.СоединениеИд, "ЧГ=0; ЧН=0") + " ждало соединения: "
		+ ?(ЗначениеЗаполнено(Жертва.ЖдалСоединения), Жертва.ЖдалСоединения, "не указаны"));
	Схема.Добавить("Ожидание, с: " + Формат(Жертва.ДлительностьМс / 1000, "ЧДЦ=3; ЧН=0"));
	Схема.Добавить("");
	Схема.Добавить("Блокировки:");
	Схема.Добавить(ПереведённыйТекст(СтрЗаменить(Жертва.Блокировки, ",", "," + Символы.ПС), Карта));
	ТекстСхема = СтрСоединить(Схема, Символы.ПС);

КонецПроцедуры

// Описание события для колонок «Жертва» / «Виновник».
&НаСервере
Функция ОписаниеСобытия(Событие, Карта)

	Строки = Новый Массив;
	Строки.Добавить("Пользователь: " + Событие.Пользователь);
	Строки.Добавить("Сеанс: " + Формат(Событие.СеансИд, "ЧГ=0; ЧН=0")
		+ ", соединение: " + Формат(Событие.СоединениеИд, "ЧГ=0; ЧН=0")
		+ ?(ЗначениеЗаполнено(Событие.Компьютер), ", компьютер: " + Событие.Компьютер, ""));
	Строки.Добавить("Событие: " + Событие.Событие + " в " + Формат(Событие.Время, "ДФ='dd.MM.yyyy HH:mm:ss'")
		+ ", длительность, с: " + Формат(Событие.ДлительностьМс / 1000, "ЧДЦ=3; ЧН=0"));
	Строки.Добавить("В транзакции: " + Формат(Событие.Транзакция, "БЛ=нет; БИ=да"));
	Строки.Добавить("Контекст: " + Событие.КонтекстТочка);
	Если ЗначениеЗаполнено(Событие.КонтекстСтрока) И Событие.КонтекстСтрока <> Событие.КонтекстТочка Тогда
		Строки.Добавить("    ...  " + Событие.КонтекстСтрока);
	КонецЕсли;
	Если ЗначениеЗаполнено(Событие.Блокировки) Тогда
		Строки.Добавить("Блокировки: " + ПереведённыйТекст(Событие.Блокировки, Карта));
	КонецЕсли;
	Если ЗначениеЗаполнено(Событие.ТекстЗапроса1С) Тогда
		Строки.Добавить("");
		Строки.Добавить("Запрос 1С:");
		Строки.Добавить(Событие.ТекстЗапроса1С);
	ИначеЕсли ЗначениеЗаполнено(Событие.ТекстSQL) Тогда
		Строки.Добавить("");
		Строки.Добавить("SQL:");
		Строки.Добавить(Событие.ТекстSQL);
	КонецЕсли;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Стороны взаимоблокировки: последнее событие каждого соединения из пересечений
// не позже взаимоблокировки (окно - длительность события + 60 с), одним запросом.
&НаСервере
Функция ОписаниеСторонВзаимоблокировки(Жертва, Пары, Карта)

	Соединения = Новый Массив;
	Для Каждого Пара Из Пары Цикл
		Для Каждого Соединение Из СтрРазделить(Пара.Ждёт + "," + Пара.Держит, ",", Ложь) Цикл
			Номер = ЧислоИзСтроки(Соединение);
			Если Номер <> Неопределено И Соединения.Найти(Номер) = Неопределено Тогда
				Соединения.Добавить(Номер);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если Соединения.Количество() = 0 Тогда
		Возврат "стороны не указаны в DeadlockConnectionIntersections";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 100
	|	Т.Ид КАК Ид,
	|	Т.Время КАК Время,
	|	Т.Сервер КАК Сервер,
	|	Т.База КАК База,
	|	Т.Событие КАК Событие,
	|	Т.ДлительностьМс КАК ДлительностьМс,
	|	Т.Пользователь КАК Пользователь,
	|	Т.СеансИд КАК СеансИд,
	|	Т.СоединениеИд КАК СоединениеИд,
	|	Т.Компьютер КАК Компьютер,
	|	Т.Транзакция КАК Транзакция,
	|	Т.КонтекстТочка КАК КонтекстТочка,
	|	Т.КонтекстСтрока КАК КонтекстСтрока,
	|	Т.ТекстЗапроса1С КАК ТекстЗапроса1С,
	|	Т.ТекстSQL КАК ТекстSQL,
	|	Т.Блокировки КАК Блокировки
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	Т.Сервер = &Сервер
	|	И Т.База = &База
	|	И Т.СоединениеИд В (&Соединения)
	|	И Т.Время МЕЖДУ &Начало И &Конец
	|	И Т.Ид <> &Ид
	|	И Т.Событие В (""TLOCK"", ""TTIMEOUT"", ""SDBL"", ""DBMSSQL"", ""DBPOSTGRS"")
	|
	|УПОРЯДОЧИТЬ ПО
	|	Время УБЫВ";
	Запрос.УстановитьПараметр("Сервер", Жертва.Сервер);
	Запрос.УстановитьПараметр("База", Жертва.База);
	Запрос.УстановитьПараметр("Соединения", Соединения);
	Запрос.УстановитьПараметр("Начало", Жертва.Время - Окр(Жертва.ДлительностьМс / 1000) - 60);
	Запрос.УстановитьПараметр("Конец", Жертва.Время);
	Запрос.УстановитьПараметр("Ид", Жертва.Ид);
	Выборка = Запрос.Выполнить().Выбрать();

	Найденные = Новый Соответствие;
	Части = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если Найденные[Выборка.СоединениеИд] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Найденные.Вставить(Выборка.СоединениеИд, Истина);
		Части.Добавить("Соединение " + Формат(Выборка.СоединениеИд, "ЧГ=0") + ":" + Символы.ПС
			+ ОписаниеСобытия(Выборка, Карта));
	КонецЦикла;
	Для Каждого Номер Из Соединения Цикл
		Если Найденные[Номер] = Неопределено Тогда
			Части.Добавить("Соединение " + Формат(Номер, "ЧГ=0") + ": виновник не найден в ТЖ (нужен TLOCK без порога)");
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, Символы.ПС + "----------" + Символы.ПС);

КонецФункции

&НаСервере
Функция СхемаВзаимоблокировки(Пары, Карта)

	Если Пары.Количество() = 0 Тогда
		Возврат рбфАнализСервер.НетДанных();
	КонецЕсли;
	Строки = Новый Массив;
	Для Каждого Пара Из Пары Цикл
		Строки.Добавить("Соединение " + Пара.Ждёт + " ждёт соединение " + Пара.Держит + ": "
			+ ПереведённыйТекст(Пара.Пространство, Карта));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаСервереБезКонтекста
Функция ПереведённыйТекст(Текст, Карта)

	Если Карта = Неопределено Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат рбфАнализСервер.ПеревестиИменаХранения(Текст, Карта);

КонецФункции

// Пары «ждёт - держит - пространство» из DeadlockConnectionIntersections:
// "ждёт держит пространство режим поля,...".
&НаСервереБезКонтекста
Функция ПарыВзаимоблокировки(Пересечения)

	Пары = Новый Массив;
	Для Каждого Пересечение Из СтрРазделить(Пересечения, ",", Ложь) Цикл
		Слова = СтрРазделить(СокрЛП(Пересечение), " ", Ложь);
		Если Слова.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		Ждёт = Слова[0];
		Держит = Слова[1];
		Слова.Удалить(0);
		Слова.Удалить(0);
		Пары.Добавить(Новый Структура("Ждёт,Держит,Пространство", Ждёт, Держит, СтрСоединить(Слова, " ")));
	КонецЦикла;
	Возврат Пары;

КонецФункции

// Пространство блокировки - первое слово описания Locks до пробела или точки: "AccumRg123.DIMS Exclusive ..." -> "AccumRg123".
&НаСервереБезКонтекста
Функция ПространствоБлокировки(Описание)

	Текст = СокрЛП(Описание);
	Если СтрНачинаетсяС(Текст, "Space=") Тогда
		Текст = Сред(Текст, 7);
	КонецЕсли;
	Конец = СтрДлина(Текст) + 1;
	Для Каждого Разделитель Из СтрРазделить(" |.|,", "|", Ложь) Цикл
		Позиция = СтрНайти(Текст, Разделитель);
		Если Позиция > 0 И Позиция < Конец Тогда
			Конец = Позиция;
		КонецЕсли;
	КонецЦикла;
	Возврат Лев(Текст, Конец - 1);

КонецФункции

// Пространство первой пары взаимоблокировки: "ждёт держит Пространство.Индекс режим ..." -> "Пространство".
&НаСервереБезКонтекста
Функция ПространствоВзаимоблокировки(Описание)

	Слова = СтрРазделить(СокрЛП(Описание), " ", Ложь);
	Если Слова.Количество() < 3 Тогда
		Возврат "";
	КонецЕсли;
	Возврат ПространствоБлокировки(Слова[2]);

КонецФункции

&НаСервереБезКонтекста
Функция ЧислоИзСтроки(Текст)

	Значение = СокрЛП(Текст);
	Если НЕ ЗначениеЗаполнено(Значение) ИЛИ СтрНайтиПоРегулярномуВыражению(Значение, "^[0-9]+$").НачальнаяПозиция = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Число(Значение);

КонецФункции

&НаСервере
Функция ЭтоТекущаяБаза(База)

	Возврат ЗначениеЗаполнено(ТекущаяБаза) И НРег(База) = НРег(ТекущаяБаза);

КонецФункции

&НаСервере
Функция УсловиеСобытий(Запрос)

	События = Новый Массив;
	Если Вид = "Взаимоблокировки" Тогда
		События.Добавить("TDEADLOCK");
	Иначе
		События.Добавить("TLOCK");
		События.Добавить("TTIMEOUT");
	КонецЕсли;
	Отбор = рбфАнализСервер.Отбор(ЭтотОбъект);
	Возврат рбфАнализСервер.УсловиеОтбораВыполненийТЖ(Запрос, Отбор, События);

КонецФункции

#КонецОбласти
