// Раздел «Анализ», страницы «Блокировки» (TLOCK, TTIMEOUT) и «Взаимоблокировки» (TDEADLOCK):
// компоновка как у 1С-Монитора. Слева - объекты блокировок с количеством, справа - события
// выбранного объекта по часам, внизу слева - схема «кто кого ждал», справа - сведения.
// Схема строится из свойств примера события (WaitConnections, DeadlockConnectionIntersections);
// полного графа и рекомендаций в агрегатах нет, их даст tj-analyzer.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Элементы.Вид.СписокВыбора.Добавить("Блокировки");
	Элементы.Вид.СписокВыбора.Добавить("Взаимоблокировки");
	Элементы.Вид.РежимВыбораИзСписка = Истина;
	Вид = ?(Параметры.Вид = "Взаимоблокировки", "Взаимоблокировки", "Блокировки");
	ТекстГрафXML = рбфАнализСервер.НетДанных();
	ТекстРекомендации = рбфАнализСервер.НетДанных();

	рбфАнализСервер.ЗаполнитьШапку(ЭтотОбъект);
	ОбновитьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОбъекты

&НаКлиенте
Процедура ОбъектыПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьСписок", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьПодробности", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьОбработка(Команда)

	ОбновитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодОбработка(Команда)

	рбфАнализКлиент.ВыбратьПериод(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ДопФильтрОбработка(Команда)

	рбфАнализКлиент.ПереключитьДопФильтр(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПоказатьСписок()

	ТекущиеДанные = Элементы.Объекты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьСписок(ТекущиеДанные.КлючХеш, ТекущиеДанные.Событие);
	ПоказатьПодробности();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПодробности()

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	ЗаполнитьПодробности(?(ТекущиеДанные = Неопределено, Неопределено, ТекущиеДанные.ПолучитьИдентификатор()));

КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере()

	Заголовок = Вид;
	Отбор = рбфАнализСервер.Отбор(ЭтотОбъект);
	Запрос = Новый Запрос;
	Условие = рбфАнализСервер.УсловиеОтбораТЖ(Запрос, Отбор, СобытияВида(Вид));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.КлючХеш КАК КлючХеш,
	|	Т.Событие КАК Событие,
	|	Т.Ключ КАК Объект,
	|	СУММА(Т.Количество) КАК Количество
	|ИЗ
	|	РегистрСведений.рбфСобытияТЖ КАК Т
	|ГДЕ
	|	" + Условие + "
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.КлючХеш,
	|	Т.Событие,
	|	Т.Ключ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Количество УБЫВ";
	Объекты.Загрузить(Запрос.Выполнить().Выгрузить());

	Если Объекты.Количество() > 0 Тогда
		ЗаполнитьСписок(Объекты[0].КлючХеш, Объекты[0].Событие);
	Иначе
		Список.Очистить();
	КонецЕсли;
	ЗаполнитьПодробности(?(Список.Количество() = 0, Неопределено, Список[0].ПолучитьИдентификатор()));

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписок(КлючХеш, Событие)

	Отбор = рбфАнализСервер.Отбор(ЭтотОбъект);
	Запрос = Новый Запрос;
	Условие = рбфАнализСервер.УсловиеОтбораТЖ(Запрос, Отбор, СобытияВида(Вид));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Час КАК Дата,
	|	Т.Событие КАК Событие,
	|	Т.Количество КАК Количество,
	|	Т.ДлительностьМаксМс / 1000 КАК Сек,
	|	Т.Сервер КАК Сервер,
	|	Т.База КАК База,
	|	Т.Ключ КАК Ключ,
	|	Т.Пример КАК Пример
	|ИЗ
	|	РегистрСведений.рбфСобытияТЖ КАК Т
	|ГДЕ
	|	" + Условие + "
	|	И Т.КлючХеш = &КлючХеш
	|	И Т.Событие = &Событие
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	Запрос.УстановитьПараметр("КлючХеш", КлючХеш);
	Запрос.УстановитьПараметр("Событие", Событие);
	Выборка = Запрос.Выполнить().Выбрать();

	Список.Очистить();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Список.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		Свойства = рбфАнализСервер.СвойстваСобытияТЖ(Выборка.Пример);
		НоваяСтрока.Пользователь = рбфАнализСервер.ЗначениеСвойства(Свойства, "Usr");
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодробности(ИдентификаторСтроки)

	Строка = ?(ИдентификаторСтроки = Неопределено, Неопределено, Список.НайтиПоИдентификатору(ИдентификаторСтроки));
	Схема.Очистить();
	Если Строка = Неопределено Тогда
		СведТаблица = "";
		СведИндекс = "";
		СведПользователь = "";
		СведКомпьютер = "";
		СведГранулярность = "";
		ТекстСведения = "";
		ТекстКонтекст = "";
		ТекстSQL = "";
		Текст1С = "";
		Возврат;
	КонецЕсли;

	Свойства = рбфАнализСервер.СвойстваСобытияТЖ(Строка.Пример);
	ПостроитьСхему(Свойства, Строка.Событие);

	// пространство блокировки: "AccumRg123.DIMS Exclusive Fld1=..., ..."; у TDEADLOCK - в пересечениях
	Блокировка = рбфАнализСервер.ЗначениеСвойства(Свойства, "Locks");
	Если НЕ ЗначениеЗаполнено(Блокировка) Тогда
		Пересечение = СтрРазделить(рбфАнализСервер.ЗначениеСвойства(Свойства, "DeadlockConnectionIntersections"), ",", Ложь);
		Если Пересечение.Количество() > 0 Тогда
			Слова = СтрРазделить(СокрЛП(Пересечение[0]), " ", Ложь);
			Слова.Удалить(0);
			Если Слова.Количество() > 0 Тогда
				Слова.Удалить(0);
			КонецЕсли;
			Блокировка = СтрСоединить(Слова, " ");
		КонецЕсли;
	КонецЕсли;
	ОписаниеБлокировки = РазобратьБлокировку(Блокировка);
	СведТаблица = рбфАнализСервер.ИлиНетДанных(ОписаниеБлокировки.Таблица);
	СведИндекс = рбфАнализСервер.ИлиНетДанных(ОписаниеБлокировки.Индекс);
	СведГранулярность = рбфАнализСервер.ИлиНетДанных(ОписаниеБлокировки.Гранулярность);
	СведПользователь = рбфАнализСервер.ИлиНетДанных(рбфАнализСервер.ЗначениеСвойства(Свойства, "Usr"));
	СведКомпьютер = рбфАнализСервер.ИлиНетДанных(
		рбфАнализСервер.ЗначениеСвойства(Свойства, "t:computerName,computerName"));

	Сведения = Новый Массив;
	Сведения.Добавить("Сервер = " + Строка.Сервер);
	Сведения.Добавить("База = " + Строка.База);
	Сведения.Добавить("Событие = " + Строка.Событие);
	Сведения.Добавить("Час = " + Формат(Строка.Дата, "ДФ='dd.MM.yyyy HH:mm'"));
	Сведения.Добавить("Событий за час = " + Строка.Количество);
	Сведения.Добавить("Ожидание макс, с = " + Строка.Сек);
	Сведения.Добавить("Объект = " + Строка.Ключ);
	Свойство = рбфАнализСервер.ПредставлениеСвойств(Свойства, "Context,Sql,Sdbl");
	Если ЗначениеЗаполнено(Свойство) Тогда
		Сведения.Добавить("");
		Сведения.Добавить(Свойство);
	ИначеЕсли ЗначениеЗаполнено(Строка.Пример) Тогда
		Сведения.Добавить("");
		Сведения.Добавить(Строка.Пример);
	КонецЕсли;
	ТекстСведения = СтрСоединить(Сведения, Символы.ПС);

	ТекстКонтекст = рбфАнализСервер.ИлиНетДанных(рбфАнализСервер.ЗначениеСвойства(Свойства, "Context"));
	ТекстSQL = рбфАнализСервер.ИлиНетДанных(рбфАнализСервер.ЗначениеСвойства(Свойства, "Sql"));
	Текст1С = рбфАнализСервер.ИлиНетДанных(рбфАнализСервер.ЗначениеСвойства(Свойства, "Sdbl"));

КонецПроцедуры

// Схема «кто кого ждал» в табличном документе по свойствам примера события:
//   TDEADLOCK - DeadlockConnectionIntersections: "ждёт держит пространство режим поля,...";
//   TLOCK, TTIMEOUT - t:connectID ждёт WaitConnections на пространстве Locks.
&НаСервере
Процедура ПостроитьСхему(Свойства, Событие)

	Пары = Новый Массив;
	Если Событие = "TDEADLOCK" Тогда
		Пересечения = рбфАнализСервер.ЗначениеСвойства(Свойства, "DeadlockConnectionIntersections");
		Для Каждого Пересечение Из СтрРазделить(Пересечения, ",", Ложь) Цикл
			Слова = СтрРазделить(СокрЛП(Пересечение), " ", Ложь);
			Если Слова.Количество() < 2 Тогда
				Продолжить;
			КонецЕсли;
			Ждёт = Слова[0];
			Держит = Слова[1];
			Слова.Удалить(0);
			Слова.Удалить(0);
			Пары.Добавить(Новый Структура("Ждёт,Держит,Пространство", Ждёт, Держит, СтрСоединить(Слова, " ")));
		КонецЦикла;
	Иначе
		Ждёт = рбфАнализСервер.ЗначениеСвойства(Свойства, "t:connectID,connectID");
		Пространство = рбфАнализСервер.ЗначениеСвойства(Свойства, "Locks");
		Для Каждого Держит Из СтрРазделить(рбфАнализСервер.ЗначениеСвойства(Свойства, "WaitConnections"), ",", Ложь) Цикл
			Пары.Добавить(Новый Структура("Ждёт,Держит,Пространство", Ждёт, СокрЛП(Держит), Пространство));
		КонецЦикла;
	КонецЕсли;

	Если Пары.Количество() = 0 Тогда
		Схема.Область("R1C1").Текст = рбфАнализСервер.НетДанных();
		Возврат;
	КонецЕсли;

	Шапка = Новый Массив;
	Шапка.Добавить("Соединение ждёт");
	Шапка.Добавить("Соединение держит");
	Шапка.Добавить("Пространство, режим, поля");
	Для Колонка = 1 По Шапка.Количество() Цикл
		Область = Схема.Область("R1C" + Формат(Колонка, "ЧГ="));
		Область.Текст = Шапка[Колонка - 1];
		Область.Шрифт = Новый Шрифт(, , Истина);
	КонецЦикла;
	Схема.Область("C1").ШиринаКолонки = 18;
	Схема.Область("C2").ШиринаКолонки = 18;
	Схема.Область("C3").ШиринаКолонки = 90;

	НомерСтроки = 1;
	Для Каждого Пара Из Пары Цикл
		НомерСтроки = НомерСтроки + 1;
		Префикс = "R" + Формат(НомерСтроки, "ЧГ=") + "C";
		Схема.Область(Префикс + "1").Текст = Пара.Ждёт;
		Схема.Область(Префикс + "2").Текст = Пара.Держит;
		Схема.Область(Префикс + "3").Текст = Пара.Пространство;
	КонецЦикла;

КонецПроцедуры

// Разбор первой блокировки из свойства Locks: пространство "Таблица.Индекс", режим и поля.
//
// Параметры:
//  Блокировка - Строка - значение Locks или пространство из пересечения взаимоблокировки.
//
// Возвращаемое значение:
//  Структура - Таблица, Индекс, Гранулярность; пустые строки, если разобрать нечего.
&НаСервереБезКонтекста
Функция РазобратьБлокировку(Блокировка)

	Результат = Новый Структура("Таблица,Индекс,Гранулярность", "", "", "");
	Первая = СтрРазделить(Блокировка, ",", Ложь);
	Если Первая.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Слова = СтрРазделить(СокрЛП(Первая[0]), " ", Ложь);
	Если Слова.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Точка = СтрНайти(Слова[0], ".");
	Если Точка > 0 Тогда
		Результат.Таблица = Лев(Слова[0], Точка - 1);
		Результат.Индекс = Сред(Слова[0], Точка + 1);
	Иначе
		Результат.Таблица = Слова[0];
	КонецЕсли;
	Режим = ?(Слова.Количество() > 1, Слова[1], "");
	Результат.Гранулярность = ?(ЗначениеЗаполнено(Режим), Режим + ", ", "")
		+ ?(Слова.Количество() > 2, "по значениям полей", "всё пространство");
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция СобытияВида(Вид)

	События = Новый Массив;
	Если Вид = "Взаимоблокировки" Тогда
		События.Добавить("TDEADLOCK");
	Иначе
		События.Добавить("TLOCK");
		События.Добавить("TTIMEOUT");
	КонецЕсли;
	Возврат События;

КонецФункции

#КонецОбласти
