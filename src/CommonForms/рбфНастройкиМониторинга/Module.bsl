// Раздел «Анализ», форма «Настройки мониторинга»: все настройки мониторинга в одном месте вместо скриптов.
// Страницы: «Общие» (выполнения ТЖ в общей строке рбфНастройкиТЖ и пороги/пути из НастройкиПравилРеестра),
// «Агенты» (настройки агентов rbf_agent: НастройкиПравилРеестра, Параметр = "Агент." + сервер, Значение = JSON,
// их отдаёт метод rbf-admin/agent-config), «Технологический журнал» (статус logcfg по серверам)
// и «Регламентные задания» расширения. Все изменения записываются кнопкой «Записать»;
// записывать может только пользователь с ролью ПолныеПрава.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	МожноИзменять = РольДоступна("ПолныеПрава");
	ТолькоПросмотр = НЕ МожноИзменять;
	Элементы.ФормаЗаписать.Доступность = МожноИзменять;
	ЗаполнитьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьОбработка(Команда)

	Ошибка = ЗаписатьНаСервере();
	Если ЗначениеЗаполнено(Ошибка) Тогда
		ПоказатьПредупреждение(, Ошибка);
	Иначе
		ПоказатьОповещениеПользователя(НСтр("ru = 'Настройки мониторинга записаны'"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОбработка(Команда)

	ЗаполнитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСлужебныеПоУмолчаниюОбработка(Команда)

	СлужебныеЗапросы = СлужебныеЗапросыПоУмолчаниюТекстом();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройкуТЖОбработка(Команда)

	ОткрытьФорму("ОбщаяФорма.рбфНастройкаТЖ", , ЭтотОбъект, "рбфНастройкаТЖ");

КонецПроцедуры

&НаКлиенте
Процедура РасписаниеЗаданияОбработка(Команда)

	ТекущиеДанные = Элементы.Задания.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	РасписаниеЗадания = ОбщегоНазначенияКлиентСервер.СтруктураВРасписание(
		СтруктураРасписания(ТекущиеДанные.РасписаниеСтрокой));
	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(РасписаниеЗадания);
	Диалог.Показать(Новый ОписаниеОповещения("РасписаниеЗаданияЗавершение", ЭтотОбъект,
		ТекущиеДанные.ПолучитьИдентификатор()));

КонецПроцедуры

&НаКлиенте
Процедура ПользовательЗаданияОбработка(Команда)

	ТекущиеДанные = Элементы.Задания.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Список = Новый СписокЗначений;
	Список.Добавить("", НСтр("ru = '<не задан>'"));
	Для Каждого Имя Из ИменаПользователейИБ() Цикл
		Список.Добавить(Имя);
	КонецЦикла;
	Список.ПоказатьВыборЭлемента(Новый ОписаниеОповещения("ПользовательЗаданияЗавершение", ЭтотОбъект,
		ТекущиеДанные.ПолучитьИдентификатор()), НСтр("ru = 'Пользователь регламентного задания'"),
		Список.НайтиПоЗначению(ТекущиеДанные.Пользователь));

КонецПроцедуры

&НаКлиенте
Процедура СоздатьПользователяЗаданияОбработка(Команда)

	ТекущиеДанные = Элементы.Задания.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	РекомендуемоеИмя = "РЗ_" + ТекущиеДанные.Имя;
	ПараметрыОткрытия = Новый Структура("ЗначенияЗаполнения", Новый Структура("Наименование", РекомендуемоеИмя));
	ОткрытьФорму("Справочник.Пользователи.ФормаОбъекта", ПараметрыОткрытия, ЭтотОбъект);
	ПоказатьОповещениеПользователя(НСтр("ru = 'Новый пользователь для задания'"), ,
		СтрШаблон(НСтр("ru = 'Рекомендуемое имя: %1. Включите вход в программу, затем выберите его кнопкой «Пользователь…».'"),
		РекомендуемоеИмя));

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗаданиеСейчасОбработка(Команда)

	ТекущиеДанные = Элементы.Задания.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПоказатьПредупреждение(, ВыполнитьЗаданиеНаСервере(ТекущиеДанные.Имя));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РасписаниеЗаданияЗавершение(Результат, ИдСтроки) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы = Задания.НайтиПоИдентификатору(ИдСтроки);
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Данные = СтрокаРасписания(ОбщегоНазначенияКлиентСервер.РасписаниеВСтруктуру(Результат));
	СтрокаТаблицы.РасписаниеСтрокой = Данные.Строка;
	СтрокаТаблицы.Расписание = Данные.Представление;

КонецПроцедуры

&НаКлиенте
Процедура ПользовательЗаданияЗавершение(Результат, ИдСтроки) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаТаблицы = Задания.НайтиПоИдентификатору(ИдСтроки);
	Если СтрокаТаблицы <> Неопределено Тогда
		СтрокаТаблицы.Пользователь = Результат.Значение;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция СлужебныеЗапросыПоУмолчаниюТекстом()

	Возврат СтрСоединить(рбфАнализСервер.СлужебныеЗапросыПоУмолчанию(), Символы.ПС);

КонецФункции

// Расписание из строки внутреннего представления в виде структуры для клиента.
&НаСервереБезКонтекста
Функция СтруктураРасписания(РасписаниеСтрокой)

	Если ЗначениеЗаполнено(РасписаниеСтрокой) Тогда
		РасписаниеЗадания = ЗначениеИзСтрокиВнутр(РасписаниеСтрокой);
	Иначе
		РасписаниеЗадания = Новый РасписаниеРегламентногоЗадания;
	КонецЕсли;
	Возврат ОбщегоНазначенияКлиентСервер.РасписаниеВСтруктуру(РасписаниеЗадания);

КонецФункции

// Строка внутреннего представления и представление расписания из его структуры.
&НаСервереБезКонтекста
Функция СтрокаРасписания(СтруктураРасписания)

	РасписаниеЗадания = ОбщегоНазначенияКлиентСервер.СтруктураВРасписание(СтруктураРасписания);
	Возврат Новый Структура("Строка,Представление", ЗначениеВСтрокуВнутр(РасписаниеЗадания), Строка(РасписаниеЗадания));

КонецФункции

&НаСервереБезКонтекста
Функция ИменаПользователейИБ()

	ПроверитьПраваИзменения();
	УстановитьПривилегированныйРежим(Истина);
	Имена = Новый СписокЗначений;
	Для Каждого ПользовательИБ Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
		Имена.Добавить(ПользовательИБ.Имя);
	КонецЦикла;
	Имена.СортироватьПоЗначению();
	Возврат Имена.ВыгрузитьЗначения();

КонецФункции

&НаСервереБезКонтекста
Функция ВыполнитьЗаданиеНаСервере(ИмяЗадания)

	ПроверитьПраваИзменения();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Задание = ПравилаРеестраБаз.ЗапуститьРегламентноеЗаданиеСейчас(ИмяЗадания);
	Исключение
		Возврат НСтр("ru = 'Задание не запущено: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат СтрШаблон(НСтр("ru = 'Задание %1 запущено фоновым заданием (%2). Итог - в журнале регистрации.'"),
		ИмяЗадания, Строка(Задание.Состояние));

КонецФункции

&НаСервереБезКонтекста
Процедура ПроверитьПраваИзменения()

	Если НЕ РольДоступна("ПолныеПрава") Тогда
		ВызватьИсключение НСтр("ru = 'Изменять настройки мониторинга может только администратор (роль «Полные права»).'");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()

	УстановитьПривилегированныйРежим(Истина);
	ЗаполнитьОбщие();
	ЗаполнитьАгентов();
	ЗаполнитьСтатусТЖ();
	ЗаполнитьЗадания();

КонецПроцедуры

#Область Общие

&НаСервере
Процедура ЗаполнитьОбщие()

	ГлубинаВыполненийДней = рбфАнализСервер.НастройкиВыполненийТЖ().ГлубинаДней;
	Запись = РегистрыСведений.рбфНастройкиТЖ.СоздатьМенеджерЗаписи();
	Запись.Сервер1С = "";
	Запись.ИмяБазы1С = "";
	Запись.Прочитать();
	СлужебныеЗапросы = ?(Запись.Выбран(), Запись.СлужебныеЗапросы, "");

	ОписанияНастроек = ОписанияПараметров();
	Имена = Новый Массив;
	Для Каждого Описание Из ОписанияНастроек Цикл
		Имена.Добавить(Описание.Имя);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Н.Параметр КАК Параметр,
	|	Н.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.НастройкиПравилРеестра КАК Н
	|ГДЕ
	|	Н.Параметр В (&Имена)";
	Запрос.УстановитьПараметр("Имена", Имена);
	Значения = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Значения.Вставить(Выборка.Параметр, Выборка.Значение);
	КонецЦикла;

	ПараметрыМониторинга.Очистить();
	Для Каждого Описание Из ОписанияНастроек Цикл
		СтрокаТаблицы = ПараметрыМониторинга.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Описание);
		Значение = Значения.Получить(Описание.Имя);
		СтрокаТаблицы.Значение = ?(Значение = Неопределено, "", ПредставлениеЗначения(Значение));
		СтрокаТаблицы.Исходное = СтрокаТаблицы.Значение;
	КонецЦикла;
	СнимокОбщих = СостояниеОбщих();

КонецПроцедуры

// Параметры мониторинга, которые код читает через ПравилаРеестраБаз.Настройка.
// Секретов среди них нет: учётные записи СУБД и кластера лежат в файлах, токен бота на сервере не хранится.
&НаСервереБезКонтекста
Функция ОписанияПараметров()

	Описания = Новый Массив;
	ДобавитьОписание(Описания, "ПорогCPUПроцентов", 90, НСтр("ru = 'Тревога: загрузка CPU сервера выше порога, %'"));
	ДобавитьОписание(Описания, "ПорогСвободнойПамятиМБ", 2048, НСтр("ru = 'Тревога: свободной памяти меньше порога, МБ'"));
	ДобавитьОписание(Описания, "ПорогPLEСекунд", 300, НСтр("ru = 'Тревога: Page life expectancy SQL ниже порога, с'"));
	ДобавитьОписание(Описания, "ПорогЗаблокированныхПроцессов", 5, НСтр("ru = 'Тревога: заблокированных процессов SQL больше порога'"));
	ДобавитьОписание(Описания, "ЗамеровДляТревогиПодряд", 3, НСтр("ru = 'Сколько последних замеров подряд за порогом дают тревогу'"));
	ДобавитьОписание(Описания, "ДолгийВызовДляСводкиСекунд", 60, НСтр("ru = 'Суточная сводка: серверные вызовы дольше, с'"));
	ДобавитьОписание(Описания, "ХранитьСчетчикиДней", 90, НСтр("ru = 'Хранение замеров агентов (рбфСчетчики), дней'"));
	ДобавитьОписание(Описания, "ХранитьСобытияТЖДней", 60, НСтр("ru = 'Хранение агрегатов ТЖ (рбфСобытияТЖ), дней'"));
	ДобавитьОписание(Описания, "ПорогПаденияСеансовПроцент", 50, НСтр("ru = 'Тревога: число сеансов базы упало больше чем на, %'"));
	ДобавитьОписание(Описания, "ПорогРостаБазыЗаНеделюМБ", 1024, НСтр("ru = 'Сводка: рост базы за неделю больше, МБ'"));
	ДобавитьОписание(Описания, "ПорогРостаБазыЗаНеделюПроцентов", 10, НСтр("ru = 'Сводка: рост базы за неделю больше, %'"));
	ДобавитьОписание(Описания, "РазмерыТаблицТопN", 10, НСтр("ru = 'Сколько самых больших таблиц базы сохранять'"));
	ДобавитьОписание(Описания, "КаталогЛоговТЖ", "D:\logs_1c\rbf", НСтр("ru = 'Каталог ТЖ в logcfg.xml по умолчанию (и агента)'"));
	ДобавитьОписание(Описания, "ТЖМусорноеИсключение", "", НСтр("ru = 'Исключение в logcfg.xml для мусорных событий'"));
	ДобавитьОписание(Описания, "ПутьLogcfg", "\\%1\c$\Program Files\1cv8\conf\logcfg.xml",
		НСтр("ru = 'Путь к logcfg.xml сервера, %1 - имя сервера'"));
	ДобавитьОписание(Описания, "КаталогТЖДляАнализа", "", НСтр("ru = 'Каталог ТЖ для формы «Анализ ИИ»'"));
	ДобавитьОписание(Описания, "КаталогОчередиТелеграм", "D:\1cv8\baselist_cfg\tg_outbox",
		НСтр("ru = 'Очередь сообщений в Telegram (файлы забирает tgbridge)'"));
	Возврат Описания;

КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьОписание(Описания, Имя, ПоУмолчанию, Описание)

	Описания.Добавить(Новый Структура("Имя,Описание,ПоУмолчанию,ЭтоЧисло", Имя, Описание,
		ПредставлениеЗначения(ПоУмолчанию), ТипЗнч(ПоУмолчанию) = Тип("Число")));

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПредставлениеЗначения(Значение)

	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Формат(Значение, "ЧГ=0"), Строка(Значение));

КонецФункции

&НаСервере
Функция СостояниеОбщих()

	Возврат Строка(ГлубинаВыполненийДней) + "|" + СлужебныеЗапросы;

КонецФункции

&НаСервере
Процедура ЗаписатьОбщие()

	Если СостояниеОбщих() <> СнимокОбщих Тогда
		Запись = РегистрыСведений.рбфНастройкиТЖ.СоздатьМенеджерЗаписи();
		Запись.Сервер1С = "";
		Запись.ИмяБазы1С = "";
		Запись.Прочитать();
		Запись.Сервер1С = "";
		Запись.ИмяБазы1С = "";
		Запись.ГлубинаВыполненийДней = ГлубинаВыполненийДней;
		Запись.СлужебныеЗапросы = СокрЛП(СлужебныеЗапросы);
		Запись.Изменено = ТекущаяДатаСеанса();
		Запись.Автор = Лев(ИмяПользователя(), 100);
		Запись.Записать();
	КонецЕсли;

	Для Каждого СтрокаТаблицы Из ПараметрыМониторинга Цикл
		Значение = СокрЛП(СтрокаТаблицы.Значение);
		Если Значение = СтрокаТаблицы.Исходное Тогда
			Продолжить;
		КонецЕсли;
		Если Значение = "" Тогда
			Набор = РегистрыСведений.НастройкиПравилРеестра.СоздатьНаборЗаписей();
			Набор.Отбор.Параметр.Установить(СтрокаТаблицы.Имя);
			Набор.Записать();
		Иначе
			Запись = РегистрыСведений.НастройкиПравилРеестра.СоздатьМенеджерЗаписи();
			Запись.Параметр = СтрокаТаблицы.Имя;
			Запись.Значение = ?(СтрокаТаблицы.ЭтоЧисло, ЧислоПараметра(СтрокаТаблицы.Имя, Значение), Значение);
			Запись.Записать();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЧислоПараметра(Имя, Значение)

	ОписаниеЧисла = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0));
	Число = ОписаниеЧисла.ПривестиЗначение(СтрЗаменить(СтрЗаменить(Значение, " ", ""), Символы.НПП, ""));
	Если Формат(Число, "ЧГ=0; ЧН=0") <> СтрЗаменить(СтрЗаменить(Значение, " ", ""), Символы.НПП, "") Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Параметр %1: ожидается целое число, указано «%2»'"), Имя, Значение);
	КонецЕсли;
	Возврат Число;

КонецФункции

#КонецОбласти

#Область Агенты

&НаСервере
Процедура ЗаполнитьАгентов()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Н.Параметр КАК Параметр,
	|	Н.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.НастройкиПравилРеестра КАК Н
	|ГДЕ
	|	Н.Параметр ПОДОБНО ""Агент.%""
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	С.Сервер КАК Сервер,
	|	МАКСИМУМ(С.Время) КАК Последний
	|ИЗ
	|	РегистрСведений.рбфСчетчики КАК С
	|
	|СГРУППИРОВАТЬ ПО
	|	С.Сервер
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сервер";
	Результаты = Запрос.ВыполнитьПакет();

	Агенты.Очистить();
	Строки = Новый Соответствие; // ВРег(сервер) -> строка
	Сохранённые = Новый Массив;
	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		ИмяСервера = СокрЛП(Сред(Выборка.Параметр, СтрДлина("Агент.") + 1));
		Если НЕ ЗначениеЗаполнено(ИмяСервера) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТаблицы = Агенты.Добавить();
		ЗаполнитьСтрокуАгента(СтрокаТаблицы, ИмяСервера, ПравилаРеестраБаз.РазобратьНастройкиАгента(Строка(Выборка.Значение)));
		СтрокаТаблицы.Сохранена = Истина;
		Строки.Вставить(ВРег(ИмяСервера), СтрокаТаблицы);
		Сохранённые.Добавить(ИмяСервера);
	КонецЦикла;

	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		ИмяСервера = СокрЛП(Выборка.Сервер);
		СтрокаТаблицы = Строки.Получить(ВРег(ИмяСервера));
		Если СтрокаТаблицы = Неопределено Тогда
			СтрокаТаблицы = Агенты.Добавить();
			ЗаполнитьСтрокуАгента(СтрокаТаблицы, ИмяСервера, ПравилаРеестраБаз.НастройкиАгентаПоУмолчанию());
			Строки.Вставить(ВРег(ИмяСервера), СтрокаТаблицы);
		КонецЕсли;
		СтрокаТаблицы.ПоследняяСвязь = Выборка.Последний;
	КонецЦикла;

	Агенты.Сортировать("Сервер");
	СохранённыеАгенты = СтрСоединить(Сохранённые, Символы.ПС);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокуАгента(СтрокаТаблицы, ИмяСервера, Настройки)

	СтрокаТаблицы.Сервер = ИмяСервера;
	СтрокаТаблицы.КаталогТЖ = Настройки.КаталогТЖ;
	СтрокаТаблицы.Диски = СтрСоединить(Настройки.Диски, ",");
	СтрокаТаблицы.Процессы = СтрСоединить(Настройки.Процессы, ",");
	Экземпляры = Новый Массив;
	Для Каждого Экземпляр Из Настройки.SQL Цикл
		Экземпляры.Добавить(Экземпляр.name + "=" + Экземпляр.instance);
	КонецЦикла;
	СтрокаТаблицы.SQL = СтрСоединить(Экземпляры, ";");
	СтрокаТаблицы.ПропускатьСобытия = СтрСоединить(Настройки.ПропускатьСобытия, ",");
	СтрокаТаблицы.ТопНаСобытие = Настройки.ТопНаСобытие;
	СтрокаТаблицы.ОтправлятьСобытия = Настройки.ОтправлятьСобытия;
	СтрокаТаблицы.ПакетСобытий = Настройки.ПакетСобытий;
	СтрокаТаблицы.МаксДлинаТекста = Настройки.МаксДлинаТекста;
	СтрокаТаблицы.Снимок = СостояниеАгента(СтрокаТаблицы);

КонецПроцедуры

&НаСервере
Функция СостояниеАгента(СтрокаТаблицы)

	Части = Новый Массив;
	Части.Добавить(СтрокаТаблицы.КаталогТЖ);
	Части.Добавить(СтрокаТаблицы.Диски);
	Части.Добавить(СтрокаТаблицы.Процессы);
	Части.Добавить(СтрокаТаблицы.SQL);
	Части.Добавить(СтрокаТаблицы.ПропускатьСобытия);
	Части.Добавить(Формат(СтрокаТаблицы.ТопНаСобытие, "ЧГ=0"));
	Части.Добавить(Формат(СтрокаТаблицы.ОтправлятьСобытия, "БЛ=0; БИ=1"));
	Части.Добавить(Формат(СтрокаТаблицы.ПакетСобытий, "ЧГ=0"));
	Части.Добавить(Формат(СтрокаТаблицы.МаксДлинаТекста, "ЧГ=0"));
	Возврат СтрСоединить(Части, "|");

КонецФункции

&НаСервере
Процедура ЗаписатьАгентов()

	Сохранённые = СтрРазделить(СохранённыеАгенты, Символы.ПС, Ложь);
	ВТаблице = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из Агенты Цикл
		ИмяСервера = СокрЛП(СтрокаТаблицы.Сервер);
		Если НЕ ЗначениеЗаполнено(ИмяСервера) Тогда
			ВызватьИсключение НСтр("ru = 'Агенты: в строке не указан сервер'");
		КонецЕсли;
		Если ВТаблице.Получить(ВРег(ИмяСервера)) <> Неопределено Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Агенты: сервер %1 указан дважды'"), ИмяСервера);
		КонецЕсли;
		ВТаблице.Вставить(ВРег(ИмяСервера), Истина);
		Если СтрокаТаблицы.Сохранена И СтрокаТаблицы.Снимок = СостояниеАгента(СтрокаТаблицы) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ СтрокаТаблицы.Сохранена И СтрокаТаблицы.Снимок = СостояниеАгента(СтрокаТаблицы) И ЗначениеЗаполнено(СтрокаТаблицы.Снимок) Тогда
			// строка добавлена по замерам рбфСчетчики и не менялась - агенту остаются умолчания
			Продолжить;
		КонецЕсли;

		Текст = ПравилаРеестраБаз.СтрокаНастроекАгента(НастройкиИзСтроки(СтрокаТаблицы));
		Если СтрДлина(Текст) > 500 Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Агенты: настройки сервера %1 длиннее 500 символов (%2), сократите списки'"),
				ИмяСервера, СтрДлина(Текст));
		КонецЕсли;
		Запись = РегистрыСведений.НастройкиПравилРеестра.СоздатьМенеджерЗаписи();
		Запись.Параметр = ПравилаРеестраБаз.КлючНастроекАгента(ИмяСервера);
		Запись.Значение = Текст;
		Запись.Записать();
	КонецЦикла;

	// строки, удалённые из таблицы, удаляются и из регистра
	Для Каждого ИмяСервера Из Сохранённые Цикл
		Если ВТаблице.Получить(ВРег(ИмяСервера)) = Неопределено Тогда
			Набор = РегистрыСведений.НастройкиПравилРеестра.СоздатьНаборЗаписей();
			Набор.Отбор.Параметр.Установить(ПравилаРеестраБаз.КлючНастроекАгента(ИмяСервера));
			Набор.Записать();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция НастройкиИзСтроки(СтрокаТаблицы)

	Настройки = ПравилаРеестраБаз.НастройкиАгентаПоУмолчанию();
	Настройки.КаталогТЖ = СокрЛП(СтрокаТаблицы.КаталогТЖ);
	Настройки.Диски = СписокИзСтроки(СтрокаТаблицы.Диски, ",");
	Настройки.Процессы = СписокИзСтроки(СтрокаТаблицы.Процессы, ",");
	Экземпляры = Новый Массив;
	Для Каждого Часть Из СписокИзСтроки(СтрокаТаблицы.SQL, ";") Цикл
		Позиция = СтрНайти(Часть, "=");
		Если Позиция = 0 Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Агенты, сервер %1: SQL-экземпляр «%2» нужно указать как имя=инстанс'"),
				СтрокаТаблицы.Сервер, Часть);
		КонецЕсли;
		Экземпляры.Добавить(Новый Структура("name,instance", СокрЛП(Лев(Часть, Позиция - 1)),
			СокрЛП(Сред(Часть, Позиция + 1))));
	КонецЦикла;
	Настройки.SQL = Экземпляры;
	Настройки.ПропускатьСобытия = СписокИзСтроки(СтрокаТаблицы.ПропускатьСобытия, ",");
	Настройки.ТопНаСобытие = СтрокаТаблицы.ТопНаСобытие;
	Настройки.ОтправлятьСобытия = СтрокаТаблицы.ОтправлятьСобытия;
	Настройки.ПакетСобытий = СтрокаТаблицы.ПакетСобытий;
	Настройки.МаксДлинаТекста = СтрокаТаблицы.МаксДлинаТекста;
	Возврат Настройки;

КонецФункции

&НаСервереБезКонтекста
Функция СписокИзСтроки(Текст, Разделитель)

	Результат = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Текст, Разделитель, Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Часть)) Тогда
			Результат.Добавить(СокрЛП(Часть));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ТехнологическийЖурнал

&НаСервере
Процедура ЗаполнитьСтатусТЖ()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Н.Сервер1С КАК Сервер1С,
	|	Н.ИмяБазы1С КАК ИмяБазы1С,
	|	Н.ДолгийЗапрос
	|		ИЛИ Н.ОжиданиеНаБлокировке1С
	|		ИЛИ Н.ОжиданиеНаБлокировкеСУБД
	|		ИЛИ Н.Взаимоблокировка1С
	|		ИЛИ Н.ВзаимоблокировкаСУБД
	|		ИЛИ Н.ОшибкаТЖ
	|		ИЛИ Н.Транзакции
	|		ИЛИ Н.СерверныйВызов КАК Включена,
	|	Н.Изменено КАК Изменено,
	|	Н.Автор КАК Автор,
	|	ВЫБОР
	|		КОГДА Н.ИмяБазы1С = """"
	|			ТОГДА ПОДСТРОКА(Н.ТекстLogcfg, 1, 1) <> """"
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Применён
	|ИЗ
	|	РегистрСведений.рбфНастройкиТЖ КАК Н
	|ГДЕ
	|	Н.Сервер1С <> """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сервер1С";
	Выборка = Запрос.Выполнить().Выбрать();

	СтатусТЖ.Очистить();
	Строки = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Части = СтрРазделить(Выборка.Сервер1С, ":", Ложь);
		ИмяСервера = СокрЛП(Части[0]);
		СтрокаТаблицы = Строки.Получить(ВРег(ИмяСервера));
		Если СтрокаТаблицы = Неопределено Тогда
			СтрокаТаблицы = СтатусТЖ.Добавить();
			СтрокаТаблицы.Сервер = ИмяСервера;
			Строки.Вставить(ВРег(ИмяСервера), СтрокаТаблицы);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.ИмяБазы1С) Тогда
			СтрокаТаблицы.БазВключено = СтрокаТаблицы.БазВключено + ?(Выборка.Включена, 1, 0);
		Иначе
			СтрокаТаблицы.LogcfgПрименён = Выборка.Применён;
			СтрокаТаблицы.Изменено = Выборка.Изменено;
			СтрокаТаблицы.Автор = Выборка.Автор;
		КонецЕсли;
	КонецЦикла;
	СтатусТЖ.Сортировать("Сервер");

КонецПроцедуры

#КонецОбласти

#Область РегламентныеЗадания

&НаСервере
Процедура ЗаполнитьЗадания()

	Задания.Очистить();
	Для Каждого МетаданныеЗадания Из Метаданные.РегламентныеЗадания Цикл
		Если МетаданныеЗадания.РасширениеКонфигурации() = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Задание = РегламентныеЗадания.НайтиПредопределенное(МетаданныеЗадания);
		Если Задание = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТаблицы = Задания.Добавить();
		СтрокаТаблицы.Имя = МетаданныеЗадания.Имя;
		СтрокаТаблицы.Наименование = МетаданныеЗадания.Представление();
		СтрокаТаблицы.Идентификатор = Строка(Задание.УникальныйИдентификатор);
		СтрокаТаблицы.Использование = Задание.Использование;
		СтрокаТаблицы.Расписание = Строка(Задание.Расписание);
		СтрокаТаблицы.РасписаниеСтрокой = ЗначениеВСтрокуВнутр(Задание.Расписание);
		СтрокаТаблицы.Пользователь = Задание.ИмяПользователя;
		Последнее = Задание.ПоследнееЗадание;
		Если Последнее <> Неопределено Тогда
			СтрокаТаблицы.ПоследнийЗапуск = Последнее.Начало;
			СтрокаТаблицы.Состояние = Строка(Последнее.Состояние);
		КонецЕсли;
		СтрокаТаблицы.Снимок = СостояниеЗадания(СтрокаТаблицы);
	КонецЦикла;
	Задания.Сортировать("Наименование");

КонецПроцедуры

&НаСервере
Функция СостояниеЗадания(СтрокаТаблицы)

	Возврат Формат(СтрокаТаблицы.Использование, "БЛ=0; БИ=1") + "|" + СтрокаТаблицы.Пользователь + "|" + СтрокаТаблицы.РасписаниеСтрокой;

КонецФункции

&НаСервере
Процедура ЗаписатьЗадания()

	Изменённые = Новый Массив;
	Для Каждого СтрокаТаблицы Из Задания Цикл
		Если СтрокаТаблицы.Снимок = СостояниеЗадания(СтрокаТаблицы) Тогда
			Продолжить;
		КонецЕсли;
		Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(СтрокаТаблицы.Идентификатор));
		Если Задание = Неопределено Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Регламентное задание %1 не найдено, обновите форму'"), СтрокаТаблицы.Наименование);
		КонецЕсли;
		Задание.Использование = СтрокаТаблицы.Использование;
		Задание.ИмяПользователя = СтрокаТаблицы.Пользователь;
		Задание.Расписание = ЗначениеИзСтрокиВнутр(СтрокаТаблицы.РасписаниеСтрокой);
		Задание.Записать();
		Изменённые.Добавить(СтрокаТаблицы.Имя);
	КонецЦикла;
	Если Изменённые.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// заданное в форме НастроитьРасписания больше не перезаписывает
	Имена = СтрРазделить(Строка(ПравилаРеестраБаз.Настройка("РасписаниеЗаданийИзФормы", "")), ",", Ложь);
	Для Каждого Имя Из Изменённые Цикл
		Если Имена.Найти(Имя) = Неопределено Тогда
			Имена.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Запись = РегистрыСведений.НастройкиПравилРеестра.СоздатьМенеджерЗаписи();
	Запись.Параметр = "РасписаниеЗаданийИзФормы";
	Запись.Значение = СтрСоединить(Имена, ",");
	Запись.Записать();

КонецПроцедуры

#КонецОбласти

// Записывает все страницы в одной транзакции.
//
// Возвращаемое значение:
//  Строка - текст ошибки или пустая строка.
&НаСервере
Функция ЗаписатьНаСервере()

	Если НЕ РольДоступна("ПолныеПрава") Тогда
		Возврат НСтр("ru = 'Изменять настройки мониторинга может только администратор (роль «Полные права»).'");
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);

	НачатьТранзакцию();
	Попытка
		ЗаписатьОбщие();
		ЗаписатьАгентов();
		ЗаписатьЗадания();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Возврат НСтр("ru = 'Настройки не записаны: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	ЗаполнитьНаСервере();
	Возврат "";

КонецФункции

#КонецОбласти
