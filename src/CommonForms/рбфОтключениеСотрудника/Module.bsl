#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ Пользователи.ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение НСтр("ru = 'Отключать сотрудников могут только администраторы.'");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ФамилияОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)

	Фамилия = Текст;
	НайтиОбработка(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСотрудники

&НаКлиенте
Процедура СотрудникиПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.Сотрудники.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПоказатьСотрудника(ТекущиеДанные.Логин);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НайтиОбработка(Команда)

	Если СтрДлина(СокрЛП(Фамилия)) < 2 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Введите фамилию.'"), , "Фамилия");
		Возврат;
	КонецЕсли;
	Состояние(НСтр("ru = 'Ищу в AD и на MikroTik...'"));
	НайтиНаСервере();
	Если Сотрудники.Количество() > 0 Тогда
		Элементы.Сотрудники.ТекущаяСтрока = Сотрудники[0].ПолучитьИдентификатор();
		ПоказатьСотрудника(Сотрудники[0].Логин);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтключитьОбработка(Команда)

	ТекущиеДанные = Элементы.Сотрудники.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Сначала найдите и выберите сотрудника.'"));
		Возврат;
	КонецЕсли;

	Отмеченные = Новый Массив;
	Для Каждого Строка Из Секреты Цикл
		Если Строка.Отключить Тогда
			Отмеченные.Добавить(Строка.Имя);
		КонецЕсли;
	КонецЦикла;

	Текст = СтрШаблон(НСтр("ru = 'Отключить %1 (%2)?
		|- учётка AD будет отключена;
		|- ppp secret: %3;
		|- будут завершены сеансы VPN, RDP и SMB этого сотрудника.
		|Перед изменением будут сняты бэкапы.'"),
		ТекущиеДанные.ФИО, ТекущиеДанные.Логин,
		?(Отмеченные.Количество() = 0, НСтр("ru = 'не выбраны'"), СтрСоединить(Отмеченные, ", ")));
	ДопПараметры = Новый Структура("Логин, Почта, Секреты", ТекущиеДанные.Логин, ТекущиеДанные.Почта, Отмеченные);
	ПоказатьВопрос(Новый ОписаниеОповещения("ОтключитьПослеВопроса", ЭтотОбъект, ДопПараметры), Текст,
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЯщикОбработка(Команда)

	Результат = Результат + Символы.ПС + ДобавитьЯщикНаСервере(ПочтаЯщика, ПарольПриложения);
	ПарольПриложения = "";

КонецПроцедуры

&НаКлиенте
Процедура ВернутьОбработка(Команда)

	ТекущиеДанные = Элементы.Сотрудники.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Сначала найдите и выберите сотрудника.'"));
		Возврат;
	КонецЕсли;

	Состояние(НСтр("ru = 'Готовлю план возврата...'"));
	План = ВернутьНаСервере(ТекущиеДанные.Логин, Истина);
	Текст = СтрШаблон(НСтр("ru = 'Вернуть %1 (%2)?
		|%3
		|Перед изменением будет снят бэкап.'"), ТекущиеДанные.ФИО, ТекущиеДанные.Логин, План);
	ПоказатьВопрос(Новый ОписаниеОповещения("ВернутьПослеВопроса", ЭтотОбъект, ТекущиеДанные.Логин), Текст,
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВернутьПослеВопроса(Ответ, Логин) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Состояние(НСтр("ru = 'Возвращаю...'"));
	Итог = ВернутьНаСервере(Логин, Ложь);
	// Обновляем найденное, чтобы таблицы показывали новое состояние
	НайтиНаСервере();
	Результат = Итог;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ВернутьНаСервере(Знач Логин, Знач ТолькоПлан)

	Ответ = ПрочитатьОтвет(рбфОтключениеСотрудников.ВернутьСотрудника(Логин, ТолькоПлан));
	Строки = Новый Массив;
	Если ЗначениеЗаполнено(ЗначениеОтвета(Ответ, "Error")) Тогда
		Строки.Добавить(НСтр("ru = 'Ошибка: '") + ЗначениеОтвета(Ответ, "Error"));
	КонецЕсли;
	Для Каждого Шаг Из МассивОтвета(Ответ, "Steps") Цикл
		Строки.Добавить(?(ЗначениеОтвета(Шаг, "Ok") = Истина, "- ", "СБОЙ ") + ЗначениеОтвета(Шаг, "Step")
			+ ": " + ЗначениеОтвета(Шаг, "Text"));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

&НаКлиенте
Процедура ОтключитьПослеВопроса(Ответ, ДопПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Состояние(НСтр("ru = 'Отключаю...'"));
	Успех = ОтключитьНаСервере(ДопПараметры.Логин, ДопПараметры.Секреты);
	Если Успех И ЗначениеЗаполнено(ДопПараметры.Почта) Тогда
		ПочтаЯщика = ДопПараметры.Почта;
		Элементы.ГруппаПочта.Видимость = Истина;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура НайтиНаСервере()

	Сотрудники.Очистить();
	Секреты.Очистить();
	Сеансы.Очистить();
	Элементы.ГруппаПочта.Видимость = Ложь;
	ДанныеПоиска = рбфОтключениеСотрудников.НайтиСотрудника(Фамилия);
	Ответ = ПрочитатьОтвет(ДанныеПоиска);
	Если ЗначениеОтвета(Ответ, "Ok") <> Истина Тогда
		Результат = НСтр("ru = 'Ошибка поиска: '") + ЗначениеОтвета(Ответ, "Error");
		Возврат;
	КонецЕсли;

	Для Каждого Найденный Из МассивОтвета(Ответ, "Users") Цикл
		Строка = Сотрудники.Добавить();
		Строка.ФИО = ЗначениеОтвета(Найденный, "Name");
		Строка.Логин = ЗначениеОтвета(Найденный, "Login");
		Строка.Почта = ЗначениеОтвета(Найденный, "Mail");
		Строка.Включена = (ЗначениеОтвета(Найденный, "Enabled") = Истина);
		Строка.ПоследнийВход = СтрЗаменить(Лев(ЗначениеОтвета(Найденный, "LastLogon"), 16), "T", " ");
		Строка.Описание = ЗначениеОтвета(Найденный, "Description");
	КонецЦикла;
	Результат = ?(Сотрудники.Количество() = 0, НСтр("ru = 'В AD никого не нашлось.'"),
		СтрШаблон(НСтр("ru = 'Найдено в AD: %1. Проверьте отметки ppp secret перед отключением.'"), Сотрудники.Количество()));

КонецПроцедуры

&НаСервере
Процедура ПоказатьСотрудника(Знач Логин)

	Секреты.Очистить();
	Сеансы.Очистить();
	Ответ = ПрочитатьОтвет(ДанныеПоиска);
	Для Каждого Найденный Из МассивОтвета(Ответ, "Users") Цикл
		Если ЗначениеОтвета(Найденный, "Login") <> Логин Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Секрет Из МассивОтвета(Найденный, "Secrets") Цикл
			Строка = Секреты.Добавить();
			Строка.Имя = ЗначениеОтвета(Секрет, "Name");
			Строка.Сервис = ЗначениеОтвета(Секрет, "Service");
			Строка.УжеОтключён = (ЗначениеОтвета(Секрет, "Disabled") = Истина);
			Строка.Совпадение = ЗначениеОтвета(Секрет, "Score", 0);
			Строка.Отключить = (ЗначениеОтвета(Секрет, "Suggest") = Истина);
			Примечания = Новый Массив;
			Если ЗначениеОтвета(Секрет, "Technical") = Истина Тогда
				Примечания.Добавить(НСтр("ru = 'техника, не трогать'"));
			КонецЕсли;
			Если ЗначениеЗаполнено(ЗначениеОтвета(Секрет, "Static")) Тогда
				Примечания.Добавить(НСтр("ru = 'site-to-site: '") + ЗначениеОтвета(Секрет, "Static"));
			КонецЕсли;
			Если ЗначениеОтвета(Секрет, "Exact") = Истина Тогда
				Примечания.Добавить(НСтр("ru = 'совпадает с логином'"));
			КонецЕсли;
			Строка.Примечание = СтрСоединить(Примечания, "; ");
		КонецЦикла;
		Для Каждого Впн Из МассивОтвета(Найденный, "Vpn") Цикл
			Строка = Сеансы.Добавить();
			Строка.Вид = "VPN " + ЗначениеОтвета(Впн, "Service");
			Строка.Сервер = "MikroTik";
			Строка.Описание = ЗначениеОтвета(Впн, "Name") + ", " + ЗначениеОтвета(Впн, "Address")
				+ ", " + ЗначениеОтвета(Впн, "Uptime");
		КонецЦикла;
		Для Каждого Сеанс Из МассивОтвета(Найденный, "Sessions") Цикл
			Строка = Сеансы.Добавить();
			Строка.Вид = ЗначениеОтвета(Сеанс, "Kind");
			Строка.Сервер = ЗначениеОтвета(Сеанс, "Server");
			Строка.Описание = СокрЛП(ЗначениеОтвета(Сеанс, "Id") + " " + ЗначениеОтвета(Сеанс, "Client"));
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ОтключитьНаСервере(Знач Логин, Знач СписокСекретов)

	Ответ = ПрочитатьОтвет(рбфОтключениеСотрудников.ОтключитьСотрудника(Логин, СписокСекретов));
	Строки = Новый Массив;
	Если ЗначениеЗаполнено(ЗначениеОтвета(Ответ, "Error")) Тогда
		Строки.Добавить(НСтр("ru = 'Ошибка: '") + ЗначениеОтвета(Ответ, "Error"));
	КонецЕсли;
	Для Каждого Шаг Из МассивОтвета(Ответ, "Steps") Цикл
		Строки.Добавить(?(ЗначениеОтвета(Шаг, "Ok") = Истина, "OK  ", "СБОЙ ") + ЗначениеОтвета(Шаг, "Step")
			+ ": " + ЗначениеОтвета(Шаг, "Text"));
	КонецЦикла;
	Результат = СтрСоединить(Строки, Символы.ПС);
	// Ящик предлагаем, если хотя бы учётка AD отключена (бэкапы сняты, шаги прошли)
	Возврат ЗначениеЗаполнено(ЗначениеОтвета(Ответ, "Backup"));

КонецФункции

&НаСервереБезКонтекста
Функция ДобавитьЯщикНаСервере(Знач Почта, Знач Пароль)

	Попытка
		Возврат рбфОтключениеСотрудников.ДобавитьЯщикВАрхив(Почта, Пароль);
	Исключение
		Возврат НСтр("ru = 'Ящик не добавлен: '") + ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьОтвет(Текст)

	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Ответ = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Ответ;

КонецФункции

// PowerShell ConvertTo-Json отдаёт массив из одного элемента как объект, а пустой - как null.
&НаСервереБезКонтекста
Функция МассивОтвета(Данные, Ключ)

	Значение = ЗначениеОтвета(Данные, Ключ, Неопределено);
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение;
	КонецЕсли;
	Результат = Новый Массив;
	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Результат.Добавить(Значение);
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеОтвета(Данные, Ключ, ПоУмолчанию = "")

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Значение = Данные.Получить(Ключ);
	Возврат ?(Значение = Неопределено, ПоУмолчанию, Значение);

КонецФункции

#КонецОбласти
