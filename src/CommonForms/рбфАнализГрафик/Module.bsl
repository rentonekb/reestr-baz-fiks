	Правила.Добавить(Правило("Машина", "rphost: память, МБ", "", "rphost", 1024));
	Правила.Добавить(Правило("Машина", "rmngr: память, МБ", "", "rmngr", 1024));
	Правила.Добавить(Правило("Машина", "sqlservr: память, МБ", "", "sqlservr", 1024));
