	Правила.Добавить(Правило("Кластер", "Сеансы: ждут блокировку 1С", "", "%2: сеансы ждут блокировку 1С"));
	Правила.Добавить(Правило("Кластер", "Сеансы: ждут СУБД", "", "%2: сеансы ждут СУБД"));
	Панели.Добавить(Новый Структура("Имя,Заголовок,Правила", "Блокировки", "Блокировки и ожидания, шт.", Правила));

	Правила = Новый Массив;
	Правила.Добавить(Правило("Машина", "Диск ", ": чтение, мс", "%1 чтение"));
	Правила.Добавить(Правило("Машина", "Диск ", ": запись, мс", "%1 запись"));
	Панели.Добавить(Новый Структура("Имя,Заголовок,Правила", "Диски", "Диски: задержка, мс", Правила));

	Правила = Новый Массив;
