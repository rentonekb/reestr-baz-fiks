	Правила.Добавить(Правило("Машина", "SQL ", ": Запросов/с", "%1"));
	Панели.Добавить(Новый Структура("Имя,Заголовок,Правила", "Запросы", "SQL: запросов в секунду", Правила));

	Правила = Новый Массив;
