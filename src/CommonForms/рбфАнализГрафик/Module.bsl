КонецФункции

&НаСервереБезКонтекста
Функция Плитка(Имя, Заголовок, Подсказка, Агрегат, ФорматЧисла, Единица, Желтый, Красный, МеньшеХуже,
	Правило1, Правило2 = Неопределено)

	Правила = Новый Массив;
	Правила.Добавить(Правило1);
	Если Правило2 <> Неопределено Тогда
		Правила.Добавить(Правило2);
	КонецЕсли;
	Возврат Новый Структура("Имя,Заголовок,Подсказка,Агрегат,Формат,Единица,Желтый,Красный,МеньшеХуже,Правила",
		Имя, Заголовок, Подсказка, Агрегат, ФорматЧисла, Единица, Желтый, Красный, МеньшеХуже, Правила);

КонецФункции

// Правило отбора счётчика для серии или плитки.
//
// Параметры:
//  Область - Строка - «Машина» (сервер = машина) или «Кластер» (сервер = машина:порт кластера 1С).
//  Начало - Строка - имя счётчика целиком (Конец пустой) или его начало.
//  Конец - Строка - окончание имени счётчика; между Началом и Концом - переменная часть (%1 в подписи).
//  Подпись - Строка - имя серии: %1 - переменная часть имени, %2 - порт кластера; пустая - переменная часть.
//  Делитель - Число - перевод единиц (1024 - из МБ в ГБ).
//
// Возвращаемое значение:
//  Структура - поля правила.
&НаСервереБезКонтекста
Функция Правило(Область, Начало, Конец = "", Подпись = "", Делитель = 1)

	Возврат Новый Структура("Область,Начало,Конец,Подпись,Делитель", Область, Начало, Конец, Подпись, Делитель);

КонецФункции

&НаСервереБезКонтекста
Функция ПодходитПравилу(Правило, Сервер, Счетчик, Машина)

	Если Правило.Область = "Кластер" Тогда
		Если НЕ СтрНачинаетсяС(Сервер, Машина + ":") Тогда
			Возврат Ложь;
		КонецЕсли;
	ИначеЕсли Сервер <> Машина Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ПустаяСтрока(Правило.Конец) Тогда
		Возврат Счетчик = Правило.Начало;
	КонецЕсли;
	Возврат СтрДлина(Счетчик) > СтрДлина(Правило.Начало) + СтрДлина(Правило.Конец)
		И СтрНачинаетсяС(Счетчик, Правило.Начало)
		И СтрЗаканчиваетсяНа(Счетчик, Правило.Конец);

КонецФункции

// Серии панелей, в которые попадает счётчик.
//
// Возвращаемое значение:
//  Массив из Структура - Панель (имя), Серия (имя серии), Делитель.
&НаСервереБезКонтекста
Функция СерииСчетчика(Панели, Сервер, Счетчик, Машина)

	Результат = Новый Массив;
	Для Каждого Панель Из Панели Цикл
		Для Каждого Правило Из Панель.Правила Цикл
			Если НЕ ПодходитПравилу(Правило, Сервер, Счетчик, Машина) Тогда
				Продолжить;
			КонецЕсли;
			Середина = Сред(Счетчик, СтрДлина(Правило.Начало) + 1,
				СтрДлина(Счетчик) - СтрДлина(Правило.Начало) - СтрДлина(Правило.Конец));
			Порт = Сред(Сервер, СтрДлина(Машина) + 2);
			// не СтрШаблон: он отказывает, если параметров больше, чем %N в подписи
			Серия = ?(ПустаяСтрока(Правило.Подпись), Середина,
				СтрЗаменить(СтрЗаменить(Правило.Подпись, "%1", Середина), "%2", Порт));
			Результат.Добавить(Новый Структура("Панель,Серия,Делитель", Панель.Имя, Серия, Правило.Делитель));
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция Свести(Значения, Агрегат)

	Если Значения.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Значения[0];
	Для Индекс = 1 По Значения.ВГраница() Цикл
		Если Агрегат = "Сумма" Тогда
			Результат = Результат + Значения[Индекс];
		ИначеЕсли Агрегат = "Минимум" Тогда
			Результат = Мин(Результат, Значения[Индекс]);
		Иначе
			Результат = Макс(Результат, Значения[Индекс]);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Плитка: подпись мелко, значение крупно; фон и цвет - по порогам плитки.
&НаСервереБезКонтекста
Функция ПредставлениеПлитки(Плитка, Значение)

	Если Значение = Неопределено Тогда
		Текст = "нет данных";
		Уровень = "Нет";
	Иначе
		Текст = Формат(Значение, Плитка.Формат) + Плитка.Единица;
		Уровень = УровеньЗначения(Плитка, Значение);
	КонецЕсли;
	Цвета = ЦветаУровня(Уровень);
	Возврат Новый ФорматированнаяСтрока(
		Новый ФорматированнаяСтрока(Плитка.Заголовок + Символы.ПС, , Цвета.Подпись, Цвета.Фон),
		Новый ФорматированнаяСтрока(Текст, Новый Шрифт(, 16, Истина), Цвета.Значение, Цвета.Фон));

КонецФункции

&НаСервереБезКонтекста
Функция УровеньЗначения(Плитка, Значение)

	Если Плитка.Желтый = 0 И Плитка.Красный = 0 Тогда
		Возврат "Нет";
	ИначеЕсли Плитка.МеньшеХуже Тогда
		Возврат ?(Значение <= Плитка.Красный, "Красный", ?(Значение <= Плитка.Желтый, "Желтый", "Зеленый"));
	КонецЕсли;
	Возврат ?(Значение >= Плитка.Красный, "Красный", ?(Значение >= Плитка.Желтый, "Желтый", "Зеленый"));

КонецФункции

&НаСервереБезКонтекста
Функция ЦветаУровня(Уровень)

	Если Уровень = "Красный" Тогда
		Возврат Новый Структура("Фон,Значение,Подпись", Новый Цвет(255, 235, 238), Новый Цвет(198, 40, 40), Новый Цвет(120, 40, 40));
	ИначеЕсли Уровень = "Желтый" Тогда
		Возврат Новый Структура("Фон,Значение,Подпись", Новый Цвет(255, 243, 224), Новый Цвет(230, 81, 0), Новый Цвет(120, 70, 20));
	ИначеЕсли Уровень = "Зеленый" Тогда
		Возврат Новый Структура("Фон,Значение,Подпись", Новый Цвет(232, 245, 233), Новый Цвет(46, 125, 50), Новый Цвет(40, 90, 45));
	КонецЕсли;
	Возврат Новый Структура("Фон,Значение,Подпись", Новый Цвет(240, 240, 240), Новый Цвет(33, 33, 33), Новый Цвет(90, 90, 90));

КонецФункции

// Строка над плитками: машина и время последнего замера; если замеров нет дольше 15 минут - красным.
&НаСервереБезКонтекста
Функция ПредставлениеСостояния(Машина, ПоследнийЗамер, КонецПериода)

	Если ПустаяСтрока(Машина) Тогда
		Возврат Новый ФорматированнаяСтрока("Нет замеров счётчиков за период: проверьте агент мониторинга",
			, Новый Цвет(198, 40, 40));
	ИначеЕсли НЕ ЗначениеЗаполнено(ПоследнийЗамер) Тогда
		Возврат Новый ФорматированнаяСтрока(СтрШаблон("%1: нет замеров за 30 минут до %2, проверьте агент мониторинга",
			Машина, Формат(КонецПериода, "ДФ='dd.MM HH:mm'")), , Новый Цвет(198, 40, 40));
	КонецЕсли;
	Текст = СтрШаблон("%1, последний замер %2, замер раз в 5 минут", Машина, Формат(ПоследнийЗамер, "ДФ='dd.MM HH:mm'"));
	Если КонецПериода - ПоследнийЗамер > 900 Тогда
		Возврат Новый ФорматированнаяСтрока(Текст + " - замеры запаздывают, проверьте агент", , Новый Цвет(198, 40, 40));
	КонецЕсли;
	Возврат Новый ФорматированнаяСтрока(Текст);

КонецФункции

#КонецОбласти

#Область Конструктор

// Перечень показателей за период; отметки и масштаб уже выбранных показателей сохраняются.
// При первом открытии отмечается загрузка CPU.
&НаСервере
Процедура ЗаполнитьПоказатели(Отбор, ПоЧасам)

	Прежние = Новый Соответствие;
	Для Каждого Строка Из Показатели Цикл
		Прежние.Вставить(КлючПоказателя(Строка), Новый Структура("Пометка,Масштаб", Строка.Пометка, Строка.Масштаб));
	КонецЦикла;
	ПервоеЗаполнение = (Показатели.Количество() = 0);

	Запрос = Новый Запрос;
	Условие = рбфАнализСервер.УсловиеОтбораТЖ(Запрос, Отбор, Неопределено);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	С.Сервер КАК Сервер,
	|	С.Счетчик КАК Счетчик
	|ИЗ
	|	РегистрСведений.рбфСчетчики КАК С
	|ГДЕ
	|	С.Время МЕЖДУ &Начало И &Конец
	|	И (&Сервер = """" ИЛИ С.Сервер = &Сервер)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сервер,
	|	Счетчик
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Событие КАК Событие
	|ИЗ
	|	РегистрСведений.рбфСобытияТЖ КАК Т
	|ГДЕ
	|	" + Условие + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Событие";
	Запрос.УстановитьПараметр("Начало", Отбор.Начало);
	Запрос.УстановитьПараметр("Конец", Отбор.Конец);
	Запрос.УстановитьПараметр("Сервер", Отбор.Сервер);
	Результаты = Запрос.ВыполнитьПакет();

	Показатели.Очистить();
	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Показатели.Добавить();
		Строка.Источник = "Счетчик";
		Строка.ИмяСервера = Выборка.Сервер;
		Строка.Ключ = Выборка.Счетчик;
		Строка.Вид = "Значение";
		Строка.Показатель = Выборка.Сервер + ": " + Выборка.Счетчик;
		Строка.ОсьX = ?(ПоЧасам, "Время, час (среднее)", "Время, 5 мин");
		Запятая = СтрНайти(Выборка.Счетчик, ", ", НаправлениеПоиска.СКонца);
		Строка.ОсьY = ?(Запятая = 0, "", Сред(Выборка.Счетчик, Запятая + 2));
		Строка.Масштаб = 1;
		Строка.Пометка = ПервоеЗаполнение И СтрНачинаетсяС(Выборка.Счетчик, "CPU");
	КонецЦикла;

	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Для Каждого Вид Из СтрРазделить("Количество,Длительность", ",") Цикл
			Строка = Показатели.Добавить();
			Строка.Источник = "ТЖ";
			Строка.Ключ = Выборка.Событие;
			Строка.Вид = Вид;
			Строка.Показатель = "ТЖ " + Выборка.Событие + ": " + ?(Вид = "Количество", "количество", "длительность");
			Строка.ОсьX = "Время, час";
			Строка.ОсьY = ?(Вид = "Количество", "шт. за час", "с за час");
			Строка.Масштаб = 1;
		КонецЦикла;
	КонецЦикла;

	Для Каждого Строка Из Показатели Цикл
		Прежний = Прежние.Получить(КлючПоказателя(Строка));
		Если Прежний <> Неопределено Тогда
			Строка.Пометка = Прежний.Пометка;
			Строка.Масштаб = Прежний.Масштаб;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПостроитьДиаграмму(Отбор, ПоЧасам)

	Счетчики = Новый Массив;
	Серверы = Новый Массив;
	СобытияТЖ = Новый Массив;
	Отмеченные = Новый Массив;
	Для Каждого Строка Из Показатели Цикл
		Если НЕ Строка.Пометка Тогда
			Продолжить;
		КонецЕсли;
		Отмеченные.Добавить(Строка);
		Если Строка.Источник = "Счетчик" Тогда
			Счетчики.Добавить(Строка.Ключ);
			Серверы.Добавить(Строка.ИмяСервера);
		Иначе
			СобытияТЖ.Добавить(Строка.Ключ);
		КонецЕсли;
	КонецЦикла;

	Диаграмма.Очистить();
	Диаграмма.ТипДиаграммы = ТипДиаграммы.График;
	Если Отмеченные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Данные = Новый Соответствие; // ключ показателя -> Соответствие (время -> значение)
	Моменты = Новый ТаблицаЗначений;
	Моменты.Колонки.Добавить("Время");

	Если Счетчики.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Если ПоЧасам Тогда
			Запрос.Текст =
			"ВЫБРАТЬ
			|	НАЧАЛОПЕРИОДА(С.Время, ЧАС) КАК Время,
			|	С.Сервер КАК Сервер,
			|	С.Счетчик КАК Счетчик,
			|	СРЕДНЕЕ(С.Значение) КАК Значение
			|ИЗ
			|	РегистрСведений.рбфСчетчики КАК С
			|ГДЕ
			|	С.Время МЕЖДУ &Начало И &Конец
			|	И С.Счетчик В (&Счетчики)
			|	И С.Сервер В (&Серверы)
			|
			|СГРУППИРОВАТЬ ПО
			|	НАЧАЛОПЕРИОДА(С.Время, ЧАС),
			|	С.Сервер,
			|	С.Счетчик";
		Иначе
			Запрос.Текст =
			"ВЫБРАТЬ
			|	С.Время КАК Время,
			|	С.Сервер КАК Сервер,
			|	С.Счетчик КАК Счетчик,
			|	С.Значение КАК Значение
			|ИЗ
			|	РегистрСведений.рбфСчетчики КАК С
			|ГДЕ
			|	С.Время МЕЖДУ &Начало И &Конец
			|	И С.Счетчик В (&Счетчики)
			|	И С.Сервер В (&Серверы)";
		КонецЕсли;
		Запрос.УстановитьПараметр("Начало", Отбор.Начало);
		Запрос.УстановитьПараметр("Конец", Отбор.Конец);
		Запрос.УстановитьПараметр("Счетчики", Счетчики);
		Запрос.УстановитьПараметр("Серверы", Серверы);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Ключ = "Счетчик|" + Выборка.Сервер + "|" + Выборка.Счетчик + "|Значение";
			ДобавитьЗначение(Данные, Моменты, Ключ, Выборка.Время, Выборка.Значение);
		КонецЦикла;
	КонецЕсли;

	Если СобытияТЖ.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Условие = рбфАнализСервер.УсловиеОтбораТЖ(Запрос, Отбор, СобытияТЖ);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Час КАК Время,
		|	Т.Событие КАК Событие,
		|	СУММА(Т.Количество) КАК Количество,
		|	СУММА(Т.ДлительностьСуммаМс) / 1000 КАК Длительность
		|ИЗ
		|	РегистрСведений.рбфСобытияТЖ КАК Т
		|ГДЕ
		|	" + Условие + "
		|
		|СГРУППИРОВАТЬ ПО
		|	Т.Час,
		|	Т.Событие";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ДобавитьЗначение(Данные, Моменты, "ТЖ||" + Выборка.Событие + "|Количество", Выборка.Время, Выборка.Количество);
			ДобавитьЗначение(Данные, Моменты, "ТЖ||" + Выборка.Событие + "|Длительность", Выборка.Время, Выборка.Длительность);
		КонецЦикла;
	КонецЕсли;

	Моменты.Свернуть("Время");
	Моменты.Сортировать("Время");
	Точки = Новый Соответствие;
	Для Каждого Момент Из Моменты Цикл
		Точка = Диаграмма.Точки.Добавить(Момент.Время);
		Точка.Текст = Формат(Момент.Время, "ДФ='dd.MM HH:mm'");
		Точки.Вставить(Момент.Время, Точка);
	КонецЦикла;

	Для Каждого Строка Из Отмеченные Цикл
		// не «Масштаб»: в модуле формы это свойство самой формы (масштаб отображения)
		Множитель = ?(Строка.Масштаб = 0, 1, Строка.Масштаб);
		Серия = Диаграмма.Серии.Добавить(Строка.Показатель + ?(Множитель = 1, "", " × " + Множитель));
		Значения = Данные.Получить(КлючПоказателя(Строка));
		Если Значения = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого КЗ Из Значения Цикл
			Диаграмма.УстановитьЗначение(Точки.Получить(КЗ.Ключ), Серия, КЗ.Значение * Множитель);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьЗначение(Данные, Моменты, Ключ, Время, Значение)

	Значения = Данные.Получить(Ключ);
	Если Значения = Неопределено Тогда
		Значения = Новый Соответствие;
		Данные.Вставить(Ключ, Значения);
	КонецЕсли;
	Значения.Вставить(Время, Значение);
	Моменты.Добавить().Время = Время;

КонецПроцедуры

&НаСервереБезКонтекста
Функция КлючПоказателя(Строка)

	Возврат Строка.Источник + "|" + Строка.ИмяСервера + "|" + Строка.Ключ + "|" + Строка.Вид;

КонецФункции

#КонецОбласти

#КонецОбласти
