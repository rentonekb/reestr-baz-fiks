// Раздел «Анализ», страница «График»: сверху - показатели (флажок, ось X, ось Y, масштаб),
// под ними - диаграмма отмеченных показателей, внизу - расшифровка выбранной точки.
// Показатели: счётчики агентов (рбфСчетчики, замер раз в 5 минут) и количество / длительность
// отдельных событий ТЖ (рбфВыполненияТЖ). Все серии строятся на одной сетке времени:
// шаг 5 минут для периода до 6 часов, час - до 40 суток, иначе сутки. Счётчики в шаге
// усредняются, события ТЖ суммируются. Флажок и масштаб перестраивают диаграмму сразу.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	рбфАнализСервер.ЗаполнитьШапку(ЭтотОбъект);
	ОбновитьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДиаграммаВыбор(Элемент, ЗначениеДиаграммы, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если ЗначениеДиаграммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Момент = ЗначениеДиаграммы.Точка.Значение;
		КлючСерии = ЗначениеДиаграммы.Серия.Значение;
	Исключение
		Возврат;
	КонецПопытки;
	Если ТипЗнч(Момент) <> Тип("Дата") Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьРасшифровку(Момент, ?(ТипЗнч(КлючСерии) = Тип("Строка"), КлючСерии, ""));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПоказатели

&НаКлиенте
Процедура ПоказателиПометкаПриИзменении(Элемент)

	ПостроитьДиаграммуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПоказателиМасштабПриИзменении(Элемент)

	ПостроитьДиаграммуНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьОбработка(Команда)

	ОбновитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодОбработка(Команда)

	рбфАнализКлиент.ВыбратьПериод(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ДопФильтрОбработка(Команда)

	рбфАнализКлиент.ПереключитьДопФильтр(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьНаСервере()

	Отбор = рбфАнализСервер.Отбор(ЭтотОбъект);
	Длительность = Отбор.Конец - Отбор.Начало;
	Если Длительность <= 6 * 3600 Тогда
		Шаг = 300;
	ИначеЕсли Длительность <= 40 * 86400 Тогда
		Шаг = 3600;
	Иначе
		Шаг = 86400;
	КонецЕсли;
	ЗаполнитьПоказатели(Отбор);
	ПостроитьДиаграмму(Отбор);
	Расшифровка.Очистить();

КонецПроцедуры

&НаСервере
Процедура ПостроитьДиаграммуНаСервере()

	ПостроитьДиаграмму(рбфАнализСервер.Отбор(ЭтотОбъект));

КонецПроцедуры

// Перечень показателей за период; отметки и масштаб уже выбранных показателей сохраняются.
// При первом открытии отмечается загрузка CPU, а если её нет - первый показатель.
&НаСервере
Процедура ЗаполнитьПоказатели(Отбор)

	Прежние = Новый Соответствие;
	Для Каждого Показатель Из Показатели Цикл
		Прежние.Вставить(КлючПоказателя(Показатель), Новый Структура("Пометка,Масштаб", Показатель.Пометка,
			Показатель.Масштаб));
	КонецЦикла;
	ПервоеЗаполнение = (Показатели.Количество() = 0);
	ОсьX = "Время, " + ПредставлениеШага();

	Запрос = Новый Запрос;
	Условие = рбфАнализСервер.УсловиеОтбораВыполнений(Запрос, Отбор, Неопределено);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	С.Сервер КАК Сервер,
	|	С.Счетчик КАК Счетчик
	|ИЗ
	|	РегистрСведений.рбфСчетчики КАК С
	|ГДЕ
	|	С.Время МЕЖДУ &Начало И &Конец
	|	И (&Сервер = """" ИЛИ С.Сервер = &Сервер)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сервер,
	|	Счетчик
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Событие КАК Событие
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	" + Условие + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Событие";
	Запрос.УстановитьПараметр("Начало", Отбор.Начало);
	Запрос.УстановитьПараметр("Конец", Отбор.Конец);
	Запрос.УстановитьПараметр("Сервер", Отбор.Сервер);
	Результаты = Запрос.ВыполнитьПакет();

	Показатели.Очистить();
	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Показатель = Показатели.Добавить();
		Показатель.Источник = "Счетчик";
		Показатель.ИмяСервера = Выборка.Сервер;
		Показатель.Ключ = Выборка.Счетчик;
		Показатель.Вид = "Среднее";
		Показатель.Показатель = Выборка.Сервер + ": " + Выборка.Счетчик;
		Показатель.ОсьX = ОсьX;
		Запятая = СтрНайти(Выборка.Счетчик, ", ", НаправлениеПоиска.СКонца);
		Показатель.ОсьY = ?(Запятая = 0, "", Сред(Выборка.Счетчик, Запятая + 2));
		Показатель.Масштаб = 1;
		Показатель.Пометка = ПервоеЗаполнение И СтрНачинаетсяС(ВРег(Выборка.Счетчик), "CPU");
	КонецЦикла;

	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Для Каждого Вид Из СтрРазделить("Количество,Длительность", ",") Цикл
			Показатель = Показатели.Добавить();
			Показатель.Источник = "ТЖ";
			Показатель.Ключ = Выборка.Событие;
			Показатель.Вид = Вид;
			Показатель.Показатель = "ТЖ " + Выборка.Событие + ": " + ?(Вид = "Количество", "количество", "длительность");
			Показатель.ОсьX = ОсьX;
			Показатель.ОсьY = ?(Вид = "Количество", "шт.", "с");
			Показатель.Масштаб = 1;
		КонецЦикла;
	КонецЦикла;

	ЕстьОтмеченные = Ложь;
	Для Каждого Показатель Из Показатели Цикл
		Прежний = Прежние.Получить(КлючПоказателя(Показатель));
		Если Прежний <> Неопределено Тогда
			Показатель.Пометка = Прежний.Пометка;
			Показатель.Масштаб = Прежний.Масштаб;
		КонецЕсли;
		ЕстьОтмеченные = ЕстьОтмеченные ИЛИ Показатель.Пометка;
	КонецЦикла;
	Если ПервоеЗаполнение И НЕ ЕстьОтмеченные И Показатели.Количество() > 0 Тогда
		Показатели[0].Пометка = Истина;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПостроитьДиаграмму(Отбор)

	Диаграмма.Очистить();
	Диаграмма.ТипДиаграммы = ТипДиаграммы.График;

	Счетчики = Новый Массив;
	Серверы = Новый Массив;
	СобытияТЖ = Новый Массив;
	Отмеченные = Новый Массив;
	Для Каждого Показатель Из Показатели Цикл
		Если НЕ Показатель.Пометка Тогда
			Продолжить;
		КонецЕсли;
		Отмеченные.Добавить(Показатель);
		Если Показатель.Источник = "Счетчик" Тогда
			Счетчики.Добавить(Показатель.Ключ);
			Серверы.Добавить(Показатель.ИмяСервера);
		ИначеЕсли СобытияТЖ.Найти(Показатель.Ключ) = Неопределено Тогда
			СобытияТЖ.Добавить(Показатель.Ключ);
		КонецЕсли;
	КонецЦикла;

	Если Показатели.Количество() = 0 Тогда
		ПоказатьСостояние(НСтр("ru = 'За период нет ни замеров счётчиков (их присылает агент rbf через rbf-admin/metrics), ни событий ТЖ (tj-analyzer или агент через rbf-admin/tj-events).'"));
		Возврат;
	ИначеЕсли Отмеченные.Количество() = 0 Тогда
		ПоказатьСостояние(НСтр("ru = 'Отметьте флажком показатели, которые нужно показать.'"));
		Возврат;
	КонецЕсли;

	// сетка времени: начало каждого шага от начала периода
	НачалоСетки = ?(Шаг >= 3600, НачалоЧаса(Отбор.Начало), НачалоМинуты(Отбор.Начало) - Минута(Отбор.Начало) % 5 * 60);
	Если Шаг = 86400 Тогда
		НачалоСетки = НачалоДня(Отбор.Начало);
	КонецЕсли;
	Моменты = Новый Массив;
	Момент = НачалоСетки;
	Пока Момент <= Отбор.Конец Цикл
		Моменты.Добавить(Момент);
		Момент = Момент + Шаг;
	КонецЦикла;

	Суммы = Новый Соответствие; // ключ показателя -> Соответствие (момент -> Структура Сумма, Количество)

	Если Счетчики.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	С.Время КАК Время,
		|	С.Сервер КАК Сервер,
		|	С.Счетчик КАК Счетчик,
		|	С.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.рбфСчетчики КАК С
		|ГДЕ
		|	С.Время МЕЖДУ &Начало И &Конец
		|	И С.Счетчик В (&Счетчики)
		|	И С.Сервер В (&Серверы)";
		Запрос.УстановитьПараметр("Начало", НачалоСетки);
		Запрос.УстановитьПараметр("Конец", Отбор.Конец);
		Запрос.УстановитьПараметр("Счетчики", Счетчики);
		Запрос.УстановитьПараметр("Серверы", Серверы);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Ключ = "Счетчик|" + Выборка.Сервер + "|" + Выборка.Счетчик + "|Среднее";
			ДобавитьВШаг(Суммы, Ключ, ШагМомента(Выборка.Время, НачалоСетки), Выборка.Значение, 1);
		КонецЦикла;
	КонецЕсли;

	Если СобытияТЖ.Количество() > 0 Тогда
		ОтборСобытий = Новый Структура;
		Для Каждого КЗ Из Отбор Цикл
			ОтборСобытий.Вставить(КЗ.Ключ, КЗ.Значение);
		КонецЦикла;
		ОтборСобытий.Начало = НачалоСетки;
		Запрос = Новый Запрос;
		Условие = рбфАнализСервер.УсловиеОтбораВыполнений(Запрос, ОтборСобытий, СобытияТЖ);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(Т.Время, МИНУТА) КАК Время,
		|	Т.Событие КАК Событие,
		|	КОЛИЧЕСТВО(*) КАК Количество,
		|	СУММА(Т.ДлительностьМс) / 1000 КАК Длительность
		|ИЗ
		|	РегистрСведений.рбфВыполненияТЖ КАК Т
		|ГДЕ
		|	" + Условие + "
		|
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(Т.Время, МИНУТА),
		|	Т.Событие";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			МоментШага = ШагМомента(Выборка.Время, НачалоСетки);
			ДобавитьВШаг(Суммы, "ТЖ||" + Выборка.Событие + "|Количество", МоментШага, Выборка.Количество, 0);
			ДобавитьВШаг(Суммы, "ТЖ||" + Выборка.Событие + "|Длительность", МоментШага, Выборка.Длительность, 0);
		КонецЦикла;
	КонецЕсли;

	Точки = Новый Соответствие;
	ФорматТочки = ?(Шаг = 86400, "ДФ=dd.MM", ?(Отбор.Конец - Отбор.Начало > 86400, "ДФ='dd.MM HH:mm'", "ДФ=HH:mm"));
	Для Каждого Момент Из Моменты Цикл
		Точка = Диаграмма.Точки.Добавить(Момент);
		Точка.Текст = Формат(Момент, ФорматТочки);
		Точки.Вставить(Момент, Точка);
	КонецЦикла;

	ЕстьДанные = Ложь;
	Для Каждого Показатель Из Отмеченные Цикл
		Масштаб = ?(Показатель.Масштаб = 0, 1, Показатель.Масштаб);
		Ключ = КлючПоказателя(Показатель);
		Серия = Диаграмма.Серии.Добавить(Ключ);
		Серия.Текст = Показатель.Показатель + ?(Масштаб = 1, "", " × " + Формат(Масштаб, "ЧГ="));
		Значения = Суммы.Получить(Ключ);
		ЕстьДанные = ЕстьДанные ИЛИ Значения <> Неопределено;
		ЭтоСчетчик = (Показатель.Источник = "Счетчик");
		Для Каждого Момент Из Моменты Цикл
			Шаговое = ?(Значения = Неопределено, Неопределено, Значения.Получить(Момент));
			Если Шаговое = Неопределено Тогда
				// у событий ТЖ нет событий - ноль, у счётчика нет замера - пропуск
				Если НЕ ЭтоСчетчик Тогда
					Диаграмма.УстановитьЗначение(Точки.Получить(Момент), Серия, 0);
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Значение = ?(ЭтоСчетчик И Шаговое.Количество > 0, Шаговое.Сумма / Шаговое.Количество, Шаговое.Сумма);
			Диаграмма.УстановитьЗначение(Точки.Получить(Момент), Серия, Значение * Масштаб);
		КонецЦикла;
	КонецЦикла;

	ПоказатьСостояние(?(ЕстьДанные, "",
		НСтр("ru = 'По отмеченным показателям за период нет данных. Проверьте период и отбор по серверу и базе.'")));

КонецПроцедуры

// Расшифровка точки: события ТЖ за шаг (по выбранному показателю ТЖ - только это событие),
// самые долгие сверху.
&НаСервере
Процедура ЗаполнитьРасшифровку(Момент, КлючСерии)

	Отбор = рбфАнализСервер.Отбор(ЭтотОбъект);
	События = Неопределено;
	Части = СтрРазделить(КлючСерии, "|");
	Если Части.Количество() = 4 И Части[0] = "ТЖ" Тогда
		События = Новый Массив;
		События.Добавить(Части[2]);
	КонецЕсли;
	Запрос = Новый Запрос;
	Условие = рбфАнализСервер.УсловиеОтбораВыполнений(Запрос, Отбор, События);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 200
	|	Т.Время КАК Время,
	|	Т.Событие КАК Событие,
	|	Т.ДлительностьМс / 1000 КАК Сек,
	|	Т.Пользователь КАК Пользователь,
	|	Т.КонтекстТочка КАК КонтекстТочка,
	|	Т.База КАК База
	|ИЗ
	|	РегистрСведений.рбфВыполненияТЖ КАК Т
	|ГДЕ
	|	" + Условие + "
	|	И Т.Время >= &НачалоШага
	|	И Т.Время < &КонецШага
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сек УБЫВ";
	Запрос.УстановитьПараметр("НачалоШага", Момент);
	Запрос.УстановитьПараметр("КонецШага", Момент + Шаг);
	Расшифровка.Загрузить(Запрос.Выполнить().Выгрузить());
	Элементы.Расшифровка.Заголовок = СтрШаблон(НСтр("ru = 'Расшифровка: события ТЖ с %1 по %2 (%3)'"),
		Формат(Момент, "ДФ='dd.MM HH:mm'"), Формат(Момент + Шаг, "ДФ=HH:mm"), Расшифровка.Количество());

КонецПроцедуры

&НаСервере
Процедура ДобавитьВШаг(Суммы, Ключ, Момент, Значение, Количество)

	Значения = Суммы.Получить(Ключ);
	Если Значения = Неопределено Тогда
		Значения = Новый Соответствие;
		Суммы.Вставить(Ключ, Значения);
	КонецЕсли;
	Шаговое = Значения.Получить(Момент);
	Если Шаговое = Неопределено Тогда
		Шаговое = Новый Структура("Сумма,Количество", 0, 0);
		Значения.Вставить(Момент, Шаговое);
	КонецЕсли;
	Шаговое.Сумма = Шаговое.Сумма + Значение;
	Шаговое.Количество = Шаговое.Количество + Количество;

КонецПроцедуры

&НаСервере
Функция ШагМомента(Время, НачалоСетки)

	Возврат НачалоСетки + Цел((Время - НачалоСетки) / Шаг) * Шаг;

КонецФункции

&НаСервере
Функция КлючПоказателя(Показатель)

	Возврат Показатель.Источник + "|" + Показатель.ИмяСервера + "|" + Показатель.Ключ + "|" + Показатель.Вид;

КонецФункции

&НаСервере
Функция ПредставлениеШага()

	Если Шаг = 300 Тогда
		Возврат "5 мин";
	ИначеЕсли Шаг = 3600 Тогда
