// Раздел «Анализ», страница «График». Две закладки:
//  «Нагрузка» - дашборд сервера: плитки текущих значений с цветом по порогам и готовые панели
//    графиков (процессор, память, SQL, блокировки, диски, долгие вызовы 1С); обновляется сам раз в минуту,
//    пока период «Последние 3 часа» или «Сегодня».
//  «Конструктор» - произвольный набор показателей (флажок, ось X, ось Y, масштаб) на одной диаграмме.
// Показатели - счётчики агентов (рбфСчетчики, замер раз в 5 минут) и количество / длительность событий ТЖ
// по часам (рбфСобытияТЖ). Масштаб умножает значения серии, чтобы показатели разного порядка уместились на одной оси.
// Элементы дашборда создаются программно (СоздатьЭлементыДашборда): форма выкладывается только модулем.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	рбфАнализСервер.ЗаполнитьШапку(ЭтотОбъект);
	СоздатьЭлементыДашборда();
	ОбновитьНаСервере(Ложь);

КонецПроцедуры

// Подключается программно в СоздатьЭлементыДашборда.
&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПодключитьОбработчикОжидания("АвтообновлениеДашборда", 60);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Подключается программно в рбфАнализСервер.ЗаполнитьШапку: выбор базы сразу обновляет данные.
&НаКлиенте
Процедура БазаПриИзменении(Элемент)

	ОбновитьОбработка(Неопределено);

КонецПроцедуры

// Подключается программно в СоздатьЭлементыДашборда: отметка или масштаб показателя сразу перестраивает диаграмму.
&НаКлиенте
Процедура ПоказателиПриИзменении(Элемент)

	ПерестроитьДиаграммуНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьОбработка(Команда)

	ОбновитьНаСервере(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодОбработка(Команда)

	рбфАнализКлиент.ВыбратьПериод(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ДопФильтрОбработка(Команда)

	рбфАнализКлиент.ПереключитьДопФильтр(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обработчик ожидания: раз в минуту перечитывает дашборд, если включено автообновление
// и период скользящий (за произвольный интервал данные не меняются).
&НаКлиенте
Процедура АвтообновлениеДашборда()

	Если ЭтотОбъект["Автообновление"] <> Истина ИЛИ ВидПериода = "Произвольный интервал" Тогда
		Возврат;
	КонецЕсли;
	ОбновитьНаСервере(Истина);

КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере(Знач ТолькоДашборд)

	Отбор = рбфАнализСервер.Отбор(ЭтотОбъект);
	ПоЧасам = ПоЧасам(Отбор);
	ЗаполнитьДашборд(Отбор, ПоЧасам);
	Если НЕ ТолькоДашборд Тогда
		ЗаполнитьПоказатели(Отбор, ПоЧасам);
		ПостроитьДиаграмму(Отбор, ПоЧасам);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПерестроитьДиаграммуНаСервере()

	Отбор = рбфАнализСервер.Отбор(ЭтотОбъект);
	ПостроитьДиаграмму(Отбор, ПоЧасам(Отбор));

КонецПроцедуры

// За период длиннее двух суток 5-минутные замеры усредняются по часам.
&НаСервереБезКонтекста
Функция ПоЧасам(Отбор)

	Возврат (Отбор.Конец - Отбор.Начало) > 2 * 86400;

КонецФункции

#Область Дашборд

// Закладки «Нагрузка» и «Конструктор», плитки, панели графиков и флажок автообновления.
// Таблица показателей и диаграмма из метаданных формы переносятся на закладку «Конструктор».
&НаСервере
Процедура СоздатьЭлементыДашборда()

	Панели = ПанелиДашборда();
	Добавляемые = Новый Массив;
	Добавляемые.Добавить(Новый РеквизитФормы("Автообновление", Новый ОписаниеТипов("Булево"), , "Обновлять каждую минуту"));
	Для Каждого Панель Из Панели Цикл
		Добавляемые.Добавить(Новый РеквизитФормы("Диаграмма" + Панель.Имя, Новый ОписаниеТипов("Диаграмма"), , Панель.Заголовок));
	КонецЦикла;
	ИзменитьРеквизиты(Добавляемые);
	ЭтотОбъект["Автообновление"] = Истина;
	УстановитьДействие("ПриОткрытии", "ПриОткрытии");

	Страницы = Элементы.Добавить("Страницы", Тип("ГруппаФормы"));
	Страницы.Вид = ВидГруппыФормы.Страницы;
	Страницы.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху;
	СтраницаНагрузка = НоваяГруппа("СтраницаНагрузка", Страницы, ВидГруппыФормы.Страница, "Нагрузка");
	СтраницаКонструктор = НоваяГруппа("СтраницаКонструктор", Страницы, ВидГруппыФормы.Страница, "Конструктор");

	Элементы.Переместить(Элементы.Показатели, СтраницаКонструктор);
	Элементы.Переместить(Элементы.Диаграмма, СтраницаКонструктор);
	// таблица показателей больше не забирает всю высоту: растягивается диаграмма
	Элементы.Показатели.РастягиватьПоВертикали = Ложь;
	Элементы.Показатели.Высота = 8;
	Элементы.ПоказателиПометка.УстановитьДействие("ПриИзменении", "ПоказателиПриИзменении");
	Элементы.ПоказателиМасштаб.УстановитьДействие("ПриИзменении", "ПоказателиПриИзменении");

	ГруппаСостояние = НоваяГруппа("ГруппаСостояние", СтраницаНагрузка, ВидГруппыФормы.ОбычнаяГруппа, "");
	Состояние = Элементы.Добавить("НадписьСостояние", Тип("ДекорацияФормы"), ГруппаСостояние);
	Состояние.Вид = ВидДекорацииФормы.Надпись;
	Состояние.РастягиватьПоГоризонтали = Истина;
	Флажок = Элементы.Добавить("Автообновление", Тип("ПолеФормы"), ГруппаСостояние);
	Флажок.Вид = ВидПоляФормы.ПолеФлажка;
	Флажок.ПутьКДанным = "Автообновление";
	Флажок.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;

	ГруппаПлитки = НоваяГруппа("ГруппаПлитки", СтраницаНагрузка, ВидГруппыФормы.ОбычнаяГруппа, "");
	Для Каждого Плитка Из ПлиткиДашборда() Цикл
		Надпись = Элементы.Добавить("Плитка" + Плитка.Имя, Тип("ДекорацияФормы"), ГруппаПлитки);
		Надпись.Вид = ВидДекорацииФормы.Надпись;
		Надпись.Ширина = 14;
		Надпись.Высота = 2;
		Надпись.РастягиватьПоГоризонтали = Истина;
		Надпись.Подсказка = Плитка.Подсказка;
	КонецЦикла;

	// панели по две в ряд
	Ряд = Неопределено;
	Для Индекс = 0 По Панели.ВГраница() Цикл
		Панель = Панели[Индекс];
		Если Индекс % 2 = 0 Тогда
			Ряд = НоваяГруппа("ГруппаПанели" + Формат(Индекс / 2 + 1, "ЧГ="), СтраницаНагрузка, ВидГруппыФормы.ОбычнаяГруппа, "");
		КонецЕсли;
		Поле = Элементы.Добавить("Диаграмма" + Панель.Имя, Тип("ПолеФормы"), Ряд);
		Поле.Вид = ВидПоляФормы.ПолеДиаграммы;
		Поле.ПутьКДанным = "Диаграмма" + Панель.Имя;
		Поле.Заголовок = Панель.Заголовок;
		Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
		Поле.Высота = 9;
		Поле.РастягиватьПоГоризонтали = Истина;
		Поле.РастягиватьПоВертикали = Истина;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция НоваяГруппа(Имя, Родитель, Вид, Заголовок)

	Группа = Элементы.Добавить(Имя, Тип("ГруппаФормы"), Родитель);
	Группа.Вид = Вид;
	Если Вид = ВидГруппыФормы.Страница Тогда
		Группа.Заголовок = Заголовок;
		Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	Иначе
		Группа.Отображение = ОтображениеОбычнойГруппы.Нет;
		Группа.ОтображатьЗаголовок = Ложь;
		// не «ГоризонтальнаяЕслиВозможно»: с ней плитки и панели встают столбиком
		Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	КонецЕсли;
	Возврат Группа;

КонецФункции

// Плитки и панели по замерам выбранной машины (сервер из доп. фильтра; пустой - первая машина с замерами).
&НаСервере
Процедура ЗаполнитьДашборд(Отбор, ПоЧасам)

	Машина = Отбор.Машина;
	Если ПустаяСтрока(Машина) Тогда
		Машина = МашинаПоУмолчанию(Отбор.Начало, Отбор.Конец);
	КонецЕсли;

	// плитки - последний замер каждого счётчика за 30 минут до конца периода
	Последние = Новый Соответствие; // Сервер|Счетчик -> Структура(Время, Сервер, Счетчик, Значение)
	ПоследнийЗамер = Дата(1, 1, 1);
	Для Каждого Замер Из ЗамерыМашины(Машина, Отбор.Конец - 1800, Отбор.Конец, Ложь) Цикл
		Ключ = Замер.Сервер + "|" + Замер.Счетчик;
		Прежний = Последние.Получить(Ключ);
		Если Прежний = Неопределено ИЛИ Прежний.Время < Замер.Время Тогда
			Последние.Вставить(Ключ, Новый Структура("Время,Сервер,Счетчик,Значение",
				Замер.Время, Замер.Сервер, Замер.Счетчик, Замер.Значение));
		КонецЕсли;
		ПоследнийЗамер = Макс(ПоследнийЗамер, Замер.Время);
	КонецЦикла;
	Для Каждого Плитка Из ПлиткиДашборда() Цикл
		Значения = Новый Массив;
		Для Каждого КЗ Из Последние Цикл
			Для Каждого Правило Из Плитка.Правила Цикл
				Если ПодходитПравилу(Правило, КЗ.Значение.Сервер, КЗ.Значение.Счетчик, Машина) Тогда
					Значения.Добавить(КЗ.Значение.Значение / Правило.Делитель);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Элементы["Плитка" + Плитка.Имя].Заголовок = ПредставлениеПлитки(Плитка, Свести(Значения, Плитка.Агрегат));
	КонецЦикла;
	Элементы.НадписьСостояние.Заголовок = ПредставлениеСостояния(Машина, ПоследнийЗамер, Отбор.Конец);

	// графики - все замеры периода по шагу 5 минут (за длинный период - средние по часам)
	Шаг = ?(ПоЧасам, 3600, 300);
	Панели = ПанелиДашборда();
	Серии = Новый Соответствие; // Сервер|Счетчик -> Массив из Структура(Панель, Серия, Делитель)
	Данные = Новый Соответствие; // Панель -> Соответствие (Серия -> Соответствие (Момент -> Значение))
	Моменты = Новый Соответствие;
	Для Каждого Замер Из ЗамерыМашины(Машина, Отбор.Начало, Отбор.Конец, ПоЧасам) Цикл
		Ключ = Замер.Сервер + "|" + Замер.Счетчик;
		Куда = Серии.Получить(Ключ);
		Если Куда = Неопределено Тогда
			Куда = СерииСчетчика(Панели, Замер.Сервер, Замер.Счетчик, Машина);
			Серии.Вставить(Ключ, Куда);
		КонецЕсли;
		Если Куда.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Момент = Дата(1, 1, 1) + Цел((Замер.Время - Дата(1, 1, 1)) / Шаг) * Шаг;
		Моменты.Вставить(Момент, Истина);
		Для Каждого Цель Из Куда Цикл
			ДанныеПанели = Данные.Получить(Цель.Панель);
			Если ДанныеПанели = Неопределено Тогда
				ДанныеПанели = Новый Соответствие;
				Данные.Вставить(Цель.Панель, ДанныеПанели);
			КонецЕсли;
			Значения = ДанныеПанели.Получить(Цель.Серия);
			Если Значения = Неопределено Тогда
				Значения = Новый Соответствие;
				ДанныеПанели.Вставить(Цель.Серия, Значения);
			КонецЕсли;
			Значения.Вставить(Момент, Замер.Значение / Цель.Делитель);
		КонецЦикла;
	КонецЦикла;

	ОсьВремени = Новый СписокЗначений;
	Для Каждого КЗ Из Моменты Цикл
		ОсьВремени.Добавить(КЗ.Ключ);
	КонецЦикла;
	ОсьВремени.СортироватьПоЗначению();
	ФорматТочки = ?(Отбор.Конец - Отбор.Начало > 86400, "ДФ='dd.MM HH:mm'", "ДФ=HH:mm");

	Для Каждого Панель Из Панели Цикл
		Диаграмма = ЭтотОбъект["Диаграмма" + Панель.Имя];
		Диаграмма.Очистить();
		Диаграмма.ТипДиаграммы = ТипДиаграммы.График;
		ДанныеПанели = Данные.Получить(Панель.Имя);
		Если ДанныеПанели = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Точки = Новый Соответствие;
		Для Каждого Элемент Из ОсьВремени Цикл
			Точка = Диаграмма.Точки.Добавить(Элемент.Значение);
			Точка.Текст = Формат(Элемент.Значение, ФорматТочки);
			Точки.Вставить(Элемент.Значение, Точка);
		КонецЦикла;
		ИменаСерий = Новый СписокЗначений;
		Для Каждого КЗ Из ДанныеПанели Цикл
			ИменаСерий.Добавить(КЗ.Ключ);
		КонецЦикла;
		ИменаСерий.СортироватьПоЗначению();
		Для Каждого ИмяСерии Из ИменаСерий Цикл
			Серия = Диаграмма.Серии.Добавить(ИмяСерии.Значение);
			Для Каждого КЗ Из ДанныеПанели.Получить(ИмяСерии.Значение) Цикл
				Диаграмма.УстановитьЗначение(Точки.Получить(КЗ.Ключ), Серия, КЗ.Значение);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Замеры счётчиков машины и её кластеров 1С («S2019» и «S2019:1541»).
&НаСервереБезКонтекста
Функция ЗамерыМашины(Машина, Начало, Конец, ПоЧасам)

	Запрос = Новый Запрос;
	Если ПоЧасам Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(С.Время, ЧАС) КАК Время,
		|	С.Сервер КАК Сервер,
		|	С.Счетчик КАК Счетчик,
		|	СРЕДНЕЕ(С.Значение) КАК Значение
		|ИЗ
		|	РегистрСведений.рбфСчетчики КАК С
		|ГДЕ
		|	С.Время МЕЖДУ &Начало И &Конец
		|	И (С.Сервер = &Машина
		|			ИЛИ С.Сервер ПОДОБНО &Кластеры СПЕЦСИМВОЛ ""~"")
		|
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(С.Время, ЧАС),
		|	С.Сервер,
		|	С.Счетчик";
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		|	С.Время КАК Время,
		|	С.Сервер КАК Сервер,
		|	С.Счетчик КАК Счетчик,
		|	С.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.рбфСчетчики КАК С
		|ГДЕ
		|	С.Время МЕЖДУ &Начало И &Конец
		|	И (С.Сервер = &Машина
		|			ИЛИ С.Сервер ПОДОБНО &Кластеры СПЕЦСИМВОЛ ""~"")";
	КонецЕсли;
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("Машина", Машина);
	Запрос.УстановитьПараметр("Кластеры", рбфАнализСервер.ТекстДляПодобно(Машина) + ":%");
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Первая по имени машина, у которой за период есть замер загрузки процессора.
&НаСервереБезКонтекста
Функция МашинаПоУмолчанию(Начало, Конец)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	С.Сервер КАК Сервер
	|ИЗ
	|	РегистрСведений.рбфСчетчики КАК С
	|ГДЕ
	|	С.Время МЕЖДУ &Начало И &Конец
	|	И С.Счетчик = ""CPU, %""
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сервер";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Сервер, "");

КонецФункции

// Панели дашборда: Имя, Заголовок, Правила (см. Правило) - какие счётчики выводятся сериями.
