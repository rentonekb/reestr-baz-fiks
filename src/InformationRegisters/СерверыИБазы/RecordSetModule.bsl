#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// Без этих полей правила реестра не могут работать с базой: отключить, вернуть,
// заархивировать или написать владельцу. Проверяется запись пользователем;
// правила реестра пишут в привилегированном режиме и проверку не проходят.
// Архивные записи не проверяются: у удалённой базы нет ни кластера, ни БД.
// ОбработкаПроверкиЗаполнения не используется: в основной конфигурации такого
// обработчика нет, и обработчик расширения платформа не вызывает.
&Перед("ПередЗаписью")
Процедура рбф_ПередЗаписью(Отказ, Замещение)

	Если ОбменДанными.Загрузка ИЛИ ПривилегированныйРежим() Тогда
		Возврат;
	КонецЕсли;

	// удаление записей проверять нечего
	Если Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Обязательные = Новый Структура;
	Обязательные.Вставить("Сервер1С", "Сервер 1С");
	Обязательные.Вставить("ИмяБазы1С", "Имя базы 1С");
	Обязательные.Вставить("СерверБД", "Сервер БД");
	Обязательные.Вставить("ИмяБазыБД", "Имя базы БД");
	Обязательные.Вставить("Тип", "Тип");
	Обязательные.Вставить("Владелец", "Владелец");

	Для Каждого Запись Из ЭтотОбъект Цикл

		Если Запись.Тип = Перечисления.ТипБазы.Архивная Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Поле Из Обязательные Цикл
			Если НЕ ЗначениеЗаполнено(Запись[Поле.Ключ]) Тогда
				ОбщегоНазначения.СообщитьПользователю(
					СтрШаблон("Не заполнено поле «%1». Без него правила реестра не смогут работать с базой.", Поле.Значение),
					, Поле.Ключ, "Запись", Отказ);
			КонецЕсли;
		КонецЦикла;

		Если Запись.Тип = Перечисления.ТипБазы.Тестовая И НЕ ЗначениеЗаполнено(Запись.ДатаАктуальности) Тогда
			ОбщегоНазначения.СообщитьПользователю(
				"Для тестовой базы укажите дату актуальности: после неё база будет отключена и удалена.",
				, "ДатаАктуальности", "Запись", Отказ);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
