#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// 1. Даты. ДатаАктуальности - дата создания базы в SQL, ДатаОтключения - она же + 2 месяца
//    (крайний срок правила для тестовых баз, владелец может продлить). Точную дату создания
//    проставляет фоновое ПравилаРеестраБаз.ЗаполнитьДатыБаз: в сеансе пользователя sqlcmd
//    запускать нельзя. Здесь пустые даты заполняются сразу: актуальность - сегодняшним днём
//    (новая база создана только что), отключение - актуальность + 2 месяца.
// 2. Обязательные поля. Без них правила реестра не могут работать с базой: отключить,
//    вернуть, заархивировать или написать владельцу. Проверяется запись пользователем;
//    правила реестра пишут в привилегированном режиме и проверку не проходят.
//    Архивные записи не проверяются: у удалённой базы нет ни кластера, ни БД.
// ОбработкаПроверкиЗаполнения не используется: в основной конфигурации такого
// обработчика нет, и обработчик расширения платформа не вызывает.
&Перед("ПередЗаписью")
Процедура рбф_ПередЗаписью(Отказ, Замещение)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// удаление записей проверять нечего, только отметить в истории
	Если Количество() = 0 Тогда
		рбфЗаписатьИсториюИзменений(Замещение);
		Возврат;
	КонецЕсли;

	Для Каждого Запись Из ЭтотОбъект Цикл
		Если Запись.Тип = Перечисления.ТипБазы.Архивная Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Запись.ДатаАктуальности) Тогда
			Запись.ДатаАктуальности = НачалоДня(ТекущаяДатаСеанса());
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Запись.ДатаОтключения) Тогда
			Запись.ДатаОтключения = ДобавитьМесяц(Запись.ДатаАктуальности, 2);
		КонецЕсли;
	КонецЦикла;

	рбфЗаписатьИсториюИзменений(Замещение);

	Если ПривилегированныйРежим() Тогда
		Возврат;
	КонецЕсли;

	Обязательные = Новый Структура;
	Обязательные.Вставить("Сервер1С", "Сервер 1С");
	Обязательные.Вставить("ИмяБазы1С", "Имя базы 1С");
	Обязательные.Вставить("СерверБД", "Сервер БД");
	Обязательные.Вставить("ИмяБазыБД", "Имя базы БД");
	Обязательные.Вставить("Тип", "Тип");
	Обязательные.Вставить("Владелец", "Владелец");

	Для Каждого Запись Из ЭтотОбъект Цикл

		Если Запись.Тип = Перечисления.ТипБазы.Архивная Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Поле Из Обязательные Цикл
			Если НЕ ЗначениеЗаполнено(Запись[Поле.Ключ]) Тогда
				ОбщегоНазначения.СообщитьПользователю(
					СтрШаблон("Не заполнено поле «%1». Без него правила реестра не смогут работать с базой.", Поле.Значение),
					, Поле.Ключ, "Запись", Отказ);
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// История изменений записей реестра: событие журнала регистрации «Реестр.ИзменениеЗаписи»
// с перечнем изменённых полей (было -> стало). Кто изменил, журнал фиксирует сам.
// Владелец - измерение, поэтому его смена видна как удаление старой записи и создание новой.
Процедура рбфЗаписатьИсториюИзменений(Замещение)

	Метаданные_ = Метаданные.РегистрыСведений.СерверыИБазы;
	Поля = Новый Массив;
	Для Каждого Поле Из Метаданные_.Ресурсы Цикл
		Поля.Добавить(Поле.Имя);
	КонецЦикла;
	Для Каждого Поле Из Метаданные_.Реквизиты Цикл
		Поля.Добавить(Поле.Имя);
	КонецЦикла;

	// прежние записи под тем же отбором
	Прежние = РегистрыСведений.СерверыИБазы.СоздатьНаборЗаписей();
	Для Каждого ЭлементОтбора Из Отбор Цикл
		Если ЭлементОтбора.Использование Тогда
			Прежние.Отбор[ЭлементОтбора.Имя].Установить(ЭлементОтбора.Значение);
		КонецЕсли;
	КонецЦикла;
	Прежние.Прочитать();

	Для Каждого Запись Из ЭтотОбъект Цикл
		Прежняя = Неопределено;
		Для Каждого ЗаписьПрежняя Из Прежние Цикл
			Совпадает = Истина;
			Для Каждого Измерение Из Метаданные_.Измерения Цикл
				Если ЗаписьПрежняя[Измерение.Имя] <> Запись[Измерение.Имя] Тогда
					Совпадает = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Совпадает Тогда
				Прежняя = ЗаписьПрежняя;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если Прежняя = Неопределено Тогда
			рбфЗаписатьВИсторию(Запись.ИмяБазы1С, "создана запись: владелец " + рбфПредставлениеЗначения(Запись.Владелец)
				+ ", тип " + рбфПредставлениеЗначения(Запись.Тип) + ", сервер 1С " + рбфПредставлениеЗначения(Запись.Сервер1С)
				+ ", БД " + Запись.ИмяБазыБД);
			Продолжить;
		КонецЕсли;
		Прежние.Удалить(Прежняя);

		Изменения = Новый Массив;
		Для Каждого ИмяПоля Из Поля Цикл
			Если Запись[ИмяПоля] <> Прежняя[ИмяПоля] Тогда
				Изменения.Добавить(ИмяПоля + ": " + рбфПредставлениеЗначения(Прежняя[ИмяПоля]) + " -> "
					+ рбфПредставлениеЗначения(Запись[ИмяПоля]));
			КонецЕсли;
		КонецЦикла;
		Если Изменения.Количество() > 0 Тогда
			рбфЗаписатьВИсторию(Запись.ИмяБазы1С, СтрСоединить(Изменения, "; "));
		КонецЕсли;
	КонецЦикла;

	// что осталось от прежних - удаляется этой записью набора (только при замещении)
	Если НЕ Замещение Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ЗаписьПрежняя Из Прежние Цикл
		рбфЗаписатьВИсторию(ЗаписьПрежняя.ИмяБазы1С, "удалена запись: владелец "
			+ рбфПредставлениеЗначения(ЗаписьПрежняя.Владелец) + ", тип " + рбфПредставлениеЗначения(ЗаписьПрежняя.Тип));
	КонецЦикла;

КонецПроцедуры

Процедура рбфЗаписатьВИсторию(ИмяБазы1С, Текст)

	ЗаписьЖурналаРегистрации("Реестр.ИзменениеЗаписи", УровеньЖурналаРегистрации.Информация,
		Метаданные.РегистрыСведений.СерверыИБазы, , ИмяБазы1С + ": " + Текст);

КонецПроцедуры

Функция рбфПредставлениеЗначения(Значение)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "(пусто)";
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

#КонецОбласти

#КонецЕсли
