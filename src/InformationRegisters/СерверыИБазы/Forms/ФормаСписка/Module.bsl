#Область ОбработчикиСобытийФормы

// Рабочие базы без полного бэкапа дольше ДнейБезБэкапаРабочей (8) - ячейка «Последний бэкап»
// красная, а если бэкапа нет вовсе - текст «нет бэкапа». Порог тот же, что в письме администраторам.
// Обработчик OnCreateAtServer в основной форме отсутствует, а подключённый к отсутствующему основному
// обработчик расширения платформа не вызывает. Поэтому настройка формы - после основного ПриОткрытии.
&НаКлиенте
&После("ПриОткрытии")
Процедура рбфПриОткрытии(Отказ)

	рбфНастроитьФорму();

КонецПроцедуры

&НаСервере
Процедура рбфНастроитьФорму()

	Граница = НачалоДня(ТекущаяДатаСеанса()) - ПравилаРеестраБаз.Настройка("ДнейБезБэкапаРабочей", 8) * 86400;
	рбфДобавитьОформлениеБэкапа(ВидСравненияКомпоновкиДанных.Меньше, Граница, "");
	рбфДобавитьОформлениеБэкапа(ВидСравненияКомпоновкиДанных.НеЗаполнено, Неопределено, "нет бэкапа");

	// поля, которые не ведутся или одинаковы у всех баз (организация и площадка у нас одни)
	Для Каждого ИмяЭлемента Из СтрРазделить("Организация,Площадка,Источник,Наряд,Группа,СетевойПуть", ",") Цикл
		ЭлементФормы = Элементы.Найти(ИмяЭлемента);
		Если ЭлементФормы <> Неопределено Тогда
			ЭлементФормы.Видимость = Ложь;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура рбфДобавитьОформлениеБэкапа(ВидСравнения, Значение, Текст)

	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Представление = "Рабочая база без свежего бэкапа (РеестрБазФикс)";
	Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных("ДатаФактБэкап");

	ОтборТипа = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборТипа.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.Тип");
	ОтборТипа.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборТипа.ПравоеЗначение = Перечисления.ТипБазы.Рабочая;

	ОтборДаты = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборДаты.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.ДатаФактБэкап");
	ОтборДаты.ВидСравнения = ВидСравнения;
	Если Значение <> Неопределено Тогда
		ОтборДаты.ПравоеЗначение = Значение;
		// пустая дата тоже «меньше» границы - её оформляет второй элемент с текстом
		ОтборЗаполнено = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЗаполнено.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.ДатаФактБэкап");
		ОтборЗаполнено.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	КонецЕсли;

	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 199, 199));
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(156, 0, 6));
	Если ЗначениеЗаполнено(Текст) Тогда
		Элемент.Оформление.УстановитьЗначениеПараметра("Текст", Текст);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура рбфВернутьБазу(Команда)

	ДанныеСтроки = Элементы.Список.ТекущиеДанные;
	Если ДанныеСтроки = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите базу в списке.");
		Возврат;
	КонецЕсли;
	ПоказатьПредупреждение(, рбфЗапроситьВозвратНаСервере(ДанныеСтроки.Сервер1С, ДанныеСтроки.ИмяБазы1С));

КонецПроцедуры

&НаКлиенте
Процедура рбфПродлитьСрок(Команда)

	ДанныеСтроки = Элементы.Список.ТекущиеДанные;
	Если ДанныеСтроки = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите базу в списке.");
		Возврат;
	КонецЕсли;
	ПоказатьПредупреждение(, рбфПродлитьСрокНаСервере(ДанныеСтроки.Сервер1С, ДанныеСтроки.ИмяБазы1С));
	Элементы.Список.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура рбфСтатьВладельцем(Команда)

	ДанныеСтроки = Элементы.Список.ТекущиеДанные;
	Если ДанныеСтроки = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите базу в списке.");
		Возврат;
	КонецЕсли;
	ПоказатьПредупреждение(, рбфСтатьВладельцемНаСервере(ДанныеСтроки.Сервер1С, ДанныеСтроки.ИмяБазы1С));
	Элементы.Список.Обновить();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// &Вместо, а не &ИзменениеИКонтроль: тело типовой функции заменено целиком.
// @skip-check change-and-validate-instead-of-around
&НаСервере
&Вместо("ОграничениеПоПользователю")
Функция рбфОграничениеПоПользователю()

	// Отбор по владельцу отключён: реестр баз виден всем целиком.
	// В типовом коде здесь было обращение к Справочники.Владелец.Пустой -
	// предопределённого элемента с таким именем в конфигурации нет, форма падала.
	Возврат Справочники.Владелец.ПустаяСсылка();

КонецФункции

&НаСервереБезКонтекста
Функция рбфЗапроситьВозвратНаСервере(Сервер1С, ИмяБазы1С)
	Возврат ПравилаРеестраБаз.ЗапроситьВозвратБазы(Сервер1С, ИмяБазы1С);
КонецФункции

&НаСервереБезКонтекста
Функция рбфПродлитьСрокНаСервере(Сервер1С, ИмяБазы1С)
	Возврат ПравилаРеестраБаз.ПродлитьСрокБазы(Сервер1С, ИмяБазы1С);
КонецФункции

&НаСервереБезКонтекста
Функция рбфСтатьВладельцемНаСервере(Сервер1С, ИмяБазы1С)
	Возврат ПравилаРеестраБаз.СтатьВладельцемБазы(Сервер1С, ИмяБазы1С);
КонецФункции

#КонецОбласти
