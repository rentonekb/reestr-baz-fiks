Функционал: «Вернуть базу» восстанавливает удалённую правилом базу из бэкапа
	Как владелец тестовой базы
	Я хочу вернуть базу, которую правило реестра удалило в архив
	Чтобы база снова была в SQL и в кластере, а реестр показывал её рабочей
	# Сценарий НЕ входит в регрессию (тег @restore исключён в VAParams.regress.json): ему нужна SQL-база, которой нет.
	# Запуск только через C:\claude\knowledge\vanessa\run-restore-test.ps1: скрипт создаёт в SQL крошечную базу
	# autotest_restore, снимает бэкап D:\Backup\SQL\autotest_restore.bak и удаляет её, а после сценария снимает
	# регистрацию в кластере S2019:1541, удаляет базу и бэкап.
	# Здесь база оформляется так, как её оставляет правило «Актуальность» после удаления: тип «Архивная», ВАрхиве,
	# ПутьБэкап, запись КонтрольБаз со статусом «удалена …», прежний тип в рбфТипДоАрхива. Само удаление правилом
	# не проверяется, проверяется возврат: очередь команд → RESTORE → регистрация в кластере → реестр.
	# Побочные эффекты возврата: письмо «снова включена» владельцу (им становится тот, кто вернул) и администраторам,
	# сообщение «БАЗА ВОССТАНОВЛЕНА» в Telegram.

Контекст:
	Дано Я открыл новый сеанс TestClient или подключил уже существующий
	И я закрываю все окна клиентского приложения
	И я выполняю код встроенного языка на сервере с передачей переменных
	"""bsl
	УстановитьПривилегированныйРежим(Истина);
	ИмяТестовой = "autotest_restore";
	ПутьБэкапа = "D:\Backup\SQL\autotest_restore.bak";
	// хвосты прошлых прогонов
	Набор = РегистрыСведений.СерверыИБазы.СоздатьНаборЗаписей();
	Набор.Отбор.ИмяБазы1С.Установить(ИмяТестовой);
	Набор.Записать();
	Для Каждого ИмяРегистра Из СтрРазделить("КонтрольБаз,рбфТипДоАрхива,рбфВозвратыБаз", ",") Цикл
		НаборХвоста = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
		НаборХвоста.Отбор.ИмяБазы1С.Установить(ИмяТестовой);
		НаборХвоста.Записать();
	КонецЦикла;
	Запрос = Новый Запрос("ВЫБРАТЬ О.Идентификатор КАК Идентификатор ИЗ РегистрСведений.ОчередьКоманд КАК О ГДЕ О.Команда = ""ВернутьБазу"" И О.Параметр ПОДОБНО ""%|autotest_restore|%""");
	Хвосты = Запрос.Выполнить().Выбрать();
	Пока Хвосты.Следующий() Цикл
		МЗО = РегистрыСведений.ОчередьКоманд.СоздатьМенеджерЗаписи();
		МЗО.Идентификатор = Хвосты.Идентификатор;
		МЗО.Удалить();
	КонецЦикла;
	// сервер кластера и СУБД - как у самой base_list (S2019:1541, SQL S2019)
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 А.Сервер1С КАК Сервер1С, А.СерверБД КАК СерверБД ИЗ РегистрСведений.СерверыИБазы КАК А ГДЕ А.ИмяБазы1С = ""base_list""");
	Образец = Запрос.Выполнить().Выбрать();
	Если НЕ Образец.Следующий() Тогда
		ВызватьИсключение "В реестре нет записи base_list, не у кого взять сервер";
	КонецЕсли;
	Сейчас = ТекущаяДатаСеанса();
	МЗ = РегистрыСведений.СерверыИБазы.СоздатьМенеджерЗаписи();
	МЗ.Сервер1С = Образец.Сервер1С;
	МЗ.СерверБД = Образец.СерверБД;
	МЗ.ИмяБазы1С = ИмяТестовой;
	МЗ.ИмяБазыБД = ИмяТестовой;
	МЗ.Владелец = Справочники.Владелец.НайтиПоНаименованию("Автотест Vanessa", Истина);
	МЗ.Тип = Перечисления.ТипБазы.Архивная;
	МЗ.ВАрхиве = Истина;
	МЗ.ДатаАрхива = Сейчас;
	МЗ.ДатаФактБэкап = Сейчас;
	МЗ.ПутьБэкап = ПутьБэкапа;
	МЗ.ДатаАктуальности = ДобавитьМесяц(НачалоДня(Сейчас), -3);
	МЗ.ДатаОтключения = ДобавитьМесяц(НачалоДня(Сейчас), -1);
	МЗ.Комментарий = "Временная запись автотеста возврата базы, удаляется самим тестом";
	МЗ.Записать();
	СерверСтрокой = Строка(Образец.Сервер1С);
	МЗТ = РегистрыСведений.рбфТипДоАрхива.СоздатьМенеджерЗаписи();
	МЗТ.Сервер1С = СерверСтрокой;
	МЗТ.ИмяБазы1С = ИмяТестовой;
	МЗТ.Тип = XMLСтрока(Перечисления.ТипБазы.Тестовая);
	МЗТ.ДатаАрхивации = Сейчас;
	МЗТ.Записать();
	МЗК = РегистрыСведений.КонтрольБаз.СоздатьМенеджерЗаписи();
	МЗК.Правило = "Актуальность";
	МЗК.Сервер1С = СерверСтрокой;
	МЗК.ИмяБазы1С = ИмяТестовой;
	МЗК.ДатаПервогоУведомления = ДобавитьМесяц(Сейчас, -1);
	МЗК.ДатаПоследнегоУведомления = ДобавитьМесяц(Сейчас, -1);
	МЗК.СрокДней = 10;
	МЗК.ДатаОтключения = ДобавитьМесяц(Сейчас, -1);
	МЗК.Статус = "удалена " + Формат(Сейчас, "ДФ=dd.MM.yyyy") + ", бэкап " + ПутьБэкапа + "; кластер: ИБ удалена";
	МЗК.Записать();
	Контекст.Вставить("ТестоваяБаза", ИмяТестовой);
	Контекст.Вставить("СерверТестовой", СерверСтрокой);
	"""

Сценарий: «Вернуть базу» у удалённой базы: RESTORE из бэкапа, регистрация в кластере, реестр снова тестовый
	И я открываю навигационную ссылку "e1cib/list/РегистрСведений.СерверыИБазы"
	Тогда открылось окно "Серверы и базы"
	И я устанавливаю флаг с именем 'АрхивныеБазы'
	И в таблице "Список" я перехожу к строке:
		| 'Имя базы 1С'    |
		| '$ТестоваяБаза$' |
	И я нажимаю на кнопку с именем 'рбфКнопкаВернутьБазу'
	Тогда появилось предупреждение, содержащее текст "Возврат базы «autotest_restore» запрошен"
	И я закрываю окно предупреждения
	И я закрываю все окна клиентского приложения
	# команду выполняет регламентное задание ОбработчикКомандОбслуживания (раз в 5 минут): ждём до 10 минут
	И я выполняю код встроенного языка на сервере с передачей переменных
	"""bsl
	Контекст.Вставить("Состояние", "");
	Контекст.Вставить("Результат", "");
	Контекст.Вставить("Попытка", 0);
	"""
	И пока выражение встроенного языка 'Контекст.Состояние <> "выполнена" И Контекст.Попытка < 40' истинно я выполняю
		И Пауза 15
		И я выполняю код встроенного языка на сервере с передачей переменных
		"""bsl
		УстановитьПривилегированныйРежим(Истина);
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 О.Состояние КАК Состояние, О.Результат КАК Результат ИЗ РегистрСведений.ОчередьКоманд КАК О ГДЕ О.Команда = ""ВернутьБазу"" И О.Параметр ПОДОБНО ""%|autotest_restore|%""");
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Контекст.Вставить("Состояние", Выборка.Состояние);
			Контекст.Вставить("Результат", Выборка.Результат);
		КонецЕсли;
		Контекст.Вставить("Попытка", Контекст.Попытка + 1);
		"""
	И я выполняю код встроенного языка на сервере с передачей переменных
	"""bsl
	УстановитьПривилегированныйРежим(Истина);
	Ошибки = Новый Массив;
	Если Контекст.Состояние <> "выполнена" Тогда
		Ошибки.Добавить("команда ВернутьБазу не выполнена за 10 минут, состояние «" + Контекст.Состояние + "»");
	КонецЕсли;
	Итог = Контекст.Результат;
	Если СтрНайти(Итог, "СУБД: восстановлена из бэкапа") = 0 Тогда
		Ошибки.Добавить("нет восстановления из бэкапа");
	КонецЕсли;
	Если СтрНайти(Итог, "кластер: ИБ зарегистрирована") = 0 Тогда
		Ошибки.Добавить("ИБ не зарегистрирована в кластере");
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ А.Тип КАК Тип, А.ВАрхиве КАК ВАрхиве, А.ДатаОтключения КАК ДатаОтключения, ПРЕДСТАВЛЕНИЕ(А.Владелец) КАК Владелец ИЗ РегистрСведений.СерверыИБазы КАК А ГДЕ А.ИмяБазы1С = ""autotest_restore""");
	Запись = Запрос.Выполнить().Выбрать();
	Если НЕ Запись.Следующий() Тогда
		Ошибки.Добавить("запись пропала из реестра");
	Иначе
		Если Запись.Тип <> Перечисления.ТипБазы.Тестовая Тогда
			Ошибки.Добавить("тип " + Запись.Тип + ", ожидался Тестовая (из рбфТипДоАрхива)");
		КонецЕсли;
		Если Запись.ВАрхиве Тогда
			Ошибки.Добавить("отметка архива не снята");
		КонецЕсли;
		Если Запись.ДатаОтключения < ДобавитьМесяц(НачалоДня(ТекущаяДатаСеанса()), 2) Тогда
			Ошибки.Добавить("дата отключения не сдвинута на 2 месяца: " + Запись.ДатаОтключения);
		КонецЕсли;
		Если Запись.Владелец = "Автотест Vanessa" Тогда
			Ошибки.Добавить("владельцем не стал вернувший базу");
		КонецЕсли;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Ч ИЗ РегистрСведений.КонтрольБаз КАК К ГДЕ К.ИмяБазы1С = ""autotest_restore""");
	Если Запрос.Выполнить().Выгрузить()[0].Ч <> 0 Тогда
		Ошибки.Добавить("база не снята с учёта правил (КонтрольБаз)");
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Ч ИЗ РегистрСведений.рбфВозвратыБаз КАК Возвраты ГДЕ Возвраты.ИмяБазы1С = ""autotest_restore""");
	Если Запрос.Выполнить().Выгрузить()[0].Ч = 0 Тогда
		Ошибки.Добавить("нет записи в истории возвратов");
	КонецЕсли;
	Контекст.Вставить("ИтогПроверки", ?(Ошибки.Количество() = 0, "ОК", СтрСоединить(Ошибки, "; ") + ". Результат очереди: " + Итог));
	"""
	И я вывожу значение переменной 'ИтогПроверки'
	И переменная 'ИтогПроверки' имеет значение 'ОК'
	# уборка в реестре; SQL-базу и регистрацию в кластере убирает run-restore-test.ps1
	И я выполняю код встроенного языка на сервере с передачей переменных
	"""bsl
	УстановитьПривилегированныйРежим(Истина);
	Набор = РегистрыСведений.СерверыИБазы.СоздатьНаборЗаписей();
	Набор.Отбор.ИмяБазы1С.Установить("autotest_restore");
	Набор.Записать();
	Для Каждого ИмяРегистра Из СтрРазделить("КонтрольБаз,рбфТипДоАрхива,рбфВозвратыБаз", ",") Цикл
		НаборХвоста = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
		НаборХвоста.Отбор.ИмяБазы1С.Установить("autotest_restore");
		НаборХвоста.Записать();
	КонецЦикла;
	"""
