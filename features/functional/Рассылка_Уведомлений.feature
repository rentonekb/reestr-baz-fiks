#language: ru

@tree
@functional
@writes
@mail

Функционал: Рассылка уведомлений владельцам баз
	Как администратор реестра баз
	Я хочу, чтобы рассылка находила базы с подходящим сроком и отправляла письмо их владельцу
	Чтобы владельцы вовремя узнавали об отключении баз
	# Пишет в боевую базу и отправляет одно настоящее письмо — только тестовому владельцу «Автотест Vanessa»
	# (почта dba@activelogic.ru). Изоляция: у временной записи autotest_vanessa уникальная дата отключения 02.01.2001,
	# отбор «Тестовая, дата раньше 03.01.2001» находит только её. Поле «Владелец» на форме запрос не фильтрует.
	# Перед «Отправить» — две проверки, что в таблице ровно одна наша база: иначе письмо ушло бы живым владельцам.

Контекст:
	Дано Я открыл новый сеанс TestClient или подключил уже существующий
	И я закрываю все окна клиентского приложения
	И я выполняю код встроенного языка на сервере с передачей переменных
	"""bsl
	УстановитьПривилегированныйРежим(Истина);
	ИмяТестовой = "autotest_vanessa";
	Набор = РегистрыСведений.СерверыИБазы.СоздатьНаборЗаписей();
	Набор.Отбор.ИмяБазы1С.Установить(ИмяТестовой);
	Набор.Записать();
	Владелец = Справочники.Владелец.НайтиПоНаименованию("Автотест Vanessa", Истина);
	Если Владелец.Пустая() Тогда
		ТестовыйВладелец = Справочники.Владелец.СоздатьЭлемент();
		ТестовыйВладелец.Наименование = "Автотест Vanessa";
		ТестовыйВладелец.Почта = "dba@activelogic.ru";
		ТестовыйВладелец.Записать();
		Владелец = ТестовыйВладелец.Ссылка;
	КонецЕсли;
	НаборУв = РегистрыСведений.ОтправленныеУведомления.СоздатьНаборЗаписей();
	НаборУв.Отбор.Владелец.Установить(Владелец);
	НаборУв.Записать();
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 А.Сервер1С КАК Сервер1С, А.СерверБД КАК СерверБД ИЗ РегистрСведений.СерверыИБазы КАК А ГДЕ А.Тип = ЗНАЧЕНИЕ(Перечисление.ТипБазы.Тестовая) И НЕ А.ВАрхиве И А.Сервер1С <> ЗНАЧЕНИЕ(Справочник.Сервер1С.ПустаяСсылка)");
	Образец = Запрос.Выполнить().Выбрать();
	Образец.Следующий();
	МЗ = РегистрыСведений.СерверыИБазы.СоздатьМенеджерЗаписи();
	МЗ.Сервер1С = Образец.Сервер1С;
	МЗ.СерверБД = Образец.СерверБД;
	МЗ.ИмяБазы1С = ИмяТестовой;
	МЗ.ИмяБазыБД = ИмяТестовой;
	МЗ.Владелец = Владелец;
	МЗ.Тип = Перечисления.ТипБазы.Тестовая;
	МЗ.ДатаАктуальности = Дата(2001, 1, 1);
	МЗ.ДатаОтключения = Дата(2001, 1, 2);
	МЗ.Комментарий = "Временная запись автотестов Vanessa, удаляется самим тестом";
	МЗ.Записать();
	Проверка = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ РегистрСведений.СерверыИБазы КАК А ГДЕ А.Тип = ЗНАЧЕНИЕ(Перечисление.ТипБазы.Тестовая) И НЕ А.ВАрхиве И А.ДатаОтключения <> ДАТАВРЕМЯ(1, 1, 1) И А.ДатаОтключения < ДАТАВРЕМЯ(2001, 1, 3)");
	Если Проверка.Выполнить().Выгрузить()[0].К <> 1 Тогда
		ВызватьИсключение "Под отбор рассылки попадает не только autotest_vanessa — письмо ушло бы живым владельцам, тест остановлен";
	КонецЕсли;
	"""

Сценарий: «Заполнить» находит базу по типу и сроку, «Отправить» шлёт письмо её владельцу
	И я открываю навигационную ссылку "e1cib/command/Обработка.РассылкаУведомленийПоПочте.Открыть"
	Тогда открылось окно "Рассылка уведомлений по почте"
	И из выпадающего списка с именем 'Тип' я выбираю по строке "Тестовая"
	И в поле с именем 'ДатаОтключения' я ввожу текст "03.01.2001"
	И я нажимаю на кнопку с именем 'Заполнить'
	И я жду, что в таблице "Базы" количество строк будет "равно" 1 в течение 20 секунд
	И таблица "Базы" содержит строки:
		| 'База'             | 'Владелец'         |
		| 'autotest_vanessa' | 'Автотест Vanessa' |
	И из выпадающего списка с именем 'Сообщение' я выбираю по строке "Тест"
	И я нажимаю на кнопку с именем 'Отправить'
	# отправка через SMTP идёт на сервере и не ждётся нажатием кнопки
	И пауза 20
	# факт отправки — запись в регистре «Отправленные уведомления» с признаком ПисьмоОтправлено
	И я выполняю код встроенного языка на сервере с передачей переменных
	"""bsl
	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ РегистрСведений.ОтправленныеУведомления КАК О ГДЕ О.Владелец.Наименование = ""Автотест Vanessa"" И О.База = ""autotest_vanessa"" И О.ПисьмоОтправлено");
	Если Запрос.Выполнить().Выгрузить()[0].К = 0 Тогда
		ВызватьИсключение "Письмо не отправлено: в «Отправленных уведомлениях» нет записи для autotest_vanessa";
	КонецЕсли;
	"""
	И я закрываю все окна клиентского приложения
	И я выполняю код встроенного языка на сервере с передачей переменных
	"""bsl
	УстановитьПривилегированныйРежим(Истина);
	Набор = РегистрыСведений.СерверыИБазы.СоздатьНаборЗаписей();
	Набор.Отбор.ИмяБазы1С.Установить("autotest_vanessa");
	Набор.Записать();
	Владелец = Справочники.Владелец.НайтиПоНаименованию("Автотест Vanessa", Истина);
	Если НЕ Владелец.Пустая() Тогда
		НаборУв = РегистрыСведений.ОтправленныеУведомления.СоздатьНаборЗаписей();
		НаборУв.Отбор.Владелец.Установить(Владелец);
		НаборУв.Записать();
	КонецЕсли;
	"""
