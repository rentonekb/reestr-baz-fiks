#language: ru

@tree
@functional
@writes
@cluster

Функционал: Создание кластера 1С: службы агента и RAS на S2019, агент на 88.63, уборка
	Как администратор реестра баз
	Я хочу, чтобы создание кластера реально ставило службы и настраивало кластер, а уборка всё снимала
	Чтобы кнопка «Создать кластер» работала, когда она понадобится
	# Создаёт НАСТОЯЩИЕ службы на боевых S2019 и 192.168.88.63: 1C:autotestvanessa (агент), 1C:RAS_[порт+5] и агент на 88.63,
	# кластер на порту N541 с рабочим сервером 88.63 и ТНФ. Порт - первый свободный N540 (режим Info).
	# Уборка - режим Remove скрипта C:\Tools\Cluster1C\Cluster1C.ps1, он работает только с именами autotest*:
	# службы и каталоги srvinfo_autotestvanessa. Уборка идёт до создания (хвосты прошлого прогона) и после.
	# Создание - тем же серверным методом рбфКластеры1С.Создать, что и кнопка: вызов идёт 1-3 минуты и не уложился бы
	# в таймаут тест-клиента. Кнопка проверяется до вопроса «Создать кластер…?» (ответ «Нет»).
	# В обычную регрессию не входит (тег @cluster исключён, как @restore).

Контекст:
	Дано Я открыл новый сеанс TestClient или подключил уже существующий
	И я закрываю все окна клиентского приложения
	И я выполняю код встроенного языка на сервере с передачей переменных
	"""bsl
	УстановитьПривилегированныйРежим(Истина);
	Если НЕ ЗначениеЗаполнено(ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("РеестрБазФикс.Кластеры1С", "ПарольService1C")) Тогда
		ВызватьИсключение "Пароль AL\service.1c не сохранён в безопасном хранилище: его вводит администратор в форме «Создание кластера 1С» кнопкой «Сохранить пароль»";
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	// уборка хвостов прошлого прогона: все службы autotestvanessa на любом порту N540
	Текст = рбфКластеры1С.Сведения().Текст;
	Для Н = 2 По 9 Цикл
		П = Н * 1000 + 540;
		Если СтрНайти(Текст, "1C:autotestvanessa") > 0 ИЛИ СтрНайти(Текст, "1C:RAS_[" + Формат(П + 5, "ЧГ=0") + "]") > 0 Тогда
			ФайлЗапроса = ПолучитьИмяВременногоФайла("json");
			ФайлОтвета = ПолучитьИмяВременногоФайла("json");
			Запись = Новый ЗаписьJSON;
			Запись.ОткрытьФайл(ФайлЗапроса, КодировкаТекста.UTF8, Ложь);
			ЗаписатьJSON(Запись, Новый Структура("Mode, Name, Version, Port", "Remove", "autotestvanessa", "", П));
			Запись.Закрыть();
			Код = 0;
			ЗапуститьПриложение(СтрШаблон("powershell.exe -NoProfile -ExecutionPolicy Bypass -File ""C:\Tools\Cluster1C\Cluster1C.ps1"" -In ""%1"" -Out ""%2""", ФайлЗапроса, ФайлОтвета), , Истина, Код);
			УдалитьФайлы(ФайлЗапроса);
			УдалитьФайлы(ФайлОтвета);
		КонецЕсли;
	КонецЦикла;
	Текст = рбфКластеры1С.Сведения().Текст;
	Если СтрНайти(Текст, "1C:autotestvanessa") > 0 Тогда
		ВызватьИсключение "Не удалось убрать службы autotestvanessa прошлого прогона: " + Текст;
	КонецЕсли;
	"""

Сценарий: Кнопка «Создать кластер» спрашивает подтверждение, ответ «Нет» ничего не создаёт
	И я открываю навигационную ссылку "e1cib/command/ОбщаяКоманда.рбфСозданиеКластера"
	Тогда открылось окно "Создание кластера 1С"
	И в поле с именем 'Имя' я ввожу текст "autotestvanessa"
	И я нажимаю на кнопку с именем 'КнопкаСоздать'
	Тогда открылось окно "1С:Предприятие"
	И я нажимаю на кнопку "Нет"
	Тогда открылось окно "Создание кластера 1С"
	И я закрываю все окна клиентского приложения
	И я выполняю код встроенного языка на сервере с передачей переменных
	"""bsl
	Текст = рбфКластеры1С.Сведения().Текст;
	Если СтрНайти(Текст, "autotestvanessa") > 0 Тогда
		ВызватьИсключение "Ответ «Нет» создал службы: " + Текст;
	КонецЕсли;
	"""

Сценарий: Создание кластера ставит службы и кластер, уборка их снимает
	И я выполняю код встроенного языка на сервере с передачей переменных
	"""bsl
	Сведения = рбфКластеры1С.Сведения();
	Если Сведения.Версии.Количество() = 0 ИЛИ Сведения.СвободныйПорт = 0 Тогда
		ВызватьИсключение "Нет версии платформы или свободного порта: " + Сведения.Текст;
	КонецЕсли;
	Порт = Сведения.СвободныйПорт;
	Итог = рбфКластеры1С.Создать("autotestvanessa", Сведения.Версии[0], Порт);
	ОшибкаСоздания = "";
	Если СтрНайти(Итог, "Кластер создан") <> 1 Тогда
		ОшибкаСоздания = "Создание не прошло: " + Итог;
	Иначе
		Текст = рбфКластеры1С.Сведения().Текст;
		Для Каждого Имя Из СтрРазделить("1C:autotestvanessa [Running],1C:RAS_[" + Формат(Порт + 5, "ЧГ=0") + "] [Running]", ",") Цикл
			Если СтрНайти(Текст, Имя) = 0 Тогда
				ОшибкаСоздания = ОшибкаСоздания + "нет службы " + Имя + "; ";
			КонецЕсли;
		КонецЦикла;
		Если СтрЧислоВхождений(Текст, "1C:autotestvanessa") < 2 Тогда
			ОшибкаСоздания = ОшибкаСоздания + "агента нет на 88.63; ";
		КонецЕсли;
		Если ЗначениеЗаполнено(ОшибкаСоздания) Тогда
			ОшибкаСоздания = ОшибкаСоздания + Символы.ПС + Итог + Символы.ПС + Текст;
		КонецЕсли;
	КонецЕсли;
	// уборка - всегда, в том числе после неудачного создания
	ФайлЗапроса = ПолучитьИмяВременногоФайла("json");
	ФайлОтвета = ПолучитьИмяВременногоФайла("json");
	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(ФайлЗапроса, КодировкаТекста.UTF8, Ложь);
	ЗаписатьJSON(Запись, Новый Структура("Mode, Name, Version, Port", "Remove", "autotestvanessa", "", Порт));
	Запись.Закрыть();
	Код = 0;
	ЗапуститьПриложение(СтрШаблон("powershell.exe -NoProfile -ExecutionPolicy Bypass -File ""C:\Tools\Cluster1C\Cluster1C.ps1"" -In ""%1"" -Out ""%2""", ФайлЗапроса, ФайлОтвета), , Истина, Код);
	УдалитьФайлы(ФайлЗапроса);
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ФайлОтвета, "UTF-8"); // у ЧтениеJSON кодировка - только строкой
	Уборка = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	УдалитьФайлы(ФайлОтвета);
	Текст = рбфКластеры1С.Сведения().Текст;
	Если НЕ Уборка.Ok ИЛИ СтрНайти(Текст, "autotestvanessa") > 0 ИЛИ СтрНайти(Текст, "RAS_[" + Формат(Порт + 5, "ЧГ=0") + "]") > 0 Тогда
		ОшибкаСоздания = ОшибкаСоздания + Символы.ПС + "Уборка не сняла службы: " + Уборка.Error + Символы.ПС + Текст;
	КонецЕсли;
	Если ЗначениеЗаполнено(ОшибкаСоздания) Тогда
		ВызватьИсключение ОшибкаСоздания;
	КонецЕсли;
	"""
