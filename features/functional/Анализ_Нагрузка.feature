@tree
@functional
@readonly

Функционал: Раздел «Анализ», форма «График»: живой дашборд нагрузки, а не пустая форма
	Как администратор реестра баз
	Я хочу видеть текущую нагрузку сервера плитками и графиками
	Чтобы остановку агента мониторинга или поломку дашборда увидеть раньше, чем понадобятся графики
	# Только чтение. Нужны замеры агента rbf_agent на S2019 (RBF-Agent-Metrics раз в 5 минут).

Контекст:
	Дано Я открыл новый сеанс TestClient или подключил уже существующий
	И я закрываю все окна клиентского приложения

Сценарий: Агент присылает свежие замеры по каждой панели дашборда
	# Пустая панель на дашборде = нет замеров её счётчиков: тест называет, каких именно.
	И я выполняю код встроенного языка на сервере с передачей переменных
	"""bsl
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ МАКСИМУМ(С.Время) КАК Последний ИЗ РегистрСведений.рбфСчетчики КАК С ГДЕ С.Сервер = ""S2019"" И С.Счетчик = ""CPU, %""");
	Последний = Запрос.Выполнить().Выгрузить()[0].Последний;
	Если НЕ ЗначениеЗаполнено(Последний) ИЛИ ТекущаяДатаСеанса() - Последний > 900 Тогда
		ВызватьИсключение СтрШаблон("Последний замер CPU на S2019: %1 - агент мониторинга не присылает данные дольше 15 минут", Последний);
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ С.Счетчик КАК Счетчик ИЗ РегистрСведений.рбфСчетчики КАК С ГДЕ С.Время >= &С И (С.Сервер = ""S2019"" ИЛИ С.Сервер ПОДОБНО ""S2019:%"")");
	Запрос.УстановитьПараметр("С", ТекущаяДатаСеанса() - 3 * 3600);
	Есть = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Счетчик");
	Панели = Новый Соответствие;
	Панели.Вставить("Процессор", "CPU, %");
	Панели.Вставить("Память", "rphost: память, МБ");
	Панели.Вставить("SQL: запросов в секунду", "SQL MSSQLSERVER: Запросов/с");
	Панели.Вставить("Блокировки и ожидания", "Сеансы: ждут блокировку 1С");
	Панели.Вставить("Диски: задержка", "Диск C: чтение, мс");
	Панели.Вставить("1С: самый долгий вызов", "Сеансы: самый долгий текущий вызов, с");
	Нет = Новый Массив;
	Для Каждого КЗ Из Панели Цикл
		Если Есть.Найти(КЗ.Значение) = Неопределено Тогда
			Нет.Добавить(КЗ.Ключ + " (" + КЗ.Значение + ")");
		КонецЕсли;
	КонецЦикла;
	Если Нет.Количество() > 0 Тогда
		ВызватьИсключение "За 3 часа нет замеров для панелей: " + СтрСоединить(Нет, "; ");
	КонецЕсли;
	"""

Сценарий: Дашборд открывается с плитками текущей нагрузки
	И я открываю навигационную ссылку "e1cib/command/ОбщаяКоманда.рбфАнализГрафик"
	Тогда открылось окно "График"
	И я перехожу к закладке с именем "СтраницаНагрузка"
	Тогда элемент формы с именем 'НадписьСостояние' стал равен шаблону "S2019, последний замер *"
	# в плитке - число с единицей; «нет данных» шаблон не пропустит
	Тогда элемент формы с именем 'ПлиткаЦП' стал равен шаблону "Процессор*%"
	Тогда элемент формы с именем 'ПлиткаПамять' стал равен шаблону "Память*%"
	Тогда элемент формы с именем 'ПлиткаRphost' стал равен шаблону "rphost*ГБ"
	Тогда элемент формы с именем 'ПлиткаPLE' стал равен шаблону "PLE* с"
	Тогда элемент формы с именем 'ПлиткаВызов' стал равен шаблону "Долгий вызов* с"
	Тогда элемент формы с именем 'ПлиткаДиски' стал равен шаблону "Диски свободно*%"
	И флаг с именем 'Автообновление' равен "Да"
	И я нажимаю на кнопку с именем 'КнопкаОбновить'
	Тогда элемент формы с именем 'ПлиткаЦП' стал равен шаблону "Процессор*%"
	И я закрываю все окна клиентского приложения

Сценарий: Конструктор перестраивает диаграмму по отметке показателя
	И я открываю навигационную ссылку "e1cib/command/ОбщаяКоманда.рбфАнализГрафик"
	Тогда открылось окно "График"
	И я перехожу к закладке с именем "СтраницаКонструктор"
	Тогда таблица "Показатели" содержит строки:
		| 'Показатель'          |
		| 'S2019: CPU, %'       |
	И в таблице "Показатели" я перехожу к строке:
		| 'Показатель'          |
		| 'S2019: CPU, %'       |
	И в таблице "Показатели" я изменяю флаг с именем 'ПоказателиПометка'
	И в таблице "Показатели" я завершаю редактирование строки
	Тогда не появилось окно предупреждения системы
	И я закрываю все окна клиентского приложения
